package web

templ AgentSettings() {
	@base("agents") {
		<main class="min-w-0 flex-1 overflow-y-auto rounded-2xl bg-stone-50 shadow-sm">
			<div class="mx-auto max-w-[1280px] p-4 sm:p-6 lg:p-8">
				<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-purple-600">Equipe</p>
						<h1 class="mt-2 text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Agentes e setores</h1>
						<p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-500">Gerencie quem atende, quem administra e como a equipe é organizada em setores.</p>
					</div>
					<button id="new-agent-button" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg" style="background: linear-gradient(to right, #3b82f6, #6123cc);"><i class="fas fa-user-plus"></i> Novo agente</button>
					<button id="new-sector-button" type="button" class="hidden items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg" style="background: linear-gradient(to right, #3b82f6, #6123cc);"><i class="fas fa-layer-group"></i> Novo setor</button>
				</header>
				<nav id="team-tabs" class="mx-auto mt-6 flex w-fit gap-1 rounded-xl bg-stone-200/70 p-1 lg:mx-0" role="tablist" aria-label="Seções da equipe">
					<button type="button" role="tab" data-team-tab="agentes" aria-selected="true" aria-controls="team-agents-panel" class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-bold text-purple-700 shadow-sm">Agentes <span id="team-tab-agents-count" class="rounded-full bg-purple-100 px-2 py-0.5 text-[11px] font-bold text-purple-700">-</span></button>
					<button type="button" role="tab" data-team-tab="setores" aria-selected="false" aria-controls="team-sectors-panel" class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-bold text-stone-600 hover:text-gray-900">Setores <span id="team-tab-sectors-count" class="rounded-full bg-stone-300/70 px-2 py-0.5 text-[11px] font-bold text-stone-600">-</span></button>
				</nav>
				<div id="team-agents-panel" role="tabpanel">
				<section class="mt-6 grid gap-3 sm:grid-cols-3">
					<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
						<div class="flex items-start justify-between"><div><p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Agentes ativos</p><p class="mt-3 flex items-baseline gap-2"><span id="agents-active" class="text-3xl font-black text-gray-950">-</span><span id="agents-total" class="text-xs text-gray-400"></span></p></div><span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-100 text-emerald-700"><i class="fas fa-headset"></i></span></div>
					</article>
					<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
						<div class="flex items-start justify-between"><div><p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Administradores</p><p class="mt-3 flex items-baseline gap-2"><span id="agents-admins" class="text-3xl font-black text-gray-950">-</span><span class="text-xs text-gray-400">acesso total</span></p></div><span class="grid h-10 w-10 place-items-center rounded-xl bg-blue-100 text-blue-700"><i class="fas fa-user-shield"></i></span></div>
					</article>
					<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
						<div class="flex items-start justify-between"><div><p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Sem setor</p><p class="mt-3 flex items-baseline gap-2"><span id="agents-unassigned" class="text-3xl font-black text-gray-950">-</span><span class="text-xs text-gray-400">não recebem filas de setor</span></p></div><span class="grid h-10 w-10 place-items-center rounded-xl bg-amber-100 text-amber-700"><i class="fas fa-layer-group"></i></span></div>
					</article>
				</section>
				<div class="mt-5 flex gap-3 rounded-2xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900">
					<span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-blue-100 text-blue-700"><i class="fas fa-shield-halved"></i></span>
					<div><p class="font-bold">Proteção do último administrador ativo</p><p class="mt-1 leading-relaxed text-blue-800">A empresa precisa manter pelo menos um administrador ativo. Para desativar ou rebaixar o último, primeiro promova e ative outro agente.</p></div>
				</div>
				<div id="agent-page-error" role="alert" class="mt-5 hidden items-start justify-between gap-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
					<div class="flex gap-3"><i class="fas fa-circle-exclamation mt-0.5"></i><span id="agent-page-error-text"></span></div>
					<button id="close-agent-error" type="button" aria-label="Fechar aviso"><i class="fas fa-xmark"></i></button>
				</div>
				<section class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
					<div class="flex flex-col gap-4 border-b border-stone-200 p-5 sm:flex-row sm:items-center sm:justify-between">
						<div><h2 class="font-bold text-gray-950">Pessoas com acesso</h2><p class="mt-1 text-sm text-gray-500">Perfis administrativos e de atendimento.</p></div>
						<label class="relative block sm:w-72"><i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-400"></i><input id="agent-search" type="search" placeholder="Buscar nome ou email" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-2.5 pl-10 pr-3 text-sm outline-none transition focus:border-purple-400 focus:bg-white focus:ring-2 focus:ring-purple-100"/></label>
					</div>
					<div id="agents-loading" class="p-12 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando equipe...</div>
					<div id="agents-table-wrap" class="hidden overflow-x-auto">
						<table class="w-full min-w-[760px] text-left text-sm">
							<thead class="bg-stone-50 text-[11px] uppercase tracking-wider text-gray-500"><tr><th class="px-5 py-3 font-semibold">Agente</th><th class="px-5 py-3 font-semibold">Papel</th><th class="px-5 py-3 font-semibold">Setores</th><th class="px-5 py-3 font-semibold">Status</th><th class="px-5 py-3 font-semibold">Atualizado</th><th class="px-5 py-3 text-right font-semibold">Ação</th></tr></thead>
							<tbody id="agents-table-body" class="divide-y divide-stone-100"></tbody>
						</table>
					</div>
					<div id="agents-mobile" class="divide-y divide-stone-100 lg:hidden"></div>
					<div id="agents-empty" class="hidden p-12 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-stone-100 text-xl text-gray-400"><i class="fas fa-user-slash"></i></span><p class="mt-4 font-semibold text-gray-700">Nenhum agente encontrado</p><p class="mt-1 text-sm text-gray-500">Adicione uma pessoa ou ajuste a busca.</p></div>
				</section>
				</div>
				<div id="team-sectors-panel" role="tabpanel" class="hidden">
					<div id="sectors-error" role="alert" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
					<div id="sectors-loading" class="mt-6 rounded-2xl border border-stone-200 bg-white p-12 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando setores...</div>
					<section id="sectors-grid" class="mt-6 hidden gap-3 sm:grid-cols-2 xl:grid-cols-3"></section>
				</div>
			</div>
		</main>
		<div id="agent-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="agent-modal-title">
			<div class="max-h-[94vh] w-full max-w-xl overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl">
				<div class="sticky top-0 z-10 flex items-center justify-between border-b border-stone-200 bg-white px-5 py-4 sm:px-7">
					<div><p class="text-[10px] font-bold uppercase tracking-[0.2em] text-purple-600">Acesso da equipe</p><h2 id="agent-modal-title" class="mt-1 text-xl font-black text-gray-950">Novo agente</h2></div>
					<button id="close-agent-modal" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 transition hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button>
				</div>
				<form id="agent-form" class="p-5 sm:p-7">
					<div id="agent-form-error" role="alert" class="mb-5 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
					<div class="space-y-5">
						<div><label for="agent-name" class="mb-2 block text-sm font-semibold text-gray-700">Nome completo</label><div class="relative"><i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i><input id="agent-name" name="name" required maxlength="40" autocomplete="name" placeholder="Nome do agente" class="w-full rounded-xl border border-stone-200 py-3 pl-12 pr-4 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div></div>
						<div><label for="agent-email" class="mb-2 block text-sm font-semibold text-gray-700">Email de acesso</label><div class="relative"><i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i><input id="agent-email" type="email" name="email" required maxlength="180" autocomplete="email" placeholder="agente@empresa.com.br" class="w-full rounded-xl border border-stone-200 py-3 pl-12 pr-4 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div></div>
						<div><div class="mb-2 flex items-center justify-between"><label for="agent-password" class="block text-sm font-semibold text-gray-700">Senha</label><span id="agent-password-hint" class="text-xs text-gray-500">Obrigatória no cadastro</span></div><div class="relative"><i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i><input id="agent-password" type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Mínimo de 8 caracteres" class="w-full rounded-xl border border-stone-200 py-3 pl-12 pr-4 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div></div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div><label for="agent-role" class="mb-2 block text-sm font-semibold text-gray-700">Papel</label><select id="agent-role" name="role" required class="w-full"><option value="agent">Agente de atendimento</option><option value="supervisor">Supervisor</option><option value="admin">Administrador</option></select></div>
							<div><span class="mb-2 block text-sm font-semibold text-gray-700">Status</span><label class="flex h-[46px] cursor-pointer items-center gap-3 rounded-xl border border-stone-200 bg-white px-4 shadow-sm transition hover:border-purple-300"><input id="agent-active" type="checkbox" name="isActive" checked class="peer sr-only"/><span class="grid h-5 w-5 shrink-0 place-items-center rounded-md border border-stone-300 bg-white text-[10px] text-transparent transition peer-checked:border-purple-600 peer-checked:bg-purple-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-purple-200 peer-focus-visible:ring-offset-2"><i class="fas fa-check"></i></span><span class="min-w-0 flex-1 truncate text-sm font-semibold text-gray-700">Acesso ativo</span><span class="shrink-0 text-[10px] font-medium text-gray-400">Pode entrar</span></label></div>
						</div>
						<fieldset id="agent-sectors-field"><legend class="mb-2 block text-sm font-semibold text-gray-700">Setores</legend><div id="agent-sectors" class="grid gap-1 rounded-xl border border-stone-200 p-2 sm:grid-cols-2"></div><p id="agent-sectors-note" class="mt-2 hidden text-xs text-gray-500"></p></fieldset>
					</div>
					<div id="agent-admin-warning" class="mt-5 hidden gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"><i class="fas fa-triangle-exclamation mt-0.5 text-amber-600"></i><p>Ao retirar o papel administrativo ou desativar este usuário, a operação só será permitida se existir outro administrador ativo.</p></div>
					<div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><button id="cancel-agent-button" type="button" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-stone-50">Cancelar</button><button id="agent-submit" type="submit" class="rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-md disabled:cursor-wait disabled:opacity-60" style="background: linear-gradient(to right, #3b82f6, #6123cc);">Criar agente</button></div>
				</form>
			</div>
		</div>
		<div id="sector-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="sector-modal-title">
			<form id="sector-form" class="w-full max-w-md overflow-hidden rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl">
				<div class="flex items-center justify-between border-b border-stone-200 px-5 py-4 sm:px-7"><div><p class="text-[10px] font-bold uppercase tracking-[0.2em] text-purple-600">Organização da equipe</p><h2 id="sector-modal-title" class="mt-1 text-xl font-black text-gray-950">Novo setor</h2></div><button type="button" data-close-team-modal="sector-modal" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 transition hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></div>
				<div class="space-y-5 p-5 sm:p-7">
					<div id="sector-form-error" role="alert" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
					<div><label for="sector-name" class="mb-2 block text-sm font-semibold text-gray-700">Nome do setor</label><input id="sector-name" required maxlength="80" placeholder="Ex: Suporte" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
					<div><span class="mb-2 block text-sm font-semibold text-gray-700">Cor</span><label class="flex items-center gap-3 rounded-xl border border-stone-200 px-3 py-2"><input id="sector-color" type="color" value="#6123CC" class="h-9 w-11 cursor-pointer rounded-lg border-0 bg-transparent p-0" aria-label="Cor do setor"/><code id="sector-color-value" class="text-xs font-semibold text-gray-500">#6123CC</code></label></div>
					<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center"><button id="sector-delete" type="button" class="hidden rounded-xl px-4 py-3 text-sm font-semibold text-red-600 hover:bg-red-50 sm:mr-auto"><i class="fas fa-trash-alt mr-2"></i>Excluir setor</button><button type="button" data-close-team-modal="sector-modal" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-stone-50 sm:ml-auto">Cancelar</button><button id="sector-submit" type="submit" class="rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-md disabled:cursor-wait disabled:opacity-60" style="background: linear-gradient(to right, #3b82f6, #6123cc);">Criar setor</button></div>
				</div>
			</form>
		</div>
		<div id="sector-members-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="sector-members-title">
			<div class="flex max-h-[94vh] w-full max-w-md flex-col overflow-hidden rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl">
				<div class="flex items-center justify-between border-b border-stone-200 px-5 py-4 sm:px-7"><div><p class="text-[10px] font-bold uppercase tracking-[0.2em] text-purple-600">Equipe do setor</p><h2 id="sector-members-title" class="mt-1 text-xl font-black text-gray-950">Gerenciar agentes</h2></div><button type="button" data-close-team-modal="sector-members-modal" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 transition hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></div>
				<div class="min-h-0 flex-1 overflow-y-auto p-5 sm:p-7"><div id="sector-members-error" role="alert" class="mb-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div><p class="mb-3 text-xs text-gray-500">Somente agentes ativos podem ser vinculados a setores.</p><div id="sector-members-list" class="space-y-1"></div></div>
				<div class="flex flex-col-reverse gap-3 border-t border-stone-200 px-5 py-4 sm:flex-row sm:justify-end sm:px-7"><button type="button" data-close-team-modal="sector-members-modal" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-stone-50">Cancelar</button><button id="sector-members-submit" type="button" class="rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-md disabled:cursor-wait disabled:opacity-60" style="background: linear-gradient(to right, #3b82f6, #6123cc);">Salvar equipe</button></div>
			</div>
		</div>
		<div id="agent-toast" class="fixed bottom-5 right-5 z-[60] hidden max-w-sm items-center gap-3 rounded-2xl bg-gray-950 px-5 py-4 text-sm font-medium text-white shadow-2xl" role="status"><i class="fas fa-check-circle text-emerald-400"></i><span id="agent-toast-text"></span></div>
		@AdminControls()
		<script>
const agentState = { agents: [] };
const teamState = { sectors: [], assignments: new Map(), loaded: false };

function agentElement(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined && text !== null) node.textContent = String(text);
    return node;
}

function agentErrorMessage(payload, fallback) {
    if (!payload) return fallback;
    const value = payload.error || payload.message;
    if (typeof value === 'string') return value;
    if (value && typeof value.message === 'string') return value.message;
    return fallback;
}

async function agentAPI(method, url, body) {
    const options = { method: method, credentials: 'same-origin', headers: { 'Accept': 'application/json' } };
    if (body !== undefined) {
        options.headers['Content-Type'] = 'application/json';
        options.body = JSON.stringify(body);
    }
    const response = await fetch(url, options);
    const text = await response.text();
    let payload = null;
    if (text) {
        try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; }
    }
    if (!response.ok) throw new Error(agentErrorMessage(payload, 'Erro ' + response.status));
    return payload;
}

function friendlyAgentError(error) {
    const message = error instanceof Error ? error.message : String(error);
    const normalized = message.toLocaleLowerCase('pt-BR');
    if ((normalized.includes('admin') && normalized.includes('active')) || normalized.includes('at least one active admin') || normalized.includes('último administrador')) {
        return 'Não é possível remover o último administrador ativo. Ative ou promova outro agente antes desta alteração.';
    }
    if (normalized.includes('email') && (normalized.includes('use') || normalized.includes('uso'))) return 'Este email já está em uso por outro agente.';
    return message;
}

function showAgentPageError(error) {
    const box = document.getElementById('agent-page-error');
    document.getElementById('agent-page-error-text').textContent = friendlyAgentError(error);
    box.classList.remove('hidden');
    box.classList.add('flex');
}

let agentToastTimer;
function showAgentToast(message) {
    const toast = document.getElementById('agent-toast');
    document.getElementById('agent-toast-text').textContent = message;
    toast.classList.remove('hidden');
    toast.classList.add('flex');
    clearTimeout(agentToastTimer);
    agentToastTimer = setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 3000);
}

function formatAgentDate(value) {
    if (!value) return 'Não informado';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return 'Não informado';
    return new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(date);
}

function agentBadge(agent) {
    if (!agent.isActive) return agentElement('span', 'inline-flex rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-600', 'Inativo');
    return agentElement('span', 'inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700', 'Ativo');
}

function roleBadge(role) {
    const styles = { admin: ['bg-purple-100 text-purple-700', 'Administrador'], supervisor: ['bg-amber-100 text-amber-800', 'Supervisor'] };
    const [className, label] = styles[role] || ['bg-blue-100 text-blue-700', 'Agente'];
    return agentElement('span', 'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ' + className, label);
}

function editAgentButton(agent, mobile) {
    const button = agentElement('button', 'inline-flex items-center justify-center gap-2 rounded-lg bg-stone-100 px-3 py-2 text-xs font-semibold text-gray-700 transition hover:bg-stone-200' + (mobile ? ' w-full' : ''));
    button.type = 'button';
    button.append(agentElement('i', 'fas fa-pen'), document.createTextNode('Editar'));
    button.addEventListener('click', () => openAgentModal(agent));
    return button;
}

function deleteAgentButton(agent) {
	if (agent.isOriginalAdmin) return agentElement('span', 'inline-flex items-center gap-2 rounded-lg bg-purple-50 px-3 py-2 text-xs font-semibold text-purple-700', 'Administrador original');
	const button = agentElement('button', 'inline-flex items-center justify-center gap-2 rounded-lg bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-100 disabled:opacity-50');
	button.type = 'button'; button.append(agentElement('i', 'fas fa-trash'), document.createTextNode('Excluir'));
	button.addEventListener('click', async () => {
		if (!await window.confirmRemoval('Excluir agente "' + agent.name + '"?', 'O acesso será removido. Conversas e mensagens serão preservadas e os atendimentos abertos voltarão para a fila.')) return;
		button.disabled = true;
		try { await agentAPI('DELETE', '/management/api/agents/' + agent.id); await loadAgents(); showAgentToast('Agente excluído.'); }
		catch (error) { showAgentPageError(error); button.disabled = false; }
	});
	return button;
}

function agentSectorIds(agent) {
    const option = teamState.assignments.get(Number(agent.id));
    return option ? option.departmentIds : null;
}

function sectorChip(sector) {
    const chip = agentElement('span', 'inline-flex max-w-[160px] items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold');
    chip.style.backgroundColor = sector.color + '1a';
    chip.style.color = sector.color;
    const dot = agentElement('span', 'h-2 w-2 shrink-0 rounded-full');
    dot.style.backgroundColor = sector.color;
    chip.append(dot, agentElement('span', 'truncate', sector.name));
    return chip;
}

function agentSectorChips(agent) {
    const wrap = agentElement('div', 'flex flex-wrap gap-1.5');
    const ids = agentSectorIds(agent);
    const sectors = (ids || []).map(id => teamState.sectors.find(sector => sector.id === id)).filter(Boolean);
    if (!sectors.length) wrap.appendChild(agentElement('span', 'text-xs text-gray-400', agent.isActive ? 'Sem setor' : '—'));
    sectors.forEach(sector => wrap.appendChild(sectorChip(sector)));
    return wrap;
}

function renderAgentTable(agents) {
    const body = document.getElementById('agents-table-body');
    body.replaceChildren();
    agents.forEach(agent => {
        const row = agentElement('tr', 'transition hover:bg-stone-50');
        const identity = agentElement('td', 'px-5 py-4');
        const wrap = agentElement('div', 'flex items-center gap-3');
        const initial = String(agent.name || '?').trim().slice(0, 1).toUpperCase();
        const avatar = agentElement('span', 'grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-blue-100 to-purple-100 font-black text-purple-700', initial);
        const text = agentElement('div', 'min-w-0');
        text.append(agentElement('p', 'max-w-[240px] truncate font-bold text-gray-900', agent.name || 'Sem nome'), agentElement('p', 'mt-0.5 max-w-[240px] truncate text-xs text-gray-500', agent.email || 'Sem email'));
        wrap.append(avatar, text);
        identity.appendChild(wrap);
        const role = agentElement('td', 'px-5 py-4');
        role.appendChild(roleBadge(agent.role));
        const sectors = agentElement('td', 'px-5 py-4');
        sectors.appendChild(agentSectorChips(agent));
        const status = agentElement('td', 'px-5 py-4');
        status.appendChild(agentBadge(agent));
        const updated = agentElement('td', 'px-5 py-4 text-xs text-gray-500', formatAgentDate(agent.updatedAt));
        const action = agentElement('td', 'px-5 py-4 text-right');
        const actions = agentElement('div', 'flex justify-end gap-2');
        actions.append(editAgentButton(agent, false), deleteAgentButton(agent)); action.appendChild(actions);
        row.append(identity, role, sectors, status, updated, action);
        body.appendChild(row);
    });
}

function renderAgentCards(agents) {
    const list = document.getElementById('agents-mobile');
    list.replaceChildren();
    agents.forEach(agent => {
        const card = agentElement('article', 'p-5');
        const heading = agentElement('div', 'flex items-start justify-between gap-3');
        const identity = agentElement('div', 'min-w-0');
        identity.append(agentElement('h3', 'truncate font-bold text-gray-950', agent.name || 'Sem nome'), agentElement('p', 'mt-1 truncate text-xs text-gray-500', agent.email || 'Sem email'));
        heading.append(identity, agentBadge(agent));
        const sectors = agentSectorChips(agent); sectors.classList.add('mt-3');
        const meta = agentElement('div', 'my-4 flex items-center justify-between rounded-xl bg-stone-50 p-3');
        meta.append(roleBadge(agent.role), agentElement('span', 'text-xs text-gray-500', formatAgentDate(agent.updatedAt)));
        const actions = agentElement('div', 'flex gap-2'); actions.append(editAgentButton(agent, true), deleteAgentButton(agent));
        card.append(heading, sectors, meta, actions);
        list.appendChild(card);
    });
}

function renderAgents() {
    const query = document.getElementById('agent-search').value.trim().toLocaleLowerCase('pt-BR');
    const agents = agentState.agents.filter(agent => !query || String(agent.name || '').toLocaleLowerCase('pt-BR').includes(query) || String(agent.email || '').toLocaleLowerCase('pt-BR').includes(query));
    const active = agentState.agents.filter(agent => agent.isActive);
    document.getElementById('agents-loading').classList.add('hidden');
    document.getElementById('agents-active').textContent = String(active.length);
    document.getElementById('agents-total').textContent = 'de ' + agentState.agents.length + (agentState.agents.length === 1 ? ' agente' : ' agentes');
    document.getElementById('agents-admins').textContent = String(active.filter(agent => agent.role === 'admin').length);
    document.getElementById('agents-unassigned').textContent = teamState.loaded ? String(active.filter(agent => !(agentSectorIds(agent) || []).length).length) : '-';
    document.getElementById('team-tab-agents-count').textContent = String(agentState.agents.length);
    document.getElementById('agents-empty').classList.toggle('hidden', agents.length > 0);
    document.getElementById('agents-table-wrap').classList.toggle('lg:block', agents.length > 0);
    renderAgentTable(agents);
    renderAgentCards(agents);
}

async function loadAgents() {
    const response = await agentAPI('GET', '/management/api/agents');
    const data = response && response.data;
    agentState.agents = Array.isArray(data) ? data : (data && Array.isArray(data.agents) ? data.agents : []);
    renderAgents();
    renderSectors();
}

async function loadSectors() {
    const response = await agentAPI('GET', '/api/departments');
    const data = (response && response.data) || {};
    teamState.sectors = Array.isArray(data.departments) ? data.departments : [];
    teamState.assignments = new Map((Array.isArray(data.agents) ? data.agents : []).map(option => [Number(option.id), { id: Number(option.id), name: option.name, departmentIds: (option.departmentIds || []).map(Number) }]));
    teamState.loaded = true;
    renderAgents();
    renderSectors();
}

function reloadTeam() { return Promise.all([loadAgents(), loadSectors()]); }

function sectorMembers(sector) {
    return Array.from(teamState.assignments.values()).filter(option => option.departmentIds.includes(sector.id));
}

function sectorAvatar(name, index) {
    const avatar = agentElement('span', 'grid h-9 w-9 place-items-center rounded-full border-2 border-white bg-purple-100 text-[11px] font-black text-purple-700', String(name || '?').trim().split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase());
    avatar.title = name;
    if (index) avatar.style.marginLeft = '-8px';
    return avatar;
}

function sectorCard(sector) {
    const members = sectorMembers(sector);
    const card = agentElement('article', 'relative flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white p-5 pl-6 shadow-sm');
    const bar = agentElement('span', 'absolute inset-y-0 left-0 w-1.5'); bar.style.backgroundColor = sector.color;
    const head = agentElement('div', 'flex items-start gap-3');
    const icon = agentElement('span', 'grid h-11 w-11 shrink-0 place-items-center rounded-xl'); icon.style.backgroundColor = sector.color + '1f';
    const dot = agentElement('span', 'h-3 w-3 rounded-full'); dot.style.backgroundColor = sector.color; icon.appendChild(dot);
    const title = agentElement('div', 'min-w-0 flex-1');
    title.append(agentElement('h3', 'truncate text-base font-black text-gray-950', sector.name), agentElement('p', 'mt-0.5 text-xs text-gray-500', members.length + (members.length === 1 ? ' agente vinculado' : ' agentes vinculados')));
    const edit = agentElement('button', 'grid h-9 w-9 shrink-0 place-items-center rounded-lg text-gray-400 transition hover:bg-stone-100 hover:text-gray-700');
    edit.type = 'button'; edit.title = 'Editar setor'; edit.setAttribute('aria-label', 'Editar ' + sector.name);
    edit.appendChild(agentElement('i', 'fas fa-ellipsis'));
    edit.addEventListener('click', () => openSectorModal(sector));
    head.append(icon, title, edit);
    const team = agentElement('div', 'mt-5 flex-1');
    team.appendChild(agentElement('p', 'text-[10px] font-bold uppercase tracking-wider text-gray-400', 'Equipe'));
    const avatars = agentElement('div', 'mt-2 flex min-h-9 items-center');
    if (!members.length) avatars.appendChild(agentElement('span', 'text-xs text-gray-400', 'Nenhum agente neste setor'));
    members.slice(0, 7).forEach((member, index) => avatars.appendChild(sectorAvatar(member.name, index)));
    if (members.length > 7) { const more = agentElement('span', 'grid h-9 w-9 place-items-center rounded-full border-2 border-white bg-stone-100 text-[11px] font-bold text-gray-600', '+' + (members.length - 7)); more.style.marginLeft = '-8px'; avatars.appendChild(more); }
    team.appendChild(avatars);
    const footer = agentElement('div', 'mt-5 border-t border-stone-100 pt-4');
    const manage = agentElement('button', 'text-sm font-bold text-purple-700 hover:text-purple-900');
    manage.type = 'button'; manage.append(agentElement('i', 'fas fa-user-group mr-2'), document.createTextNode('Gerenciar agentes'));
    manage.addEventListener('click', () => openSectorMembers(sector));
    footer.appendChild(manage);
    card.append(bar, head, team, footer);
    return card;
}

function renderSectors() {
    if (!teamState.loaded) return;
    document.getElementById('sectors-loading').classList.add('hidden');
    document.getElementById('team-tab-sectors-count').textContent = String(teamState.sectors.length);
    const grid = document.getElementById('sectors-grid');
    grid.replaceChildren();
    grid.classList.remove('hidden'); grid.classList.add('grid');
    teamState.sectors.forEach(sector => grid.appendChild(sectorCard(sector)));
    const create = agentElement('button', 'flex min-h-[220px] flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-stone-300 bg-white/60 text-gray-500 transition hover:border-purple-300 hover:text-purple-700');
    create.type = 'button';
    create.append(agentElement('i', 'fas fa-plus text-2xl'), agentElement('span', 'text-sm font-bold', 'Criar setor'));
    create.addEventListener('click', () => openSectorModal(null));
    grid.appendChild(create);
}

function showSectorsError(error) {
    const box = document.getElementById('sectors-error');
    box.textContent = error instanceof Error ? error.message : String(error);
    box.classList.remove('hidden');
}

function openTeamModal(id, focus) {
    const modal = document.getElementById(id);
    modal.classList.remove('hidden'); modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
    if (focus) setTimeout(() => focus.focus(), 50);
}

function closeTeamModal(id) {
    const modal = document.getElementById(id);
    modal.classList.add('hidden'); modal.classList.remove('flex');
    if (!document.querySelector('#agent-modal.flex, #sector-modal.flex, #sector-members-modal.flex')) document.body.classList.remove('overflow-hidden');
}

function sectorCheckbox(name, value, checked, color) {
    const label = agentElement('label', 'flex cursor-pointer items-center gap-3 rounded-xl px-3 py-2 text-sm text-gray-700 transition hover:bg-purple-50');
    const input = agentElement('input', 'peer sr-only'); input.type = 'checkbox'; input.value = String(value); input.checked = checked;
    const control = agentElement('span', 'grid h-5 w-5 shrink-0 place-items-center rounded-md border border-stone-300 bg-white text-[10px] text-transparent transition peer-checked:border-purple-600 peer-checked:bg-purple-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-purple-200 peer-focus-visible:ring-offset-2');
    control.appendChild(agentElement('i', 'fas fa-check'));
    label.append(input, control);
    if (color) { const dot = agentElement('span', 'h-2.5 w-2.5 shrink-0 rounded-full'); dot.style.backgroundColor = color; label.appendChild(dot); }
    label.appendChild(agentElement('span', 'min-w-0 truncate font-medium', name));
    return label;
}

function renderAgentSectorField(agent) {
    const list = document.getElementById('agent-sectors');
    const note = document.getElementById('agent-sectors-note');
    list.replaceChildren();
    const ids = agent ? agentSectorIds(agent) : [];
    const editable = teamState.loaded && ids !== null;
    document.getElementById('agent-sectors-field').dataset.editable = editable ? 'true' : 'false';
    list.classList.toggle('hidden', !editable || !teamState.sectors.length);
    note.classList.toggle('hidden', editable && teamState.sectors.length > 0);
    if (!teamState.loaded) note.textContent = 'Não foi possível carregar os setores.';
    else if (ids === null) note.textContent = 'Ative o agente para vinculá-lo a setores.';
    else if (!teamState.sectors.length) note.textContent = 'Nenhum setor cadastrado. Crie setores na aba Setores.';
    if (!editable) return;
    teamState.sectors.forEach(sector => list.appendChild(sectorCheckbox(sector.name, sector.id, ids.includes(sector.id), sector.color)));
}

function openAgentModal(agent) {
    const form = document.getElementById('agent-form');
    form.reset();
    document.getElementById('agent-form-error').classList.add('hidden');
    const editing = Boolean(agent);
    form.dataset.agentId = editing ? String(agent.id) : '';
    form.dataset.originalRole = editing ? String(agent.role) : '';
    document.getElementById('agent-modal-title').textContent = editing ? 'Editar agente' : 'Novo agente';
    document.getElementById('agent-submit').textContent = editing ? 'Salvar alterações' : 'Criar agente';
    document.getElementById('agent-password').required = !editing;
    document.getElementById('agent-password-hint').textContent = editing ? 'Opcional: deixe em branco para manter' : 'Obrigatória no cadastro';
    document.getElementById('agent-admin-warning').classList.toggle('hidden', !editing || agent.role !== 'admin' || !agent.isActive);
    document.getElementById('agent-admin-warning').classList.toggle('flex', editing && agent.role === 'admin' && agent.isActive);
    if (editing) {
        document.getElementById('agent-name').value = agent.name || '';
        document.getElementById('agent-email').value = agent.email || '';
        document.getElementById('agent-role').value = agent.role || 'agent';
        document.getElementById('agent-active').checked = Boolean(agent.isActive);
    } else {
        document.getElementById('agent-role').value = 'agent';
        document.getElementById('agent-active').checked = true;
    }
    renderAgentSectorField(agent);
    if (window.refreshAdminSelects) window.refreshAdminSelects(form);
    openTeamModal('agent-modal', document.getElementById('agent-name'));
}

function closeAgentModal() { closeTeamModal('agent-modal'); }

function openSectorModal(sector) {
    const form = document.getElementById('sector-form');
    form.dataset.sectorId = sector ? String(sector.id) : '';
    document.getElementById('sector-form-error').classList.add('hidden');
    document.getElementById('sector-modal-title').textContent = sector ? 'Editar setor' : 'Novo setor';
    document.getElementById('sector-submit').textContent = sector ? 'Salvar alterações' : 'Criar setor';
    document.getElementById('sector-delete').classList.toggle('hidden', !sector);
    document.getElementById('sector-name').value = sector ? sector.name : '';
    const color = (sector && sector.color) || '#6123CC';
    document.getElementById('sector-color').value = color;
    document.getElementById('sector-color-value').textContent = color.toUpperCase();
    openTeamModal('sector-modal', document.getElementById('sector-name'));
}

function openSectorMembers(sector) {
    const modal = document.getElementById('sector-members-modal');
    modal.dataset.sectorId = String(sector.id);
    document.getElementById('sector-members-title').textContent = sector.name;
    document.getElementById('sector-members-error').classList.add('hidden');
    const list = document.getElementById('sector-members-list');
    list.replaceChildren();
    const options = Array.from(teamState.assignments.values());
    if (!options.length) list.appendChild(agentElement('p', 'text-sm text-gray-500', 'Nenhum agente ativo.'));
    options.forEach(option => list.appendChild(sectorCheckbox(option.name, option.id, option.departmentIds.includes(sector.id))));
    openTeamModal('sector-members-modal', document.getElementById('sector-members-submit'));
}

function setTeamTab(tab, updateURL) {
    if (tab !== 'setores') tab = 'agentes';
    document.getElementById('team-agents-panel').classList.toggle('hidden', tab !== 'agentes');
    document.getElementById('team-sectors-panel').classList.toggle('hidden', tab !== 'setores');
    document.getElementById('new-agent-button').classList.toggle('hidden', tab !== 'agentes');
    document.getElementById('new-agent-button').classList.toggle('inline-flex', tab === 'agentes');
    document.getElementById('new-sector-button').classList.toggle('hidden', tab !== 'setores');
    document.getElementById('new-sector-button').classList.toggle('inline-flex', tab === 'setores');
    document.querySelectorAll('[data-team-tab]').forEach(button => {
        const active = button.dataset.teamTab === tab;
        button.setAttribute('aria-selected', active ? 'true' : 'false');
        button.className = 'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-bold ' + (active ? 'bg-white text-purple-700 shadow-sm' : 'text-stone-600 hover:text-gray-900');
        button.querySelector('span').className = 'rounded-full px-2 py-0.5 text-[11px] font-bold ' + (active ? 'bg-purple-100 text-purple-700' : 'bg-stone-300/70 text-stone-600');
    });
    if (updateURL) {
        const url = new URL(window.location.href);
        if (tab === 'setores') url.searchParams.set('tab', 'setores'); else url.searchParams.delete('tab');
        history.replaceState(history.state, '', url.pathname + url.search + url.hash);
    }
}

document.querySelectorAll('[data-team-tab]').forEach(button => button.addEventListener('click', () => setTeamTab(button.dataset.teamTab, true)));
document.getElementById('new-agent-button').addEventListener('click', () => openAgentModal(null));
document.getElementById('new-sector-button').addEventListener('click', () => openSectorModal(null));
document.getElementById('close-agent-modal').addEventListener('click', closeAgentModal);
document.getElementById('cancel-agent-button').addEventListener('click', closeAgentModal);
document.querySelectorAll('[data-close-team-modal]').forEach(button => button.addEventListener('click', () => closeTeamModal(button.dataset.closeTeamModal)));
['agent-modal', 'sector-modal', 'sector-members-modal'].forEach(id => document.getElementById(id).addEventListener('click', event => { if (event.target === event.currentTarget) closeTeamModal(id); }));
document.addEventListener('keydown', event => { if (event.key !== 'Escape') return; ['sector-members-modal', 'sector-modal', 'agent-modal'].forEach(id => { if (document.getElementById(id).classList.contains('flex')) closeTeamModal(id); }); });
document.getElementById('agent-search').addEventListener('input', renderAgents);
document.getElementById('close-agent-error').addEventListener('click', () => {
    const box = document.getElementById('agent-page-error');
    box.classList.add('hidden');
    box.classList.remove('flex');
});
document.getElementById('sector-color').addEventListener('input', event => { document.getElementById('sector-color-value').textContent = event.target.value.toUpperCase(); });

document.getElementById('agent-form').addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const agentId = form.dataset.agentId;
    const submit = document.getElementById('agent-submit');
    const errorBox = document.getElementById('agent-form-error');
    errorBox.classList.add('hidden');
    submit.disabled = true;
    const payload = {
        name: document.getElementById('agent-name').value.trim(),
        email: document.getElementById('agent-email').value.trim(),
        password: document.getElementById('agent-password').value,
        role: document.getElementById('agent-role').value,
        isActive: document.getElementById('agent-active').checked
    };
    const sectorsEditable = document.getElementById('agent-sectors-field').dataset.editable === 'true' && teamState.sectors.length > 0;
    const sectorIds = Array.from(document.querySelectorAll('#agent-sectors input:checked')).map(input => Number(input.value));
    let saved = false;
    try {
        const response = await agentAPI(agentId ? 'PUT' : 'POST', agentId ? '/management/api/agents/' + agentId : '/management/api/agents', payload);
        saved = true;
        const savedId = agentId || (response && response.data && response.data.id);
        if (sectorsEditable && payload.isActive && savedId) await agentAPI('PUT', '/api/departments/agents/' + savedId, { departmentIds: sectorIds });
        showAgentToast(agentId ? 'Agente atualizado.' : 'Agente criado.');
        closeAgentModal();
    } catch (error) {
        errorBox.textContent = saved ? 'O agente foi salvo, mas não foi possível atualizar os setores: ' + friendlyAgentError(error) : friendlyAgentError(error);
        errorBox.classList.remove('hidden');
    } finally {
        submit.disabled = false;
        if (saved) reloadTeam().catch(showAgentPageError);
    }
});

document.getElementById('sector-form').addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const sectorId = form.dataset.sectorId;
    const submit = document.getElementById('sector-submit');
    const errorBox = document.getElementById('sector-form-error');
    errorBox.classList.add('hidden');
    submit.disabled = true;
    try {
        const payload = { name: document.getElementById('sector-name').value.trim(), color: document.getElementById('sector-color').value };
        await agentAPI(sectorId ? 'PUT' : 'POST', sectorId ? '/api/departments/' + sectorId : '/api/departments', payload);
        closeTeamModal('sector-modal');
        showAgentToast(sectorId ? 'Setor atualizado.' : 'Setor criado.');
        await loadSectors();
    } catch (error) {
        errorBox.textContent = error.message;
        errorBox.classList.remove('hidden');
    } finally { submit.disabled = false; }
});

document.getElementById('sector-delete').addEventListener('click', async () => {
    const sectorId = document.getElementById('sector-form').dataset.sectorId;
    const sector = teamState.sectors.find(item => String(item.id) === sectorId);
    if (!sector || !await window.confirmRemoval('Excluir setor "' + sector.name + '"?', 'Os agentes serão desvinculados e as conversas deste setor ficarão sem setor.')) return;
    try {
        await agentAPI('DELETE', '/api/departments/' + sector.id);
        closeTeamModal('sector-modal');
        showAgentToast('Setor excluído.');
        await loadSectors();
    } catch (error) {
        const errorBox = document.getElementById('sector-form-error');
        errorBox.textContent = error.message;
        errorBox.classList.remove('hidden');
    }
});

document.getElementById('sector-members-submit').addEventListener('click', async function () {
    const button = this;
    const sectorId = Number(document.getElementById('sector-members-modal').dataset.sectorId);
    const errorBox = document.getElementById('sector-members-error');
    errorBox.classList.add('hidden');
    button.disabled = true;
    try {
        const changes = Array.from(document.querySelectorAll('#sector-members-list input')).map(input => {
            const option = teamState.assignments.get(Number(input.value));
            const has = option.departmentIds.includes(sectorId);
            if (input.checked === has) return null;
            const ids = input.checked ? option.departmentIds.concat(sectorId) : option.departmentIds.filter(id => id !== sectorId);
            return agentAPI('PUT', '/api/departments/agents/' + option.id, { departmentIds: ids });
        }).filter(Boolean);
        await Promise.all(changes);
        closeTeamModal('sector-members-modal');
        if (changes.length) showAgentToast('Equipe do setor atualizada.');
    } catch (error) {
        errorBox.textContent = error.message;
        errorBox.classList.remove('hidden');
    } finally {
        button.disabled = false;
        loadSectors().catch(showSectorsError);
    }
});

setTeamTab(new URLSearchParams(window.location.search).get('tab'), false);
if (window.refreshAdminSelects) window.refreshAdminSelects(document.getElementById('agent-form'));
loadAgents().catch(error => {
    document.getElementById('agents-loading').classList.add('hidden');
    showAgentPageError(error);
});
loadSectors().catch(error => {
    document.getElementById('sectors-loading').classList.add('hidden');
    showSectorsError(error);
    renderAgents();
});
</script>
	}
}

package web

templ Login() {
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sophus</title>
	@BrandIcons()
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
</head>
<body class="min-h-screen bg-stone-100">
    <div class="flex min-h-screen">
        <!-- Left Side - Branding -->
        <div class="hidden md:flex w-1/2 flex-col justify-center items-center p-12" style="background: linear-gradient(135deg, #6123cc 0%, #3b82f6 100%);">
            <div class="text-center">
                <div class="mb-8 inline-block p-4 bg-white bg-opacity-20 rounded-2xl">
                    @BrandSymbol(true, "h-20 w-20")
                </div>
                <h1 class="mb-4"><img src="/logos/Sophus_logo_horizontal_branco.svg" alt="Sophus" width="1120" height="256" class="mx-auto h-14 w-auto"/></h1>
                <p class="text-lg text-white text-opacity-80 max-w-md">
                    Conecte-se com seus contatos de forma rápida e segura
                </p>
                <div class="mt-12 space-y-4">
                    <div class="flex items-center gap-3 text-white text-opacity-90">
                        <i class="fas fa-check-circle text-2xl"></i>
                        <span>Mensagens em tempo real</span>
                    </div>
                    <div class="flex items-center gap-3 text-white text-opacity-90">
                        <i class="fas fa-shield-alt text-2xl"></i>
                        <span>Totalmente seguro e criptografado</span>
                    </div>
                    <div class="flex items-center gap-3 text-white text-opacity-90">
                        <i class="fas fa-users text-2xl"></i>
                        <span>Gerenciar múltiplos departamentos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side - Login Form -->
         <div class="flex w-full flex-col items-center justify-center bg-stone-50 px-5 py-8 sm:p-8 md:w-1/2">
            <div class="w-full max-w-md">
                <!-- Logo Mobile -->
                <div class="md:hidden mb-8 flex justify-center">
                    @BrandLogo(false, "h-12 w-auto")
                </div>

                <!-- Title -->
                <h2 class="text-3xl font-bold text-gray-900 mb-2 text-center md:text-left">Bem-vindo</h2>
                <p class="text-gray-600 mb-8 text-center md:text-left">Faça login para acessar sua conta</p>

                <!-- Form -->
                <form id="login-form" hx-post="/dologin" hx-swap="none" class="space-y-5">
					<div id="login-error" role="alert" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
                    <!-- Email Input -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <div class="relative">
                            <i class="fas fa-envelope text-gray-400 absolute left-4 top-1/2 -translate-y-1/2"></i>
                            <input type="email" name="email" placeholder="seu.email@example.com" class="w-full pl-12 pr-4 py-3 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all" style="color: #1f2937;">
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-sm font-medium text-gray-700">Senha</label>
                            <a href="#" class="text-sm text-purple-600 hover:text-purple-700 transition-colors" style="color: #6123cc;">Esqueceu?</a>
                        </div>
                        <div class="relative">
                            <i class="fas fa-lock text-gray-400 absolute left-4 top-1/2 -translate-y-1/2"></i>
                            <input type="password" name="password" placeholder="••••••••" class="w-full pl-12 pr-4 py-3 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all" style="color: #1f2937;">
                        </div>
                    </div>

                    <!-- Remember Me -->
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="remember" class="w-4 h-4 rounded accent-purple-600" style="accent-color: #6123cc;">
                        <label for="remember" class="text-sm text-gray-600">Lembrar-me nesta máquina</label>
                    </div>

                    <!-- Login Button -->
                    <button type="submit" class="w-full py-3 rounded-xl font-medium text-white shadow-sm hover:shadow-md transition-all" style="background: linear-gradient(to right, #3b82f6, #6123cc);">
                        <i class="fas fa-sign-in-alt mr-2"></i>
                        Entrar
                    </button>

                    <!-- Divider -->
                    <div class="flex items-center gap-3 my-6">
                        <div class="flex-1 h-px bg-stone-200"></div>
                        <span class="text-sm text-gray-500">ou</span>
                        <div class="flex-1 h-px bg-stone-200"></div>
                    </div>

                    <!-- Social Login -->
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" class="py-3 px-4 border border-stone-200 rounded-xl hover:bg-stone-100 transition-colors flex items-center justify-center gap-2">
                            <i class="fab fa-google text-xl text-red-500"></i>
                            <span class="text-sm font-medium text-gray-700">Google</span>
                        </button>
                        <button type="button" class="py-3 px-4 border border-stone-200 rounded-xl hover:bg-stone-100 transition-colors flex items-center justify-center gap-2">
                            <i class="fab fa-microsoft text-xl text-blue-600"></i>
                            <span class="text-sm font-medium text-gray-700">Microsoft</span>
                        </button>
                    </div>

                    <!-- Sign Up Link -->
                    <p class="text-center text-sm text-gray-600 mt-8">
                        Não tem uma conta?
                        <a href="#" class="font-medium transition-colors" style="color: #6123cc;">Crie uma agora</a>
                    </p>
                </form>

                <!-- Footer -->
                <div class="mt-12 pt-8 border-t border-stone-200 flex items-center justify-center gap-4 text-xs text-gray-500">
                    <a href="#" class="hover:text-gray-700 transition-colors">Privacidade</a>
                    <span>•</span>
                    <a href="#" class="hover:text-gray-700 transition-colors">Termos</a>
                    <span>•</span>
                    <a href="#" class="hover:text-gray-700 transition-colors">Suporte</a>
                </div>
            </div>
        </div>
    </div>
	<script>
		const loginForm = document.getElementById('login-form');
		loginForm.addEventListener('htmx:beforeRequest', () => document.getElementById('login-error').classList.add('hidden'));
		loginForm.addEventListener('htmx:afterRequest', event => {
			const error = document.getElementById('login-error');
			const xhr = event.detail.xhr;
			if (event.detail.successful || (xhr && ((xhr.status >= 200 && xhr.status < 400) || xhr.getResponseHeader('HX-Redirect')))) {
				error.classList.add('hidden');
				return;
			}
			let message = 'Não foi possível entrar. Tente novamente.';
			try { message = JSON.parse(xhr.responseText).error || message; } catch (_) {}
			error.textContent = message; error.classList.remove('hidden');
		});
	</script>
</body>
</html>
}

package web

templ ConversationPicker() {
	<div id="conversation-picker" class="fixed inset-0 z-[70] hidden items-end justify-center bg-stone-950/65 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="conversation-picker-title">
		<div class="flex max-h-[92vh] w-full max-w-2xl flex-col overflow-hidden rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl">
			<header class="flex items-center justify-between border-b border-stone-200 px-5 py-4 sm:px-6"><div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Contato pelo WhatsApp</p><h2 id="conversation-picker-title" class="mt-1 text-xl font-black text-gray-950">Abrir conversa</h2></div><button id="conversation-picker-close" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header>
			<div class="min-h-0 flex-1 overflow-y-auto p-5 sm:p-6">
				<div id="conversation-picker-error" class="mb-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
				<div><label for="conversation-picker-connection" class="mb-2 block text-sm font-semibold text-gray-700">Conexão de envio</label><select id="conversation-picker-connection" class="w-full"><option value="">Carregando conexões...</option></select></div>
				<label class="relative mt-4 block"><i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-gray-400"></i><input id="conversation-picker-search" type="search" disabled placeholder="Buscar por nome, email, telefone ou tag" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-3 pl-10 pr-4 text-sm outline-none focus:border-purple-400 focus:bg-white focus:ring-2 focus:ring-purple-100 disabled:opacity-60"/></label>
				<div id="conversation-picker-results" class="mt-4 space-y-2"></div>
				<div id="conversation-picker-empty" class="mt-4 hidden rounded-2xl border border-dashed border-stone-300 bg-stone-50 p-8 text-center text-sm text-gray-500"><i class="fas fa-address-book mb-3 block text-2xl text-gray-300"></i>Nenhum contato encontrado.</div>
			</div>
			<footer class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"><p id="conversation-picker-selection" class="truncate text-xs text-gray-500">Selecione um contato.</p><button id="conversation-picker-submit" type="button" disabled class="rounded-xl bg-gray-950 px-5 py-3 text-sm font-bold text-white hover:bg-gray-800 disabled:cursor-not-allowed disabled:opacity-40">Abrir conversa</button></footer>
		</div>
	</div>
	@AdminControls()
	<script>
(function () {
	if (window.openConversationPicker) return;
	const state = { connections: null, contacts: [], selected: null, options: {}, request: 0 };
	const modal = document.getElementById('conversation-picker');
	const connection = document.getElementById('conversation-picker-connection');
	const search = document.getElementById('conversation-picker-search');
	const results = document.getElementById('conversation-picker-results');
	const empty = document.getElementById('conversation-picker-empty');
	const submit = document.getElementById('conversation-picker-submit');
	const selection = document.getElementById('conversation-picker-selection');
	const errorBox = document.getElementById('conversation-picker-error');
	function api(method, url, body) { const options = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } }; if (body !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); } return fetch(url, options).then(async response => { const text = await response.text(); let payload = {}; if (text) { try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; } } if (!response.ok) throw new Error(payload.error || 'Erro ' + response.status); return payload; }); }
	function showError(error) { errorBox.textContent = error.message || String(error); errorBox.classList.remove('hidden'); }
	function contactButton(contact) { const button = document.createElement('button'); button.type = 'button'; button.className = 'w-full rounded-2xl border border-stone-200 bg-white p-3 text-left transition hover:border-purple-300 hover:bg-purple-50'; const top = document.createElement('div'); top.className = 'flex items-start gap-3'; const avatar = document.createElement('span'); avatar.className = 'grid h-10 w-10 shrink-0 place-items-center rounded-full bg-purple-100 text-xs font-black text-purple-700'; avatar.textContent = String(contact.name || '?').trim().slice(0, 1).toUpperCase(); const content = document.createElement('div'); content.className = 'min-w-0 flex-1'; const name = document.createElement('p'); name.className = 'truncate text-sm font-bold text-gray-900'; name.textContent = contact.name || contact.number; const details = document.createElement('p'); details.className = 'mt-1 truncate text-xs text-gray-500'; details.textContent = [contact.number, contact.email].filter(Boolean).join(' · '); content.append(name, details); if (Array.isArray(contact.tags) && contact.tags.length) { const tags = document.createElement('div'); tags.className = 'mt-2 flex flex-wrap gap-1'; contact.tags.slice(0, 4).forEach(value => { const tag = document.createElement('span'); tag.className = 'rounded-full bg-stone-100 px-2 py-1 text-[10px] font-semibold text-gray-600'; tag.textContent = value; tags.appendChild(tag); }); content.appendChild(tags); } const status = document.createElement('span'); status.className = 'shrink-0 rounded-full bg-stone-100 px-2 py-1 text-[9px] font-bold text-gray-500'; status.textContent = contact.latestConversationURL ? 'Conversa existente' : 'Nova conversa'; top.append(avatar, content, status); button.appendChild(top); button.onclick = () => { state.selected = contact; results.querySelectorAll('button').forEach(item => item.classList.remove('border-purple-500', 'ring-2', 'ring-purple-100')); button.classList.add('border-purple-500', 'ring-2', 'ring-purple-100'); submit.disabled = false; selection.textContent = contact.name + ' · ' + contact.number; }; return button; }
	function render() { results.replaceChildren(); state.contacts.forEach(contact => results.appendChild(contactButton(contact))); empty.classList.toggle('hidden', state.contacts.length > 0); }
	async function loadConnections() { if (state.connections) return; const response = await api('GET', '/management/api/conversation-picker/connections'); state.connections = Array.isArray(response.data) ? response.data : []; connection.replaceChildren(); const placeholder = document.createElement('option'); placeholder.value = ''; placeholder.textContent = state.connections.length ? 'Selecione uma conexão' : 'Nenhuma conexão conectada'; connection.appendChild(placeholder); state.connections.forEach(item => { const option = document.createElement('option'); option.value = String(item.id); option.textContent = item.name + (item.number ? ' · ' + item.number : ''); connection.appendChild(option); }); if (state.connections.length === 1) { connection.value = String(state.connections[0].id); search.disabled = false; await loadContacts(); } if (window.refreshAdminSelects) window.refreshAdminSelects(modal); }
	async function loadContacts() { const id = connection.value; state.selected = null; submit.disabled = true; selection.textContent = 'Selecione um contato.'; if (!id) { search.disabled = true; state.contacts = []; render(); return; } search.disabled = false; const request = ++state.request; results.innerHTML = '<div class="py-8 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"><\/i>Buscando contatos...<\/div>'; const params = new URLSearchParams({ connectionId: id, q: search.value.trim() }); try { const response = await api('GET', '/management/api/contacts?' + params); if (request !== state.request) return; state.contacts = (Array.isArray(response.data) ? response.data : []).filter(contact => !contact.isGroup); render(); } catch (error) { if (request === state.request) showError(error); } }
	function close() { modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); }
	window.openConversationPicker = async function (options) { state.options = options || {}; state.selected = null; submit.disabled = true; submit.textContent = state.options.media ? 'Enviar mídia' : 'Abrir conversa'; document.getElementById('conversation-picker-title').textContent = state.options.media ? 'Encaminhar mídia' : 'Abrir conversa'; errorBox.classList.add('hidden'); search.value = state.options.query || ''; modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); try { await loadConnections(); if (connection.value) { await loadContacts(); setTimeout(() => search.focus(), 30); } else setTimeout(() => (connection._adminTrigger || connection).focus(), 30); } catch (error) { showError(error); } };
	connection.addEventListener('change', loadContacts); let timer; search.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(loadContacts, 250); });
	submit.onclick = async () => { if (!state.selected) return; submit.disabled = true; errorBox.classList.add('hidden'); const body = { contactId: state.selected.id, connectionId: Number(connection.value) }; try { let response; if (state.options.media) { const media = state.options.media; response = await api('POST', '/management/api/media/' + encodeURIComponent(media.scope) + '/' + encodeURIComponent(media.name) + '/forward', body); } else response = await api('POST', '/management/api/conversations/open', body); const data = response.data || {}; const url = data.conversationURL || data.url; if (url) window.location.href = '/messages/' + url; else close(); } catch (error) { showError(error); submit.disabled = false; } };
	document.getElementById('conversation-picker-close').onclick = close; modal.addEventListener('click', event => { if (event.target === modal) close(); }); document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('flex')) close(); });
	if (window.refreshAdminSelects) window.refreshAdminSelects(modal);
})();
	</script>
}

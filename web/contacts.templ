package web

templ Contacts() {
	@base("contacts") {
		<main class="min-w-0 flex-1 overflow-y-auto rounded-2xl bg-stone-50 shadow-sm">
			<div class="mx-auto max-w-[1280px] p-4 sm:p-6 lg:p-8">
				<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div><p class="text-xs font-bold uppercase tracking-[.2em] text-purple-600">Relacionamento</p><h1 class="mt-2 text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Contatos</h1><p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-500">Gerencie clientes e localize registros por nome, empresa, email, telefone ou tags.</p></div>
					<button type="button" onclick="window.openConversationPicker && window.openConversationPicker({})" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-gray-800"><i class="fas fa-comment-medical"></i> Abrir conversa</button>
				</header>
				<nav id="contacts-section-tabs" class="mx-auto mt-6 flex w-fit gap-1 rounded-xl bg-stone-200/70 p-1 lg:mx-0" aria-label="Seções de contatos"><button type="button" data-contacts-tab="contacts" class="rounded-lg bg-white px-4 py-2 text-sm font-bold text-purple-700 shadow-sm">Contatos</button><button type="button" data-contacts-tab="tags" class="rounded-lg px-4 py-2 text-sm font-bold text-gray-600">Tags</button></nav>
				<div id="contacts-error" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
				<div id="contacts-panel">
				<p class="mt-4 text-xs text-gray-500">A importação considera contatos salvos na agenda do telefone. Participantes conhecidos apenas por grupos não são importados.</p>
				<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:p-5"><div class="flex flex-col gap-3 sm:flex-row"><label class="relative block min-w-0 flex-1"><i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-gray-400"></i><input id="contacts-search" type="search" placeholder="Buscar por nome, empresa, email, telefone ou tag" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-3 pl-10 pr-4 text-sm outline-none focus:border-purple-400 focus:bg-white focus:ring-2 focus:ring-purple-100"/></label><div class="w-full min-w-0 sm:w-64 sm:shrink-0"><label for="contacts-connection" class="sr-only">Filtrar por conexão</label><select id="contacts-connection" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm text-gray-800 shadow-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="">Todas as conexões</option></select></div><button id="contacts-import" type="button" class="rounded-xl bg-purple-700 px-4 py-3 text-sm font-bold text-white hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-file-import mr-1"></i> Importar contatos</button></div><p id="contacts-import-status" class="mt-3 hidden text-xs text-gray-500"></p></section>
				<div id="contacts-loading" class="mt-6 rounded-2xl border border-stone-200 bg-white p-16 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando contatos...</div>
				<section id="contacts-list" class="mt-6 hidden overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
					<div class="hidden overflow-x-auto lg:block"><table class="w-full min-w-[1050px] text-left text-sm"><thead class="bg-stone-50 text-[11px] uppercase tracking-wider text-gray-500"><tr><th class="px-5 py-3">Contato</th><th class="px-5 py-3">Empresa</th><th class="px-5 py-3">Telefone</th><th class="px-5 py-3">Conexão</th><th class="px-5 py-3">Tags</th><th class="px-5 py-3 text-right">Ações</th></tr></thead><tbody id="contacts-table" class="divide-y divide-stone-100"></tbody></table></div>
					<div id="contacts-cards" class="divide-y divide-stone-100 lg:hidden"></div>
				</section>
				<div id="contacts-pagination" class="mt-4 hidden"></div>
				<section id="contacts-empty" class="mt-6 hidden rounded-2xl border border-dashed border-stone-300 bg-white p-14 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-stone-100 text-xl text-gray-400"><i class="fas fa-address-book"></i></span><p class="mt-4 font-bold text-gray-700">Nenhum contato encontrado</p><p class="mt-1 text-sm text-gray-500">Ajuste sua pesquisa ou importe os contatos em uma instância conectada.</p></section>
				</div>
				<section id="contact-tags-panel" class="mt-6 hidden overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm"><div class="flex flex-col gap-4 border-b border-stone-200 p-5 sm:flex-row sm:items-end sm:justify-between"><div><h2 class="font-black text-gray-950">Tags da empresa</h2><p class="mt-1 text-sm text-gray-500">Organize contatos e use as mesmas tags em condições dos flows.</p></div><form id="contact-tag-create-form" class="flex gap-2 sm:w-96"><input id="contact-tag-name" required maxlength="80" placeholder="Nome da nova tag" class="min-w-0 flex-1 rounded-xl border border-stone-200 px-4 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><button type="submit" class="rounded-xl bg-purple-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-purple-800 disabled:opacity-60">Adicionar</button></form></div><div id="contact-tag-create-error" role="alert" class="mx-5 mt-4 hidden rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div><div id="contact-tags-list" class="divide-y divide-stone-100"></div><div id="contact-tags-empty" class="hidden p-12 text-center text-sm text-gray-500">Nenhuma tag cadastrada.</div></section>
			</div>
		</main>
		<div id="contact-edit-modal" class="fixed inset-0 z-[75] hidden items-end justify-center bg-stone-950/65 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="contact-edit-title">
			<div class="max-h-[100dvh] w-full max-w-xl overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:max-h-[calc(100dvh-2.5rem)] sm:rounded-3xl">
				<header class="flex items-center justify-between border-b border-stone-200 px-5 py-4 sm:px-6"><div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Cadastro do contato</p><h2 id="contact-edit-title" class="mt-1 text-xl font-black text-gray-950">Editar contato</h2></div><button id="contact-edit-close" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header>
				<form id="contact-edit-form" class="p-5 sm:p-6"><input id="contact-edit-id" type="hidden"/><div id="contact-edit-error" class="mb-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold text-gray-700">Nome<input id="contact-edit-name" required maxlength="160" class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></label><label class="text-sm font-semibold text-gray-700">Empresa<input id="contact-edit-company" maxlength="160" class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100" placeholder="Empresa do contato"/></label><label class="text-sm font-semibold text-gray-700">Email<input id="contact-edit-email" type="email" maxlength="320" class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></label><label class="text-sm font-semibold text-gray-700">Telefone<input id="contact-edit-number" type="tel" required maxlength="24" class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><span class="mt-1 block text-xs font-normal text-gray-400">Use DDI e DDD.</span></label></div><div class="mt-5"><p class="mb-2 text-sm font-semibold text-gray-700">Tags</p><div id="contact-edit-tags" class="flex max-h-36 flex-wrap gap-2 overflow-y-auto rounded-xl border border-stone-200 bg-stone-50 p-3"></div></div><div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><button id="contact-edit-cancel" type="button" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-bold text-gray-700 hover:bg-stone-50">Cancelar</button><button id="contact-edit-save" type="submit" class="rounded-xl bg-purple-700 px-5 py-3 text-sm font-bold text-white hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60">Salvar alterações</button></div></form>
			</div>
		</div>
		<div id="contact-import-modal" class="fixed inset-0 z-[75] hidden items-end justify-center bg-stone-950/65 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="contact-import-title"><div class="w-full max-w-md rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl"><header class="flex items-start gap-4 border-b border-stone-200 px-5 py-4 sm:px-6"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-purple-100 text-purple-700"><i class="fas fa-file-import"></i></span><div class="min-w-0 flex-1"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">WhatsApp conectado</p><h2 id="contact-import-title" class="mt-1 text-lg font-black text-gray-950">Importar contatos</h2><p class="mt-1 text-xs leading-relaxed text-gray-500">Escolha a instância de origem. Contatos existentes serão atualizados quando houver informação nova.</p></div><button id="contact-import-close" type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-gray-400 hover:bg-stone-100" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header><div class="p-5 sm:p-6"><label for="contact-import-connection" class="mb-2 block text-sm font-bold text-gray-700">Instância conectada</label><select id="contact-import-connection" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></select><div id="contact-import-error" class="mt-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div></div><footer class="flex flex-col-reverse gap-3 border-t border-stone-100 bg-stone-50 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><button id="contact-import-cancel" type="button" class="rounded-xl border border-stone-200 px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-white">Cancelar</button><button id="contact-import-confirm" type="button" class="rounded-xl bg-purple-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-file-import mr-2"></i>Importar contatos</button></footer></div></div>
		<div id="contact-tag-edit-modal" class="fixed inset-0 z-[80] hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="contact-tag-edit-title" aria-describedby="contact-tag-edit-description">
			<form id="contact-tag-edit-form" class="w-full max-w-md overflow-hidden rounded-t-3xl border border-stone-200 bg-white shadow-2xl sm:rounded-3xl">
				<header class="flex items-start gap-4 border-b border-stone-100 p-5 sm:p-6"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-purple-100 text-purple-700"><i class="fas fa-tag text-xl"></i></span><div class="min-w-0 flex-1"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Organização dos contatos</p><h2 id="contact-tag-edit-title" class="mt-1 text-xl font-black text-gray-950">Editar tag</h2><p id="contact-tag-edit-description" class="mt-1 text-xs leading-relaxed text-gray-500">Atualize o nome da tag mantendo os contatos associados a ela.</p></div><button type="button" data-close-tag-editor class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-gray-400 hover:bg-stone-100" aria-label="Fechar edição da tag"><i class="fas fa-xmark"></i></button></header>
				<div class="space-y-4 p-5 sm:p-6"><div id="contact-tag-edit-error" role="alert" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div><div><label for="contact-tag-edit-name" class="mb-2 block text-sm font-bold text-gray-700">Nome da tag</label><input id="contact-tag-edit-name" required maxlength="80" autocomplete="off" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-purple-400 focus:bg-white focus:ring-4 focus:ring-purple-100"/><p class="mt-2 text-xs text-gray-400">Até 80 caracteres. Use um nome fácil de identificar.</p></div></div>
				<footer class="flex flex-col-reverse gap-3 border-t border-stone-100 bg-stone-50 p-5 sm:flex-row sm:justify-end sm:px-6"><button type="button" data-close-tag-editor class="rounded-xl border border-stone-200 bg-white px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-stone-100">Cancelar</button><button id="contact-tag-edit-save" type="submit" class="rounded-xl bg-purple-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-check mr-2"></i>Salvar alterações</button></footer>
			</form>
		</div>
		@ConversationPicker()
		@ContactAPIRuntime()
		<script>
const contactsState = { items: [], tags: [], request: 0, tab: 'contacts', page: 1, pageSize: 50, total: 0, connections: [] };
function contactsElement(tag, className, text) { const node = document.createElement(tag); if (className) node.className = className; if (text != null) node.textContent = String(text); return node; }
function contactAvatar(contact, size) { const classes = size || 'h-10 w-10'; const avatar = contactsElement('span', 'relative grid ' + classes + ' shrink-0 place-items-center overflow-hidden rounded-full bg-purple-100 text-xs font-black text-purple-700 ring-1 ring-stone-200', String(contact.name || contact.number || '?').trim().slice(0, 1).toUpperCase()); if (contact.id) { const image = document.createElement('img'); image.src = '/management/api/contacts/' + contact.id + '/avatar'; image.alt = 'Foto de ' + (contact.name || 'contato'); image.loading = 'lazy'; image.className = 'absolute inset-0 h-full w-full object-cover'; avatar.appendChild(image); } return avatar; }
function contactTags(contact) { const wrap = contactsElement('div', 'flex flex-wrap gap-1'); (contact.tags || []).slice(0, 4).forEach(value => wrap.appendChild(contactsElement('span', 'rounded-full bg-purple-50 px-2 py-1 text-[10px] font-semibold text-purple-700', value))); if (!wrap.childElementCount) wrap.appendChild(contactsElement('span', 'text-xs text-gray-400', 'Sem tags')); return wrap; }
function openContact(contact) { window.openConversationPicker({ query: contact.number }); }
function contactActionButton(label, className, action, icon) { const button = contactsElement('button', className); button.type = 'button'; button.innerHTML = '<i class="fas ' + icon + ' mr-1"><\/i>' + label; button.onclick = action; return button; }
function contactRemoveButton(contact, mobile) {
	const button = contactActionButton(mobile ? '' : 'Excluir', 'rounded-lg bg-red-50 px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-100 disabled:opacity-50', async () => {
		if (!await window.confirmRemoval('Excluir contato "' + contact.name + '"?', 'As conversas e mensagens deste contato serão removidas permanentemente. Esta ação não pode ser desfeita.')) return;
		button.disabled = true;
		try { const response = await fetch('/management/api/contacts/' + contact.id, { method: 'DELETE', credentials: 'same-origin', headers: { Accept: 'application/json' } }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Não foi possível excluir o contato.'); contactsState.page = 1; await Promise.all([loadContacts(), loadTags()]); }
		catch (error) { showContactsError(error); button.disabled = false; }
	}, 'fa-trash');
	button.setAttribute('aria-label', 'Excluir contato ' + contact.name); button.title = 'Excluir contato';
	return button;
}
function renderContacts() {
	const table = document.getElementById('contacts-table'); const cards = document.getElementById('contacts-cards'); table.replaceChildren(); cards.replaceChildren();
	contactsState.items.forEach(contact => {
		const row = document.createElement('tr'); row.className = 'hover:bg-stone-50';
		const identity = document.createElement('td'); identity.className = 'px-5 py-4'; const identityWrap = contactsElement('div', 'flex items-center gap-3'); const identityText = contactsElement('div', 'min-w-0'); identityText.append(contactsElement('p', 'truncate font-bold text-gray-900', contact.name), contactsElement('p', 'mt-1 truncate text-xs text-gray-500', contact.email || 'Email não informado')); identityWrap.append(contactAvatar(contact), identityText); identity.appendChild(identityWrap);
		const tags = document.createElement('td'); tags.className = 'px-5 py-4'; tags.appendChild(contactTags(contact));
		const actions = document.createElement('td'); actions.className = 'px-5 py-4 text-right'; const actionWrap = document.createElement('div'); actionWrap.className = 'flex justify-end gap-2'; if (contact.isGroup) { actionWrap.appendChild(contactsElement('span', 'rounded-lg bg-indigo-50 px-3 py-2 text-xs font-bold text-indigo-700', 'Grupo')); } else { actionWrap.append(contactActionButton('Editar', 'rounded-lg bg-stone-100 px-3 py-2 text-xs font-bold text-gray-700 hover:bg-stone-200', () => openContactEditor(contact), 'fa-pen'), contactActionButton('Conversar', 'rounded-lg bg-purple-50 px-3 py-2 text-xs font-bold text-purple-700 hover:bg-purple-100', () => openContact(contact), 'fa-comment')); } actions.appendChild(actionWrap);
		row.append(identity, contactsElement('td', 'px-5 py-4 text-gray-700', contact.company || 'Não informada'), contactsElement('td', 'px-5 py-4 text-gray-700', contact.number), contactsElement('td', 'px-5 py-4 text-gray-700', contact.connectionName), tags, actions); table.appendChild(row);
		const card = document.createElement('article'); card.className = 'p-5'; const top = document.createElement('div'); top.className = 'flex items-start justify-between gap-3'; const mobileIdentity = contactsElement('div', 'flex min-w-0 items-center gap-3'); const text = document.createElement('div'); text.className = 'min-w-0'; text.append(contactsElement('h2', 'truncate font-bold text-gray-900', contact.name), contactsElement('p', 'mt-1 truncate text-xs text-gray-500', (contact.company || 'Empresa não informada') + ' · ' + contact.number), contactsElement('p', 'mt-1 text-xs text-gray-400', contact.connectionName)); mobileIdentity.append(contactAvatar(contact, 'h-11 w-11'), text); const mobileActions = document.createElement('div'); mobileActions.className = 'flex shrink-0 gap-2'; if (contact.isGroup) { mobileActions.appendChild(contactsElement('span', 'rounded-lg bg-indigo-50 px-3 py-2 text-xs font-bold text-indigo-700', 'Grupo')); } else { mobileActions.append(contactActionButton('', 'rounded-lg bg-stone-100 px-3 py-2 text-xs font-bold text-gray-700', () => openContactEditor(contact), 'fa-pen'), contactActionButton('', 'rounded-lg bg-purple-50 px-3 py-2 text-xs font-bold text-purple-700', () => openContact(contact), 'fa-comment')); } top.append(mobileIdentity, mobileActions); card.append(top, contactTags(contact)); cards.appendChild(card);
		if (!contact.isGroup) { actionWrap.appendChild(contactRemoveButton(contact, false)); mobileActions.appendChild(contactRemoveButton(contact, true)); }
	});
	const hasItems = contactsState.items.length > 0; document.getElementById('contacts-list').classList.toggle('hidden', !hasItems); document.getElementById('contacts-empty').classList.toggle('hidden', hasItems);
	renderContactsPagination();
}
function renderContactsPagination() { const container = document.getElementById('contacts-pagination'); container.replaceChildren(); const pages = Math.ceil(contactsState.total / contactsState.pageSize); if (pages <= 1) { container.classList.add('hidden'); return; } container.classList.remove('hidden'); const row = contactsElement('div', 'flex items-center justify-between gap-3'); const previous = contactActionButton('Anterior', 'rounded-xl border border-stone-200 px-4 py-2 text-xs font-bold text-gray-700 disabled:opacity-40', () => { contactsState.page--; loadContacts().catch(showContactsError); }, 'fa-arrow-left'); previous.disabled = contactsState.page <= 1; const next = contactActionButton('Próxima', 'rounded-xl border border-stone-200 px-4 py-2 text-xs font-bold text-gray-700 disabled:opacity-40', () => { contactsState.page++; loadContacts().catch(showContactsError); }, 'fa-arrow-right'); next.disabled = contactsState.page >= pages; row.append(previous, contactsElement('span', 'text-xs text-gray-500', 'Página ' + contactsState.page + ' de ' + pages + ' · ' + contactsState.total + ' registros'), next); container.appendChild(row); }
async function loadContacts() { const request = ++contactsState.request; const params = new URLSearchParams({ q: document.getElementById('contacts-search').value.trim(), page: String(contactsState.page) }); const connectionID = document.getElementById('contacts-connection').value; if (connectionID) params.set('connectionId', connectionID); const payload = await window.contactRequest('GET', '/management/api/contacts?' + params, undefined, 'Não foi possível carregar os contatos.'); if (request !== contactsState.request) return; contactsState.items = Array.isArray(payload.data) ? payload.data : []; contactsState.total = Number(payload.total || 0); contactsState.page = Number(payload.page || 1); contactsState.pageSize = Number(payload.pageSize || 50); document.getElementById('contacts-loading').classList.add('hidden'); renderContacts(); }
async function contactTagsAPI(method, path, body) { return window.contactRequest(method, '/management/api/' + path, body, 'Não foi possível atualizar as tags.'); }
function renderTagManagement() { const list = document.getElementById('contact-tags-list'); list.replaceChildren(); contactsState.tags.forEach(tag => { const row = contactsElement('div', 'flex flex-wrap items-center gap-3 p-4 sm:px-5'); const badge = contactsElement('span', 'max-w-full truncate rounded-full bg-purple-50 px-3 py-1.5 text-xs font-bold text-purple-700', tag.name); const count = contactsElement('span', 'text-xs text-gray-400', Number(tag.contactCount || 0) + (Number(tag.contactCount) === 1 ? ' contato' : ' contatos')); const actions = contactsElement('div', 'ml-auto flex gap-2'); actions.append(contactActionButton('Editar', 'rounded-lg bg-stone-100 px-3 py-2 text-xs font-bold text-gray-700 hover:bg-stone-200', () => openTagEditor(tag), 'fa-pen'), contactActionButton('Excluir', 'rounded-lg bg-red-50 px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-100', async () => { if (!confirm('Excluir a tag "' + tag.name + '"?')) return; try { await contactTagsAPI('DELETE', 'contact-tags/' + tag.id); await Promise.all([loadTags(), loadContacts()]); } catch (error) { showContactsError(error); } }, 'fa-trash')); row.append(badge, count, actions); list.appendChild(row); }); document.getElementById('contact-tags-empty').classList.toggle('hidden', contactsState.tags.length > 0); }
const tagEditor = document.getElementById('contact-tag-edit-modal');
const tagEditorForm = document.getElementById('contact-tag-edit-form');
let tagEditorFocus, tagEditorSaving = false;
function openTagEditor(tag) {
	tagEditorFocus = document.activeElement;
	tagEditorForm.dataset.tagId = String(tag.id); tagEditorForm.dataset.initialName = tag.name;
	document.getElementById('contact-tag-edit-name').value = tag.name;
	document.getElementById('contact-tag-edit-error').classList.add('hidden');
	tagEditor.classList.remove('hidden'); tagEditor.classList.add('flex');
	document.body.classList.add('overflow-hidden');
	document.getElementById('contact-tag-edit-name').focus(); document.getElementById('contact-tag-edit-name').select();
}
function closeTagEditor() {
	if (tagEditorSaving) return;
	tagEditor.classList.add('hidden'); tagEditor.classList.remove('flex'); document.body.classList.remove('overflow-hidden');
	if (tagEditorFocus && tagEditorFocus.isConnected) tagEditorFocus.focus();
}
tagEditorForm.addEventListener('submit', async event => {
	event.preventDefault(); if (tagEditorSaving) return;
	const input = document.getElementById('contact-tag-edit-name'); const name = input.value.trim(); const errorBox = document.getElementById('contact-tag-edit-error');
	errorBox.classList.add('hidden');
	if (!name) { errorBox.textContent = 'Informe um nome para a tag.'; errorBox.classList.remove('hidden'); input.focus(); return; }
	if (name === tagEditorForm.dataset.initialName) { closeTagEditor(); return; }
	tagEditorSaving = true; tagEditorForm.setAttribute('aria-busy', 'true');
	tagEditorForm.querySelectorAll('button,input').forEach(control => control.disabled = true);
	try {
		await contactTagsAPI('PUT', 'contact-tags/' + tagEditorForm.dataset.tagId, { name });
		tagEditorSaving = false; closeTagEditor();
		try { await Promise.all([loadTags(), loadContacts()]); } catch (error) { showContactsError(new Error('A tag foi salva, mas não foi possível atualizar a lista. ' + error.message)); }
	} catch (error) { window.showContactRequestError(errorBox, error); }
	finally { tagEditorSaving = false; tagEditorForm.removeAttribute('aria-busy'); tagEditorForm.querySelectorAll('button,input').forEach(control => control.disabled = false); }
});
tagEditor.querySelectorAll('[data-close-tag-editor]').forEach(button => button.addEventListener('click', closeTagEditor));
tagEditor.addEventListener('click', event => { if (event.target === tagEditor) closeTagEditor(); });
tagEditor.addEventListener('keydown', event => {
	if (event.key === 'Escape') { event.stopPropagation(); closeTagEditor(); }
	if (event.key === 'Tab') {
		const controls = Array.from(tagEditor.querySelectorAll('button:not(:disabled),input:not(:disabled)')); const first = controls[0], last = controls[controls.length - 1];
		if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
		else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
	}
});
async function loadTags() { const response = await contactTagsAPI('GET', 'contact-tags'); contactsState.tags = Array.isArray(response.data) ? response.data : []; renderTagManagement(); }
async function loadContactConnections() { const payload = await window.contactRequest('GET', '/management/api/conversation-picker/connections', undefined, 'Não foi possível carregar as conexões.'); contactsState.connections = Array.isArray(payload.data) ? payload.data : []; const select = document.getElementById('contacts-connection'); contactsState.connections.forEach(connection => { const option = document.createElement('option'); option.value = connection.id; option.textContent = connection.name + (connection.number ? ' · ' + connection.number : ''); select.appendChild(option); }); }
function renderContactTagChoices(contact) { const wrap = document.getElementById('contact-edit-tags'); wrap.replaceChildren(); const selected = new Set((contact.tagIds || []).map(Number)); contactsState.tags.forEach(tag => { const label = contactsElement('label', 'cursor-pointer'); const input = document.createElement('input'); input.type = 'checkbox'; input.value = tag.id; input.checked = selected.has(Number(tag.id)); input.className = 'peer sr-only'; const badge = contactsElement('span', 'block rounded-lg border border-stone-200 bg-white px-3 py-2 text-xs font-bold text-gray-600 peer-checked:border-purple-500 peer-checked:bg-purple-50 peer-checked:text-purple-700', tag.name); label.append(input, badge); wrap.appendChild(label); }); if (!contactsState.tags.length) wrap.appendChild(contactsElement('span', 'text-xs text-gray-400', 'Cadastre tags na aba Tags.')); }
function openContactEditor(contact) { document.getElementById('contact-edit-id').value = contact.id; document.getElementById('contact-edit-name').value = contact.name || ''; document.getElementById('contact-edit-company').value = contact.company || ''; document.getElementById('contact-edit-email').value = contact.email || ''; document.getElementById('contact-edit-number').value = contact.number || ''; document.getElementById('contact-edit-form').dataset.initial = JSON.stringify({ name: contact.name || '', company: contact.company || '', email: contact.email || '', number: contact.number || '', tagIds: (contact.tagIds || []).map(Number).sort((a, b) => a - b) }); renderContactTagChoices(contact); document.getElementById('contact-edit-error').classList.add('hidden'); const modal = document.getElementById('contact-edit-modal'); modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); setTimeout(() => document.getElementById('contact-edit-name').focus(), 30); }
function closeContactEditor() { const modal = document.getElementById('contact-edit-modal'); modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); }
document.getElementById('contact-edit-form').onsubmit = async event => {
	event.preventDefault(); const form = event.currentTarget; const button = document.getElementById('contact-edit-save'); const errorBox = document.getElementById('contact-edit-error'); const contactId = document.getElementById('contact-edit-id').value;
	const contact = { name: document.getElementById('contact-edit-name').value, company: document.getElementById('contact-edit-company').value, email: document.getElementById('contact-edit-email').value, number: document.getElementById('contact-edit-number').value, tagIds: Array.from(document.querySelectorAll('#contact-edit-tags input:checked')).map(input => Number(input.value)).sort((a, b) => a - b) };
	const initial = JSON.parse(form.dataset.initial || '{}');
	const fieldsChanged = ['name', 'company', 'email', 'number'].some(key => contact[key] !== initial[key]);
	const tagsChanged = JSON.stringify(contact.tagIds) !== JSON.stringify(initial.tagIds || []);
	if (!fieldsChanged && !tagsChanged) { closeContactEditor(); return; }
	button.disabled = true; errorBox.classList.add('hidden');
	try {
		if (fieldsChanged) await window.contactRequest('PUT', '/management/api/contacts/' + contactId, { name: contact.name, company: contact.company, email: contact.email, number: contact.number }, 'Não foi possível atualizar o contato.');
		if (tagsChanged) await contactTagsAPI('PUT', 'contacts/' + contactId + '/tags', { tagIds: contact.tagIds });
		closeContactEditor();
		try { await Promise.all([loadContacts(), loadTags()]); } catch (error) { showContactsError(new Error('O contato foi salvo, mas não foi possível atualizar a lista. ' + error.message)); }
	} catch (error) { window.showContactRequestError(errorBox, error); } finally { button.disabled = false; }
};
document.getElementById('contact-edit-close').onclick = closeContactEditor; document.getElementById('contact-edit-cancel').onclick = closeContactEditor; document.getElementById('contact-edit-modal').addEventListener('click', event => { if (event.target.id === 'contact-edit-modal') closeContactEditor(); });
const contactDeleteButton = document.createElement('button'); contactDeleteButton.type = 'button'; contactDeleteButton.className = 'sm:mr-auto rounded-xl px-5 py-3 text-sm font-bold text-red-700 hover:bg-red-50'; contactDeleteButton.innerHTML = '<i class="fas fa-trash mr-2"><\/i>Excluir contato'; document.querySelector('#contact-edit-form .mt-6').prepend(contactDeleteButton); contactDeleteButton.onclick = async () => { const contactID = document.getElementById('contact-edit-id').value; const name = document.getElementById('contact-edit-name').value.trim() || 'este contato'; if (!await window.confirmRemoval('Excluir contato "' + name + '"?', 'O histórico de conversas e mensagens também será removido permanentemente. Esta ação não pode ser desfeita.')) return; const errorBox = document.getElementById('contact-edit-error'); contactDeleteButton.disabled = true; errorBox.classList.add('hidden'); try { const response = await fetch('/management/api/contacts/' + encodeURIComponent(contactID), { method: 'DELETE', credentials: 'same-origin', headers: { Accept: 'application/json' } }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Não foi possível excluir o contato.'); closeContactEditor(); contactsState.page = 1; await Promise.all([loadContacts(), loadTags()]); } catch (error) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); } finally { contactDeleteButton.disabled = false; } };
let contactsTimer; document.getElementById('contacts-search').addEventListener('input', () => { contactsState.page = 1; clearTimeout(contactsTimer); contactsTimer = setTimeout(() => loadContacts().catch(showContactsError), 250); }); document.getElementById('contacts-connection').onchange = () => { contactsState.page = 1; loadContacts().catch(showContactsError); }; function showContactsError(error) { window.showContactRequestError(document.getElementById('contacts-error'), error); document.getElementById('contacts-loading').classList.add('hidden'); }
document.querySelectorAll('[data-contacts-tab]').forEach(button => button.onclick = () => { contactsState.tab = button.dataset.contactsTab; document.getElementById('contacts-panel').classList.toggle('hidden', contactsState.tab !== 'contacts'); document.getElementById('contact-tags-panel').classList.toggle('hidden', contactsState.tab !== 'tags'); document.querySelectorAll('[data-contacts-tab]').forEach(item => item.className = 'rounded-lg px-4 py-2 text-sm font-bold ' + (item === button ? 'bg-white text-purple-700 shadow-sm' : 'text-gray-600')); });
document.getElementById('contact-tag-create-form').onsubmit = async event => {
	event.preventDefault(); const input = document.getElementById('contact-tag-name'); const button = event.currentTarget.querySelector('button[type="submit"]'); const errorBox = document.getElementById('contact-tag-create-error'); let created = false;
	button.disabled = true; errorBox.classList.add('hidden');
	try { await contactTagsAPI('POST', 'contact-tags', { name: input.value.trim() }); created = true; input.value = ''; await loadTags(); }
	catch (error) { window.showContactRequestError(errorBox, created ? new Error('A tag foi criada, mas não foi possível atualizar a lista. ' + error.message) : error); }
	finally { button.disabled = false; }
};
const contactImportModal = document.getElementById('contact-import-modal'); function closeContactImport() { contactImportModal.classList.add('hidden'); contactImportModal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); } document.getElementById('contacts-import').onclick = () => { const select = document.getElementById('contact-import-connection'); select.replaceChildren(); contactsState.connections.forEach(connection => { const option = document.createElement('option'); option.value = connection.id; option.textContent = connection.name + (connection.number ? ' · ' + connection.number : ''); select.appendChild(option); }); const errorBox = document.getElementById('contact-import-error'); errorBox.classList.add('hidden'); document.getElementById('contact-import-confirm').disabled = !select.options.length; if (!select.options.length) { errorBox.textContent = 'Nenhuma instância conectada está disponível para importação.'; errorBox.classList.remove('hidden'); } contactImportModal.classList.remove('hidden'); contactImportModal.classList.add('flex'); document.body.classList.add('overflow-hidden'); }; document.getElementById('contact-import-close').onclick = closeContactImport; document.getElementById('contact-import-cancel').onclick = closeContactImport; contactImportModal.onclick = event => { if (event.target === contactImportModal) closeContactImport(); }; document.getElementById('contact-import-confirm').onclick = async function () { const button = this; const errorBox = document.getElementById('contact-import-error'); const connectionID = document.getElementById('contact-import-connection').value; if (!connectionID) return; button.disabled = true; errorBox.classList.add('hidden'); try { const response = await fetch('/instances/' + connectionID + '/contacts/import', { method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json' } }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Não foi possível importar os contatos.'); const result = payload.data || {}; const status = document.getElementById('contacts-import-status'); status.textContent = String(result.imported || 0) + ' contatos importados, ' + String(result.updated || 0) + ' atualizados.'; status.classList.remove('hidden'); closeContactImport(); contactsState.page = 1; await loadContacts(); } catch (error) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); } finally { button.disabled = false; } };
if (window.refreshAdminSelects) { window.refreshAdminSelects(document.getElementById('contacts-panel')); window.refreshAdminSelects(document.getElementById('contact-import-modal')); }
Promise.all([loadContactConnections(), loadContacts(), loadTags()]).catch(showContactsError);
		</script>
	}
}

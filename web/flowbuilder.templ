package web

import "encoding/json"
import "fmt"
import "strings"
import "sophus/internal/flowengine"

func flowStarterCatalogJSON() string {
	data,_:=json.Marshal(flowengine.StarterTemplates());return string(data)
}

templ FlowBuilder() {
	@base("flows") {
	<main id="flowbuilder-page" class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-2xl bg-stone-50 shadow-sm">
<style>
	@scope (#flowbuilder-page) {
  #canvas-wrap { min-width: 0; background-image: radial-gradient(#e7e5e4 1.5px, transparent 1.5px); background-size: 22px 22px; }
	#canvas-wrap.canvas-panning { cursor: grabbing; user-select: none; }
	#canvas-wrap.canvas-panning * { cursor: grabbing !important; }
  .node-card { position: absolute; width: 220px; cursor: grab; user-select: none; touch-action: none; }
  .node-card.dragging { cursor: grabbing; z-index: 30; }
  .node-card.selected { box-shadow: 0 0 0 2px #6123cc, 0 8px 20px rgba(0,0,0,.12); }
  .node-card.connection-target { box-shadow: 0 0 0 3px #22c55e, 0 8px 20px rgba(34,197,94,.2); }
  .handle { width: 14px; height: 14px; border-radius: 9999px; border: 2px solid white; box-shadow: 0 0 0 1px #a8a29e; cursor: crosshair; position: absolute; background: #78716c; touch-action: none; }
  .handle:hover { background: #6123cc; box-shadow: 0 0 0 1px #6123cc; }
  .handle.armed { background: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.4); animation: pulse 1s infinite; }
  .edge-group { cursor: pointer; }
  .edge-hit { pointer-events: stroke; }
  .edge-line { pointer-events: none; }
  .edge-remove { opacity: 0; pointer-events: none; transition: opacity .12s ease; }
  .edge-group.active .edge-remove { opacity: 1; pointer-events: all; }
  .handle-label { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); white-space: nowrap; pointer-events: none; font-size: 10px; line-height: 1; color: #78716c; }
  .handle.sub-handle { width: 12px; height: 12px; border-radius: 2px; transform: rotate(45deg); background: #fff; border: 0; box-shadow: 0 0 0 1.5px #7c3aed; }
  .handle.sub-handle:hover, .handle.sub-handle.armed { background: #7c3aed; animation: none; }
  .sub-port { position: absolute; bottom: -6px; display: flex; flex-direction: column; align-items: center; transform: translateX(-50%); z-index: 2; }
  .sub-port .handle { position: relative; }
  .sub-port-label { margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; border: 1px solid #ddd6fe; border-radius: 9999px; background: #fff; padding: 2px 7px; font-size: 10px; font-weight: 600; line-height: 1.2; color: #6d28d9; cursor: pointer; }
  .sub-port-label:hover { background: #f5f3ff; border-color: #a78bfa; }
  .sub-port-label.connected { border-color: #c4b5fd; background: #f5f3ff; }
	input[type="checkbox"]:not(.hidden) { appearance: none; -webkit-appearance: none; width: 1.1rem; height: 1.1rem; flex: 0 0 auto; display: inline-grid; place-content: center; border: 1.5px solid #c4b5fd; border-radius: .32rem; background: #fff; cursor: pointer; transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease; }
	input[type="checkbox"]:not(.hidden)::before { content: ''; width: .58rem; height: .32rem; border-left: 2px solid white; border-bottom: 2px solid white; transform: rotate(-45deg) scale(0); transform-origin: center; transition: transform .12s ease; margin-top: -.08rem; }
	input[type="checkbox"]:not(.hidden):checked { border-color: #7c3aed; background: linear-gradient(135deg, #7c3aed, #4f46e5); box-shadow: 0 0 0 2px rgba(124,58,237,.12); }
	input[type="checkbox"]:not(.hidden):checked::before { transform: rotate(-45deg) scale(1); }
	input[type="checkbox"]:not(.hidden):focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(124,58,237,.22); }
	input[type="checkbox"]:not(.hidden):disabled { cursor: not-allowed; opacity: .5; }
  @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.25); } }
  .palette-item { cursor: pointer; aspect-ratio: 1; min-width: 0; }
	#canvas-wrap { cursor: grab; }
	@media (min-width: 768px) {
		#palette-panel.palette-collapsed { width: 4rem; }
		#palette-panel.palette-collapsed .palette-toggle-label, #palette-panel.palette-collapsed .palette-category-title, #palette-panel.palette-collapsed .palette-item-label { display: none; }
		#palette-panel.palette-collapsed .palette-grid { grid-template-columns: minmax(0, 1fr); gap: .375rem; }
		#palette-panel.palette-collapsed .palette-item { padding: .25rem; }
		#palette-panel.palette-collapsed #palette > div { margin-bottom: .5rem; }
		#palette-panel.palette-collapsed #palette-toggle { justify-content: center; }
	}
  .palette-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
  .flow-dropdown-panel { position: fixed; inset: auto; margin: 0; padding: .375rem 0; display: none; flex-direction: column; overflow-y: auto; border: 1px solid #e7e5e4; border-radius: .75rem; background: white; color: #374151; box-shadow: 0 12px 32px #1c191733; z-index: 160; }
  .flow-dropdown-panel:popover-open { display: flex; }
  .palette-item:active { cursor: grabbing; }
	.variable-accordion > summary { list-style: none; }
	.variable-accordion > summary::-webkit-details-marker { display: none; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 8px; }
	/* Phones: the free canvas becomes a step list; palette and inspector open as bottom sheets. */
	#mobile-steps, #mobile-flow-actions, #palette-mobile-header, #btn-editor-more, #mobile-sheet-backdrop, .mobile-only { display: none; }
	#editor-topbar-more { display: contents; }
	@media (max-width: 767px) {
		#view-editor { flex-direction: column; }
		:scope.editor-open #flow-topbar-title { display: none; }
		#inp-name { flex: 1 1 auto; width: auto; min-width: 0; }
		#btn-editor-more, .mobile-only { display: grid; }
		#editor-topbar-more { display: none; }
		#editor-topbar-more.open { order: 10; display: flex; width: 100%; flex-wrap: wrap; align-items: center; gap: .5rem; padding: .5rem; border-radius: .75rem; background: rgba(255,255,255,.12); }
		#editor-topbar-more #btn-test, #editor-topbar-more #btn-save { display: none; }
		#canvas-wrap, #zoom-controls { display: none; }
		#mobile-steps { display: block; }
		#mobile-flow-actions { display: flex; }
		#palette-panel { display: none; }
		#view-editor.mobile-palette-open #palette-panel { display: block; position: absolute; left: 0; right: 0; bottom: 0; z-index: 46; max-height: 80%; width: 100%; overflow-y: auto; border: 0; border-radius: 1.25rem 1.25rem 0 0; padding: .75rem 1rem 1rem; box-shadow: 0 -16px 40px rgba(0,0,0,.18); }
		#view-editor.mobile-palette-open #palette-mobile-header { display: flex; }
		#view-editor.mobile-palette-open #mobile-sheet-backdrop, #view-editor.mobile-inspector-open #mobile-sheet-backdrop { display: block; position: absolute; inset: 0; z-index: 44; background: rgba(28,25,23,.45); }
		#palette { display: block; width: auto; }
		#palette > div { width: auto; margin-bottom: 1rem; }
		.palette-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.palette-item { aspect-ratio: auto; min-height: 5rem; }
		.node-card { touch-action: none; }
		#inspector:not(.hidden) { inset: auto 0 0; z-index: 45; height: min(82%, 44rem); width: 100%; max-width: none; border-radius: 1.25rem 1.25rem 0 0; border: 0; box-shadow: 0 -16px 40px rgba(0,0,0,.18); }
	}
	}
</style>

  <!-- Top bar -->
  <div class="z-40 flex max-h-[40dvh] shrink-0 flex-wrap items-center justify-between gap-2 overflow-y-auto px-3 py-2 shadow-sm sm:px-5 sm:py-3" style="background: linear-gradient(to right, #3b82f6, #6123cc);">
    <div id="flow-topbar-title" class="flex items-center gap-3 text-white">
      <i class="fas fa-diagram-project text-lg"></i>
      <span class="font-bold text-lg">Automações</span>
    </div>
    <div id="editor-topbar-extra" class="flex w-full flex-wrap items-center gap-2 lg:w-auto"></div>
  </div>

  <!-- LIST VIEW -->
  <div id="flow-starter-guide" class="hidden shrink-0 border-b border-purple-100 bg-purple-50 px-4 py-3 text-xs text-purple-800" role="status"></div>
  <div id="view-list" class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Seus fluxos</h1>
          <p class="text-sm text-gray-500 mt-1">Robôs de atendimento automático para o WhatsApp</p>
        </div>
		<div class="flex items-center gap-2">
<button id="btn-templates" class="px-4 py-2.5 rounded-xl font-medium text-purple-700 bg-purple-50 hover:bg-purple-100 transition-all flex items-center gap-2"><i class="fas fa-layer-group"></i> Modelos de mensagem</button>
		  <button id="btn-import-flow" type="button" class="px-4 py-2.5 rounded-xl font-medium text-gray-700 bg-white border border-stone-200 hover:bg-stone-50 transition-all flex items-center gap-2"><i class="fas fa-file-import"></i> Importar</button>
		  <input id="flow-import-file" type="file" accept=".json,application/json" class="hidden" aria-label="Arquivo JSON do fluxo"/>
		  <button id="btn-new-flow" class="px-5 py-2.5 rounded-xl font-medium text-white shadow-sm hover:shadow-md transition-all flex items-center gap-2" style="background: linear-gradient(to right, #3b82f6, #6123cc);">
			<i class="fas fa-plus"></i> Nova automação
		  </button>
		</div>
      </div>
      <div id="flows-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>
      <div id="flows-empty" class="hidden text-center py-24 text-gray-400">
        <i class="fas fa-diagram-project text-5xl mb-4"></i>
        <p class="text-sm">Nenhum fluxo criado ainda.</p>
      </div>
    </div>
  </div>

  <!-- EDITOR VIEW -->
  <div id="view-editor" class="relative hidden min-h-0 flex-1 flex overflow-hidden">
    <!-- Palette -->
    <div id="palette-panel" class="max-h-[22dvh] w-full shrink-0 overflow-auto border-b border-stone-200 bg-white p-2 md:max-h-none md:w-52 md:overflow-y-auto md:border-b-0 md:border-r md:p-2">
      <button id="palette-toggle" type="button" class="mb-2 hidden w-full items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-xs font-semibold text-gray-500 hover:bg-stone-100 md:flex" aria-expanded="true" aria-controls="palette" title="Recolher blocos"><span class="palette-toggle-label">Blocos</span><i class="fas fa-angles-left"></i></button>
      <div id="palette-mobile-header" class="mb-3 items-center justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-[.16em] text-purple-600">Novo bloco</p><p class="text-base font-black text-gray-900">Adicionar bloco</p></div><button id="palette-mobile-close" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500" aria-label="Fechar lista de blocos"><i class="fas fa-xmark"></i></button></div>
      <div id="palette"></div>
    </div>

    <!-- Canvas -->
    <div id="canvas-area" class="relative min-h-0 min-w-0 flex-1">
      <div id="canvas-wrap" class="absolute inset-0 overflow-auto" title="Arraste o fundo para navegar · Ctrl + roda do mouse para zoom">
        <div id="canvas-sizer" style="position:relative;width:4000px;height:3000px;">
          <div id="canvas" style="width:4000px;height:3000px;position:absolute;left:0;top:0;transform-origin:0 0;">
           <div id="canvas-origin" style="position:absolute;left:1600px;top:1200px;">
            <svg id="edges-svg" width="2400" height="1800" style="position:absolute;top:0;left:0;pointer-events:none;overflow:visible;">
              <defs>
                <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
                  <path d="M0,0 L8,4 L0,8 Z" fill="#a8a29e"></path>
                </marker>
                <marker id="arrow-active" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
                  <path d="M0,0 L8,4 L0,8 Z" fill="#6123cc"></path>
                </marker>
              </defs>
            </svg>
            <div id="nodes-layer"></div>
           </div>
          </div>
        </div>
      </div>
      <div id="zoom-controls" class="absolute bottom-3 left-3 z-20 flex items-center gap-1 rounded-xl border border-stone-200 bg-white p-1 shadow-md" role="group" aria-label="Zoom do fluxo">
        <button type="button" data-zoom="out" class="grid h-8 w-8 place-items-center rounded-lg text-gray-600 hover:bg-stone-100" title="Diminuir zoom (Ctrl -)" aria-label="Diminuir zoom"><i class="fas fa-minus text-xs"></i></button>
        <button type="button" data-zoom="reset" id="zoom-level" class="h-8 min-w-[3.5rem] rounded-lg px-2 text-xs font-semibold text-gray-700 hover:bg-stone-100" title="Voltar para 100% (Ctrl 0)">100%</button>
        <button type="button" data-zoom="in" class="grid h-8 w-8 place-items-center rounded-lg text-gray-600 hover:bg-stone-100" title="Aumentar zoom (Ctrl +)" aria-label="Aumentar zoom"><i class="fas fa-plus text-xs"></i></button>
        <span class="mx-0.5 h-5 w-px bg-stone-200"></span>
        <button type="button" data-zoom="fit" class="grid h-8 w-8 place-items-center rounded-lg text-gray-600 hover:bg-stone-100" title="Ajustar o fluxo à tela" aria-label="Ajustar o fluxo à tela"><i class="fas fa-expand text-xs"></i></button>
      </div>

      <div id="mobile-steps" class="absolute inset-0 overflow-y-auto bg-stone-50 px-3 pb-6 pt-3" aria-label="Etapas do fluxo"></div>

      <!-- Inspector: floats over the canvas instead of shrinking it -->
      <div id="inspector" class="hidden absolute bottom-3 right-3 top-3 z-30 w-[22rem] max-w-[calc(100%-1.5rem)] overflow-y-auto rounded-2xl border border-stone-200 bg-white p-4 shadow-2xl"></div>
    </div>
    <div id="mobile-flow-actions" class="shrink-0 gap-2 border-t border-stone-200 bg-white px-3 py-2.5">
      <button id="mobile-btn-test" type="button" class="flex min-h-[46px] flex-1 items-center justify-center gap-2 rounded-xl border border-stone-200 bg-white text-sm font-bold text-gray-700"><i class="fas fa-vial"></i>Testar</button>
      <button id="mobile-btn-save" type="button" class="min-h-[46px] flex-[2] rounded-xl bg-[#6123cc] text-sm font-black text-white"><i class="fas fa-save mr-1"></i>Salvar flow</button>
    </div>
    <div id="mobile-sheet-backdrop" aria-hidden="true"></div>
  </div>

  <div id="templates-modal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-40 p-4 items-center justify-center">
	<div class="w-full max-w-3xl max-h-[88vh] overflow-hidden rounded-2xl bg-white shadow-2xl flex flex-col">
	  <div class="p-5 border-b border-stone-200 flex items-center justify-between"><div><h2 class="text-lg font-bold text-gray-900">Modelos de mensagem</h2><p class="text-xs text-gray-500 mt-1">Conteúdo reutilizável capturado no snapshot de cada execução.</p></div><button id="btn-close-templates" class="p-2 rounded-lg hover:bg-stone-100"><i class="fas fa-times"></i></button></div>
	  <div class="grid min-h-0 flex-1 grid-rows-2 md:grid-cols-2 md:grid-rows-1">
		<div id="templates-list" class="p-4 border-r border-stone-200 overflow-y-auto space-y-2"></div>
		<form id="template-form" class="p-4 flex flex-col gap-3 overflow-y-auto">
		  <input type="hidden" id="template-id"><input type="hidden" id="template-revision">
		  <div><label class="block text-xs font-medium text-gray-600 mb-1">Nome</label><input id="template-name" maxlength="100" required class="w-full px-3 py-2 rounded-lg border border-stone-200"></div>
		  <div><label class="block text-xs font-medium text-gray-600 mb-1">Mensagem</label><div class="rounded-lg border border-stone-200 bg-stone-50"><div class="flex flex-wrap items-center gap-1 px-2 py-1.5 border-b border-stone-200 bg-white"><button type="button" data-template-format="*" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-bold"></i></button><button type="button" data-template-format="_" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-italic"></i></button><button type="button" data-template-format="~" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-strikethrough"></i></button><button type="button" data-template-format="```" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-code"></i></button><span class="h-5 w-px bg-stone-200 mx-1"></span><button type="button" id="btn-template-variables" class="h-8 px-2.5 rounded-md text-xs font-medium text-purple-700 hover:bg-purple-50"><i class="fas fa-at mr-1"></i>Variáveis</button></div><div id="template-variables" class="hidden border-b border-stone-200 bg-white max-h-48 overflow-y-auto"></div><textarea id="template-content" maxlength="10000" rows="10" required class="w-full px-3 py-2 bg-stone-50 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-purple-400"></textarea></div><p class="text-[11px] text-gray-400 mt-1">Aceita variáveis do contexto do fluxo.</p></div>
		  <div class="flex gap-2"><button type="submit" class="flex-1 px-4 py-2 rounded-lg bg-purple-700 text-white font-medium">Salvar modelo</button><button type="button" id="btn-new-template" class="px-4 py-2 rounded-lg bg-stone-100 text-gray-700">Limpar</button></div>
		</form>
	  </div>
	</div>
  </div>

  <div id="no-response-modal" class="hidden fixed inset-0 z-50 bg-stone-950/55 p-4 items-center justify-center backdrop-blur-sm">
	<form id="no-response-form" class="max-h-[calc(100dvh-2rem)] w-full max-w-xl overflow-y-auto rounded-2xl bg-white shadow-2xl">
	  <div class="flex items-start justify-between border-b border-stone-200 px-5 py-4">
		<div><p class="text-[10px] font-bold uppercase tracking-[.18em] text-purple-600">Comportamento do fluxo</p><h2 class="mt-1 text-lg font-bold text-gray-900">Cliente sem resposta</h2><p class="mt-1 text-xs text-gray-500">Envie um lembrete e transfira a conversa quando o cliente não responder.</p></div>
		<button id="btn-close-no-response" type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-gray-400 hover:bg-stone-100 hover:text-gray-700" aria-label="Fechar"><i class="fas fa-times"></i></button>
	  </div>
	  <div class="space-y-4 p-5">
		<label class="flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4"><input id="no-response-enabled" type="checkbox"><span><span class="block text-sm font-semibold text-gray-800">Detectar falta de resposta</span><span class="mt-1 block text-xs leading-relaxed text-gray-500">Aplica este prazo sempre que o fluxo estiver aguardando uma resposta do cliente.</span></span></label>
		<div id="no-response-fields" class="space-y-4">
		  <div><label for="no-response-minutes" class="mb-1 block text-xs font-medium text-gray-600">Enviar lembrete após</label><div class="relative"><input id="no-response-minutes" type="number" min="1" max="43200" required class="w-full rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 pr-20 text-sm outline-none focus:ring-2 focus:ring-purple-400"><span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400">minutos</span></div><p class="mt-1 text-[11px] text-gray-400">Entre 1 minuto e 30 dias. Substitui o timeout individual dos blocos de resposta.</p></div>
		  <div><label for="no-response-message" class="mb-1 block text-xs font-medium text-gray-600">Mensagem de lembrete</label><textarea id="no-response-message" maxlength="10000" rows="4" required class="w-full rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-purple-400"></textarea><p class="mt-1 text-[11px] text-gray-400">Aceita as mesmas variáveis disponíveis nos blocos de mensagem.</p></div>
		  <div class="grid gap-4 sm:grid-cols-2"><div><label class="mb-1 block text-xs font-medium text-gray-600">Transferir para</label><div id="no-response-target-type"></div></div><div><label id="no-response-target-label" class="mb-1 block text-xs font-medium text-gray-600">Destino</label><div id="no-response-target"></div></div></div>
		</div>
	  </div>
	  <div class="flex justify-end gap-2 border-t border-stone-200 bg-stone-50 px-5 py-4"><button id="btn-cancel-no-response" type="button" class="rounded-lg border border-stone-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-stone-100">Cancelar</button><button type="submit" class="rounded-lg bg-purple-700 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-800"><i class="fas fa-check mr-1"></i>Aplicar</button></div>
	</form>
  </div>

  <div id="flow-starter-catalog" class="hidden" data-templates={flowStarterCatalogJSON()}></div>
  <dialog id="new-flow-modal" aria-labelledby="new-flow-title" class="m-auto w-11/12 max-w-3xl max-h-[90dvh] overflow-hidden rounded-3xl border border-stone-200 bg-white p-0 shadow-2xl backdrop:bg-stone-950/60 backdrop:backdrop-blur-sm">
	<div class="flex max-h-[90dvh] flex-col"><header class="flex shrink-0 items-center justify-between gap-3 border-b border-stone-100 px-5 py-4"><div><h2 id="new-flow-title" class="text-lg font-black text-gray-900">Como deseja criar seu flow?</h2><p class="mt-1 text-xs text-gray-500">Escolha um ponto de partida e personalize no editor.</p></div><button id="new-flow-close" type="button" aria-label="Fechar criação de flow" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-gray-500 hover:bg-stone-100"><i class="fas fa-xmark"></i></button></header>
	<section id="new-flow-options" class="grid gap-4 p-5 sm:grid-cols-3"><button id="new-flow-blank" type="button" class="rounded-2xl border border-stone-200 p-5 text-left transition hover:border-purple-400 hover:bg-purple-50"><span class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-stone-100 text-xl text-gray-600"><i class="fas fa-file"></i></span><span class="block font-bold text-gray-900">Começar em branco</span><span class="mt-2 block text-sm leading-relaxed text-gray-500">Abra o editor somente com o bloco Início e monte seu fluxo livremente.</span></button><button id="new-flow-from-model" type="button" class="rounded-2xl border border-purple-200 bg-purple-50 p-5 text-left transition hover:border-purple-400 hover:bg-purple-100"><span class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-purple-100 text-xl text-purple-700"><i class="fas fa-wand-magic-sparkles"></i></span><span class="block font-bold text-gray-900">Começar a partir de modelo</span><span class="mt-2 block text-sm leading-relaxed text-gray-500">Use um exemplo com blocos conectados, mensagens e gatilho já preenchidos.</span></button><button id="new-flow-import" type="button" class="rounded-2xl border border-stone-200 p-5 text-left transition hover:border-purple-400 hover:bg-purple-50"><span class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-blue-50 text-xl text-blue-700"><i class="fas fa-file-import"></i></span><span class="block font-bold text-gray-900">Importar de arquivo</span><span class="mt-2 block text-sm leading-relaxed text-gray-500">Abra um fluxo exportado em JSON, desta ou de outra empresa, para revisar e salvar.</span></button></section>
	<section id="new-flow-models" class="hidden min-h-0 flex-1 overflow-y-auto p-5"><p class="mb-4 text-xs leading-relaxed text-gray-500">Todos os modelos são editáveis e começam inativos. Escolha um exemplo para ver as orientações no editor.</p><div class="grid gap-3 sm:grid-cols-2">
		for _, model:=range flowengine.StarterTemplates() {
			<label class="cursor-pointer rounded-2xl border border-stone-200 p-4 transition hover:border-purple-300 has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50 has-[:checked]:ring-1 has-[:checked]:ring-purple-300"><div class="flex items-start gap-3"><i class={"fas mt-1 text-purple-600",model.Icon}></i><div class="min-w-0 flex-1"><span class="block text-sm font-bold text-gray-900">{model.Name}</span><span class="mt-1 block text-xs leading-relaxed text-gray-500">{model.Description}</span></div><input type="radio" name="flow-starter-choice" value={model.ID} class="mt-1 accent-purple-600"/></div><p class="mt-3 text-[11px] leading-relaxed text-purple-700">{strings.Join(model.Steps," → ")}</p><p class="mt-2 text-[10px] text-gray-400">{fmt.Sprintf("%d blocos · Gatilho: Sempre responde",len(model.FlowData.Nodes))}</p></label>
		}
	</div></section><footer id="new-flow-model-actions" class="hidden shrink-0 items-center justify-between gap-3 border-t border-stone-100 px-5 py-4"><button id="new-flow-back" type="button" class="rounded-xl px-3 py-2 text-xs font-bold text-gray-600 hover:bg-stone-100"><i class="fas fa-arrow-left mr-2"></i>Voltar</button><button id="new-flow-use-model" type="button" disabled class="rounded-xl bg-purple-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-purple-700 disabled:cursor-not-allowed disabled:opacity-40">Usar este modelo</button></footer></div>
  </dialog>
<dialog id="flow-export-modal" aria-labelledby="flow-export-title" class="m-auto w-11/12 max-w-lg rounded-3xl border border-stone-200 bg-white p-0 shadow-2xl backdrop:bg-stone-950/60 backdrop:backdrop-blur-sm">
	<form id="flow-export-form" method="dialog">
	  <header class="flex items-start justify-between gap-3 border-b border-stone-100 px-5 py-4"><div><p class="text-[10px] font-bold uppercase tracking-[.18em] text-purple-600">Exportar fluxo</p><h2 id="flow-export-title" class="mt-1 text-lg font-black text-gray-900"></h2></div><button id="flow-export-close" type="button" aria-label="Fechar exportação" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-gray-500 hover:bg-stone-100"><i class="fas fa-xmark"></i></button></header>
	  <div class="space-y-3 p-5 text-sm text-gray-600">
		<p id="flow-export-summary"></p>
		<p class="text-xs leading-relaxed text-gray-500">O arquivo leva o gatilho, os blocos, as conexões entre eles e as mídias enviadas. Ao importar em outra empresa, subfluxos, modelos, credenciais, agentes e setores são associados pelo nome; o que não existir lá precisará ser escolhido de novo.</p>
		<label id="flow-export-secrets-field" class="hidden flex cursor-pointer items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-3"><input id="flow-export-secrets" type="checkbox" class="mt-0.5"/><span><span class="block text-sm font-semibold text-amber-900">Incluir tokens e cabeçalhos de autenticação</span><span id="flow-export-secrets-list" class="mt-1 block text-xs leading-relaxed text-amber-800"></span></span></label>
		<p id="flow-export-status" class="hidden rounded-xl bg-stone-50 p-3 text-xs" role="status"></p>
	  </div>
	  <footer class="flex justify-end gap-2 border-t border-stone-100 bg-stone-50 px-5 py-4"><button id="flow-export-cancel" type="button" class="rounded-lg border border-stone-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-stone-100">Cancelar</button><button id="flow-export-submit" type="submit" class="rounded-lg bg-purple-700 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-download mr-1"></i>Baixar JSON</button></footer>
	</form>
  </dialog>
<script>
// ---------------------------------------------------------------------
// Node type metadata - field names/behavior mirror internal/flowengine
// exactly (types.go / engine.go).
// ---------------------------------------------------------------------
const NODE_TYPES = {
  start:           { label: 'Início',              icon: 'fa-play',            color: '#22c55e', category: 'Fluxo',     singleton: true, noInput: true },
  sendText:        { label: 'Enviar Texto',         icon: 'fa-comment',         color: '#3b82f6', category: 'Mensagens' },
  sendImage:       { label: 'Enviar Imagem',        icon: 'fa-image',           color: '#3b82f6', category: 'Mensagens' },
  sendVideo:       { label: 'Enviar Vídeo',          icon: 'fa-video',           color: '#3b82f6', category: 'Mensagens' },
  sendAudio:       { label: 'Enviar Áudio',         icon: 'fa-microphone',      color: '#3b82f6', category: 'Mensagens' },
  sendFile:        { label: 'Enviar Arquivo',       icon: 'fa-paperclip',       color: '#3b82f6', category: 'Mensagens' },
  sendMenu:        { label: 'Enviar Menu',          icon: 'fa-list-ul',         color: '#3b82f6', category: 'Mensagens' },
  sendButtons:     { label: 'Botões',              icon: 'fa-hand-pointer',    color: '#2563eb', category: 'Mensagens' },
  sendTemplate:    { label: 'Enviar Modelo',        icon: 'fa-layer-group',     color: '#3b82f6', category: 'Mensagens' },
  condition:       { label: 'Condição',             icon: 'fa-code-branch',     color: '#f59e0b', category: 'Lógica' },
  switch:          { label: 'Múltipla Escolha',     icon: 'fa-list',            color: '#f59e0b', category: 'Lógica' },
  delay:           { label: 'Aguardar',             icon: 'fa-clock',           color: '#f59e0b', category: 'Lógica' },
  changeStatus:    { label: 'Mudar Status',         icon: 'fa-tag',             color: '#8b5cf6', category: 'Sistema' },
  assign:          { label: 'Transferir conversa',  icon: 'fa-user-check',      color: '#8b5cf6', category: 'Sistema' },
  httpRequest:     { label: 'HTTP Request',         icon: 'fa-globe',           color: '#8b5cf6', category: 'Sistema' },
  waitForResponse: { label: 'Esperar Resposta',     icon: 'fa-hourglass-half',  color: '#ec4899', category: 'Interação' },
  input:           { label: 'Capturar Resposta',    icon: 'fa-keyboard',        color: '#ec4899', category: 'Interação' },
  checkResponse:   { label: 'Verificar Resposta',   icon: 'fa-check-double',    color: '#ec4899', category: 'Interação' },
  setVariable:     { label: 'Definir Variável',      icon: 'fa-code',            color: '#8b5cf6', category: 'Sistema' },
  tag:             { label: 'Gerenciar Tag',         icon: 'fa-tags',            color: '#8b5cf6', category: 'Sistema' },
  updateContact:   { label: 'Atualizar Contato',     icon: 'fa-address-card',    color: '#8b5cf6', category: 'Sistema' },
  setContactField: { label: 'Campo Personalizado',   icon: 'fa-table-list',      color: '#8b5cf6', category: 'Sistema' },
  businessHours:   { label: 'Horário Comercial',    icon: 'fa-calendar-check',  color: '#f59e0b', category: 'Lógica' },
  randomSplit:     { label: 'Divisão Aleatória',     icon: 'fa-shuffle',         color: '#f59e0b', category: 'Lógica' },
  messageType:     { label: 'Tipo de Mensagem',      icon: 'fa-photo-film',      color: '#f59e0b', category: 'Lógica' },
  smartAssign:     { label: 'Distribuição Inteligente', icon: 'fa-users-gear',   color: '#8b5cf6', category: 'Sistema' },
  addNote:         { label: 'Registrar Nota',         icon: 'fa-note-sticky',    color: '#8b5cf6', category: 'Sistema' },
  callback:        { label: 'Callback',               icon: 'fa-satellite-dish', color: '#8b5cf6', category: 'Sistema' },
  subflow:         { label: 'Executar Subfluxo',      icon: 'fa-diagram-project', color: '#8b5cf6', category: 'Sistema' },
  ai:              { label: 'Gerar com IA',          icon: 'fa-wand-magic-sparkles', color: '#8b5cf6', category: 'Sistema' },
	 mediaTranscription: { label: 'Transcrever Mídia', icon: 'fa-file-waveform', color: '#7c3aed', category: 'Sistema' },
	 conversationSummary: { label: 'Resumir Conversa', icon: 'fa-file-lines', color: '#7c3aed', category: 'Sistema' },
	 aiAgent:        { label: 'Transferir para Agente IA', icon: 'fa-robot', color: '#7c3aed', category: 'Fluxo' },
	 aiKnowledge:    { label: 'Base (descontinuada)', icon: 'fa-book-open', color: '#a8a29e', category: 'Fluxo', subNode: true, hidden: true },
	 aiTools:        { label: 'Ações da IA', icon: 'fa-screwdriver-wrench', color: '#7c3aed', category: 'Fluxo', subNode: true },
  npsEvaluation:   { label: 'Avaliação NPS',          icon: 'fa-star-half-stroke', color: '#ec4899', category: 'Interação' },
  scheduleMessage: { label: 'Agendar Mensagem',      icon: 'fa-calendar-plus',    color: '#8b5cf6', category: 'Sistema' },
  end:             { label: 'Fim',                  icon: 'fa-flag-checkered', color: '#ef4444', category: 'Fluxo' },
};
const CATEGORIES = ['Fluxo', 'Mensagens', 'Lógica', 'Sistema', 'Interação'];
const NODE_W = 220;
// Providers the Transcrever Mídia block accepts; mirrors llm.MediaAnalysisProvider.
const MEDIA_PROVIDERS = ['openai', 'gemini', 'claude', 'groq'];
const CONDITION_SOURCES = [
  { value: 'contactName', label: 'NOME DO CONTATO' },
  { value: 'contactNumber', label: 'NÚMERO DO CONTATO' },
  { value: 'conversationTag', label: 'TAG DA CONVERSA' },
  { value: 'contactEmail', label: 'EMAIL DO CONTATO' },
  { value: 'contactMessage', label: 'MENSAGEM DO CONTATO' },
  { value: 'department', label: 'DEPARTAMENTO' },
  { value: 'time', label: 'HORÁRIO' },
  { value: 'variable', label: 'VARIÁVEL' },
  { value: 'connectionType', label: 'TIPO DE CONEXÃO' },
];
const CONDITION_OPERATORS = [
  { value: 'equals', label: 'IGUAL A' },
  { value: 'notEquals', label: 'NÃO IGUAL' },
  { value: 'contains', label: 'CONTÉM' },
  { value: 'notContains', label: 'NÃO CONTÉM' },
  { value: 'greaterThan', label: 'MAIOR QUE' },
  { value: 'lessThan', label: 'MENOR QUE' },
  { value: 'true', label: 'VERDADEIRO' },
  { value: 'false', label: 'FALSO' },
];
const CONDITION_OUTPUT_LABELS = {
  equals:      ['Igual a', 'Não igual'],
  notEquals:   ['Não igual', 'Igual a'],
  contains:    ['Contém', 'Não contém'],
  notContains: ['Não contém', 'Contém'],
  greaterThan: ['Maior que', 'Menor ou igual'],
  lessThan:    ['Menor que', 'Maior ou igual'],
  true:        ['Verdadeiro', 'Falso'],
  false:       ['Falso', 'Verdadeiro'],
};

function uid(prefix) { return prefix + '_' + Math.random().toString(36).slice(2, 9); }

// The AI agent block has two bottom ports. "Ações" takes the AI actions
// sub-block (mirrors validateAIAgentEdge in internal/flowengine/ai_tools.go).
// "Base de conhecimento" is a shortcut: the knowledge base lives on the agent
// and is edited in /ai-agents, where files can be imported.
const AI_SUB_PORTS = [
	{ handle: 'knowledge', label: 'Base de conhecimento', link: true, icon: 'fa-arrow-up-right-from-square' },
	{ handle: 'tools', label: 'Ações', accepts: 'aiTools' },
];
const VAR_OPEN = '{' + '{', VAR_CLOSE = '}' + '}';
const AI_ACTION_TYPES = [
	{ value: 'transfer', label: 'Transferir atendimento' },
	{ value: 'close', label: 'Encerrar atendimento' },
	{ value: 'pause', label: 'Pausar a IA' },
	{ value: 'summary', label: 'Resumo para o operador' },
	{ value: 'tag', label: 'Adicionar etiqueta' },
	{ value: 'contactField', label: 'Salvar dado do cliente' },
	{ value: 'http', label: 'Chamar API / Webhook' },
];

function subPortsFor(node) { return node && node.type === 'aiAgent' ? AI_SUB_PORTS : []; }
function subPortFor(nodeId, handle) { return subPortsFor(state.flowData.nodes.find(node => node.id === nodeId)).find(port => port.handle === handle); }
function subPortX(index, count) { return Math.round(NODE_W * (2 * index + 1) / (2 * count)); }
function isSubNode(node) { return !!(node && NODE_TYPES[node.type] && NODE_TYPES[node.type].subNode); }

// canConnect tells whether the output (sourceId, handle) may end on target.
function canConnect(sourceId, handle, target) {
	if (!target || target.id === sourceId) return false;
	const port = subPortFor(sourceId, handle);
	if (port) return !port.link && target.type === port.accepts;
	const meta = NODE_TYPES[target.type] || {};
	return !meta.noInput && !meta.subNode;
}

function defaultAIAction(type) {
	const action = { id: uid('act'), type, name: '', description: '' };
	switch (type) {
	case 'transfer': return Object.assign(action, { name: 'Transferir atendimento', description: 'Quando o cliente pedir para falar com uma pessoa ou a dúvida não puder ser resolvida com a base de conhecimento.', assignType: 'department', message: '' });
	case 'close': return Object.assign(action, { name: 'Encerrar atendimento', description: 'Quando o cliente confirmar que não precisa de mais nada.', message: '' });
	case 'pause': return Object.assign(action, { name: 'Pausar a IA', description: 'Quando o cliente pedir para falar com uma pessoa e a equipe deve assumir a conversa sem transferir.', pauseMinutes: 0, message: '' });
	case 'summary': return Object.assign(action, { name: 'Resumo para o operador', description: 'Quando o cliente já tiver explicado o que precisa, ou antes de transferir ou pausar o atendimento.' });
	case 'tag': return Object.assign(action, { name: 'Marcar interesse', description: 'Quando o cliente demonstrar interesse em contratar.', tag: '' });
	case 'contactField': return Object.assign(action, { name: 'Salvar email', description: 'Quando o cliente informar o email dele.', field: 'email', fieldKey: '' });
	case 'http': return Object.assign(action, { name: 'Agendar reunião', description: 'Quando o cliente quiser agendar uma reunião e já tiver informado data e horário.', method: 'POST', url: '', headers: [], parameters: [{ name: 'dataHora', description: 'Data e horário desejados, no formato AAAA-MM-DD HH:MM', required: true }], timeout: 15000 });
	}
	return action;
}

// ---------------------------------------------------------------------
// Custom selectors use top-layer popovers so scrollable toolbars and the
// inspector cannot clip their options. Radios remain inside the wrapper.
// ---------------------------------------------------------------------
let ddCounter = 0;
function customSelectHTML(role, options, selected, placeholder, field) {
  const base = 'dd' + (ddCounter++);
  const wrapperId = base + '_wrap';
  const toggleId = base + '_toggle';
  const selectedOpt = options.find(o => String(o.value) === String(selected));

  const radios = options.map((o, i) =>
    '<input type="radio" name="' + base + '" id="' + base + '_opt' + i + '" value="' + escapeAttr(o.value) +
    '" class="hidden" ' + (String(o.value) === String(selected) ? 'checked' : '') + '>'
  ).join('');

  const panelItems = options.map((o, i) => {
    const radioId = base + '_opt' + i;
    return '<label for="' + radioId + '" class="cursor-pointer w-full px-4 py-2.5 text-left text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors flex items-center gap-2.5 dd-item" data-radio="' + radioId + '">' +
      (o.dot ? '<span class="w-2 h-2 rounded-full flex-shrink-0" style="background:' + o.dot + '"><\/span>' : '') +
      '<span class="truncate">' + escapeHtml(o.label) + '<\/span>' +
      '<i class="fas fa-check ml-auto text-purple-600 opacity-0 dd-check" data-radio="' + radioId + '"><\/i>' +
      '<\/label>';
  }).join('');

  const hasRules = options.map((o, i) =>
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) .dd-placeholder{display:none}' +
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) .dd-selected{display:flex}' +
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) [data-radio="' + base + '_opt' + i + '"].dd-check{opacity:1}' +
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) [data-radio="' + base + '_opt' + i + '"].dd-item{background:#faf5ff;color:#7e22ce;font-weight:500}'
  ).join('');

  return '' +
    '<div class="relative' + (field ? ' w-full' : '') + '" id="' + wrapperId + '" data-dd-name="' + base + '" data-dd-role="' + role + '"' + (field ? ' data-dd-field="' + escapeAttr(field) + '"' : '') + '>' +
      radios +
      '<input type="checkbox" id="' + toggleId + '" data-dd-toggle class="hidden peer">' +
      '<label for="' + toggleId + '" data-dd-trigger role="button" tabindex="0" aria-expanded="false" aria-controls="' + base + '_panel" class="cursor-pointer' + (field ? ' w-full' : '') + ' min-w-[170px] px-3 py-2 bg-white border border-stone-200 rounded-xl text-sm transition-all flex items-center justify-between gap-2 hover:border-purple-300 peer-checked:ring-2 peer-checked:ring-purple-400 shadow-sm">' +
        '<span class="dd-placeholder text-gray-400 truncate">' + escapeHtml(placeholder) + '<\/span>' +
        '<span class="dd-selected hidden text-gray-900 items-center gap-2 truncate">' +
          (selectedOpt && selectedOpt.dot ? '<span class="w-2 h-2 rounded-full flex-shrink-0" style="background:' + selectedOpt.dot + '"><\/span>' : '') +
          '<span class="truncate">' + escapeHtml(selectedOpt ? selectedOpt.label : '') + '<\/span>' +
        '<\/span>' +
        '<i class="fas fa-chevron-down text-gray-400 text-xs transition-transform peer-checked:rotate-180 flex-shrink-0"><\/i>' +
      '<\/label>' +
      '<div id="' + base + '_panel" popover="manual" data-dd-panel class="flow-dropdown-panel">' +
        panelItems +
      '<\/div>' +
      '<style>' + hasRules + '<\/style>' +
    '<\/div>';
}

function inspectorSelect(fieldName, options, selected, placeholder) {
  return customSelectHTML('inspector-' + fieldName, options, selected, placeholder || 'Selecione', fieldName);
}

function hideFlowDropdown(wrapper) {
	const panel=wrapper.querySelector('[data-dd-panel]');const toggle=wrapper.querySelector('[data-dd-toggle]');
	if(toggle)toggle.checked=false;wrapper.querySelector('[data-dd-trigger]')?.setAttribute('aria-expanded','false');
	if(panel?.matches(':popover-open'))panel.hidePopover();else if(panel)panel.style.display='';
}

function positionFlowDropdown(wrapper) {
	const panel=wrapper.querySelector('[data-dd-panel]'),trigger=wrapper.querySelector('[data-dd-trigger]');if(!panel||!trigger)return;
	const bounds=trigger.getBoundingClientRect(),margin=8,width=Math.min(Math.max(bounds.width,170),innerWidth-margin*2);
	const below=innerHeight-bounds.bottom-margin,above=bounds.top-margin,up=below<160&&above>below;
	panel.style.width=width+'px';panel.style.left=Math.max(margin,Math.min(bounds.left,innerWidth-width-margin))+'px';panel.style.maxHeight=Math.min(256,Math.max(48,up?above:below))+'px';
	panel.style.top=Math.max(margin,Math.min(up?bounds.top-panel.getBoundingClientRect().height-4:bounds.bottom+4,innerHeight-panel.getBoundingClientRect().height-margin))+'px';
}

function showFlowDropdown(wrapper) {
	document.querySelectorAll('[data-dd-name]').forEach(other=>{if(other!==wrapper)hideFlowDropdown(other);});
	const panel=wrapper.querySelector('[data-dd-panel]');if(!panel)return;
	if(panel.showPopover){if(!panel.matches(':popover-open'))panel.showPopover();}else{panel.style.display='flex';}
	wrapper.querySelector('[data-dd-toggle]').checked=true;wrapper.querySelector('[data-dd-trigger]').setAttribute('aria-expanded','true');positionFlowDropdown(wrapper);
}

document.addEventListener('change',event=>{
	if(event.target.matches('[data-dd-toggle]')){const wrapper=event.target.closest('[data-dd-name]');if(event.target.checked)showFlowDropdown(wrapper);else hideFlowDropdown(wrapper);}
});
document.addEventListener('click',event=>{document.querySelectorAll('[data-dd-name]').forEach(wrapper=>{if(!wrapper.contains(event.target))hideFlowDropdown(wrapper);});});
document.addEventListener('keydown',event=>{
	const trigger=event.target.closest('[data-dd-trigger]');
	if(trigger&&(event.key==='Enter'||event.key===' ')){event.preventDefault();const wrapper=trigger.closest('[data-dd-name]');if(wrapper.querySelector('[data-dd-toggle]').checked)hideFlowDropdown(wrapper);else showFlowDropdown(wrapper);}
	if(event.key==='Escape'){document.querySelectorAll('[data-dd-toggle]:checked').forEach(toggle=>{const wrapper=toggle.closest('[data-dd-name]');hideFlowDropdown(wrapper);wrapper.querySelector('[data-dd-trigger]').focus();});}
});
function repositionFlowDropdowns(){document.querySelectorAll('[data-dd-toggle]:checked').forEach(toggle=>{if(toggle.isConnected)positionFlowDropdown(toggle.closest('[data-dd-name]'));});}
window.addEventListener('resize',repositionFlowDropdowns);window.addEventListener('scroll',repositionFlowDropdowns,true);

// ---------------------------------------------------------------------
// State
// ---------------------------------------------------------------------
const state = {
  flows: [],
  connections: [],
  agents: [],
  departments: [],
	aiAgents: [],
	aiCredentials: [],
	templates: [],
  currentFlow: null,      // {id, name, description, connectionId, triggerType, triggerValue, isActive}
  flowData: { nodes: [], edges: [] },
  selectedNodeId: null,
  armedHandle: null,      // {nodeId, handle} - connection source selected by click or drag
	connectionDrag: null,   // {pointerId, startClientX, startClientY, x, y, moved}
	canvasPan: null,
	hoveredEdgeId: null,
	zoom: 1,
	suppressClick: false, // swallows the click a drag or pan ends with
	httpTestResponses: {},
	httpTestContexts: {},
	savedFingerprint: '',
	saving: false,
};

function flowFingerprint() {
	if (!state.currentFlow) return '';
	const flow = state.currentFlow;
	return JSON.stringify({ name: flow.name, description: flow.description, connectionId: flow.connectionId,
		triggerType: flow.triggerType, triggerValue: flow.triggerValue, isActive: flow.isActive,
		priority: flow.priority || 0, flowData: state.flowData });
}

function flowIsDirty() { return !!state.currentFlow && state.savedFingerprint !== flowFingerprint(); }

// ---------------------------------------------------------------------
// API helpers
// ---------------------------------------------------------------------
async function api(method, url, body) {
  const res = await fetch(url, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: body !== undefined ? JSON.stringify(body) : undefined,
  });
  if (res.status === 204) return null;
  const json = await res.json().catch(() => ({}));
  if (!res.ok) {
    console.error('API error', method, url, res.status, json);
    throw new Error(json.error || ('Erro ' + res.status));
  }
  return json.data;
}

// ---------------------------------------------------------------------
// List view
// ---------------------------------------------------------------------
async function loadFlowsList() {
  state.flows = await api('GET', '/flows/api/');
  renderFlowsList();
}

function triggerBadge(flow) {
  if (flow.triggerType === 'always') return '<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 text-xs font-medium">Sempre responde<\/span>';
  if (flow.triggerType === 'exact') return `<span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-medium">Mensagem exata: "${escapeHtml(flow.triggerValue||'')}"<\/span>`;
  return `<span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 text-xs font-medium">Palavra-chave: "${escapeHtml(flow.triggerValue||'')}"<\/span>`;
}

function renderFlowsList() {
  const grid = document.getElementById('flows-grid');
  const empty = document.getElementById('flows-empty');
  grid.innerHTML = '';
  empty.classList.toggle('hidden', state.flows.length > 0);
  for (const flow of state.flows) {
    const conn = state.connections.find(c => c.id === flow.connectionId);
    const card = document.createElement('div');
    card.className = 'bg-white rounded-2xl p-5 shadow-sm border-t-4 hover:shadow-lg transition-all flex flex-col';
    card.style.borderTopColor = flow.isActive ? '#22c55e' : '#d6d3d1';
    card.innerHTML = `
      <div class="flex items-start justify-between mb-2">
        <h3 class="text-base font-bold text-gray-900">${escapeHtml(flow.name)}<\/h3>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full ${flow.isActive ? 'bg-green-100 text-green-700' : 'bg-stone-100 text-gray-500'}">
          ${flow.isActive ? 'Ativo' : 'Inativo'}
        <\/span>
      <\/div>
      <p class="text-xs text-gray-500 mb-3 flex-1">${escapeHtml(flow.description || 'Sem descrição')}<\/p>
      <div class="flex items-center gap-2 flex-wrap mb-3">${triggerBadge(flow)}<\/div>
      <div class="text-xs text-gray-500 mb-4 flex items-center gap-1.5">
        <i class="fab fa-whatsapp ${conn ? 'text-green-600' : 'text-gray-300'}"><\/i>
		${conn ? escapeHtml(conn.name) : 'Todas as conexões'}
      <\/div>
      <div class="flex gap-2">
        <button data-edit="${flow.id}" class="flex-1 p-2 bg-stone-100 hover:bg-stone-200 rounded-lg transition-colors text-xs font-medium text-gray-700">
          <i class="fas fa-edit mr-1"><\/i>Editar
        <\/button>
        <button data-export="${flow.id}" title="Exportar JSON" aria-label="Exportar ${escapeAttr(flow.name)}" class="p-2 bg-stone-100 hover:bg-stone-200 text-gray-600 rounded-lg transition-colors">
          <i class="fas fa-file-export text-xs"><\/i>
        <\/button>
        <button data-del="${flow.id}" class="p-2 bg-red-50 hover:bg-red-100 text-red-500 rounded-lg transition-colors">
          <i class="fas fa-trash text-xs"><\/i>
        <\/button>
      <\/div>`;
    grid.appendChild(card);
  }
  grid.querySelectorAll('[data-edit]').forEach(btn => btn.onclick = () => openEditor(Number(btn.dataset.edit)));
  grid.querySelectorAll('[data-del]').forEach(btn => btn.onclick = () => deleteFlow(Number(btn.dataset.del)));
  grid.querySelectorAll('[data-export]').forEach(btn => btn.onclick = () => exportSavedFlow(Number(btn.dataset.export)));
}

async function deleteFlow(id) {
  if (!confirm('Apagar esta automação? Essa ação não pode ser desfeita.')) return;
  await api('DELETE', '/flows/api/' + id);
  await loadFlowsList();
}

// ---------------------------------------------------------------------
// Editor view - open/new/save
// ---------------------------------------------------------------------
function blankFlowData() {
  return { nodes: [{ id: uid('n'), type: 'start', position: { x: 240, y: 200 }, data: {} }], edges: [], settings: {} };
}

const FLOW_STARTERS = JSON.parse(document.getElementById('flow-starter-catalog').dataset.templates);
let selectedStarterId = null;

function openNewFlowModal() {
	const modal=document.getElementById('new-flow-modal');selectedStarterId=null;
	document.querySelectorAll('[name="flow-starter-choice"]').forEach(radio=>{radio.checked=false;});
	document.getElementById('new-flow-use-model').disabled=true;
	showNewFlowModels(false);modal.showModal();
}

function showNewFlowModels(show) {
	document.getElementById('new-flow-options').classList.toggle('hidden',show);
	document.getElementById('new-flow-models').classList.toggle('hidden',!show);
	const actions=document.getElementById('new-flow-model-actions');actions.classList.toggle('hidden',!show);actions.classList.toggle('flex',show);
	if(show)document.querySelector('[name="flow-starter-choice"]').focus();
}

function cloneStarterGraph(template) {
	const data=JSON.parse(JSON.stringify(template.flowData));const ids=new Map();
	data.nodes.forEach(node=>{const id=uid('n');ids.set(node.id,id);node.id=id;});
	data.edges.forEach(edge=>{edge.id=uid('e');edge.source=ids.get(edge.source);edge.target=ids.get(edge.target);});
	return data;
}

function migrateLegacyAICredentialSelections(flowData) {
	(flowData.nodes || []).forEach(node => {
		if (!['conversationSummary', 'mediaTranscription'].includes(node.type) || Number(node.data.credentialId) > 0) return;
		const legacyAgent = state.aiAgents.find(agent => agent.id === Number(node.data.aiAgentId));
		if (!legacyAgent || Number(legacyAgent.credentialId) <= 0) return;
		node.data.credentialId = Number(legacyAgent.credentialId);
		delete node.data.aiAgentId;
	});
	return flowData;
}

async function openEditor(id, starterId) {
	const starter=starterId?FLOW_STARTERS.find(template=>template.id===starterId):null;
  if (id) {
    const flow = await api('GET', '/flows/api/' + id);
    state.currentFlow = flow;
	state.flowData = flow.flowData && flow.flowData.nodes ? migrateLegacyAICredentialSelections(flow.flowData) : blankFlowData();
  } else {
	state.currentFlow = { id: null, name: 'Nova automação', description: '', connectionId: null, triggerType: 'keyword', triggerValue: '', isActive: false, priority: 0, revision: 0 };
	if(starter){state.currentFlow.name=starter.name;state.currentFlow.description=starter.description;state.currentFlow.triggerType=starter.triggerType||'always';state.currentFlow.triggerValue=starter.triggerValue||'';state.flowData=cloneStarterGraph(starter);}else{state.flowData=blankFlowData();}
  }
  state.selectedNodeId = null;
  state.armedHandle = null;
  state.connectionDrag = null;
  showView('editor');
  renderTopbarExtra();
  renderPalette();
  renderCanvas();
	renderInspector();
	const guide=document.getElementById('flow-starter-guide');guide.textContent=starter?'Modelo: '+starter.name+' — '+starter.instructions+' Salve, revise a conexão e ative quando estiver pronto.':'';guide.classList.toggle('hidden',!starter);
	requestAnimationFrame(fitView);
	state.savedFingerprint = starter ? '' : flowFingerprint();
}

function closeEditor() {
	if (flowIsDirty() && !confirm('Existem alterações não salvas. Deseja sair mesmo assim?')) return;
	document.querySelectorAll('[data-dd-name]').forEach(hideFlowDropdown);
  state.currentFlow = null;
  showView('list');
	document.getElementById('flow-starter-guide').classList.add('hidden');
  renderTopbarExtra();
  loadFlowsList().catch(e => console.error('erro ao recarregar lista de fluxos', e));
}

function showView(name) {
  document.getElementById('view-list').classList.toggle('hidden', name !== 'list');
  document.getElementById('view-editor').classList.toggle('hidden', name !== 'editor');
  document.getElementById('flowbuilder-page').classList.toggle('editor-open', name === 'editor');
  if (name !== 'editor') closeMobilePalette();
}

async function saveFlow() {
	if (state.saving) return;
  const f = state.currentFlow;
  if (!f.name || !f.name.trim()) { alert('Dá um nome pra essa automação antes de salvar.'); return; }
  const startNodes = state.flowData.nodes.filter(n => n.type === 'start');
  if (startNodes.length !== 1) { alert('O fluxo precisa ter exatamente um node de Início.'); return; }
  const requiredMediaFields = {
    sendImage: { url: 'imageUrl', path: 'imagePath' },
    sendVideo: { url: 'videoUrl', path: 'videoPath' },
    sendAudio: { url: 'audioUrl', path: 'audioPath' },
    sendFile: { url: 'fileUrl', path: 'filePath' },
  };
  const missingMedia = state.flowData.nodes.find(node => {
    const fields = requiredMediaFields[node.type];
    return fields && !String(node.data[fields.url] || '').trim() && (!fields.path || !String(node.data[fields.path] || '').trim());
  });
  if (missingMedia) { alert('Configure a mídia do bloco "' + NODE_TYPES[missingMedia.type].label + '" antes de salvar.'); return; }
	const credentialNodeTypes = ['ai', 'conversationSummary', 'mediaTranscription'];
	const missingCredential = state.flowData.nodes.find(node => credentialNodeTypes.includes(node.type) && Number(node.data.credentialId) <= 0);
	if (missingCredential) { alert('Selecione uma credencial de IA no bloco "' + NODE_TYPES[missingCredential.type].label + '" antes de salvar.'); return; }

  const payload = {
    name: f.name,
    description: f.description || '',
    connectionId: f.connectionId || null,
    triggerType: f.triggerType || 'keyword',
    triggerValue: f.triggerValue || '',
	  flowData: state.flowData,
	  isActive: !!f.isActive,
	  priority: Number(f.priority || 0),
	  revision: Number(f.revision || 0),
  };
	const submittedFingerprint = flowFingerprint();
	try {
		state.saving = true;
		const saveButton = document.getElementById('btn-save');
		if (saveButton) saveButton.disabled = true;
    let savedFlow;
    if (f.id) {
      savedFlow = await api('PUT', '/flows/api/' + f.id, payload);
    } else {
      savedFlow = await api('POST', '/flows/api/', payload);
    }
		if (flowFingerprint() === submittedFingerprint) {
		  Object.assign(f, savedFlow);
		  state.savedFingerprint = flowFingerprint();
		} else {
		  f.id = savedFlow.id;
		  f.revision = savedFlow.revision;
		  f.createdAt = savedFlow.createdAt;
		  f.updatedAt = savedFlow.updatedAt;
		  state.savedFingerprint = submittedFingerprint;
		}
    flashSaved();
    loadFlowsList().catch(e => console.error('erro ao atualizar lista após salvar', e));
	} catch (e) {
    console.error('erro ao salvar fluxo', e);
    alert('Não deu pra salvar: ' + e.message);
	} finally {
		state.saving = false;
		const saveButton = document.getElementById('btn-save');
		if (saveButton) saveButton.disabled = false;
	}
}

function flashSaved() {
  ['btn-save', 'mobile-btn-save'].forEach(id => {
    const btn = document.getElementById(id);
    if (!btn) return;
    const original = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-check"><\/i> Salvo';
    setTimeout(() => { btn.innerHTML = original; }, 1200);
  });
}

async function testFlow() {
  const f = state.currentFlow;
  if (!f.id) { alert('Salve o fluxo antes de testar.'); return; }
  const conversationId = prompt('ID da conversa (numérico) pra rodar esse fluxo de teste:');
  if (!conversationId) return;
  try {
    await api('POST', '/flows/api/' + f.id + '/execute', { conversationId: Number(conversationId), context: {} });
    alert('Fluxo enfileirado para execução nessa conversa.');
  } catch (e) {
    alert('Erro ao testar: ' + e.message);
  }
}

// ---------------------------------------------------------------------
// Top bar (editor mode)
// ---------------------------------------------------------------------
function renderTopbarExtra() {
  const el = document.getElementById('editor-topbar-extra');
  if (!state.currentFlow) { el.innerHTML = ''; return; }
  const f = state.currentFlow;

	const connOptions = [{ value: '', label: 'Todas as conexões' }]
    .concat(state.connections.map(c => ({ value: String(c.id), label: c.name, dot: c.status === 'connected' ? '#22c55e' : '#a8a29e' })));
  const triggerOptions = [
    { value: 'keyword', label: 'Palavra-chave' },
    { value: 'exact', label: 'Mensagem exata' },
    { value: 'always', label: 'Sempre responde' },
  ];

  el.innerHTML = `
    <input id="inp-name" value="${escapeAttr(f.name)}" placeholder="Nome da automação" aria-label="Nome da automação"
      class="px-3 py-2 rounded-xl text-sm bg-white bg-opacity-90 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-white w-48 shadow-sm">
    <button id="btn-editor-more" type="button" class="h-10 w-10 shrink-0 place-items-center rounded-xl bg-white bg-opacity-20 text-white" aria-expanded="false" aria-controls="editor-topbar-more" aria-label="Mais opções da automação"><i class="fas fa-ellipsis-vertical"><\/i><\/button>
    <div id="editor-topbar-more">
    ${customSelectHTML('connection', connOptions, f.connectionId || '', 'Selecione a conexão')}
    ${customSelectHTML('trigger-type', triggerOptions, f.triggerType || 'keyword', 'Tipo de gatilho')}
	<input id="inp-trigger-value" value="${escapeAttr(f.triggerValue||'')}" placeholder="ex: orçamento"
      class="px-3 py-2 rounded-xl text-sm bg-white bg-opacity-90 text-gray-900 placeholder-gray-400 focus:outline-none w-32 shadow-sm ${f.triggerType==='always'?'hidden':''}">
	<input id="inp-priority" type="number" min="-1000" max="1000" value="${Number(f.priority || 0)}" title="Prioridade do gatilho" class="w-20 px-3 py-2 rounded-xl text-sm bg-white bg-opacity-90 text-gray-900 focus:outline-none shadow-sm">
    <label class="flex items-center gap-1.5 text-white text-sm px-2">
      <input id="chk-active" type="checkbox" ${f.isActive?'checked':''}> Ativo
    <\/label>
    <button id="btn-test" class="px-3 py-1.5 rounded-lg text-sm font-medium text-white bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors">
      <i class="fas fa-vial mr-1"><\/i>Testar
    <\/button>
	<button id="btn-flow-settings" class="px-3 py-1.5 rounded-lg text-sm font-medium text-white bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors" title="Configurar tratamento quando o cliente não responder">
	  <i class="fas fa-user-clock mr-1"><\/i>Sem resposta
	<\/button>
	<button id="btn-export-flow" class="px-3 py-1.5 rounded-lg text-sm font-medium text-white bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors" title="Exportar este fluxo em JSON" aria-label="Exportar este fluxo em JSON">
	  <i class="fas fa-file-export 2xl:mr-1"><\/i><span class="hidden 2xl:inline">Exportar<\/span>
	<\/button>
	<a href="/settings#settings-ai-credentials" class="px-3 py-1.5 rounded-lg text-sm font-medium text-white bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors" title="Configurar chaves de IA">
      <i class="fas fa-key mr-1"><\/i>Chaves IA
    <\/a>
    <button id="btn-save" class="px-4 py-1.5 rounded-lg text-sm font-bold text-purple-700 bg-white hover:bg-purple-50 transition-colors shadow-sm">
      <i class="fas fa-save mr-1"><\/i>Salvar
    <\/button>
    <\/div>
    <button id="btn-close-editor" aria-label="Fechar editor" class="p-2 hover:bg-white hover:bg-opacity-20 rounded-lg text-white transition-colors">
      <i class="fas fa-times"><\/i>
    <\/button>
  `;
  document.getElementById('inp-name').oninput = e => { f.name = e.target.value; };

  el.querySelector('[data-dd-role="connection"]').querySelectorAll('input[type=radio]').forEach(r => {
    r.addEventListener('change', () => {
      f.connectionId = r.value ? Number(r.value) : null;
	  closeDropdown(r);
	  // The custom selector renders its selected label from the initial value.
	  // Rebuild the top bar so the label reflects this new connection immediately.
	  renderTopbarExtra();
    });
  });
  el.querySelector('[data-dd-role="trigger-type"]').querySelectorAll('input[type=radio]').forEach(r => {
    r.addEventListener('change', () => {
      f.triggerType = r.value;
      document.getElementById('inp-trigger-value').classList.toggle('hidden', f.triggerType === 'always');
      closeDropdown(r);
	  renderTopbarExtra();
    });
  });

	document.getElementById('inp-trigger-value').oninput = e => { f.triggerValue = e.target.value; };
	document.getElementById('inp-priority').oninput = e => { f.priority = Number(e.target.value || 0); };
  document.getElementById('chk-active').onchange = e => { f.isActive = e.target.checked; };
  document.getElementById('btn-test').onclick = testFlow;
  document.getElementById('btn-flow-settings').onclick = openNoResponseSettings;
  document.getElementById('btn-export-flow').onclick = () => openFlowExport(f, state.flowData);
  document.getElementById('btn-save').onclick = saveFlow;
  document.getElementById('btn-close-editor').onclick = closeEditor;
  const more = document.getElementById('editor-topbar-more'), moreToggle = document.getElementById('btn-editor-more');
  if (state.topbarMoreOpen) { more.classList.add('open'); moreToggle.setAttribute('aria-expanded', 'true'); }
  moreToggle.onclick = () => { state.topbarMoreOpen = !more.classList.contains('open'); more.classList.toggle('open', state.topbarMoreOpen); moreToggle.setAttribute('aria-expanded', String(state.topbarMoreOpen)); };
}

function closeDropdown(radio) {
  const wrapper = radio.closest('[data-dd-name]');
  if (wrapper) hideFlowDropdown(wrapper);
}

let noResponseDraft = null;

function openNoResponseSettings() {
  const saved = state.flowData.settings?.noResponse || {};
  noResponseDraft = {
	enabled: !!saved.enabled,
	reminderMinutes: Number(saved.reminderMinutes || 30),
	reminderMessage: saved.reminderMessage || 'Ainda está por aí? Precisamos da sua resposta para continuar o atendimento.',
	targetType: saved.targetType === 'department' ? 'department' : 'agent',
	targetId: Number(saved.targetId || 0),
  };
  document.getElementById('no-response-enabled').checked = noResponseDraft.enabled;
  document.getElementById('no-response-minutes').value = noResponseDraft.reminderMinutes;
  document.getElementById('no-response-message').value = noResponseDraft.reminderMessage;
  renderNoResponseTargets();
  setNoResponseFieldsEnabled(noResponseDraft.enabled);
  const modal = document.getElementById('no-response-modal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
}

function closeNoResponseSettings() {
	document.querySelectorAll('#no-response-modal [data-dd-name]').forEach(hideFlowDropdown);
  const modal = document.getElementById('no-response-modal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  noResponseDraft = null;
}

function setNoResponseFieldsEnabled(enabled) {
  const fields = document.getElementById('no-response-fields');
  fields.classList.toggle('pointer-events-none', !enabled);
  fields.classList.toggle('opacity-50', !enabled);
  fields.querySelectorAll('input, textarea').forEach(input => { input.disabled = !enabled; });
}

function renderNoResponseTargets() {
  const typeOptions = [{ value: 'agent', label: 'Agente' }, { value: 'department', label: 'Setor' }];
  const destinationOptions = noResponseDraft.targetType === 'department' ? state.departments : state.agents;
  document.getElementById('no-response-target-label').textContent = noResponseDraft.targetType === 'department' ? 'Setor' : 'Agente';
  document.getElementById('no-response-target-type').innerHTML = customSelectHTML('no-response-target-type', typeOptions, noResponseDraft.targetType, 'Selecione', 'targetType');
  document.getElementById('no-response-target').innerHTML = customSelectHTML('no-response-target',
	[{ value: '', label: 'Selecione' }].concat(destinationOptions.map(option => ({ value: String(option.id), label: option.name }))),
	noResponseDraft.targetId || '', 'Selecione', 'targetId');

  document.querySelector('#no-response-target-type [data-dd-role="no-response-target-type"]').querySelectorAll('input[type=radio]').forEach(radio => {
	radio.addEventListener('change', () => {
	  noResponseDraft.targetType = radio.value;
	  noResponseDraft.targetId = 0;
	  renderNoResponseTargets();
	  setNoResponseFieldsEnabled(noResponseDraft.enabled);
	});
  });
  document.querySelector('#no-response-target [data-dd-role="no-response-target"]').querySelectorAll('input[type=radio]').forEach(radio => {
	radio.addEventListener('change', () => {
	  noResponseDraft.targetId = radio.value ? Number(radio.value) : 0;
	  closeDropdown(radio);
	});
  });
}

// ---------------------------------------------------------------------
// Palette
// ---------------------------------------------------------------------
function renderPalette() {
  const el = document.getElementById('palette');
  el.innerHTML = CATEGORIES.map(cat => {
    const items = Object.entries(NODE_TYPES).filter(([,m]) => m.category === cat && !m.hidden);
    return `
      <div class="mb-4">
        <div class="palette-category-title text-xs font-bold text-gray-400 uppercase tracking-wide mb-2 px-1">${cat}<\/div>
        <div class="palette-grid grid grid-cols-2 gap-2">
          ${items.map(([type, meta]) => `
            <button type="button" data-add="${type}" title="${meta.label}" aria-label="Adicionar ${meta.label}" class="palette-item flex flex-col items-center justify-center gap-2 rounded-xl border border-stone-200 p-2 text-center transition-all hover:-translate-y-0.5 hover:border-purple-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400"
              style="background: color-mix(in srgb, ${meta.color} 8%, white);">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-lg" style="background:${meta.color}22;">
                <i class="fas ${meta.icon}" aria-hidden="true" style="color:${meta.color};"><\/i>
              <\/span>
              <span class="palette-item-label max-w-full break-words text-[11px] font-semibold leading-tight text-gray-700">${meta.label}<\/span>
            <\/button>`).join('')}
        <\/div>
      <\/div>`;
  }).join('');
  el.querySelectorAll('[data-add]').forEach(btn => btn.onclick = () => addNode(btn.dataset.add));
}

function defaultDataFor(type) {
  switch (type) {
    case 'sendMenu': return {
      title: 'Menu', description: '', buttonText: 'Ver Menu', footerText: 'DoveChat', useFallback: false,
	  allowBackPrevious: false, allowBackMain: false,
      sections: [{ title: 'Opções', rows: [{ title: 'Opção 1', description: '', rowId: 'opcao_1', _handleId: uid('mh') }] }],
    };
	case 'sendButtons': return { title: '', description: '', footer: '', useFallback: false,
	  buttons: [{ text: 'Opção 1', id: 'opcao_1', _handleId: uid('bh') }] };
	case 'switch': return { message: '', cases: [{ label: 'Opção 1', condition: '' }] };
    case 'condition': return { conditionSource: 'contactMessage', conditionOperator: 'equals', conditionValue: '' };
    case 'delay': return { delayType: 'fixed', seconds: 2 };
    case 'sendImage': return { imageUrl: '', imagePath: '', imageMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'sendVideo': return { videoUrl: '', videoPath: '', videoMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'sendAudio': return { audioUrl: '', audioPath: '', audioMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'sendFile': return { fileUrl: '', filePath: '', fileMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'assign': return { assignType: 'agent' };
    case 'setVariable': return { variableName: '', value: '' };
    case 'tag': return { operation: 'add', tag: '' };
    case 'updateContact': return { field: 'name', value: '' };
    case 'setContactField': return { fieldKey: '', fieldType: 'text', value: '' };
    case 'businessHours': return { timezone: 'America/Sao_Paulo', days: [1,2,3,4,5], startTime: '08:00', endTime: '18:00', lunchEnabled: false, lunchStart: '12:00', lunchEnd: '13:00' };
    case 'randomSplit': return { percentage: 50 };
	case 'input': return { variableName: 'userInput', validationType: 'any' };
	case 'smartAssign': return { strategy: 'leastLoaded' };
	case 'addNote': return { eventType: 'note', content: '' };
	case 'callback': return { eventName: 'flow.event', url: '', timeout: 10000, followRedirects: false };
	case 'subflow': return {};
	case 'sendTemplate': return {};
	case 'ai': return { credentialId: '', systemPrompt: '', knowledgeBase: '', prompt: '', saveResponseTo: 'aiResponse', safeMode: true };
	case 'mediaTranscription': return { credentialId: '', prompt: '', saveResponseTo: 'mediaText', safeMode: true };
	case 'conversationSummary': return { credentialId: '', maxMessages: 30, instructions: '', saveResponseTo: 'conversationSummary', persist: true, safeMode: true };
	case 'aiAgent': return { safeMode: true };
	case 'aiKnowledge': return { content: '' };
	case 'aiTools': return { actions: [defaultAIAction('transfer')] };
	case 'npsEvaluation': return { message: 'De 0 a 10, o quanto você recomendaria nosso atendimento?', saveScoreTo: 'npsScore', timeout: 86400 };
	case 'scheduleMessage': return { message: '', delayMinutes: 60 };
    case 'httpRequest': return {
      method: 'POST', headerMode: 'none', headerFields: [],
	  bodyMode: 'none', bodyFields: [], responseMappings: [], timeout: 60000, connectTimeout: 10000, routeByStatus: true,
    };
    default: return {};
  }
}

// ---------------------------------------------------------------------
// Canvas / nodes / edges rendering
// ---------------------------------------------------------------------
function nodeHeight(node) {
  if (node.type === 'sendMenu' || node.type === 'sendButtons') {
    return 103 + outputsFor(node).length * 28;
  }
	const outputCount = outputsFor(node).length;
	let baseHeight = 90;
	if (node.type === 'switch') baseHeight = 56 + outputCount * 26;
	if (node.type === 'condition') baseHeight = 130;
	if (node.type === 'messageType') baseHeight = 212;
	if (node.type === 'smartAssign') baseHeight = 112;
	if (outputCount > 1) baseHeight = Math.max(baseHeight, 70 + (outputCount - 1) * 32);
	return baseHeight;
}

// Returns [{handle, label}] for a node's outgoing connection points.
function outputsFor(node) {
	if (node.type === 'condition' || node.type === 'checkResponse') {
		if (node.type === 'checkResponse') return [{ handle: 'true', label: 'Respondeu' }, { handle: 'false', label: 'Não respondeu' }];
    const labels = CONDITION_OUTPUT_LABELS[(node.data || {}).conditionOperator] || ['Verdadeiro', 'Falso'];
    return [{ handle: 'true', label: labels[0] }, { handle: 'false', label: labels[1] }];
  }
	if (node.type === 'businessHours') return [{ handle: 'true', label: 'Dentro do horário' }, { handle: 'false', label: 'Fora do horário' }];
	if (node.type === 'randomSplit') return [{ handle: 'a', label: 'Grupo A' }, { handle: 'b', label: 'Grupo B' }];
	if (node.type === 'waitForResponse') {
		return [{ handle: 'replied', label: 'Respondeu' }, { handle: 'timeout', label: 'Timeout' }];
	}
	if (node.type === 'input') return [{ handle: 'valid', label: 'Válida' }, { handle: 'invalid', label: 'Inválida' }, { handle: 'timeout', label: 'Timeout' }];
	if (node.type === 'messageType') return [
	  { handle: 'text', label: 'Texto' }, { handle: 'image', label: 'Imagem' }, { handle: 'video', label: 'Vídeo' },
	  { handle: 'audio', label: 'Áudio' }, { handle: 'document', label: 'Documento' }, { handle: 'other', label: 'Outro' },
	];
	if (node.type === 'smartAssign') return [{ handle: 'assigned', label: 'Atribuído' }, { handle: 'unavailable', label: 'Indisponível' }];
	if (node.type === 'callback') return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'subflow') return [{ handle: 'success', label: 'Concluído' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'ai') return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'mediaTranscription') return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'httpRequest') {
	  return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	}
	if (node.type === 'conversationSummary') return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'npsEvaluation') return [
	  { handle: 'promoter', label: 'Promotor (9-10)' }, { handle: 'passive', label: 'Neutro (7-8)' },
	  { handle: 'detractor', label: 'Detrator (0-6)' }, { handle: 'invalid', label: 'Inválida' }, { handle: 'timeout', label: 'Timeout' },
	];
	if (node.type === 'scheduleMessage') return [{ handle: 'scheduled', label: 'Agendada' }, { handle: 'failure', label: 'Falha' }];
  if (node.type === 'sendMenu') {
    const out = [];
    const fallbackEdges = state.flowData.edges.filter(edge => edge.source === node.id && (edge.sourceHandle === 'fallback' || !edge.sourceHandle));
    if (node.data.useFallback === undefined) node.data.useFallback = fallbackEdges.length > 0;
    if (node.data.useFallback) fallbackEdges.forEach(edge => { edge.sourceHandle = 'fallback'; });
    else if (fallbackEdges.length) state.flowData.edges = state.flowData.edges.filter(edge => !fallbackEdges.includes(edge));
    (node.data.sections || []).forEach(section => (section.rows || []).forEach(row => {
      if (!row._handleId) {
        const legacyHandle = 'menu-' + row.rowId;
        row._handleId = state.flowData.edges.some(edge => edge.source === node.id && edge.sourceHandle === legacyHandle) ? row.rowId : uid('mh');
      }
      out.push({ handle: 'menu-' + row._handleId, label: row.title || row.rowId || 'Opção' });
    }));
    if (node.data.useFallback) out.push({ handle: 'fallback', label: 'Caminho padrão' });
    return out;
  }
  if (node.type === 'sendButtons') {
    const out = (node.data.buttons || []).map(button => ({ handle: 'button-' + button._handleId, label: button.text || button.id || 'Botão' }));
    if (node.data.useFallback) out.push({ handle: 'fallback', label: 'Caminho padrão' });
    return out;
  }
  if (node.type === 'switch') {
    const cases = (node.data.cases || []);
    const out = cases.map((c, i) => ({ handle: 'case-' + i, label: c.label || ('Opção ' + (i + 1)) }));
    out.push({ handle: 'fallback', label: 'Nenhuma opção' });
    return out;
  }
	if (node.type === 'end' || node.type === 'aiAgent' || isSubNode(node)) return [];
  return [{ handle: '', label: '' }];
}

function nodeSummary(node) {
  const d = node.data || {};
  switch (node.type) {
    case 'sendText': return d.message ? truncate(d.message, 60) : 'Sem mensagem configurada';
    case 'sendImage': return d.mediaName || (d.imageUrl ? truncate(d.imageUrl, 40) : 'Sem imagem configurada');
    case 'sendVideo': return d.mediaName || (d.videoUrl ? truncate(d.videoUrl, 40) : 'Sem vídeo configurado');
    case 'sendAudio': return d.mediaName || (d.audioUrl ? truncate(d.audioUrl, 40) : 'Sem áudio configurado');
    case 'sendFile': return d.mediaName || (d.fileUrl ? truncate(d.fileUrl, 40) : 'Sem arquivo configurado');
    case 'sendMenu': return [d.title, d.description].filter(Boolean).join(' — ') || 'Sem mensagem configurada';
    case 'sendButtons': return [d.title, d.description].filter(Boolean).join(' — ') || 'Sem mensagem configurada';
	case 'sendTemplate': {
	  const selected = state.templates.find(template => template.id === Number(d.templateId));
	  return selected ? selected.name : 'Sem modelo selecionado';
	}
    case 'condition': {
      if (!d.conditionSource || d.conditionSource === 'legacy') return d.condition ? truncate(d.condition, 60) : 'Sem condição configurada';
      const source = CONDITION_SOURCES.find(option => option.value === d.conditionSource)?.label || d.conditionSource;
      const operator = CONDITION_OPERATORS.find(option => option.value === d.conditionOperator)?.label || d.conditionOperator || '';
      const value = d.conditionSource === 'variable' ? (d.conditionVariable || 'variável') : d.conditionValue;
      return truncate([source, operator, value].filter(Boolean).join(' · '), 60);
    }
    case 'switch': return (d.cases || []).length + ' opção(ões)';
    case 'delay': return d.delayType === 'range' ? (d.minSeconds||0) + 's - ' + (d.maxSeconds||0) + 's' : (d.seconds||0) + 's';
    case 'changeStatus': return d.status ? ('→ ' + d.status) : 'Sem status definido';
    case 'assign': {
      const options = d.assignType === 'department' ? state.departments : state.agents;
      const selected = options.find(option => option.id === Number(d.assignId));
      return selected ? ((d.assignType === 'department' ? 'Setor: ' : 'Agente: ') + selected.name) : 'Sem destino definido';
    }
    case 'httpRequest': return d.url ? truncate((d.method||'POST') + ' ' + d.url, 50) : 'Sem URL configurada';
    case 'input': return d.variableName ? ('Salva em: ' + d.variableName) : 'Captura resposta livre';
    case 'waitForResponse': return d.timeout ? ('Timeout: ' + d.timeout + 's') : 'Sem timeout';
    case 'checkResponse': return d.saveResponseTo ? ('Salva em: ' + d.saveResponseTo) : '';
	case 'setVariable': return d.variableName ? (d.variableName + ' = ' + truncate(d.value || '', 35)) : 'Sem variável definida';
	case 'tag': return (d.operation === 'remove' ? 'Remover: ' : 'Adicionar: ') + (d.tag || 'sem tag');
	case 'updateContact': return (d.field === 'email' ? 'Email: ' : 'Nome: ') + (d.value || 'sem valor');
	case 'setContactField': return d.fieldKey ? (d.fieldKey + ' = ' + truncate(d.value || '', 35)) : 'Sem campo definido';
	case 'businessHours': return (d.startTime || '08:00') + ' - ' + (d.endTime || '18:00');
	case 'randomSplit': return (d.percentage || 50) + '% no grupo A';
	case 'messageType': return 'Roteia conforme a mídia recebida';
	case 'smartAssign': return d.strategy === 'random' ? 'Agente aleatório' : 'Agente com menor carga';
	case 'addNote': return d.content ? truncate(d.content, 55) : 'Sem conteúdo';
	case 'callback': return d.url ? truncate((d.eventName || 'evento') + ' → ' + d.url, 55) : 'Sem URL configurada';
	case 'subflow': {
	  const selected = state.flows.find(flow => flow.id === Number(d.flowId));
	  return selected ? selected.name : 'Sem subfluxo selecionado';
	}
	case 'ai': { const credential = state.aiCredentials.find(item => item.id === Number(d.credentialId)); return credential ? (credential.name + ' · resposta em: ' + (d.saveResponseTo || 'sem variável')) : 'Sem credencial selecionada'; }
	case 'conversationSummary': {
	  const credential = state.aiCredentials.find(item => item.id === Number(d.credentialId));
	  return credential ? (credential.name + ' · resumo em: ' + (d.saveResponseTo || 'sem variável')) : 'Sem credencial selecionada';
	}
	case 'mediaTranscription': {
	  const credential = state.aiCredentials.find(item => item.id === Number(d.credentialId));
	  return credential ? (credential.name + ' · resultado em: ' + (d.saveResponseTo || 'sem variável')) : 'Sem credencial selecionada';
	}
	case 'aiAgent': {
	  const selected = state.aiAgents.find(agent => agent.id === Number(d.aiAgentId));
	  return selected ? selected.name : 'Sem agente selecionado';
	}
	case 'aiKnowledge': return d.content ? truncate(d.content, 70) : 'Sem conteúdo';
	case 'aiTools': {
	  const actions = d.actions || [];
	  return actions.length ? actions.length + (actions.length === 1 ? ' ação: ' : ' ações: ') + truncate(actions.map(action => action.name || 'sem nome').join(', '), 50) : 'Nenhuma ação';
	}
	case 'scheduleMessage': return d.delayMinutes ? ('Enviar em ' + d.delayMinutes + ' min') : 'Sem prazo definido';
	case 'npsEvaluation': return d.saveScoreTo ? ('Nota em: ' + d.saveScoreTo) : 'Sem variável definida';
    case 'start': return d.businessHours && d.businessHours.enabled ? 'Horário de atendimento ativo' : 'Início do fluxo';
    default: return '';
  }
}

function truncate(s, n) { s = String(s); return s.length > n ? s.slice(0, n) + '…' : s; }

function nodeBodyHTML(node, outs) {
  if (node.type === 'sendMenu' || node.type === 'sendButtons') {
    const title = node.data.title || 'Sem título';
    const message = node.data.description || 'Sem mensagem configurada';
    return '<div class="px-3 py-2 text-xs leading-snug overflow-hidden" style="height:52px">' +
      '<div class="font-semibold text-gray-700 truncate">' + escapeHtml(title) + '<\/div>' +
      '<div class="text-gray-500 mt-0.5 line-clamp-2">' + escapeHtml(message) + '<\/div>' +
    '<\/div>' +
    '<div class="px-3 pb-2 text-[10px] text-gray-400 flex flex-col">' +
      outs.map(o => '<div class="truncate flex items-center" style="height:28px">↳ ' + escapeHtml(o.label) + '<\/div>').join('') +
    '<\/div>';
  }
  if (node.type === 'condition') {
    return '<div class="px-3 py-2 text-xs text-gray-500 leading-snug line-clamp-3" style="height:89px;padding-right:108px">' + escapeHtml(nodeSummary(node)) + '<\/div>';
  }
	const bodyHeight = Math.max(36, nodeHeight(node) - 43);
	const gutter = handleLabelGutter(node, outs);
	return '<div class="px-3 py-2 text-xs text-gray-500 leading-snug overflow-hidden break-words" style="height:' + bodyHeight + 'px;' + (gutter ? 'padding-right:' + gutter + 'px;' : '') + 'overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:' + Math.max(2, Math.floor((bodyHeight - 16) * 0.055)) + '">' + escapeHtml(nodeSummary(node)) + '<\/div>';
}

// Every block with more than one exit names them next to the handle, except
// menus and buttons, whose rows already sit beside their handles.
function showsHandleLabels(node, outs) {
	return outs.length > 1 && node.type !== 'sendMenu' && node.type !== 'sendButtons' && outs.some(output => output.label);
}

// Room kept on the right of the block body so the summary text does not run
// under the exit labels.
function handleLabelGutter(node, outs) {
	if (!showsHandleLabels(node, outs)) return 0;
	return Math.min(110, 26 + Math.max(...outs.map(output => String(output.label || '').length)) * 6);
}

function outputY(node, index, count) {
  if (node.type === 'sendMenu' || node.type === 'sendButtons') return 108 + index * 28;
  const h = nodeHeight(node);
	if (count === 1) return h / 2;
	const topPadding = 48;
	const bottomPadding = 24;
	const spacing = Math.min(32, (h - topPadding - bottomPadding) / Math.max(1, count - 1));
	const groupHeight = spacing * (count - 1);
	const center = (topPadding + h - bottomPadding) / 2;
	return center - groupHeight / 2 + index * spacing;
}

function renderCanvas() {
	resizeCanvasToContent();
  const layer = document.getElementById('nodes-layer');
  layer.innerHTML = '';
  for (const node of state.flowData.nodes) {
    const meta = NODE_TYPES[node.type] || { label: node.type, icon: 'fa-question', color: '#78716c' };
    const h = nodeHeight(node);
    const outs = outputsFor(node);
    const card = document.createElement('div');
    card.className = 'node-card bg-white rounded-xl shadow-sm border border-stone-200' + (state.selectedNodeId === node.id ? ' selected' : '');
    card.style.left = node.position.x + 'px';
    card.style.top = node.position.y + 'px';
    card.style.height = h + 'px';
    card.dataset.nodeId = node.id;

    card.innerHTML = `
      <div class="flex items-center gap-2 px-3 py-2 border-b border-stone-100 rounded-t-xl" style="background:${meta.color}14;">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:${meta.color}22;">
          <i class="fas ${meta.icon} text-xs" style="color:${meta.color};"><\/i>
        <\/span>
        <span class="text-xs font-bold text-gray-700 flex-1 truncate">${meta.label}<\/span>
        ${node.type !== 'start' ? '<button type="button" data-del-node="' + node.id + '" class="text-gray-300 hover:text-red-500 transition-colors" aria-label="Remover bloco"><i class="fas fa-times text-xs"><\/i><\/button>' : ''}
      <\/div>
      ${nodeBodyHTML(node, outs)}
    `;

    if (meta.subNode) {
      // Sub-blocks hang under the AI agent: their single input sits on top.
      const inHandle = document.createElement('div');
      inHandle.className = 'handle sub-handle';
      inHandle.style.left = (NODE_W / 2 - 6) + 'px';
      inHandle.style.top = '-6px';
      inHandle.title = 'Conecte ao Agente IA';
      inHandle.onclick = (e) => { e.stopPropagation(); completeConnection(node.id); };
      card.appendChild(inHandle);
    } else if (!meta.noInput) {
      const inHandle = document.createElement('div');
      inHandle.className = 'handle';
      inHandle.style.left = '-7px';
      inHandle.style.top = (h / 2 - 7) + 'px';
      inHandle.onclick = (e) => { e.stopPropagation(); completeConnection(node.id); };
      card.appendChild(inHandle);
    }

    const ports = subPortsFor(node);
    ports.forEach((port, i) => {
      const connected = state.flowData.edges.some(edge => edge.source === node.id && edge.sourceHandle === port.handle);
      const wrap = document.createElement('div');
      wrap.className = 'sub-port';
      wrap.style.left = subPortX(i, ports.length) + 'px';
      if (port.link) {
        const link = document.createElement('button');
        link.type = 'button';
        link.className = 'sub-port-label connected';
        link.dataset.subPortLabel = port.handle;
        link.title = 'Editar a base de conhecimento do agente em Agentes IA';
        link.innerHTML = '<i class="fas ' + port.icon + ' text-[8px]"><\/i>' + escapeHtml(port.label);
        link.onclick = (e) => { e.preventDefault(); e.stopPropagation(); openAgentKnowledge(node); };
        wrap.appendChild(link);
        card.appendChild(wrap);
        return;
      }
      const handle = document.createElement('div');
      handle.className = 'handle sub-handle' + (state.armedHandle && state.armedHandle.nodeId === node.id && state.armedHandle.handle === port.handle ? ' armed' : '');
      handle.title = port.label;
      handle.dataset.subPort = port.handle;
      handle.onpointerdown = (e) => startConnectionDrag(e, node.id, port.handle);
      const label = document.createElement('button');
      label.type = 'button';
      label.className = 'sub-port-label' + (connected ? ' connected' : '');
      label.dataset.subPortLabel = port.handle;
      label.title = connected ? 'Abrir ' + NODE_TYPES[port.accepts].label : 'Adicionar ' + NODE_TYPES[port.accepts].label;
      label.innerHTML = (connected ? '' : '<i class="fas fa-plus text-[8px]"><\/i>') + escapeHtml(port.label);
      label.onclick = (e) => { e.preventDefault(); e.stopPropagation(); openSubPort(node.id, port.handle); };
      wrap.append(handle, label);
      card.appendChild(wrap);
    });

    outs.forEach((o, i) => {
      const y = outputY(node, i, outs.length);
      const out = document.createElement('div');
      out.className = 'handle' + (state.armedHandle && state.armedHandle.nodeId === node.id && state.armedHandle.handle === o.handle ? ' armed' : '');
      out.style.right = '-7px';
      out.style.top = (y - (node.type === 'sendMenu' || node.type === 'sendButtons' ? 8 : 7)) + 'px';
      out.title = o.label;
	  if (showsHandleLabels(node, outs)) out.innerHTML = '<span class="handle-label">' + escapeHtml(o.label) + '<\/span>';
      out.onpointerdown = (e) => startConnectionDrag(e, node.id, o.handle);
      card.appendChild(out);
    });

    card.onpointerdown = (e) => startDrag(e, node);
	const removeButton = card.querySelector('[data-del-node]');
	if (removeButton) removeButton.onclick = (event) => { event.preventDefault(); event.stopPropagation(); deleteNode(node.id); };
    card.onclick = (e) => {
	  if (e.target.closest('button')) return;
      if (state.armedHandle) return;
      if (state.suppressClick) { state.suppressClick = false; return; }
      selectNode(node.id);
    };
    layer.appendChild(card);
  }
  renderEdges();
  renderMobileSteps();
}

function selectNode(id) {
  state.selectedNodeId = id;
  renderCanvas();
  renderInspector();
}

// Canvas geometry. Node positions are logical (unscaled) pixels; #canvas is
// scaled by state.zoom and #canvas-sizer gives the scroll area its scaled size.
const ZOOM_MIN = 0.1, ZOOM_MAX = 2;
// Blocks sit inside #canvas-origin, offset from the canvas corner, so there is
// room to scroll, zoom and centre in every direction around the flow.
const CANVAS_ORIGIN_X = 1600, CANVAS_ORIGIN_Y = 1200;
const DRAG_THRESHOLD = 4;

function canvasZoom() { return state.zoom || 1; }

function resizeCanvasToContent() {
	const canvas = document.getElementById('canvas');
	const sizer = document.getElementById('canvas-sizer');
	const wrap = document.getElementById('canvas-wrap');
	const svg = document.getElementById('edges-svg');
	if (!canvas || !sizer || !wrap || !svg) return;
	const zoom = canvasZoom();
	const viewW = wrap.clientWidth * (1 / zoom), viewH = wrap.clientHeight * (1 / zoom);
	let maxX = 0, maxY = 0;
	state.flowData.nodes.forEach(node => {
	  maxX = Math.max(maxX, Number(node.position?.x || 0) + NODE_W);
	  maxY = Math.max(maxY, Number(node.position?.y || 0) + nodeHeight(node));
	});
	// Always leave at least a screen of free space past the last block.
	const right = Math.ceil(Math.max(2400, viewW + 600, maxX + Math.max(1200, viewW)));
	const bottom = Math.ceil(Math.max(1800, viewH + 400, maxY + Math.max(900, viewH)));
	const width = CANVAS_ORIGIN_X + right, height = CANVAS_ORIGIN_Y + bottom;
	canvas.style.width = width + 'px';
	canvas.style.height = height + 'px';
	canvas.style.transform = 'scale(' + zoom + ')';
	sizer.style.width = Math.ceil(width * zoom) + 'px';
	sizer.style.height = Math.ceil(height * zoom) + 'px';
	svg.setAttribute('width', right);
	svg.setAttribute('height', bottom);
	wrap.style.backgroundSize = (22 * zoom) + 'px ' + (22 * zoom) + 'px';
	const label = document.getElementById('zoom-level');
	if (label) label.textContent = Math.round(zoom * 100) + '%';
}

// setZoom keeps the canvas point under (clientX, clientY) fixed on screen.
function setZoom(value, clientX, clientY) {
	const wrap = document.getElementById('canvas-wrap');
	const zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, Math.round(value * 100) * 0.01));
	if (!wrap || zoom === canvasZoom()) return;
	const rect = wrap.getBoundingClientRect();
	if (clientX === undefined) { clientX = rect.left + rect.width * 0.5; clientY = rect.top + rect.height * 0.5; }
	const anchor = canvasPoint(clientX, clientY);
	state.zoom = zoom;
	resizeCanvasToContent();
	renderEdges();
	wrap.scrollLeft = (CANVAS_ORIGIN_X + anchor.x) * zoom - (clientX - rect.left);
	wrap.scrollTop = (CANVAS_ORIGIN_Y + anchor.y) * zoom - (clientY - rect.top);
}

function zoomStep(direction) {
	const steps = [0.1, 0.15, 0.25, 0.33, 0.5, 0.67, 0.75, 0.9, 1, 1.1, 1.25, 1.5, 1.75, 2];
	const current = canvasZoom();
	const next = direction > 0 ? steps.find(step => step > current + 0.001) : steps.slice().reverse().find(step => step < current - 0.001);
	if (next) setZoom(next);
}

// fitView frames every block, never enlarging past 100%.
function fitView() {
	const wrap = document.getElementById('canvas-wrap');
	if (!wrap || !state.flowData.nodes.length) return;
	let minX = Infinity, minY = Infinity, maxX = 0, maxY = 0;
	state.flowData.nodes.forEach(node => {
	  minX = Math.min(minX, node.position.x); minY = Math.min(minY, node.position.y);
	  maxX = Math.max(maxX, node.position.x + NODE_W); maxY = Math.max(maxY, node.position.y + nodeHeight(node));
	});
	const margin = 80;
	const zoom = Math.min(1, Math.max(ZOOM_MIN, Math.min((wrap.clientWidth - margin * 2) * (1 / (maxX - minX)), (wrap.clientHeight - margin * 2) * (1 / (maxY - minY)))));
	state.zoom = Math.floor(zoom * 100) * 0.01;
	resizeCanvasToContent();
	renderEdges();
	wrap.scrollLeft = (CANVAS_ORIGIN_X + (minX + maxX) * 0.5) * state.zoom - wrap.clientWidth * 0.5;
	wrap.scrollTop = (CANVAS_ORIGIN_Y + (minY + maxY) * 0.5) * state.zoom - wrap.clientHeight * 0.5;
}

function canvasPoint(clientX, clientY) {
  const rect = document.getElementById('canvas-origin').getBoundingClientRect();
  const zoom = canvasZoom();
  return { x: (clientX - rect.left) * (1 / zoom), y: (clientY - rect.top) * (1 / zoom) };
}

// Scrolls the canvas while a pointer rests near its edge during a drag.
function edgeScroll(wrap, clientX, clientY) {
	const rect = wrap.getBoundingClientRect(), zone = 48, speed = 14;
	const dx = clientX > rect.right - zone ? speed : clientX < rect.left + zone ? -speed : 0;
	const dy = clientY > rect.bottom - zone ? speed : clientY < rect.top + zone ? -speed : 0;
	if (dx) wrap.scrollLeft += dx;
	if (dy) wrap.scrollTop += dy;
	return dx !== 0 || dy !== 0;
}

function startDrag(e, node) {
	if (e.ctrlKey || e.button !== 0 || e.target.closest('.handle, button, input, textarea, select, a')) return;
  state.suppressClick = false;
  const wrap = document.getElementById('canvas-wrap');
  const start = canvasPoint(e.clientX, e.clientY);
  const origX = node.position.x, origY = node.position.y;
  const card = e.currentTarget;
  let last = { x: e.clientX, y: e.clientY }, moved = false, frame = 0;

  function place() {
    const point = canvasPoint(last.x, last.y);
    node.position.x = Math.max(40 - CANVAS_ORIGIN_X, Math.round(origX + point.x - start.x));
    node.position.y = Math.max(40 - CANVAS_ORIGIN_Y, Math.round(origY + point.y - start.y));
    card.style.left = node.position.x + 'px';
    card.style.top = node.position.y + 'px';
    renderEdges();
  }
  function tick() {
    frame = 0;
    if (!moved) return;
    if (edgeScroll(wrap, last.x, last.y)) {
      place();
      resizeCanvasToContent();
      frame = requestAnimationFrame(tick);
    }
  }
  function onMove(ev) {
	if (ev.pointerId !== e.pointerId) return;
    last = { x: ev.clientX, y: ev.clientY };
    if (!moved && Math.hypot(ev.clientX - e.clientX, ev.clientY - e.clientY) < DRAG_THRESHOLD) return;
    if (!moved) { moved = true; card.classList.add('dragging'); }
    place();
    if (!frame) frame = requestAnimationFrame(tick);
  }
  function onUp(ev) {
	if (ev.pointerId !== e.pointerId) return;
    card.classList.remove('dragging');
	if (frame) cancelAnimationFrame(frame);
	card.releasePointerCapture?.(e.pointerId);
	card.removeEventListener('pointermove', onMove);
	card.removeEventListener('pointerup', onUp);
	card.removeEventListener('pointercancel', onUp);
	// A drag is not a click: the properties panel opens only on a click.
	if (moved) { state.suppressClick = true; resizeCanvasToContent(); }
  }
	card.setPointerCapture?.(e.pointerId);
	card.addEventListener('pointermove', onMove);
	card.addEventListener('pointerup', onUp);
	card.addEventListener('pointercancel', onUp);
}

function isCanvasBackground(target) {
	return target && (target.id === 'canvas-wrap' || target.id === 'canvas-sizer' || target.id === 'canvas' || target.id === 'canvas-origin' || target.id === 'nodes-layer' || target.id === 'edges-svg');
}

function initCanvasNavigation() {
	const wrap = document.getElementById('canvas-wrap');
	if (!wrap) return;
	// Dragging the empty background pans (mouse and pen; touch scrolls natively).
	wrap.addEventListener('pointerdown', event => {
	  if (event.button !== 0 || event.pointerType === 'touch') return;
	  if (!event.ctrlKey && !isCanvasBackground(event.target)) return;
	  state.suppressClick = false;
	  event.preventDefault();
	  state.connectionDrag = null;
	  state.canvasPan = { pointerId: event.pointerId, clientX: event.clientX, clientY: event.clientY, left: wrap.scrollLeft, top: wrap.scrollTop, moved: false };
	  wrap.setPointerCapture?.(event.pointerId);
	});
	wrap.addEventListener('pointermove', event => {
	  const pan = state.canvasPan;
	  if (!pan || pan.pointerId !== event.pointerId) return;
	  if (!pan.moved && Math.hypot(event.clientX - pan.clientX, event.clientY - pan.clientY) < DRAG_THRESHOLD) return;
	  if (!pan.moved) { pan.moved = true; wrap.classList.add('canvas-panning'); }
	  wrap.scrollLeft = pan.left - (event.clientX - pan.clientX);
	  wrap.scrollTop = pan.top - (event.clientY - pan.clientY);
	});
	function finishPan(event) {
	  const pan = state.canvasPan;
	  if (!pan || pan.pointerId !== event.pointerId) return;
	  if (pan.moved) state.suppressClick = true;
	  state.canvasPan = null;
	  wrap.classList.remove('canvas-panning');
	}
	wrap.addEventListener('pointerup', finishPan);
	wrap.addEventListener('pointercancel', finishPan);
	// Ctrl/Cmd + wheel (and trackpad pinch, which browsers report the same
	// way) zooms the flow instead of the whole page.
	wrap.addEventListener('wheel', event => {
	  if (!event.ctrlKey && !event.metaKey) return;
	  event.preventDefault();
	  setZoom(canvasZoom() * Math.exp(-event.deltaY * 0.0015), event.clientX, event.clientY);
	}, { passive: false });
	document.querySelectorAll('[data-zoom]').forEach(button => button.addEventListener('click', () => {
	  const action = button.dataset.zoom;
	  if (action === 'in') zoomStep(1); else if (action === 'out') zoomStep(-1); else if (action === 'reset') setZoom(1); else fitView();
	}));
	document.addEventListener('keydown', event => {
	  if (!state.currentFlow || document.getElementById('view-editor').classList.contains('hidden')) return;
	  if (document.querySelector('dialog[open]') || document.querySelector('.flow-dropdown-panel:popover-open')) return;
	  const typing = event.target.closest && event.target.closest('input, textarea, select, [contenteditable="true"]');
	  if ((event.ctrlKey || event.metaKey) && !event.altKey) {
	    if (event.key === '+' || event.key === '=') { event.preventDefault(); zoomStep(1); }
	    else if (event.key === '-' || event.key === '_') { event.preventDefault(); zoomStep(-1); }
	    else if (event.key === '0') { event.preventDefault(); setZoom(1); }
	    return;
	  }
	  if (event.key === 'Escape' && !typing && state.selectedNodeId) { state.selectedNodeId = null; state.armedHandle = null; renderCanvas(); renderInspector(); }
	});
	window.addEventListener('resize', resizeCanvasToContent);
	const panel = document.getElementById('palette-panel'), toggle = document.getElementById('palette-toggle');
	const applyPalette = collapsed => {
	  panel.classList.toggle('palette-collapsed', collapsed);
	  toggle.setAttribute('aria-expanded', String(!collapsed));
	  toggle.title = collapsed ? 'Expandir blocos' : 'Recolher blocos';
	  toggle.querySelector('i').className = collapsed ? 'fas fa-angles-right' : 'fas fa-angles-left';
	  resizeCanvasToContent();
	};
	let collapsed = false;
	try { collapsed = localStorage.getItem('sophus-flow-palette-collapsed') === 'true'; } catch (_) {}
	applyPalette(collapsed);
	toggle.addEventListener('click', () => {
	  collapsed = !panel.classList.contains('palette-collapsed');
	  try { localStorage.setItem('sophus-flow-palette-collapsed', String(collapsed)); } catch (_) {}
	  applyPalette(collapsed);
	});
}

// New blocks appear in the middle of the visible area (left of the open
// properties panel), shifted until they do not cover another block.
function freeNodePosition(type) {
	const wrap = document.getElementById('canvas-wrap');
	const rect = wrap.getBoundingClientRect();
	const inspector = document.getElementById('inspector');
	const panelWidth = window.matchMedia('(min-width: 768px)').matches ? (inspector.offsetWidth || 352) + 24 : 0;
	const center = canvasPoint(rect.left + Math.max(rect.width - panelWidth, NODE_W) * 0.5, rect.top + rect.height * 0.45);
	const height = nodeHeight({ type, data: defaultDataFor(type) });
	let x = Math.max(40 - CANVAS_ORIGIN_X, Math.round(center.x - NODE_W * 0.5)), y = Math.max(40 - CANVAS_ORIGIN_Y, Math.round(center.y - height * 0.5));
	const gap = 32;
	const overlaps = (px, py) => state.flowData.nodes.some(node => px < node.position.x + NODE_W + gap && px + NODE_W + gap > node.position.x
		&& py < node.position.y + nodeHeight(node) + gap && py + height + gap > node.position.y);
	// Search outward from the centre: below, above, then neighbouring columns.
	const rowStep = height + gap, colStep = NODE_W + gap;
	for (let ring = 0; ring < 12 && overlaps(x, y); ring++) {
		const candidates = [[0, ring], [0, -ring], [ring, 0], [-ring, 0], [ring, ring], [-ring, ring], [ring, -ring], [-ring, -ring]];
		const free = candidates.map(([col, row]) => ({ x: x + col * colStep, y: y + row * rowStep })).find(point => !overlaps(point.x, point.y));
		if (free) { x = free.x; y = free.y; break; }
	}
	return { x, y };
}

function addNode(type) {
  const meta = NODE_TYPES[type];
  if (meta.singleton && state.flowData.nodes.some(n => n.type === type)) {
    alert('Só pode existir um node de ' + meta.label + ' no fluxo.');
    return;
  }
	// With an AI agent selected, a sub-block goes straight onto its free port.
	const selected = state.flowData.nodes.find(n => n.id === state.selectedNodeId);
	const port = meta.subNode && subPortsFor(selected).find(item => item.accepts === type);
	if (port && !state.flowData.edges.some(edge => edge.source === selected.id && edge.sourceHandle === port.handle)) {
		openSubPort(selected.id, port.handle);
		return;
	}
  // From the phone step list, the new block is chained to the output it was added from.
  const insert = state.mobileInsert;
  closeMobilePalette();
  const source = insert && state.flowData.nodes.find(n => n.id === insert.source);
  const node = { id: uid('n'), type, position: source ? positionNear(source, insert.handle, type) : freeNodePosition(type), data: defaultDataFor(type) };
  state.flowData.nodes.push(node);
  if (source && canConnect(source.id, insert.handle, node)) {
    state.flowData.edges = state.flowData.edges.filter(e => !(e.source === source.id && (e.sourceHandle || '') === (insert.handle || '')));
    state.flowData.edges.push({ id: uid('e'), source: source.id, target: node.id, sourceHandle: insert.handle });
  }
  state.selectedNodeId = node.id;
  renderCanvas();
  renderInspector();
}

// positionNear keeps blocks added from the phone readable on the desktop
// canvas: right of their source, on the row of the output they hang from.
function positionNear(source, handle, type) {
  const outs = outputsFor(source);
  const index = Math.max(0, outs.findIndex(out => (out.handle || '') === (handle || '')));
  const height = nodeHeight({ type, data: defaultDataFor(type) }), gap = 32;
  const x = source.position.x + NODE_W + 110;
  let y = source.position.y + index * (height + gap);
  const overlaps = py => state.flowData.nodes.some(node => x < node.position.x + NODE_W + gap && x + NODE_W + gap > node.position.x
    && py < node.position.y + nodeHeight(node) + gap && py + height + gap > node.position.y);
  for (let tries = 0; tries < 40 && overlaps(y); tries++) y += height + gap;
  return { x, y };
}

// ---- Phone layout: the flow as a vertical list of steps ----
const mobileFlowQuery = window.matchMedia ? window.matchMedia('(max-width: 767px)') : { matches: false, addEventListener() {} };

function openMobilePalette(source, handle) {
  state.mobileInsert = source ? { source, handle: handle || '' } : null;
  document.getElementById('view-editor').classList.add('mobile-palette-open');
  document.getElementById('palette-mobile-close')?.focus();
}

function closeMobilePalette() {
  state.mobileInsert = null;
  document.getElementById('view-editor')?.classList.remove('mobile-palette-open');
}

function mobileStepOutputs(node) {
  return outputsFor(node).concat(subPortsFor(node).filter(port => !port.link).map(port => ({ handle: port.handle, label: port.label, sub: true })));
}

function renderMobileSteps() {
  const el = document.getElementById('mobile-steps');
  if (!el || !mobileFlowQuery.matches || !state.flowData) return;
  const nodes = state.flowData.nodes, edges = state.flowData.edges;
  const byId = new Map(nodes.map(node => [node.id, node]));
  const steps = new Map();
  const parts = [];
  const wrap = (depth, html) => {
    const level = Math.min(depth, 4);
    const style = level > 0 ? ' style="margin-left:' + ((level - 1) * 14) + 'px;border-left:2px solid #e7e5e4;padding-left:10px;"' : '';
    parts.push('<div class="pb-2"' + style + '>' + html + '<\/div>');
  };
  const addButton = (node, out, depth) => wrap(depth, '<button type="button" data-mobile-add="' + escapeAttr(node.id) + '" data-mobile-handle="' + escapeAttr(out.handle || '') + '"' + (out.sub ? ' data-mobile-sub="1"' : '') + ' class="flex min-h-[44px] w-full items-center justify-center gap-1.5 rounded-xl border-[1.5px] border-dashed border-stone-300 bg-white/60 text-xs font-bold text-stone-500"><i class="fas fa-plus" aria-hidden="true"><\/i>' + (out.sub ? 'Adicionar ' + escapeHtml(out.label) : 'Adicionar bloco') + '<\/button>');
  const visit = (node, depth) => {
    const meta = NODE_TYPES[node.type] || { label: node.type, icon: 'fa-question', color: '#78716c' };
    if (steps.has(node.id)) {
      wrap(depth, '<button type="button" data-mobile-node="' + escapeAttr(node.id) + '" class="flex min-h-[40px] w-full items-center gap-2 rounded-xl bg-purple-50 px-3 text-left text-xs font-bold text-purple-700"><i class="fas fa-rotate-left" aria-hidden="true"><\/i>Volta para: ' + escapeHtml(meta.label) + ' · etapa ' + steps.get(node.id) + '<\/button>');
      return;
    }
    steps.set(node.id, steps.size + 1);
    const selected = state.selectedNodeId === node.id;
    const summary = nodeSummary(node);
    wrap(depth, '<button type="button" data-mobile-node="' + escapeAttr(node.id) + '" aria-label="Editar ' + escapeAttr(meta.label) + '" class="block w-full overflow-hidden rounded-xl border bg-white text-left shadow-sm ' + (selected ? 'border-purple-500 ring-2 ring-purple-200' : 'border-stone-200') + '">' +
      '<span class="flex items-center gap-2 border-b border-stone-100 px-3 py-2" style="background:' + meta.color + '14;"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-lg" style="background:' + meta.color + '22;"><i class="fas ' + meta.icon + ' text-xs" style="color:' + meta.color + ';" aria-hidden="true"><\/i><\/span>' +
      '<span class="min-w-0 flex-1 truncate text-xs font-bold text-gray-700">' + escapeHtml(meta.label) + '<\/span><span class="text-[11px] font-bold text-gray-400">' + steps.get(node.id) + '<\/span><\/span>' +
      '<span class="block px-3 py-2.5 text-[13px] leading-snug ' + (summary ? 'text-gray-600' : 'text-gray-400') + '">' + escapeHtml(summary || 'Toque para configurar') + '<\/span><\/button>');
    const outs = mobileStepOutputs(node);
    if (outs.length === 1 && !outs[0].label) {
      const edge = edges.find(e => e.source === node.id && (e.sourceHandle || '') === (outs[0].handle || ''));
      const next = edge && byId.get(edge.target);
      if (next) visit(next, depth); else addButton(node, outs[0], depth);
      return;
    }
    outs.forEach(out => {
      wrap(depth + 1, '<p class="flex items-center gap-1.5 text-xs font-bold text-stone-600"><i class="fas fa-code-branch text-[10px] text-stone-400" aria-hidden="true"><\/i>' + escapeHtml(out.label) + '<\/p>');
      const edge = edges.find(e => e.source === node.id && (e.sourceHandle || '') === (out.handle || ''));
      const next = edge && byId.get(edge.target);
      if (next) visit(next, depth + 1); else addButton(node, out, depth + 1);
    });
  };
  const start = nodes.find(node => node.type === 'start') || nodes[0];
  if (start) visit(start, 0);
  const loose = nodes.filter(node => !steps.has(node.id) && !isSubNode(node));
  if (loose.length) {
    parts.push('<p class="mb-2 mt-4 text-[10px] font-bold uppercase tracking-[.16em] text-stone-500">Blocos sem conexão<\/p>');
    loose.forEach(node => { if (!steps.has(node.id)) visit(node, 0); });
  }
  parts.push('<button type="button" data-mobile-add="" class="mt-2 flex min-h-[44px] w-full items-center justify-center gap-1.5 rounded-xl text-xs font-bold text-stone-500"><i class="fas fa-plus" aria-hidden="true"><\/i>Bloco sem conexão<\/button>');
  const scroll = el.scrollTop;
  el.innerHTML = parts.join('');
  el.scrollTop = scroll;
}

function initMobileFlowLayout() {
  document.getElementById('mobile-steps').addEventListener('click', event => {
    const nodeButton = event.target.closest('[data-mobile-node]');
    if (nodeButton) { selectNode(nodeButton.dataset.mobileNode); return; }
    const add = event.target.closest('[data-mobile-add]');
    if (!add) return;
    if (add.dataset.mobileSub) { openSubPort(add.dataset.mobileAdd, add.dataset.mobileHandle); return; }
    openMobilePalette(add.dataset.mobileAdd, add.dataset.mobileHandle);
  });
  document.getElementById('palette-mobile-close').onclick = closeMobilePalette;
  document.getElementById('mobile-sheet-backdrop').onclick = () => {
    if (document.getElementById('view-editor').classList.contains('mobile-palette-open')) { closeMobilePalette(); return; }
    state.selectedNodeId = null; renderCanvas(); renderInspector();
  };
  document.getElementById('mobile-btn-test').onclick = testFlow;
  document.getElementById('mobile-btn-save').onclick = saveFlow;
  mobileFlowQuery.addEventListener('change', () => { closeMobilePalette(); if (state.flowData) renderCanvas(); });
}

// openSubPort selects the block attached to an AI agent port, or creates
// and attaches one below the agent when the port is free.
function openSubPort(nodeId, handle) {
	const agent = state.flowData.nodes.find(n => n.id === nodeId);
	const port = subPortFor(nodeId, handle);
	if (!agent || !port) return;
	if (port.link) { openAgentKnowledge(agent); return; }
	state.armedHandle = null;
	const existing = state.flowData.edges.find(edge => edge.source === nodeId && edge.sourceHandle === handle);
	if (existing) { selectNode(existing.target); return; }
	const index = subPortsFor(agent).indexOf(port);
	const position = { x: agent.position.x + (index - (subPortsFor(agent).length - 1) * 0.5) * (NODE_W + 24), y: agent.position.y + nodeHeight(agent) + 90 };
	const node = { id: uid('n'), type: port.accepts, position, data: defaultDataFor(port.accepts) };
	state.flowData.nodes.push(node);
	state.flowData.edges.push({ id: uid('e'), source: nodeId, target: node.id, sourceHandle: handle });
	state.selectedNodeId = node.id;
	renderCanvas();
	renderInspector();
}

// openAgentKnowledge opens the agent's knowledge base in /ai-agents in a new
// tab, so unsaved flow changes stay here.
function openAgentKnowledge(agentNode) {
	const id = Number(agentNode && agentNode.data && agentNode.data.aiAgentId);
	window.open(id > 0 ? '/ai-agents#agent-' + id + '-knowledge' : '/ai-agents', '_blank', 'noopener');
}

function startConnectionDrag(e, nodeId, handle) {
  if (e.button !== undefined && e.button !== 0) return;
  e.preventDefault();
  e.stopPropagation();

  const point = canvasPoint(e.clientX, e.clientY);
  state.armedHandle = { nodeId, handle };
  state.connectionDrag = {
    pointerId: e.pointerId,
    startClientX: e.clientX,
    startClientY: e.clientY,
    x: point.x,
    y: point.y,
    moved: false,
  };
  e.currentTarget.classList.add('armed');

  function onMove(ev) {
    if (!state.connectionDrag || ev.pointerId !== state.connectionDrag.pointerId) return;
    ev.preventDefault();
    const drag = state.connectionDrag;
    const current = canvasPoint(ev.clientX, ev.clientY);
    drag.x = current.x;
    drag.y = current.y;
    drag.moved = drag.moved || Math.hypot(ev.clientX - drag.startClientX, ev.clientY - drag.startClientY) > 4;
    highlightConnectionTarget(ev.clientX, ev.clientY, nodeId, handle);
    renderEdges();
  }

  function finish(ev, cancelled) {
    if (!state.connectionDrag || ev.pointerId !== state.connectionDrag.pointerId) return;
    const drag = state.connectionDrag;
    const targetCard = !cancelled && document.elementFromPoint(ev.clientX, ev.clientY)?.closest('.node-card');
    const targetId = targetCard && targetCard.dataset.nodeId;
    const targetNode = state.flowData.nodes.find(n => n.id === targetId);
    const connectable = canConnect(nodeId, handle, targetNode);

    document.removeEventListener('pointermove', onMove);
    document.removeEventListener('pointerup', onUp);
    document.removeEventListener('pointercancel', onCancel);
    clearConnectionTarget();
    state.connectionDrag = null;

    if (connectable) {
      completeConnection(targetId);
    } else if (!drag.moved && !cancelled && subPortFor(nodeId, handle)) {
      // A click on an AI agent port adds or opens its sub-block.
      openSubPort(nodeId, handle);
    } else if (drag.moved || cancelled) {
      state.armedHandle = null;
      renderCanvas();
    } else {
      renderCanvas();
    }
  }

  function onUp(ev) { finish(ev, false); }
  function onCancel(ev) { finish(ev, true); }

  document.addEventListener('pointermove', onMove, { passive: false });
  document.addEventListener('pointerup', onUp);
  document.addEventListener('pointercancel', onCancel);
  renderEdges();
}

function highlightConnectionTarget(clientX, clientY, sourceNodeId, handle) {
  clearConnectionTarget();
  const card = document.elementFromPoint(clientX, clientY)?.closest('.node-card');
  if (!card || card.dataset.nodeId === sourceNodeId) return;
  const node = state.flowData.nodes.find(n => n.id === card.dataset.nodeId);
  if (canConnect(sourceNodeId, handle, node)) card.classList.add('connection-target');
}

function clearConnectionTarget() {
  document.querySelectorAll('.node-card.connection-target').forEach(card => card.classList.remove('connection-target'));
}

function completeConnection(targetNodeId) {
  if (!state.armedHandle) return;
  if (state.armedHandle.nodeId === targetNodeId) { state.armedHandle = null; renderCanvas(); return; }
  if (!canConnect(state.armedHandle.nodeId, state.armedHandle.handle, state.flowData.nodes.find(n => n.id === targetNodeId))) {
    state.armedHandle = null;
    renderCanvas();
    return;
  }
  state.flowData.edges = state.flowData.edges.filter(e => !(e.source === state.armedHandle.nodeId && (e.sourceHandle || '') === (state.armedHandle.handle || '')));
  state.flowData.edges.push({
    id: uid('e'),
    source: state.armedHandle.nodeId,
    target: targetNodeId,
    sourceHandle: state.armedHandle.handle,
  });
  state.armedHandle = null;
  renderCanvas();
}

document.addEventListener('click', (e) => {
  if (isCanvasBackground(e.target) && state.suppressClick) { state.suppressClick = false; return; }
  if (isCanvasBackground(e.target)) {
    state.armedHandle = null;
    state.selectedNodeId = null;
    renderCanvas();
    renderInspector();
  }
});

async function deleteNode(id) {
  const flow = state.flowData;
  const node = flow.nodes.find(item => item.id === id);
  if (!node) return;
  if (!await window.confirmRemoval('Remover bloco?', 'O bloco "' + (node.data?.label || NODE_TYPES[node.type]?.label || node.type) + '" e suas conexões serão removidos do flow. Salve a automação para aplicar a alteração.')) return;
  if (state.flowData !== flow) return;
  state.flowData.nodes = state.flowData.nodes.filter(n => n.id !== id);
  state.flowData.edges = state.flowData.edges.filter(e => e.source !== id && e.target !== id);
  if (state.selectedNodeId === id) state.selectedNodeId = null;
  renderCanvas();
  renderInspector();
}

function handlePos(node, handle, isOutput) {
  const h = nodeHeight(node);
  if (!isOutput) {
    if (isSubNode(node)) return { x: node.position.x + NODE_W / 2, y: node.position.y, vertical: true };
    return { x: node.position.x, y: node.position.y + h / 2 };
  }
  const ports = subPortsFor(node);
  const portIndex = ports.findIndex(port => port.handle === handle);
  if (portIndex >= 0) return { x: node.position.x + subPortX(portIndex, ports.length), y: node.position.y + h, vertical: true };
  const outs = outputsFor(node);
  const idx = Math.max(0, outs.findIndex(o => o.handle === handle));
  const y = outputY(node, idx, outs.length);
  return { x: node.position.x + NODE_W, y: node.position.y + y };
}

const SVG_NS = 'http://www.w3.org/2000/svg';

// Bezier control points: horizontal links leave right and enter left;
// links from an AI agent port leave downwards and enter sub-blocks on top.
function edgeControlPoints(p1, p2) {
  if (p1.vertical) {
    const dy = Math.max(40, Math.abs(p2.y - p1.y) * 0.5);
    return [{ x: p1.x, y: p1.y + dy }, { x: p2.x, y: p2.y - dy }];
  }
  const dx = Math.max(60, Math.abs(p2.x - p1.x) * 0.5);
  return [{ x: p1.x + dx, y: p1.y }, { x: p2.x - dx, y: p2.y }];
}

async function removeEdge(edgeId) {
  const flow = state.flowData;
  if (!await window.confirmRemoval('Remover conexão?', 'A ligação entre estes blocos será removida. Salve a automação para aplicar a alteração.') || state.flowData !== flow) return;
  state.flowData.edges = state.flowData.edges.filter(edge => edge.id !== edgeId);
  if (state.hoveredEdgeId === edgeId) state.hoveredEdgeId = null;
  renderEdges();
}

function setEdgeActive(group, active) {
  group.classList.toggle('active', active);
  const line = group.querySelector('.edge-line');
  line.setAttribute('stroke', active ? '#6123cc' : '#a8a29e');
  line.setAttribute('stroke-width', active ? 3 : 2);
  line.setAttribute('marker-end', active ? 'url(#arrow-active)' : 'url(#arrow)');
}

function svgElement(tag, attributes) {
  const element = document.createElementNS(SVG_NS, tag);
  for (const name in attributes) element.setAttribute(name, attributes[name]);
  return element;
}

function renderEdges() {
  const svg = document.getElementById('edges-svg');
  svg.querySelectorAll('.edge, .edge-group').forEach(p => p.remove());
  const byId = Object.fromEntries(state.flowData.nodes.map(n => [n.id, n]));
  // Hit areas keep about 18 screen pixels whatever the zoom.
  const hitWidth = Math.max(18, 18 * (1 / canvasZoom()));
  for (const edge of state.flowData.edges) {
    const s = byId[edge.source], t = byId[edge.target];
    if (!s || !t) continue;
    const p1 = handlePos(s, edge.sourceHandle, true);
    const p2 = handlePos(t, edge.targetHandle, false);
    const [c1, c2] = edgeControlPoints(p1, p2);
    const d = 'M ' + p1.x + ' ' + p1.y + ' C ' + c1.x + ' ' + c1.y + ', ' + c2.x + ' ' + c2.y + ', ' + p2.x + ' ' + p2.y;
    const active = state.hoveredEdgeId === edge.id;
    const group = svgElement('g', { class: 'edge-group' + (active ? ' active' : ''), 'data-edge-id': edge.id });
    // Wide transparent stroke: the target the pointer actually has to hit.
    const hit = svgElement('path', { d, class: 'edge-hit', stroke: 'transparent', 'stroke-width': hitWidth, fill: 'none' });
    const line = svgElement('path', { d, class: 'edge-line', stroke: active ? '#6123cc' : '#a8a29e', 'stroke-width': active ? 3 : 2, fill: 'none', 'marker-end': active ? 'url(#arrow-active)' : 'url(#arrow)' });
    // Sub-block links (knowledge, actions) are attachments, not a path the
    // conversation follows: dashed, like the agent's ports.
    if (p1.vertical) line.setAttribute('stroke-dasharray', '6 4');
    // Removal button on the curve's midpoint, shown while the connection is hovered.
    const mid = { x: (p1.x + 3 * c1.x + 3 * c2.x + p2.x) * 0.125, y: (p1.y + 3 * c1.y + 3 * c2.y + p2.y) * 0.125 };
    const remove = svgElement('g', { class: 'edge-remove', transform: 'translate(' + mid.x + ' ' + mid.y + ')', role: 'button', 'aria-label': 'Remover conexão' });
    const title = svgElement('title', {}); title.textContent = 'Remover conexão';
    remove.append(title, svgElement('circle', { r: 11, fill: 'white', stroke: '#6123cc', 'stroke-width': 2 }),
      svgElement('path', { d: 'M -4 -4 L 4 4 M 4 -4 L -4 4', stroke: '#6123cc', 'stroke-width': 2, 'stroke-linecap': 'round' }));
    group.append(hit, line, remove);
    group.addEventListener('pointerenter', () => { if (state.connectionDrag) return; state.hoveredEdgeId = edge.id; setEdgeActive(group, true); });
    group.addEventListener('pointerleave', () => { if (state.hoveredEdgeId === edge.id) state.hoveredEdgeId = null; setEdgeActive(group, false); });
    group.addEventListener('click', event => { event.stopPropagation(); removeEdge(edge.id); });
    svg.appendChild(group);
  }

  if (state.connectionDrag && state.armedHandle) {
    const source = byId[state.armedHandle.nodeId];
    if (!source) return;
    const p1 = handlePos(source, state.armedHandle.handle, true);
    const p2 = { x: state.connectionDrag.x, y: state.connectionDrag.y, vertical: p1.vertical };
    const [c1, c2] = edgeControlPoints(p1, p2);
    const preview = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    preview.setAttribute('d', 'M ' + p1.x + ' ' + p1.y + ' C ' + c1.x + ' ' + c1.y + ', ' + c2.x + ' ' + c2.y + ', ' + p2.x + ' ' + p2.y);
    preview.setAttribute('class', 'edge');
    preview.setAttribute('stroke', '#6123cc');
    preview.setAttribute('stroke-width', '2.5');
    preview.setAttribute('stroke-dasharray', '7 5');
    preview.setAttribute('fill', 'none');
    preview.setAttribute('marker-end', 'url(#arrow)');
    svg.appendChild(preview);
  }
}

// ---------------------------------------------------------------------
// Inspector (right panel) - field editors per node type
// ---------------------------------------------------------------------
function renderInspector() {
  const el = document.getElementById('inspector');
  const node = state.flowData.nodes.find(n => n.id === state.selectedNodeId);
  document.getElementById('view-editor').classList.toggle('mobile-inspector-open', !!node);
  if (!node) { el.classList.add('hidden'); return; }
  el.classList.remove('hidden');
  const meta = NODE_TYPES[node.type];
  el.innerHTML = `
    <div class="flex items-center gap-2 mb-4">
      <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:${meta.color}22;">
        <i class="fas ${meta.icon}" style="color:${meta.color};"><\/i>
      <\/span>
      <h3 class="min-w-0 flex-1 font-bold text-gray-800">${meta.label}<\/h3>
      ${meta.singleton ? '' : '<button type="button" id="inspector-delete" class="mobile-only h-9 w-9 place-items-center rounded-lg text-red-600 hover:bg-red-50" aria-label="Remover bloco"><i class="fas fa-trash"><\/i><\/button>'}
      <button type="button" id="inspector-close" class="rounded-lg p-2 text-gray-500 hover:bg-stone-100" title="Fechar (Esc)" aria-label="Fechar propriedades"><i class="fas fa-xmark"><\/i><\/button>
    <\/div>
    <div id="inspector-fields" class="flex flex-col gap-3"><\/div>
  `;
  el.querySelector('#inspector-close').onclick = () => { state.selectedNodeId = null; renderCanvas(); renderInspector(); };
  const removeButton = el.querySelector('#inspector-delete');
  if (removeButton) removeButton.onclick = () => deleteNode(node.id);
  renderFieldsFor(node);
}

function field(label, inputHtml, hint) {
  return '<div><label class="block text-xs font-medium text-gray-600 mb-1">' + label + '<\/label>' + inputHtml + (hint ? '<p class="text-[11px] text-gray-400 mt-1">' + hint + '<\/p>' : '') + '<\/div>';
}
function textInput(val, name) {
  return '<input data-field="' + name + '" value="' + escapeAttr(val||'') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">';
}
function textArea(val, name, rows) {
  return '<textarea data-field="' + name + '" rows="' + (rows||3) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">' + escapeHtml(val||'') + '<\/textarea>';
}

function availableFlowVariables() {
	const categories = [
	  { id: 'execution', label: 'Execução', icon: 'fa-diagram-project', variables: [
		{ name: 'conversationId', label: 'ID do atendimento' }, { name: 'executionId', label: 'ID da execução' }, { name: 'flowId', label: 'ID do fluxo' },
	  ] },
	  { id: 'customer', label: 'Cliente', icon: 'fa-address-card', variables: [
		{ name: 'contactName', label: 'Nome do cliente' }, { name: 'contactNumber', label: 'Número do cliente' }, { name: 'contactEmail', label: 'Email do cliente' },
	  ] },
	  { id: 'channel', label: 'Mensagem e canal', icon: 'fa-comments', variables: [
		{ name: 'message', label: 'Mensagem recebida' }, { name: 'response', label: 'Última resposta' }, { name: 'senderName', label: 'Nome informado pelo WhatsApp' },
		{ name: 'messageId', label: 'ID da mensagem recebida' }, { name: 'messageType', label: 'Tipo da mensagem recebida' }, { name: 'userReplied', label: 'Cliente respondeu' },
		{ name: 'conversationTags', label: 'Tags do atendimento' },
		{ name: 'department', label: 'Setor atual' }, { name: 'connectionType', label: 'Tipo de conexão' },
	  ] },
	];
	const dynamic = new Map();
	const used = new Set(categories.flatMap(category => category.variables.map(variable => variable.name)));
	function add(categoryID, categoryLabel, icon, name, label) {
	  name = String(name || '').trim();
	  if (!name || used.has(name)) return;
	  if (!dynamic.has(categoryID)) dynamic.set(categoryID, { id: categoryID, label: categoryLabel, icon, variables: [] });
	  dynamic.get(categoryID).variables.push({ name, label });
	  used.add(name);
	}
	function flowDataFor(flow) {
	  if (!flow?.flowData) return null;
	  if (typeof flow.flowData !== 'string') return flow.flowData;
	  try { return JSON.parse(flow.flowData); } catch (_) { return null; }
	}
	function collectVariablesFromNodes(nodes, visitedFlowIDs) {
	(nodes || []).forEach(node => {
	  const data = node.data || {};
	  if (node.type === 'setVariable') add('defined', 'Variáveis definidas', 'fa-code', data.variableName, 'Definida no fluxo');
	  if (node.type === 'input') add('captured', 'Respostas capturadas', 'fa-keyboard', data.variableName || 'userInput', 'Resposta do cliente');
	  if (node.type === 'checkResponse') add('logic', 'Resultados de lógica', 'fa-code-branch', data.saveResponseTo, 'Resultado da verificação');
	  if (node.type === 'condition') add('logic', 'Resultados de lógica', 'fa-code-branch', 'currentTime', 'Horário atual do fluxo');
	  if (node.type === 'httpRequest') {
		add('http', 'HTTP Request', 'fa-globe', data.saveResponseTo, 'Resposta HTTP completa');
		(data.responseMappings || []).forEach(mapping => add('http', 'HTTP Request', 'fa-globe', mapping.variableName, mapping.path || 'Campo mapeado'));
		add('http', 'HTTP Request', 'fa-globe', 'httpError', 'Motivo da falha da requisição');
	  }
	  if (node.type === 'ai') {
		add('ai', 'Inteligência artificial', 'fa-wand-magic-sparkles', data.saveResponseTo, 'Resposta gerada pela IA');
		add('ai', 'Inteligência artificial', 'fa-wand-magic-sparkles', 'aiError', 'Erro ao gerar com IA');
	  }
	  if (node.type === 'mediaTranscription') {
		add('ai', 'Inteligência artificial', 'fa-file-waveform', data.saveResponseTo, 'Conteúdo da mídia transcrita');
		add('ai', 'Inteligência artificial', 'fa-file-waveform', 'transcriptionError', 'Erro da transcrição');
	  }
	  if (node.type === 'conversationSummary') {
		add('ai', 'Inteligência artificial', 'fa-file-lines', data.saveResponseTo, 'Resumo da conversa');
		add('ai', 'Inteligência artificial', 'fa-file-lines', 'summaryError', 'Erro do resumo');
	  }
	  if (node.type === 'npsEvaluation') add('nps', 'Avaliação NPS', 'fa-star-half-stroke', data.saveScoreTo, 'Nota NPS recebida');
	  if (node.type === 'smartAssign') {
		add('assignment', 'Distribuição', 'fa-users-gear', 'assignedAgentId', 'ID do agente distribuído');
		add('assignment', 'Distribuição', 'fa-users-gear', 'assignedAgentName', 'Nome do agente distribuído');
	  }
	  if (node.type === 'callback') {
		add('callback', 'Callback', 'fa-satellite-dish', 'callbackResponse', 'Resposta do callback');
		add('callback', 'Callback', 'fa-satellite-dish', 'callbackError', 'Motivo da falha do callback');
	  }
	  if (node.type === 'scheduleMessage') {
		add('schedule', 'Agendamento', 'fa-calendar-plus', 'scheduledMessageAt', 'Data do agendamento');
		add('schedule', 'Agendamento', 'fa-calendar-plus', 'scheduleError', 'Erro do agendamento');
	  }
	  if (node.type === 'subflow') {
		add('subflow', 'Subfluxo', 'fa-diagram-project', 'subflowError', 'Erro do subfluxo');
		const flowID = Number(data.flowId || 0);
		if (flowID > 0 && !visitedFlowIDs.has(flowID)) {
		  visitedFlowIDs.add(flowID);
		  const nestedFlowData = flowDataFor(state.flows.find(flow => Number(flow.id) === flowID));
		  collectVariablesFromNodes(nestedFlowData?.nodes, visitedFlowIDs);
		}
	  }
	});
	}
	const visitedFlowIDs = new Set(state.currentFlow?.id ? [Number(state.currentFlow.id)] : []);
	collectVariablesFromNodes(state.currentFlow ? (state.flowData?.nodes || []) : [], visitedFlowIDs);
	return { categories: categories.concat(Array.from(dynamic.values()).filter(category => category.variables.length)) };
}

function variableAccordions(catalog, renderer) {
	return catalog.categories.map(category =>
	  '<details class="variable-accordion group border-b border-stone-100">' +
		'<summary class="cursor-pointer px-3 py-2.5 flex items-center gap-2 bg-stone-50 hover:bg-purple-50"><i class="fas ' + category.icon + ' w-4 text-center text-purple-500"><\/i><span class="flex-1 text-[11px] font-semibold text-gray-700">' + escapeHtml(category.label) + '<\/span><span class="rounded-full bg-white px-1.5 py-0.5 text-[9px] text-gray-400">' + category.variables.length + '<\/span><i class="fas fa-chevron-down text-[9px] text-gray-400 transition-transform group-open:rotate-180"><\/i><\/summary>' +
		'<div class="divide-y divide-stone-50">' + category.variables.map(renderer).join('') + '<\/div>' +
	  '<\/details>'
	).join('');
}

function formattedTextArea(val, name, rows) {
  const formats = [
    { token: '*', icon: 'fa-bold', title: 'Negrito' },
    { token: '_', icon: 'fa-italic', title: 'Itálico' },
    { token: '~', icon: 'fa-strikethrough', title: 'Tachado' },
    { token: '```', icon: 'fa-code', title: 'Monoespaçado' },
  ];
	const variables = availableFlowVariables();
	const variableButton = variable => '<button type="button" data-variable-name="' + escapeAttr(variable.name) + '" class="w-full px-3 py-2 text-left hover:bg-purple-50 flex items-center justify-between gap-2"><span><span class="block text-xs font-medium text-gray-700">' + escapeHtml(variable.label) + '<\/span><code class="text-[10px] text-purple-600">{' + '{' + escapeHtml(variable.name) + '}' + '}<\/code><\/span><i class="fas fa-plus text-[10px] text-purple-500"><\/i><\/button>';
	return '<div data-formatted-editor class="rounded-lg border border-stone-200 bg-stone-50">' +
    '<div class="flex items-center gap-1 px-2 py-1.5 border-b border-stone-200 bg-white">' +
      formats.map(format => '<button type="button" data-format-token="' + format.token + '" title="' + format.title + '" class="w-8 h-8 rounded-md text-gray-600 hover:bg-purple-50 hover:text-purple-700"><i class="fas ' + format.icon + '"><\/i><\/button>').join('') +
	  '<span class="h-5 w-px bg-stone-200 mx-1"><\/span>' +
	  '<button type="button" data-variable-toggle title="Inserir variável" class="h-8 px-2.5 rounded-md text-xs font-medium text-purple-700 hover:bg-purple-50 flex items-center gap-1.5"><i class="fas fa-at"><\/i>Variáveis<\/button>' +
    '<\/div>' +
	'<div data-variable-menu class="hidden border-b border-stone-200 bg-white max-h-56 overflow-y-auto">' +
	  variableAccordions(variables, variableButton) +
	'<\/div>' +
    '<textarea data-field="' + name + '" data-formatted-text rows="' + (rows||4) + '" class="w-full px-3 py-2 bg-stone-50 text-sm focus:outline-none focus:ring-2 focus:ring-inset focus:ring-purple-400">' + escapeHtml(val||'') + '<\/textarea>' +
  '<\/div>';
}

function numberInput(val, name) {
  return '<input type="number" data-field="' + name + '" value="' + (val ?? '') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">';
}

function safeModeField(data, summary) {
	return field('Modo seguro', '<label class="flex cursor-pointer items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3"><input type="checkbox" data-field="safeMode" ' + (data.safeMode !== false ? 'checked' : '') + ' class="mt-0.5 accent-emerald-700"><span><span class="block text-sm font-semibold text-emerald-900">Ativar proteções adicionais</span><span class="mt-1 block text-xs font-normal leading-relaxed text-emerald-800">' + escapeHtml(summary) + '<\/span><\/span><\/label>', 'A política é adicionada internamente ao prompt e não fica visível para o contato.');
}

function businessHoursFields(bh, prefix, includeOutsideAction) {
  if (!bh.startTime) bh.startTime = '08:00';
  if (!bh.endTime) bh.endTime = '18:00';
  if (!bh.timezone) bh.timezone = 'America/Sao_Paulo';
  if (!Array.isArray(bh.days)) bh.days = [1,2,3,4,5];
  const timeInput = (value, path) => '<input type="time" data-field="' + path + '" value="' + escapeAttr(value) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">';
  const dayLabels = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  let html = field('Dias de atendimento', '<div class="grid grid-cols-4 gap-1.5">' + dayLabels.map((label, day) =>
    '<label class="flex items-center gap-1 text-xs text-gray-600"><input type="checkbox" data-business-days-path="' + prefix + 'days" value="' + day + '" ' + (bh.days.includes(day)?'checked':'') + '> ' + label + '<\/label>'
  ).join('') + '<\/div>');
  html += field('Início', timeInput(bh.startTime, prefix + 'startTime'));
  html += field('Fim', timeInput(bh.endTime, prefix + 'endTime'));
  html += field('Fuso horário', textInput(bh.timezone, prefix + 'timezone'));
  html += field('Intervalo', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="' + prefix + 'lunchEnabled" ' + (bh.lunchEnabled?'checked':'') + '> Considerar intervalo de almoço<\/label>');
  if (bh.lunchEnabled) {
    if (!bh.lunchStart) bh.lunchStart = '12:00';
    if (!bh.lunchEnd) bh.lunchEnd = '13:00';
    html += field('Início do intervalo', timeInput(bh.lunchStart, prefix + 'lunchStart'));
    html += field('Fim do intervalo', timeInput(bh.lunchEnd, prefix + 'lunchEnd'));
  }
  if (includeOutsideAction) {
    if (!bh.outsideAction) bh.outsideAction = 'block';
    html += field('Fora do horário', inspectorSelect(prefix + 'outsideAction', [
      { value: 'block', label: 'Ignorar mensagem' }, { value: 'message', label: 'Enviar aviso automático' },
    ], bh.outsideAction, 'Selecione uma ação'));
	if (bh.outsideAction === 'message') html += field('Mensagem de aviso', formattedTextArea(bh.outsideMessage, prefix + 'outsideMessage', 4));
  }
  return html;
}

function mediaNodeConfig(type) {
  if (type === 'sendImage') return { kind: 'image', urlField: 'imageUrl', pathField: 'imagePath', mimeField: 'imageMimeType', accept: 'image/jpeg,image/png,image/gif,image/webp', label: 'uma imagem', hint: 'JPG, PNG, GIF ou WEBP · até 10 MB' };
  if (type === 'sendVideo') return { kind: 'video', urlField: 'videoUrl', pathField: 'videoPath', mimeField: 'videoMimeType', accept: 'video/mp4,video/webm,video/quicktime', label: 'um vídeo', hint: 'MP4, WEBM ou MOV · até 50 MB' };
  if (type === 'sendAudio') return { kind: 'audio', urlField: 'audioUrl', pathField: 'audioPath', mimeField: 'audioMimeType', accept: 'audio/webm,audio/ogg,audio/mpeg,audio/mp4,audio/wav', label: 'um áudio', hint: 'WEBM, OGG, MP3, M4A ou WAV · até 20 MB' };
  if (type === 'sendFile') return { kind: 'document', urlField: 'fileUrl', pathField: 'filePath', mimeField: 'fileMimeType', accept: '.pdf,.txt,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip', label: 'um documento', hint: 'PDF, Office, TXT, CSV ou ZIP · até 50 MB' };
  return null;
}

function mediaUploadHTML(kind, data, options) {
  const url = data[options.urlField] || '';
  const uploaded = !!data[options.pathField];
  const previewUrl = data.mediaPreviewUrl || url;
  let preview = '';
  if (uploaded && previewUrl) {
    if (kind === 'image') preview = '<img src="' + escapeAttr(previewUrl) + '" class="w-full h-28 object-cover rounded-lg border border-stone-200">';
    if (kind === 'video') preview = '<video src="' + escapeAttr(previewUrl) + '" controls class="w-full max-h-36 rounded-lg border border-stone-200"><\/video>';
    if (kind === 'audio') preview = '<audio src="' + escapeAttr(previewUrl) + '" controls class="w-full"><\/audio>';
    if (kind === 'document') preview = '<a href="' + escapeAttr(previewUrl) + '" target="_blank" class="flex items-center gap-2 p-3 rounded-lg border border-stone-200 bg-stone-50 text-sm text-purple-700"><i class="fas fa-file-lines text-xl"><\/i><span class="truncate">' + escapeHtml(data.mediaName || 'Documento') + '<\/span><\/a>';
    preview += '<div class="flex items-center justify-between gap-2 mt-2"><span class="text-[11px] text-gray-500 truncate">' + escapeHtml(data.mediaName || options.label) + '<\/span>' +
      '<button type="button" data-media-remove class="text-xs text-red-600 hover:underline">Remover<\/button><\/div>';
  }
  return '<div data-media-upload>' +
    '<label class="block border-2 border-dashed border-stone-300 hover:border-purple-400 rounded-xl p-4 text-center cursor-pointer transition-colors" data-media-dropzone>' +
      '<input type="file" accept="' + options.accept + '" class="hidden" data-media-file>' +
      '<i class="fas fa-cloud-arrow-up text-2xl text-purple-500 mb-2"><\/i>' +
      '<div class="text-sm font-medium text-gray-700">Arraste ou selecione ' + options.label + '<\/div>' +
      '<div class="text-[11px] text-gray-400 mt-1">' + options.hint + '<\/div>' +
    '<\/label>' +
    (kind === 'audio' ? '<button type="button" data-record-audio class="mt-2 w-full px-3 py-2 rounded-lg bg-purple-100 text-purple-700 hover:bg-purple-200 text-sm font-medium"><i class="fas fa-microphone mr-1"><\/i>Gravar agora<\/button>' : '') +
    '<div data-media-status class="text-xs text-gray-500 mt-2"><\/div>' +
    (preview ? '<div class="mt-3">' + preview + '<\/div>' : '') +
  '<\/div>';
}

function renderFieldsFor(node) {
  const box = document.getElementById('inspector-fields');
  const d = node.data;
  let html = '';

  switch (node.type) {
    case 'start': {
      d.businessHours = d.businessHours || {};
      const bh = d.businessHours;
      html += field('Horário de atendimento', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="businessHours.enabled" ' + (bh.enabled?'checked':'') + '> Restringir a um horário<\/label>');
	  if (bh.enabled) {
		html += businessHoursFields(bh, 'businessHours.', true);
      }
      break;
    }
    case 'sendText':
      html += field('Mensagem', formattedTextArea(d.message, 'message', 5), 'Selecione um trecho e use a barra de formatação. Variáveis continuam disponíveis com {' + '{variavel}' + '}.');
      break;
	case 'sendTemplate':
	  html += field('Modelo', inspectorSelect('templateId', [{ value: '', label: 'Selecione' }].concat(state.templates.map(template => ({ value: String(template.id), label: template.name }))), d.templateId || '', 'Selecione'));
	  const selectedTemplate = state.templates.find(template => template.id === Number(d.templateId));
	  if (selectedTemplate) html += '<div class="rounded-lg bg-stone-50 border border-stone-200 p-3 text-xs text-gray-600 whitespace-pre-wrap">' + escapeHtml(selectedTemplate.content) + '<\/div>';
	  break;
    case 'sendImage':
      html += mediaUploadHTML('image', d, mediaNodeConfig(node.type));
      if (!d.imagePath) html += field('Ou use uma URL externa', textInput(d.imageUrl, 'imageUrl'));
	  html += field('Legenda (opcional)', formattedTextArea(d.caption, 'caption', 3));
      break;
    case 'sendVideo':
      html += mediaUploadHTML('video', d, mediaNodeConfig(node.type));
      if (!d.videoPath) html += field('Ou use uma URL externa', textInput(d.videoUrl, 'videoUrl'));
	  html += field('Legenda (opcional)', formattedTextArea(d.caption, 'caption', 3));
      break;
    case 'sendAudio':
      html += mediaUploadHTML('audio', d, mediaNodeConfig(node.type));
      if (!d.audioPath) html += field('Ou use uma URL externa', textInput(d.audioUrl, 'audioUrl'));
      break;
    case 'sendFile':
      html += mediaUploadHTML('document', d, mediaNodeConfig(node.type));
      if (!d.filePath) html += field('Ou use uma URL externa', textInput(d.fileUrl, 'fileUrl'));
	  html += field('Legenda (opcional)', formattedTextArea(d.caption, 'caption', 3));
      break;
    case 'sendMenu':
      d.sections = d.sections || [];
      html += field('Título', textInput(d.title || 'Menu', 'title'));
	  html += field('Mensagem', formattedTextArea(d.description, 'description', 4));
      html += field('Texto do botão', textInput(d.buttonText || 'Ver Menu', 'buttonText'));
      html += field('Rodapé', textInput(d.footerText ?? 'DoveChat', 'footerText'), 'Deixe vazio para enviar o menu sem rodapé.');
      html += field('Caminho padrão', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="useFallback" ' + (d.useFallback?'checked':'') + '> Adicionar saída para respostas inválidas<\/label>');
	  html += field('Navegação entre menus', '<div class="space-y-2 rounded-xl border border-stone-200 bg-stone-50 p-3">' +
		'<label class="flex items-start gap-2 text-sm text-gray-700"><input type="checkbox" data-field="allowBackPrevious" ' + (d.allowBackPrevious?'checked':'') + '><span><span class="block font-medium">Voltar ao menu anterior<\/span><span class="block text-[11px] text-gray-400">Retoma o menu visitado imediatamente antes deste.<\/span><\/span><\/label>' +
		'<label class="flex items-start gap-2 text-sm text-gray-700"><input type="checkbox" data-field="allowBackMain" ' + (d.allowBackMain?'checked':'') + '><span><span class="block font-medium">Voltar ao menu principal<\/span><span class="block text-[11px] text-gray-400">Retoma o primeiro menu visitado na execução.<\/span><\/span><\/label>' +
	  '<\/div>', 'As opções aparecem para o cliente somente quando já existe um menu anterior no histórico.');
      html += '<div class="text-xs font-medium text-gray-600 mt-1">Seções e opções<\/div>';
      html += '<div id="menu-sections" class="flex flex-col gap-3"><\/div>';
      html += '<button id="btn-add-menu-section" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar seção<\/button>';
      break;
    case 'sendButtons':
      d.buttons = d.buttons || [];
      html += field('Título (opcional)', textInput(d.title, 'title'), 'Se ficar vazio, será enviado "Escolha uma opção": o WhatsApp exige um título nos botões.');
      html += field('Mensagem', formattedTextArea(d.description, 'description', 4));
      html += field('Rodapé (opcional)', textInput(d.footer, 'footer'), 'Se ficar vazio, será enviado "Toque em um botão para responder".');
      html += field('Caminho padrão', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="useFallback" ' + (d.useFallback?'checked':'') + '> Adicionar saída para respostas inválidas<\/label>');
      html += '<div class="text-xs font-medium text-gray-600 mt-1">Botões de resposta (máximo 3)<\/div>';
      html += '<div id="reply-buttons" class="flex flex-col gap-2"><\/div>';
      html += '<button type="button" id="btn-add-reply-button" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar botão<\/button>';
      break;
    case 'condition': {
      if (!d.conditionSource) d.conditionSource = d.condition ? 'legacy' : 'contactMessage';
      if (!d.conditionOperator) d.conditionOperator = 'equals';
      const sourceOptions = d.conditionSource === 'legacy'
        ? [{ value: 'legacy', label: 'EXPRESSÃO ANTIGA' }].concat(CONDITION_SOURCES)
        : CONDITION_SOURCES;
      html += field('Avaliar', inspectorSelect('conditionSource', sourceOptions, d.conditionSource, 'Escolha o dado'));
      if (d.conditionSource === 'legacy') {
        html += field('Expressão antiga', textArea(d.condition, 'condition', 3), 'Selecione uma origem acima para migrar esta condição para o formato visual.');
        break;
      }
      if (d.conditionSource === 'variable') {
        html += field('Nome da variável', textInput(d.conditionVariable, 'conditionVariable'), 'Use o nome salvo por Capturar Resposta ou HTTP Request. Caminhos como apiResult.data.status são aceitos.');
      }
      html += field('Operador', inspectorSelect('conditionOperator', CONDITION_OPERATORS, d.conditionOperator, 'Escolha o operador'));
      if (d.conditionOperator !== 'true' && d.conditionOperator !== 'false') {
        if (d.conditionSource === 'department') {
          const departments = [{ value: '', label: 'Selecione o departamento' }].concat(state.departments.map(department => ({ value: department.name, label: department.name })));
          html += field('Valor', inspectorSelect('conditionValue', departments, d.conditionValue || '', 'Selecione o departamento'));
        } else if (d.conditionSource === 'connectionType') {
          html += field('Valor', inspectorSelect('conditionValue', [
            { value: 'whatsapp_qrcode', label: 'WhatsApp por QR Code' },
            { value: 'api_oficial', label: 'WhatsApp API Oficial' },
          ], d.conditionValue || '', 'Selecione o tipo'));
        } else if (d.conditionSource === 'time') {
          html += field('Horário', '<input type="time" data-field="conditionValue" value="' + escapeAttr(d.conditionValue || '') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', 'Usa o fuso horário configurado no bloco Início; o padrão é America/Sao_Paulo.');
        } else {
          html += field('Valor', textInput(d.conditionValue, 'conditionValue'), 'A comparação ignora diferenças entre maiúsculas e minúsculas.');
        }
      } else {
        html += '<p class="text-[11px] text-gray-400">Este operador avalia o valor diretamente e não precisa de comparação.<\/p>';
      }
      break;
    }
    case 'switch':
      d.cases = d.cases || [];
	  html += field('Mensagem (opcional)', formattedTextArea(d.message, 'message', 4), 'Enviada antes de aguardar a resposta.');
      html += '<div class="text-xs font-medium text-gray-600 mb-1">Opções (avaliadas na ordem)<\/div>';
      html += '<div id="switch-cases" class="flex flex-col gap-2"><\/div>';
      html += '<button id="btn-add-case" class="mt-1 text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar opção<\/button>';
      html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'), 'Se o contato não responder nesse tempo, segue pelo "Nenhuma opção".');
      break;
    case 'delay':
      html += field('Tipo', inspectorSelect('delayType', [
        { value: 'fixed', label: 'Tempo fixo' },
        { value: 'range', label: 'Intervalo aleatório' },
      ], d.delayType || 'fixed', 'Selecione o tipo'));
      if (d.delayType === 'range') {
        html += field('Mínimo (s)', numberInput(d.minSeconds, 'minSeconds'));
        html += field('Máximo (s)', numberInput(d.maxSeconds, 'maxSeconds'));
      } else {
        html += field('Segundos', numberInput(d.seconds, 'seconds'));
      }
      html += '<p class="text-[11px] text-gray-400">Limitado a 60s no máximo.<\/p>';
      break;
    case 'changeStatus':
      html += field('Novo status', inspectorSelect('status', [
        { value: '', label: 'Selecione' },
        { value: 'open', label: 'Aberta', dot: '#22c55e' },
        { value: 'pending', label: 'Pendente', dot: '#f59e0b' },
        { value: 'closed', label: 'Fechada', dot: '#ef4444' },
      ], d.status || '', 'Selecione o status'));
      break;
    case 'assign':
      html += field('Transferir para', inspectorSelect('assignType', [
        { value: 'agent', label: 'Agente' },
        { value: 'department', label: 'Setor' },
      ], d.assignType || 'agent', 'Selecione o destino'));
      const assignmentOptions = d.assignType === 'department' ? state.departments : state.agents;
      html += field(d.assignType === 'department' ? 'Setor' : 'Agente',
          inspectorSelect('assignId', [{ value: '', label: 'Selecione' }].concat(assignmentOptions.map(option => ({ value: String(option.id), label: option.name }))), d.assignId || '', 'Selecione'));
	  html += field('Mensagem após transferir (opcional)', formattedTextArea(d.message, 'message', 4), 'Enviada ao cliente depois que a transferência for concluída.');
      break;
    case 'httpRequest':
      html += '<div class="rounded-xl border border-purple-200 bg-purple-50 p-3 flex flex-col gap-2">' +
        '<div><p class="text-xs font-semibold text-purple-900"><i class="fas fa-terminal mr-1"><\/i>Importar de cURL<\/p><p class="mt-1 text-[11px] leading-relaxed text-purple-700">Cole um comando cURL para preencher URL, método, headers e corpo.<\/p><\/div>' +
        '<textarea id="http-curl-command" rows="5" spellcheck="false" placeholder="curl https://api.exemplo.com ..." class="w-full resize-y rounded-lg border border-purple-200 bg-white px-3 py-2 font-mono text-xs text-gray-800 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><\/textarea>' +
        '<button type="button" id="btn-import-http-curl" class="w-full rounded-lg bg-purple-700 px-3 py-2 text-xs font-semibold text-white transition hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-file-import mr-1"><\/i>Importar configurações<\/button>' +
        '<p id="http-curl-feedback" class="hidden text-[11px] leading-relaxed"><\/p><\/div>';
      html += field('Método', inspectorSelect('method', ['GET','POST','PUT','PATCH','DELETE'].map(method => ({ value: method, label: method })), d.method || 'POST', 'Método HTTP'));
      html += field('URL', textInput(d.url, 'url'));
      if (!d.headerMode) {
        d.headerMode = d.headers && typeof d.headers === 'object' && !Array.isArray(d.headers) ? 'rawJSON' : 'none';
        if (d.headerMode === 'rawJSON' && !d.headersRaw) d.headersRaw = JSON.stringify(d.headers, null, 2);
      }
      d.headerFields = d.headerFields || [];
      html += field('Formato dos headers', inspectorSelect('headerMode', [
        { value: 'fields', label: 'Chave/valor' },
        { value: 'rawJSON', label: 'JSON livre' },
        { value: 'none', label: 'Sem headers' },
      ], d.headerMode, 'Formato dos headers'));
      if (d.headerMode === 'fields') {
        html += '<div class="flex items-center justify-between"><span class="text-xs font-medium text-gray-600">Headers</span>' +
          '<button type="button" id="btn-add-http-header" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar header<\/button><\/div>' +
          '<div id="http-header-fields" class="flex flex-col gap-2"><\/div>' +
          '<p class="text-[11px] text-gray-400">Valores aceitam {' + '{variavel}' + '}. Headers de proxy e roteamento são bloqueados.<\/p>';
      } else if (d.headerMode === 'rawJSON') {
        html += field('Headers JSON', textArea(d.headersRaw, 'headersRaw', 5), 'Objeto JSON com valores de texto. Ex: {"Authorization":"Bearer token"}.');
      }
      if ((d.method||'POST') !== 'GET') {
        if (!d.bodyMode) d.bodyMode = d.body ? 'rawJSON' : 'none';
        d.bodyFields = d.bodyFields || [];
        html += field('Formato do corpo', inspectorSelect('bodyMode', [
          { value: 'json', label: 'JSON por campos' },
          { value: 'rawJSON', label: 'JSON livre' },
          { value: 'raw', label: 'Texto livre' },
          { value: 'form', label: 'Formulário (x-www-form-urlencoded)' },
		  { value: 'multipart', label: 'Form-data (multipart)' },
          { value: 'none', label: 'Sem corpo' },
        ], d.bodyMode, 'Formato do corpo'));
		if (d.bodyMode === 'json' || d.bodyMode === 'form' || d.bodyMode === 'multipart') {
          html += '<div class="flex items-center justify-between"><span class="text-xs font-medium text-gray-600">Campos do corpo<\/span>' +
            '<button type="button" id="btn-add-http-field" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar campo<\/button><\/div>' +
            '<div id="http-body-fields" class="flex flex-col gap-2"><\/div>' +
			'<p class="text-[11px] text-gray-400">' + (d.bodyMode === 'multipart' ? 'Cada campo será enviado como uma parte do form-data. O Content-Type da parte é opcional.' : 'Valores aceitam {' + '{variavel}' + '}. No modo JSON, números, booleanos, objetos e arrays válidos são tipados automaticamente.') + '<\/p>';
        } else if (d.bodyMode === 'rawJSON' || d.bodyMode === 'raw') {
          html += field(d.bodyMode === 'rawJSON' ? 'Corpo JSON' : 'Corpo da requisição', textArea(d.body, 'body', 6), 'Use {' + '{variavel}' + '} para inserir dados capturados no fluxo.');
        }
      }
      html += field('Salvar resposta em', textInput(d.saveResponseTo, 'saveResponseTo'), 'Nome da variável, ex: apiResult');
	  html += field('Timeout total (ms)', numberInput(d.timeout, 'timeout'), 'Padrão: 60000. Para APIs lentas, use até 240000 (4 minutos).');
	  html += field('Timeout de conexão (ms)', numberInput(d.connectTimeout, 'connectTimeout'), 'Tempo máximo apenas para estabelecer a conexão. Limite: 60000.');
	  html += field('Redirecionamentos', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="followRedirects" ' + (d.followRedirects?'checked':'') + '> Seguir respostas 3xx<\/label>', 'Ative para reproduzir cURL com --location. Cada destino continua sujeito à proteção contra endereços privados.');
	  d.responseMappings = d.responseMappings || [];
	  html += '<div class="mt-2 rounded-xl border border-blue-200 bg-blue-50 p-3 space-y-2">' +
		'<div><p class="text-xs font-semibold text-blue-900"><i class="fas fa-play mr-1"><\/i>Testar e mapear resposta<\/p><p class="mt-1 text-[11px] text-blue-700">Execute a requisição para navegar pelos campos retornados.<\/p><\/div>' +
		'<details><summary class="cursor-pointer text-[11px] font-medium text-blue-700">Contexto de teste para variáveis<\/summary><textarea id="http-test-context" rows="3" placeholder="{&quot;document&quot;:&quot;12345678900&quot;}" class="mt-2 w-full rounded-lg border border-blue-200 bg-white px-2.5 py-2 font-mono text-xs"><\/textarea><\/details>' +
		'<button type="button" id="btn-test-http" class="w-full rounded-lg bg-blue-700 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-800 disabled:cursor-wait disabled:opacity-60">Testar requisição<\/button>' +
		'<p id="http-test-feedback" class="hidden text-[11px]"><\/p><div id="http-test-response"><\/div><\/div>';
	  html += '<div class="mt-2 flex items-center justify-between"><div><p class="text-xs font-semibold text-gray-700">Variáveis da resposta<\/p><p class="text-[11px] text-gray-400">Caminho JSON → variável do fluxo<\/p><\/div><button type="button" id="btn-add-response-mapping" class="text-xs font-medium text-purple-600 hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar<\/button><\/div><div id="http-response-mappings" class="space-y-2"><\/div>';
      break;
    case 'waitForResponse':
      html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'));
      break;
    case 'input':
	  html += field('Mensagem (opcional)', formattedTextArea(d.message, 'message', 4), 'Enviada antes de aguardar a resposta.');
      html += field('Salvar resposta em', textInput(d.variableName, 'variableName'), 'Nome da variável, ex: nomeCliente');
	  html += field('Validação', inspectorSelect('validationType', [
		{ value: 'any', label: 'Qualquer mensagem (texto ou mídia)' }, { value: 'text', label: 'Texto não vazio' }, { value: 'email', label: 'Email' },
		{ value: 'number', label: 'Número' }, { value: 'regex', label: 'Expressão regular' },
	  ], d.validationType || 'any', 'Selecione'));
	  if (d.validationType === 'regex') html += field('Expressão regular', textInput(d.validationPattern, 'validationPattern'), 'Formato RE2 do Go, por exemplo: ^[0-9]{11}$');
      html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'));
      break;
    case 'checkResponse':
      html += field('Salvar resultado em (opcional)', textInput(d.saveResponseTo, 'saveResponseTo'));
      break;
	case 'setVariable':
	  html += field('Nome da variável', textInput(d.variableName, 'variableName'), 'Use letras, números e sublinhado; comece por uma letra.');
	  html += field('Valor', textArea(d.value, 'value', 3), 'Aceita variáveis como {' + '{contactName}' + '}.');
	  break;
	case 'tag':
	  html += field('Ação', inspectorSelect('operation', [{ value: 'add', label: 'Adicionar tag' }, { value: 'remove', label: 'Remover tag' }], d.operation || 'add', 'Selecione'));
	  html += field('Tag', textInput(d.tag, 'tag'), 'Aceita variáveis e ignora diferenças entre maiúsculas e minúsculas ao evitar duplicatas.');
	  break;
	case 'updateContact':
	  html += field('Campo', inspectorSelect('field', [{ value: 'name', label: 'Nome' }, { value: 'email', label: 'Email' }], d.field || 'name', 'Selecione'));
	  html += field('Novo valor', textInput(d.value, 'value'), 'Aceita variáveis do contexto do fluxo.');
	  break;
	case 'setContactField':
	  html += field('Chave do campo', textInput(d.fieldKey, 'fieldKey'), 'Use letras, números e sublinhado; comece por uma letra.');
	  html += field('Tipo do valor', inspectorSelect('fieldType', [{ value: 'text', label: 'Texto' }, { value: 'number', label: 'Número' }, { value: 'boolean', label: 'Verdadeiro/falso' }], d.fieldType || 'text', 'Selecione'));
	  html += field('Valor', textInput(d.value, 'value'), 'Aceita variáveis. Para verdadeiro/falso, informe true ou false.');
	  break;
	case 'businessHours':
	  html += '<div class="rounded-xl border border-purple-200 bg-purple-50 p-4 text-sm leading-relaxed text-purple-900"><i class="fas fa-building-clock mr-2 text-purple-600"><\/i>Este bloco usa automaticamente os dias, horários, intervalo e fuso definidos em <strong>Configurações da empresa<\/strong>.<\/div>';
	  break;
	case 'randomSplit':
	  html += field('Percentual no grupo A', '<input type="number" min="1" max="99" data-field="percentage" value="' + Number(d.percentage || 50) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', 'O restante segue pelo grupo B. Cada passagem faz um novo sorteio.');
	  break;
	case 'messageType':
	  html += '<p class="text-sm text-gray-500">Encaminha o fluxo conforme o tipo da última mensagem recebida pelo contato.<\/p>';
	  break;
	case 'smartAssign':
	  html += field('Estratégia', inspectorSelect('strategy', [
		{ value: 'leastLoaded', label: 'Menor quantidade de conversas' }, { value: 'random', label: 'Aleatória' },
	  ], d.strategy || 'leastLoaded', 'Selecione'));
	  html += field('Restringir ao setor (opcional)', inspectorSelect('departmentId', [{ value: '', label: 'Todos os agentes' }].concat(state.departments.map(department => ({ value: String(department.id), label: department.name }))), d.departmentId || '', 'Todos os agentes'));
	  break;
	case 'addNote':
	  html += field('Tipo', inspectorSelect('eventType', [{ value: 'note', label: 'Nota interna' }, { value: 'history', label: 'Evento de histórico' }], d.eventType || 'note', 'Selecione'));
	  html += field('Conteúdo', textArea(d.content, 'content', 4), 'Registro interno: não será enviado ao contato. Aceita variáveis.');
	  break;
	case 'callback':
	  html += field('Nome do evento', textInput(d.eventName, 'eventName'));
	  html += field('URL', textInput(d.url, 'url'), 'Somente destinos públicos são permitidos.');
	  html += field('Token Bearer (opcional)', '<input type="password" data-field="token" value="' + escapeAttr(d.token || '') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">');
	  html += field('Timeout (ms)', numberInput(d.timeout, 'timeout'));
	  html += field('Redirecionamentos', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="followRedirects" ' + (d.followRedirects?'checked':'') + '> Seguir respostas 3xx<\/label>');
	  break;
	case 'subflow': {
	  const availableFlows = state.flows.filter(flow => flow.id !== state.currentFlow.id);
	  html += field('Fluxo reutilizável', inspectorSelect('flowId', [{ value: '', label: 'Selecione' }].concat(availableFlows.map(flow => ({ value: String(flow.id), label: flow.name }))), d.flowId || '', 'Selecione'));
	  html += '<p class="text-[11px] text-gray-400">Subfluxos são capturados no início da execução e não podem conter blocos que aguardam resposta.<\/p>';
	  break;
	}
	case 'ai':
	  html += field('Credencial IA', inspectorSelect('credentialId', [{ value: '', label: 'Selecione uma credencial' }].concat(state.aiCredentials.map(credential => ({ value: String(credential.id), label: credential.name + ' · ' + credential.provider + ' · ' + credential.model }))), d.credentialId || '', 'Selecione uma credencial'), state.aiCredentials.length ? 'O provedor e o modelo desta credencial serão usados. A chave permanece criptografada no servidor.' : 'Nenhuma credencial disponível. Cadastre uma em Configurações > Chaves IA.');
	  html += safeModeField(d, 'Mantém a resposta no contexto do prompt, oculta modelo e instruções internas, resiste a tentativas de desvio e recusa conteúdo ilegal ou perigoso.');
	  html += field('Instrução do sistema (opcional)', textArea(d.systemPrompt, 'systemPrompt', 4));
	  html += field('Base de conhecimento (opcional)', textArea(d.knowledgeBase, 'knowledgeBase', 8), 'Use seções curtas e objetivas. O trecho mais relevante para o prompt será enviado à IA. Limite de 500.000 caracteres.');
	  html += '<div class="rounded-xl border border-violet-200 bg-violet-50 p-3 text-xs leading-relaxed text-violet-900"><div class="flex items-start justify-between gap-3"><div><p class="font-bold"><i class="fas fa-book-open mr-1"><\/i> Esquema recomendado</p><p class="mt-1">Organize por seções: <code class="rounded bg-white/70 px-1"># Produtos</code>, <code class="rounded bg-white/70 px-1"># Preços</code>, <code class="rounded bg-white/70 px-1"># Políticas</code> e <code class="rounded bg-white/70 px-1"># Perguntas frequentes</code>.</p></div><a href="/flows/knowledge-base-template.pdf" download class="shrink-0 rounded-lg bg-white px-3 py-2 font-bold text-violet-700 shadow-sm hover:bg-violet-100"><i class="fas fa-file-pdf mr-1"><\/i> Modelo PDF<\/a></div></div>';
	  html += field('Prompt', textArea(d.prompt, 'prompt', 6), 'Aceita variáveis.');
	  html += field('Salvar resposta em', textInput(d.saveResponseTo, 'saveResponseTo'));
	  break;
	case 'conversationSummary':
	  html += field('Credencial IA', inspectorSelect('credentialId', [{ value: '', label: 'Selecione uma credencial' }].concat(state.aiCredentials.map(credential => ({ value: String(credential.id), label: credential.name + ' · ' + credential.provider + ' · ' + credential.model }))), d.credentialId || '', 'Selecione uma credencial'), state.aiCredentials.length ? 'O provedor e o modelo desta credencial serão usados para gerar o resumo.' : 'Nenhuma credencial disponível. Cadastre uma em Configurações > Chaves IA.');
	  html += safeModeField(d, 'Resume somente o histórico do atendimento, ignora comandos maliciosos contidos nas mensagens e evita expor dados ou instruções internas.');
	  html += field('Últimas mensagens', '<input type="number" min="2" max="100" data-field="maxMessages" value="' + Number(d.maxMessages || 30) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">');
	  html += field('Instruções adicionais (opcional)', textArea(d.instructions, 'instructions', 4));
	  html += field('Salvar resumo em', textInput(d.saveResponseTo, 'saveResponseTo'));
	  html += field('Histórico interno', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="persist" ' + (d.persist?'checked':'') + '> Registrar o resumo na conversa<\/label>');
	  break;
	case 'mediaTranscription': {
	  const mediaCredentials = state.aiCredentials.filter(credential => MEDIA_PROVIDERS.includes(credential.provider));
	  const selectedMediaCredential = mediaCredentials.find(credential => credential.id === Number(d.credentialId));
	  html += field('Credencial compatível', inspectorSelect('credentialId', [{ value: '', label: 'Selecione uma credencial' }].concat(mediaCredentials.map(credential => ({ value: String(credential.id), label: credential.name + ' · ' + credential.provider + ' · ' + credential.model }))), d.credentialId || '', 'Selecione uma credencial'), mediaCredentials.length ? 'Selecione uma credencial OpenAI, Gemini, Claude ou Groq.' : 'Nenhuma credencial compatível disponível. Cadastre uma OpenAI, Gemini, Claude ou Groq em Configurações > Chaves IA.');
	  html += '<div class="rounded-xl border border-violet-200 bg-violet-50 p-3 text-xs leading-relaxed text-violet-900"><p class="font-semibold"><i class="fas fa-circle-info mr-1"><\/i> IAs compatíveis<\/p><p class="mt-1"><strong>OpenAI:<\/strong> áudio, imagem, vídeo e documento.<\/p><p><strong>Gemini:<\/strong> áudio, imagem, vídeo e documento PDF ou texto, até 14 MB por arquivo.<\/p><p><strong>Claude:<\/strong> imagem até 5 MB e documento PDF ou texto; não lê áudio nem vídeo.<\/p><p><strong>Groq:<\/strong> áudio (Whisper Large V3 Turbo) e imagem até 3 MB (Llama 4 Scout).<\/p><\/div>';
	  if (selectedMediaCredential && selectedMediaCredential.provider === 'gemini') html += '<div data-gemini-privacy class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-relaxed text-amber-900"><i class="fas fa-shield-halved mr-1"><\/i> No plano gratuito do Gemini o Google pode usar as mídias enviadas para melhorar seus produtos. Para mídias de clientes, prefira uma chave de projeto com faturamento ativo.<\/div>';
	  html += safeModeField(d, 'Trata a mídia somente como conteúdo, não executa instruções presentes no arquivo e não acrescenta respostas ou orientações ilegais e perigosas.');
	  html += field('Prompt (opcional)', textArea(d.prompt, 'prompt', 4), 'Oriente idioma, termos, formato ou informações que devem ser extraídas. Aceita variáveis. Limite de 2000 caracteres.');
	  html += field('Salvar resultado em', textInput(d.saveResponseTo, 'saveResponseTo'), 'Usa a última mídia recebida: áudio, imagem, vídeo ou documento.');
	  break;
	}
	case 'aiAgent':
	  html += field('Agente que assumirá a conversa', inspectorSelect('aiAgentId', [{ value: '', label: 'Selecione' }].concat(state.aiAgents.map(agent => ({ value: String(agent.id), label: agent.name + ' · ' + agent.provider }))), d.aiAgentId || '', 'Selecione'));
	  html += safeModeField(d, 'Aplica as proteções durante toda esta sessão transferida: limita o agente ao escopo, oculta detalhes técnicos e recusa desvios ou conteúdo perigoso.');
	  html += '<div class="rounded-xl border border-violet-200 bg-violet-50 p-3 text-xs leading-relaxed text-violet-800"><i class="fas fa-circle-info mr-1"><\/i> Este bloco encerra o flow e transfere as próximas mensagens para o agente autônomo.<\/div>';
	  html += '<div class="rounded-xl border border-stone-200 bg-stone-50 p-3 text-xs leading-relaxed text-gray-600"><p class="font-semibold text-gray-700"><i class="fas fa-plug mr-1 text-violet-600"><\/i> Conectores do agente<\/p><p class="mt-1">Conecte <strong>Ações<\/strong> que a IA pode executar sozinha: transferir, pausar ou encerrar o atendimento, enviar um resumo à equipe, etiquetar, salvar dados do cliente ou chamar uma API (agendamentos, CRM, pedidos).<\/p><p class="mt-1">A <strong>base de conhecimento<\/strong> é a do próprio agente, editada em <em>Agentes IA<\/em>, onde também é possível importar PDF, Word, planilhas, textos e imagens.<\/p><div class="mt-2 flex flex-wrap gap-2">' +
		AI_SUB_PORTS.map(port => '<button type="button" data-open-sub-port="' + port.handle + '" class="rounded-lg border border-violet-200 bg-white px-2.5 py-1.5 font-semibold text-violet-700 hover:bg-violet-50"><i class="fas ' + (port.link ? 'fa-book-open' : NODE_TYPES[port.accepts].icon) + ' mr-1"><\/i>' + (port.link ? 'Editar base de conhecimento' : (state.flowData.edges.some(edge => edge.source === node.id && edge.sourceHandle === port.handle) ? 'Abrir ' : 'Adicionar ') + escapeHtml(port.label.toLowerCase())) + (port.link ? ' <i class="fas fa-arrow-up-right-from-square ml-1 text-[10px]"><\/i>' : '') + '<\/button>').join('') + '<\/div><\/div>';
	  break;
	case 'aiKnowledge': {
	  // Legacy block: the flow no longer sends this content to the agent.
	  const parent = state.flowData.edges.map(edge => edge.target === node.id && state.flowData.nodes.find(n => n.id === edge.source && n.type === 'aiAgent')).find(Boolean);
	  html += '<div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-relaxed text-amber-900"><i class="fas fa-triangle-exclamation mr-1"><\/i> Este bloco foi descontinuado e seu conteúdo <strong>não é mais usado<\/strong>. A base de conhecimento agora fica somente no agente. Copie o texto abaixo para a base do agente em <em>Agentes IA<\/em> e exclua este bloco.<\/div>';
	  html += field('Conteúdo antigo', '<textarea readonly rows="12" class="w-full rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-xs text-gray-600">' + escapeHtml(d.content || '') + '<\/textarea>');
	  html += '<button type="button" data-open-agent-knowledge class="rounded-lg bg-violet-100 px-3 py-2 text-xs font-semibold text-violet-700 hover:bg-violet-200"><i class="fas fa-arrow-up-right-from-square mr-1"><\/i> Abrir base do agente<\/button>';
	  html += '<span class="hidden" data-legacy-parent="' + escapeAttr(parent ? parent.id : '') + '"><\/span>';
	  break;
	}
	case 'aiTools':
	  html += '<div class="rounded-xl border border-violet-200 bg-violet-50 p-3 text-xs leading-relaxed text-violet-800"><i class="fas fa-circle-info mr-1"><\/i> Conecte este bloco ao conector <strong>Ações<\/strong> de um Agente IA. A IA decide sozinha quando usar cada ação, com base no campo <em>Quando usar<\/em>.<\/div>';
	  html += aiActionsHTML(d);
	  break;
	case 'scheduleMessage':
	  html += field('Mensagem', formattedTextArea(d.message, 'message', 5), 'As variáveis são resolvidas no momento do agendamento.');
	  html += field('Enviar após (minutos)', '<input type="number" min="1" max="43200" data-field="delayMinutes" value="' + Number(d.delayMinutes || 60) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', 'Entre 1 minuto e 30 dias. O envio sobrevive a reinícios do servidor.');
	  break;
	case 'npsEvaluation':
	  html += field('Pergunta', formattedTextArea(d.message, 'message', 4), 'O contato deve responder com uma nota inteira entre 0 e 10.');
	  html += field('Salvar nota em', textInput(d.saveScoreTo, 'saveScoreTo'));
	  html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'), 'Após o prazo, segue pela saída Timeout.');
	  html += '<div class="rounded-xl border border-pink-200 bg-pink-50 p-3 text-xs leading-relaxed text-pink-800">0 a 6: detrator · 7 a 8: neutro · 9 a 10: promotor.<\/div>';
	  break;
    case 'end':
      html += '<p class="text-sm text-gray-500">Fim do fluxo. Nenhuma configuração necessária.<\/p>';
      break;
  }

  box.innerHTML = html;

  box.querySelectorAll('[data-field]').forEach(input => {
    const path = input.dataset.field;
    const handler = () => {
      const val = input.type === 'checkbox' ? input.checked
        : input.type === 'number' ? (input.value === '' ? undefined : Number(input.value))
		: isNumericField(path) ? (input.value === '' ? undefined : Number(input.value))
        : input.value;
      setPath(d, path, val);
      if (node.type === 'httpRequest' && path === 'bodyMode') {
		if ((val === 'json' || val === 'form' || val === 'multipart') && !d.bodyFields.length) d.bodyFields.push({ key: '', value: '', contentType: '' });
      }
      if (node.type === 'httpRequest' && path === 'headerMode') {
        d.headerFields = d.headerFields || [];
        if (val === 'fields' && !d.headerFields.length) d.headerFields.push({ key: '', value: '' });
      }
      const mediaConfig = mediaNodeConfig(node.type);
      if (mediaConfig && path === mediaConfig.urlField) {
        delete d[mediaConfig.pathField];
        delete d[mediaConfig.mimeField];
        delete d.mediaPreviewUrl;
        delete d.mediaName;
      }
      if (node.type === 'assign' && path === 'assignType') delete d.assignId;
      if (node.type === 'condition' && path === 'conditionSource') d.conditionValue = '';
      if ((node.type === 'sendMenu' || node.type === 'sendButtons') && path === 'useFallback' && !val) {
        state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || (edge.sourceHandle !== 'fallback' && !!edge.sourceHandle));
        if (state.armedHandle?.nodeId === node.id && state.armedHandle.handle === 'fallback') state.armedHandle = null;
      }
      renderCanvas();
      if (node.type !== 'sendMenu' && (input.tagName === 'SELECT' || input.type === 'checkbox')) renderInspector();
    };
    input.addEventListener((input.tagName === 'SELECT' || input.type === 'checkbox') ? 'change' : 'input', handler);
  });

  box.querySelectorAll('[data-dd-field]').forEach(wrapper => {
    const path = wrapper.dataset.ddField;
    wrapper.querySelectorAll('input[type=radio]').forEach(radio => radio.addEventListener('change', () => {
      const val = isNumericField(path) ? (radio.value === '' ? undefined : Number(radio.value)) : radio.value;
      setPath(d, path, val);
      if (node.type === 'aiTools' && path.startsWith('actions.')) {
        const index = Number(path.split('.')[1]), action = d.actions[index];
        if (path.endsWith('.type')) d.actions[index] = Object.assign(defaultAIAction(val), { id: action.id });
        if (path.endsWith('.assignType')) delete action.assignId;
      }
      if (node.type === 'httpRequest' && path === 'bodyMode') {
        d.bodyFields = d.bodyFields || [];
		if ((val === 'json' || val === 'form' || val === 'multipart') && !d.bodyFields.length) d.bodyFields.push({ key: '', value: '', contentType: '' });
      }
      if (node.type === 'httpRequest' && path === 'headerMode') {
        d.headerFields = d.headerFields || [];
        if (val === 'fields' && !d.headerFields.length) d.headerFields.push({ key: '', value: '' });
      }
      if (node.type === 'assign' && path === 'assignType') delete d.assignId;
      if (node.type === 'condition' && path === 'conditionSource') d.conditionValue = '';
      closeDropdown(radio);
      renderCanvas();
      renderInspector();
    }));
  });

  box.querySelectorAll('[data-business-days-path]').forEach(input => input.addEventListener('change', () => {
	const path = input.dataset.businessDaysPath;
	const days = Array.from(box.querySelectorAll('[data-business-days-path="' + path + '"]:checked')).map(day => Number(day.value));
	setPath(d, path, days);
	renderCanvas();
  }));

  box.querySelectorAll('[data-format-token]').forEach(button => button.onclick = () => {
	const editor = button.closest('[data-formatted-editor]');
	const input = editor?.querySelector('[data-formatted-text]');
	if (!input) return;
    const token = button.dataset.formatToken;
    const start = input.selectionStart;
    const end = input.selectionEnd;
    const selected = input.value.slice(start, end) || 'texto';
	const replacement = token + selected + token;
	input.setRangeText(replacement, start, end, 'end');
	input.dispatchEvent(new Event('input', { bubbles: true }));
	input.focus();
  });

  box.querySelectorAll('[data-variable-toggle]').forEach(button => button.onclick = () => {
	const editor = button.closest('[data-formatted-editor]');
	const menu = editor?.querySelector('[data-variable-menu]');
	if (menu) menu.classList.toggle('hidden');
  });

  box.querySelectorAll('[data-variable-name]').forEach(button => button.onclick = () => {
	const editor = button.closest('[data-formatted-editor]');
	const input = editor?.querySelector('[data-formatted-text]');
	if (!input) return;
	const variable = '{' + '{' + button.dataset.variableName + '}' + '}';
	input.setRangeText(variable, input.selectionStart, input.selectionEnd, 'end');
	input.dispatchEvent(new Event('input', { bubbles: true }));
	editor.querySelector('[data-variable-menu]')?.classList.add('hidden');
	input.focus();
  });

  if (node.type === 'aiTools') bindAIActions(node, box);
  box.querySelectorAll('[data-open-agent-knowledge]').forEach(button => button.onclick = () => {
	const parentId = box.querySelector('[data-legacy-parent]')?.dataset.legacyParent;
	openAgentKnowledge(state.flowData.nodes.find(n => n.id === parentId));
  });
  box.querySelectorAll('[data-open-sub-port]').forEach(button => button.onclick = () => openSubPort(node.id, button.dataset.openSubPort));
  if (node.type === 'switch') renderSwitchCases(node);
  if (node.type === 'sendMenu') renderMenuSections(node);
  if (node.type === 'sendButtons') renderReplyButtons(node);
  if (node.type === 'httpRequest') {
	bindHTTPCURLImport(node, box);
    renderHTTPHeaderFields(node);
    renderHTTPBodyFields(node);
	bindHTTPTest(node, box);
	renderHTTPResponseMappings(node);
	renderHTTPTestResponse(node);
  }
  bindMediaUploads(node, box);
}

function bindHTTPCURLImport(node, box) {
  const button = box.querySelector('#btn-import-http-curl');
  const input = box.querySelector('#http-curl-command');
  const feedback = box.querySelector('#http-curl-feedback');
  if (!button || !input || !feedback) return;
  button.onclick = async () => {
    const command = input.value.trim();
    if (!command) {
      feedback.textContent = 'Cole um comando cURL antes de importar.';
      feedback.className = 'text-[11px] leading-relaxed text-red-600';
      input.focus();
      return;
    }
    button.disabled = true;
    feedback.textContent = 'Lendo configurações...';
    feedback.className = 'text-[11px] leading-relaxed text-purple-700';
    try {
      const imported = await api('POST', '/flows/api/parse-curl', { command });
	  if (state.selectedNodeId !== node.id || !state.flowData.nodes.includes(node)) return;
	  ['method', 'url', 'headerMode', 'headerFields', 'headersRaw', 'headers', 'bodyMode', 'bodyFields', 'body', 'timeout', 'connectTimeout', 'followRedirects'].forEach(field => delete node.data[field]);
      Object.assign(node.data, imported);
      renderCanvas();
      renderInspector();
      const success = document.getElementById('http-curl-feedback');
      if (success) {
        success.textContent = 'Configurações importadas. Revise os dados antes de salvar.';
        success.className = 'text-[11px] leading-relaxed text-emerald-700';
      }
    } catch (error) {
      feedback.textContent = error.message;
      feedback.className = 'text-[11px] leading-relaxed text-red-600';
      button.disabled = false;
    }
  };
}

function bindHTTPTest(node, box) {
	const button = box.querySelector('#btn-test-http');
	const contextInput = box.querySelector('#http-test-context');
	const feedback = box.querySelector('#http-test-feedback');
	if (!button || !contextInput || !feedback) return;
	contextInput.value = state.httpTestContexts[node.id] || '{}';
	contextInput.oninput = () => { state.httpTestContexts[node.id] = contextInput.value; };
	button.onclick = async () => {
	  let testContext;
	  try {
		testContext = JSON.parse(contextInput.value || '{}');
		if (!testContext || Array.isArray(testContext) || typeof testContext !== 'object') throw new Error('use um objeto JSON');
	  } catch (error) {
		feedback.textContent = 'Contexto de teste inválido: ' + error.message;
		feedback.className = 'text-[11px] text-red-600';
		return;
	  }
	  button.disabled = true;
	  feedback.textContent = 'Executando requisição...';
	  feedback.className = 'text-[11px] text-blue-700';
	  try {
		const config = JSON.parse(JSON.stringify(node.data));
		const response = await api('POST', '/flows/api/test-http', { config, context: testContext });
		if (state.selectedNodeId !== node.id || !state.flowData.nodes.includes(node)) return;
		state.httpTestResponses[node.id] = response;
		feedback.textContent = response.errorType === 'timeout'
		  ? ('Tempo limite de ' + Math.round(Number(response.timeoutMs || 0) / 1000) + 's atingido sem resposta. Aumente o Timeout total, se a API normalmente demora mais.')
		  : response.error ? ('Falha: ' + (response.message || 'erro na requisição')) : ('Resposta recebida · HTTP ' + (response.status || 0));
		feedback.className = 'text-[11px] ' + (response.error ? 'text-red-600' : 'text-emerald-700');
		renderHTTPTestResponse(node);
	  } catch (error) {
		feedback.textContent = error.message;
		feedback.className = 'text-[11px] text-red-600';
	  } finally {
		button.disabled = false;
	  }
	};
}

function renderHTTPTestResponse(node) {
	const container = document.getElementById('http-test-response');
	if (!container) return;
	const response = state.httpTestResponses[node.id];
	if (!response) { container.innerHTML = ''; return; }
	const fields = [];
	collectJSONFields(response.data, '', fields, 0);
	if (!fields.length) {
	  container.innerHTML = '<div class="rounded-lg border border-blue-100 bg-white p-2.5"><p class="text-[11px] text-gray-500">A resposta não possui campos JSON mapeáveis.<\/p><pre class="mt-2 max-h-32 overflow-auto whitespace-pre-wrap break-all text-[10px] text-gray-600">' + escapeHtml(JSON.stringify(response.data, null, 2) || String(response.data || '')) + '<\/pre><\/div>';
	  return;
	}
	container.innerHTML = '<div class="rounded-lg border border-blue-100 bg-white overflow-hidden"><div class="px-3 py-2 border-b border-blue-100 flex items-center justify-between"><span class="text-[11px] font-semibold text-gray-700">Campos retornados<\/span><span class="text-[10px] text-gray-400">' + fields.length + ' caminhos<\/span><\/div><div class="max-h-72 overflow-y-auto divide-y divide-stone-100">' + fields.map(field =>
	  '<div class="px-3 py-2 flex items-center gap-2"><div class="min-w-0 flex-1"><code class="block truncate text-[11px] font-semibold text-purple-700" title="' + escapeAttr(field.path) + '">' + escapeHtml(field.path) + '<\/code><p class="truncate text-[10px] text-gray-400">' + escapeHtml(field.type + ' · ' + field.preview) + '<\/p><\/div><button type="button" data-map-response-path="' + escapeAttr(field.path) + '" class="shrink-0 rounded-md bg-purple-50 px-2 py-1 text-[10px] font-semibold text-purple-700 hover:bg-purple-100">Mapear<\/button><\/div>'
	).join('') + '<\/div><\/div>';
	container.querySelectorAll('[data-map-response-path]').forEach(button => button.onclick = () => {
	  addHTTPResponseMapping(node, button.dataset.mapResponsePath);
	});
}

function collectJSONFields(value, path, output, depth) {
	if (output.length >= 300 || depth > 12) return;
	if (path) output.push({ path, type: jsonValueType(value), preview: jsonValuePreview(value, path) });
	if (Array.isArray(value)) {
	  value.forEach((item, index) => collectJSONFields(item, path + '[' + index + ']', output, depth + 1));
	  return;
	}
	if (value && typeof value === 'object') {
	  Object.entries(value).forEach(([key, item]) => collectJSONFields(item, appendJSONPath(path, key), output, depth + 1));
	}
}

function appendJSONPath(path, key) {
	if (/^[A-Za-z_][A-Za-z0-9_-]*$/.test(key)) return path ? path + '.' + key : key;
	return (path || '$') + '[' + JSON.stringify(key) + ']';
}

function jsonValueType(value) {
	if (value === null) return 'null';
	if (Array.isArray(value)) return 'array';
	return typeof value;
}

function jsonValuePreview(value, path) {
	if (value === null) return 'null';
	if (isSensitiveJSONPath(path)) return '••••••';
	if (Array.isArray(value)) return '[' + value.length + ' itens]';
	if (value && typeof value === 'object') return '{' + Object.keys(value).length + ' campos}';
	const encoded = typeof value === 'string' ? value : JSON.stringify(value);
	return truncate(encoded == null ? '' : encoded, 90);
}

function isSensitiveJSONPath(path) {
	return /cpf|cnpj|document|telefone|email|contato|password|senha|secret|token|authorization|cookie|api.?key|link_quitacao/i.test(path);
}

function responseVariableName(path, mappings) {
	let base = path.replace(/\[(\d+)\]/g, '_$1').split('.').pop() || 'responseValue';
	base = base.replace(/^\[|\]$/g, '').replace(/^"|"$/g, '').replace(/[^A-Za-z0-9_]/g, '_');
	if (!/^[A-Za-z]/.test(base)) base = 'value_' + base;
	base = base.slice(0, 110) || 'responseValue';
	const used = new Set(mappings.map(mapping => String(mapping.variableName || '')));
	let candidate = base, suffix = 2;
	while (used.has(candidate)) candidate = (base.slice(0, 110) + suffix++).slice(0, 120);
	return candidate;
}

function addHTTPResponseMapping(node, path) {
	node.data.responseMappings = node.data.responseMappings || [];
	const existingIndex = node.data.responseMappings.findIndex(mapping => mapping.path === path);
	if (existingIndex >= 0) {
	  document.querySelector('[data-mapping-path="' + existingIndex + '"]')?.focus();
	  return;
	}
	node.data.responseMappings.push({ path, variableName: responseVariableName(path, node.data.responseMappings) });
	renderHTTPResponseMappings(node);
}

function renderHTTPResponseMappings(node) {
	const container = document.getElementById('http-response-mappings');
	const addButton = document.getElementById('btn-add-response-mapping');
	if (!container || !addButton) return;
	node.data.responseMappings = node.data.responseMappings || [];
	container.innerHTML = node.data.responseMappings.length ? node.data.responseMappings.map((mapping, index) =>
	  '<div class="rounded-xl border border-stone-200 bg-stone-50 p-2.5"><div class="grid grid-cols-[1fr_auto] gap-2"><input data-response-mapping-path="' + escapeAttr(mapping.path || '') + '" data-mapping-path="' + index + '" value="' + escapeAttr(mapping.path || '') + '" placeholder="evaluation.result" class="min-w-0 rounded-lg border border-stone-200 bg-white px-2.5 py-2 font-mono text-xs"><button type="button" data-delete-response-mapping="' + index + '" class="px-2 text-red-500 hover:text-red-700"><i class="fas fa-trash"><\/i><\/button><\/div><div class="mt-2 flex items-center gap-2"><i class="fas fa-arrow-right text-[10px] text-gray-400"><\/i><input data-mapping-variable="' + index + '" value="' + escapeAttr(mapping.variableName || '') + '" placeholder="nomeDaVariavel" class="min-w-0 flex-1 rounded-lg border border-stone-200 bg-white px-2.5 py-2 text-xs"><\/div><\/div>'
	).join('') : '<p class="rounded-lg border border-dashed border-stone-200 p-3 text-center text-[11px] text-gray-400">Nenhum campo mapeado.<\/p>';
	container.querySelectorAll('[data-mapping-path]').forEach(input => input.oninput = () => { node.data.responseMappings[Number(input.dataset.mappingPath)].path = input.value; });
	container.querySelectorAll('[data-mapping-variable]').forEach(input => input.oninput = () => { node.data.responseMappings[Number(input.dataset.mappingVariable)].variableName = input.value; });
	container.querySelectorAll('[data-delete-response-mapping]').forEach(button => button.onclick = () => {
	  node.data.responseMappings.splice(Number(button.dataset.deleteResponseMapping), 1);
	  renderHTTPResponseMappings(node);
	});
	addButton.onclick = () => {
	  node.data.responseMappings.push({ path: '', variableName: '' });
	  renderHTTPResponseMappings(node);
	  container.querySelector('[data-mapping-path="' + (node.data.responseMappings.length - 1) + '"]')?.focus();
	};
}

function renderHTTPHeaderFields(node) {
  const wrap = document.getElementById('http-header-fields');
  if (!wrap) return;
  node.data.headerFields = node.data.headerFields || [];
  wrap.innerHTML = node.data.headerFields.map((header, index) =>
    '<div class="grid grid-cols-[1fr_1fr_auto] gap-2 items-center">' +
      '<input data-http-header-key="' + index + '" value="' + escapeAttr(header.key||'') + '" placeholder="Header" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
      '<input data-http-header-value="' + index + '" value="' + escapeAttr(header.value||'') + '" placeholder="Valor" autocomplete="off" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
      '<button type="button" data-http-header-remove="' + index + '" class="w-8 h-8 text-red-500 hover:bg-red-50 rounded-lg"><i class="fas fa-times"><\/i><\/button>' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-http-header-key]').forEach(input => input.oninput = () => {
    node.data.headerFields[Number(input.dataset.httpHeaderKey)].key = input.value;
  });
  wrap.querySelectorAll('[data-http-header-value]').forEach(input => input.oninput = () => {
    node.data.headerFields[Number(input.dataset.httpHeaderValue)].value = input.value;
  });
  wrap.querySelectorAll('[data-http-header-remove]').forEach(button => button.onclick = () => {
    node.data.headerFields.splice(Number(button.dataset.httpHeaderRemove), 1);
    renderHTTPHeaderFields(node);
  });
  const add = document.getElementById('btn-add-http-header');
  if (add) add.onclick = () => {
    node.data.headerFields.push({ key: '', value: '' });
    renderHTTPHeaderFields(node);
    wrap.querySelector('[data-http-header-key="' + (node.data.headerFields.length - 1) + '"]').focus();
  };
}

function renderHTTPBodyFields(node) {
  const wrap = document.getElementById('http-body-fields');
  if (!wrap) return;
  node.data.bodyFields = node.data.bodyFields || [];
	const multipart = node.data.bodyMode === 'multipart';
  wrap.innerHTML = node.data.bodyFields.map((field, index) =>
	'<div class="grid ' + (multipart ? 'grid-cols-[1fr_1fr_1fr_auto]' : 'grid-cols-[1fr_1fr_auto]') + ' gap-2 items-center">' +
      '<input data-http-key="' + index + '" value="' + escapeAttr(field.key||'') + '" placeholder="Chave" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
      '<input data-http-value="' + index + '" value="' + escapeAttr(field.value||'') + '" placeholder="Valor" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
	  (multipart ? '<input data-http-content-type="' + index + '" value="' + escapeAttr(field.contentType||'') + '" placeholder="Content-Type opcional" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' : '') +
      '<button type="button" data-http-remove="' + index + '" class="w-8 h-8 text-red-500 hover:bg-red-50 rounded-lg"><i class="fas fa-times"><\/i><\/button>' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-http-key]').forEach(input => input.oninput = () => {
    node.data.bodyFields[Number(input.dataset.httpKey)].key = input.value;
  });
  wrap.querySelectorAll('[data-http-value]').forEach(input => input.oninput = () => {
    node.data.bodyFields[Number(input.dataset.httpValue)].value = input.value;
  });
	wrap.querySelectorAll('[data-http-content-type]').forEach(input => input.oninput = () => {
		node.data.bodyFields[Number(input.dataset.httpContentType)].contentType = input.value;
	});
  wrap.querySelectorAll('[data-http-remove]').forEach(button => button.onclick = () => {
    node.data.bodyFields.splice(Number(button.dataset.httpRemove), 1);
    renderHTTPBodyFields(node);
  });
  const add = document.getElementById('btn-add-http-field');
  if (add) add.onclick = () => {
	node.data.bodyFields.push({ key: '', value: '', contentType: '' });
    renderHTTPBodyFields(node);
    wrap.querySelector('[data-http-key="' + (node.data.bodyFields.length - 1) + '"]').focus();
  };
}

function bindMediaUploads(node, box) {
  const wrapper = box.querySelector('[data-media-upload]');
  if (!wrapper) return;
  const config = mediaNodeConfig(node.type);
  const input = wrapper.querySelector('[data-media-file]');
  const dropzone = wrapper.querySelector('[data-media-dropzone]');
  const status = wrapper.querySelector('[data-media-status]');

  async function uploadMedia(file) {
    if (!file) return;
    status.textContent = 'Enviando mídia...';
    status.className = 'text-xs text-gray-500 mt-2';
    const form = new FormData();
    form.append('kind', config.kind);
    form.append('file', file, file.name || ('gravacao.' + (file.type.includes('ogg') ? 'ogg' : 'webm')));
    try {
      const response = await fetch('/flows/api/media', { method: 'POST', body: form });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || ('Erro ' + response.status));
      const stored = payload.data;
      delete node.data[config.urlField];
      node.data[config.pathField] = stored.path;
      node.data[config.mimeField] = stored.mimeType;
      node.data.mediaPreviewUrl = stored.url;
      node.data.mediaName = stored.name;
      renderCanvas();
      renderInspector();
    } catch (error) {
      status.textContent = error.message;
      status.className = 'text-xs text-red-600 mt-2';
    }
  }

  input.addEventListener('change', () => uploadMedia(input.files[0]));
  dropzone.addEventListener('dragover', event => {
    event.preventDefault();
    dropzone.classList.add('border-purple-500', 'bg-purple-50');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-purple-500', 'bg-purple-50'));
  dropzone.addEventListener('drop', event => {
    event.preventDefault();
    dropzone.classList.remove('border-purple-500', 'bg-purple-50');
    uploadMedia(event.dataTransfer.files[0]);
  });

  const remove = wrapper.querySelector('[data-media-remove]');
  if (remove) remove.onclick = () => {
    delete node.data[config.urlField];
    delete node.data[config.pathField];
    delete node.data[config.mimeField];
    delete node.data.mediaPreviewUrl;
    delete node.data.mediaName;
    renderCanvas();
    renderInspector();
  };

  const record = wrapper.querySelector('[data-record-audio]');
  if (record) record.onclick = async () => {
    if (record._recorder && record._recorder.state === 'recording') {
      record._recorder.stop();
      return;
    }
    if (!navigator.mediaDevices || !window.MediaRecorder) {
      status.textContent = 'Gravação de áudio não suportada neste navegador.';
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const candidates = ['audio/webm;codecs=opus', 'audio/ogg;codecs=opus', 'audio/webm'];
      const mimeType = candidates.find(type => MediaRecorder.isTypeSupported(type)) || '';
      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
      const chunks = [];
      record._recorder = recorder;
      recorder.ondataavailable = event => { if (event.data.size) chunks.push(event.data); };
      recorder.onstop = () => {
        stream.getTracks().forEach(track => track.stop());
        record.innerHTML = '<i class="fas fa-microphone mr-1"><\/i>Gravar agora';
        record.className = 'mt-2 w-full px-3 py-2 rounded-lg bg-purple-100 text-purple-700 hover:bg-purple-200 text-sm font-medium';
        const type = recorder.mimeType || 'audio/webm';
        const extension = type.includes('ogg') ? 'ogg' : 'webm';
        uploadMedia(new File(chunks, 'gravacao-' + Date.now() + '.' + extension, { type }));
      };
      recorder.start();
      record.innerHTML = '<i class="fas fa-stop mr-1"><\/i>Parar gravação';
      record.className = 'mt-2 w-full px-3 py-2 rounded-lg bg-red-100 text-red-700 hover:bg-red-200 text-sm font-medium';
      status.textContent = 'Gravando...';
    } catch (error) {
      status.textContent = 'Não foi possível acessar o microfone: ' + error.message;
      status.className = 'text-xs text-red-600 mt-2';
    }
  };
}

function renderMenuSections(node) {
  const wrap = document.getElementById('menu-sections');
  if (!wrap) return;
  wrap.innerHTML = node.data.sections.map((section, sectionIndex) =>
    '<div class="p-2.5 bg-stone-50 rounded-xl border border-stone-200 flex flex-col gap-2">' +
      '<div class="flex items-center gap-1.5">' +
        '<input data-menu-section-title="' + sectionIndex + '" value="' + escapeAttr(section.title||'') + '" placeholder="Nome da seção" class="flex-1 px-2 py-1.5 bg-white border border-stone-200 rounded text-xs font-medium">' +
        '<button data-menu-section-del="' + sectionIndex + '" class="text-gray-300 hover:text-red-500"><i class="fas fa-trash text-xs"><\/i><\/button>' +
      '<\/div>' +
      '<div class="flex flex-col gap-2">' + (section.rows || []).map((row, rowIndex) =>
        '<div class="p-2 bg-white rounded-lg border border-stone-100 flex flex-col gap-1.5">' +
          '<div class="flex items-center gap-1.5">' +
            '<input data-menu-row-title="' + sectionIndex + ':' + rowIndex + '" value="' + escapeAttr(row.title||'') + '" placeholder="Texto da opção" class="flex-1 px-2 py-1.5 bg-stone-50 border border-stone-200 rounded text-xs">' +
            '<button data-menu-row-del="' + sectionIndex + ':' + rowIndex + '" class="text-gray-300 hover:text-red-500"><i class="fas fa-times text-xs"><\/i><\/button>' +
          '<\/div>' +
          '<input data-menu-row-description="' + sectionIndex + ':' + rowIndex + '" value="' + escapeAttr(row.description||'') + '" placeholder="Descrição (opcional)" class="px-2 py-1.5 bg-stone-50 border border-stone-200 rounded text-xs">' +
          '<input data-menu-row-id="' + sectionIndex + ':' + rowIndex + '" value="' + escapeAttr(row.rowId||'') + '" placeholder="ID da resposta, ex: vendas" class="px-2 py-1.5 bg-stone-50 border border-stone-200 rounded text-xs font-mono">' +
        '<\/div>'
      ).join('') + '<\/div>' +
      '<button data-menu-row-add="' + sectionIndex + '" class="text-left text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar opção<\/button>' +
    '<\/div>'
  ).join('');

  wrap.querySelectorAll('[data-menu-section-title]').forEach(input => input.oninput = () => {
    node.data.sections[Number(input.dataset.menuSectionTitle)].title = input.value;
  });
  wrap.querySelectorAll('[data-menu-section-del]').forEach(button => button.onclick = () => {
    const sectionIndex = Number(button.dataset.menuSectionDel);
    const handles = new Set((node.data.sections[sectionIndex].rows || []).map(row => 'menu-' + row._handleId));
    state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || !handles.has(edge.sourceHandle));
    node.data.sections.splice(sectionIndex, 1);
    renderCanvas();
    renderInspector();
  });
  wrap.querySelectorAll('[data-menu-row-add]').forEach(button => button.onclick = () => {
    const sectionIndex = Number(button.dataset.menuRowAdd);
    const section = node.data.sections[sectionIndex];
    const number = section.rows.length + 1;
    section.rows.push({ title: 'Opção ' + number, description: '', rowId: 'secao_' + (sectionIndex + 1) + '_opcao_' + number, _handleId: uid('mh') });
    renderCanvas();
    renderInspector();
  });
  wrap.querySelectorAll('[data-menu-row-del]').forEach(button => button.onclick = () => {
    const [sectionIndex, rowIndex] = button.dataset.menuRowDel.split(':').map(Number);
    const handle = 'menu-' + node.data.sections[sectionIndex].rows[rowIndex]._handleId;
    state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || edge.sourceHandle !== handle);
    node.data.sections[sectionIndex].rows.splice(rowIndex, 1);
    renderCanvas();
    renderInspector();
  });
  wrap.querySelectorAll('[data-menu-row-title], [data-menu-row-description], [data-menu-row-id]').forEach(input => input.oninput = () => {
    const key = input.hasAttribute('data-menu-row-title') ? 'title' : input.hasAttribute('data-menu-row-description') ? 'description' : 'rowId';
    const indexes = input.dataset.menuRowTitle || input.dataset.menuRowDescription || input.dataset.menuRowId;
    const [sectionIndex, rowIndex] = indexes.split(':').map(Number);
    node.data.sections[sectionIndex].rows[rowIndex][key] = input.value;
    if (key === 'title') renderCanvas();
  });

  const addSection = document.getElementById('btn-add-menu-section');
  if (addSection) addSection.onclick = () => {
    const number = node.data.sections.length + 1;
    node.data.sections.push({ title: 'Seção ' + number, rows: [{ title: 'Opção 1', description: '', rowId: 'secao_' + number + '_opcao_1', _handleId: uid('mh') }] });
    renderCanvas();
    renderInspector();
  };
}

function renderReplyButtons(node) {
  const wrap = document.getElementById('reply-buttons');
  if (!wrap) return;
  wrap.innerHTML = node.data.buttons.map((button, index) =>
    '<div class="p-2.5 bg-stone-50 rounded-xl border border-stone-200 flex flex-col gap-2">' +
      '<div class="flex items-center gap-1.5"><input data-button-text="' + index + '" maxlength="25" value="' + escapeAttr(button.text || '') + '" placeholder="Texto do botão" class="flex-1 min-w-0 px-2 py-1.5 bg-white border border-stone-200 rounded text-xs">' +
      '<button type="button" data-button-remove="' + index + '" class="text-red-500" aria-label="Remover botão"><i class="fas fa-times"><\/i><\/button><\/div>' +
      '<input data-button-id="' + index + '" maxlength="100" value="' + escapeAttr(button.id || '') + '" placeholder="ID da resposta, ex: suporte" class="px-2 py-1.5 bg-white border border-stone-200 rounded text-xs font-mono">' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-button-text], [data-button-id]').forEach(input => input.oninput = () => {
    const index = Number(input.dataset.buttonText ?? input.dataset.buttonId);
    node.data.buttons[index][input.hasAttribute('data-button-text') ? 'text' : 'id'] = input.value;
    renderCanvas();
  });
  wrap.querySelectorAll('[data-button-remove]').forEach(button => button.onclick = () => {
    const index = Number(button.dataset.buttonRemove);
    const handle = 'button-' + node.data.buttons[index]._handleId;
    state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || edge.sourceHandle !== handle);
    node.data.buttons.splice(index, 1);
    renderCanvas();
    renderInspector();
  });
  const add = document.getElementById('btn-add-reply-button');
  add.disabled = node.data.buttons.length >= 3;
  add.classList.toggle('opacity-40', add.disabled);
  add.onclick = () => {
    if (node.data.buttons.length >= 3) return;
    const index = node.data.buttons.length + 1;
    node.data.buttons.push({ text: 'Opção ' + index, id: 'opcao_' + index, _handleId: uid('bh') });
    renderCanvas();
    renderInspector();
  };
}

function renderSwitchCases(node) {
  const wrap = document.getElementById('switch-cases');
  if (!wrap) return;
  wrap.innerHTML = node.data.cases.map((c, i) =>
    '<div class="flex flex-col gap-1 p-2 bg-stone-50 rounded-lg border border-stone-100">' +
      '<div class="flex items-center gap-1.5">' +
        '<input data-case-label="' + i + '" value="' + escapeAttr(c.label||'') + '" placeholder="Nome da opção" class="flex-1 px-2 py-1.5 bg-white border border-stone-200 rounded text-xs">' +
        '<button data-case-del="' + i + '" class="text-gray-300 hover:text-red-500"><i class="fas fa-times text-xs"><\/i><\/button>' +
      '<\/div>' +
      '<input data-case-cond="' + i + '" value="' + escapeAttr(c.condition||'') + '" placeholder=\'condição, ex: response == "1"\' class="px-2 py-1.5 bg-white border border-stone-200 rounded text-xs">' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-case-label]').forEach(inp => inp.oninput = () => { node.data.cases[Number(inp.dataset.caseLabel)].label = inp.value; renderCanvas(); });
  wrap.querySelectorAll('[data-case-cond]').forEach(inp => inp.oninput = () => { node.data.cases[Number(inp.dataset.caseCond)].condition = inp.value; });
  wrap.querySelectorAll('[data-case-del]').forEach(btn => btn.onclick = () => {
    const i = Number(btn.dataset.caseDel);
    const removedHandle = 'case-' + i;
    node.data.cases.splice(i, 1);
    state.flowData.edges = state.flowData.edges.filter(e => !(e.source === node.id && e.sourceHandle === removedHandle));
    state.flowData.edges.forEach(e => {
      if (e.source === node.id && e.sourceHandle && e.sourceHandle.startsWith('case-')) {
        const idx = Number(e.sourceHandle.split('-')[1]);
        if (idx > i) e.sourceHandle = 'case-' + (idx - 1);
      }
    });
    renderCanvas();
    renderInspector();
  });
  const addBtn = document.getElementById('btn-add-case');
  if (addBtn) addBtn.onclick = () => {
    node.data.cases.push({ label: 'Opção ' + (node.data.cases.length + 1), condition: '' });
    renderCanvas();
    renderInspector();
  };
}

// Fields that store record ids, also when nested (actions.0.assignId).
function isNumericField(path) {
	const key = String(path).split('.').pop();
	return ['assignId', 'departmentId', 'flowId', 'templateId', 'aiAgentId', 'credentialId'].includes(key);
}

function aiActionListHTML(title, addAttr, rows) {
	return '<div><div class="mb-1 flex items-center justify-between gap-2"><span class="text-xs font-medium text-gray-600">' + title + '<\/span><button type="button" ' + addAttr + ' class="text-xs font-semibold text-purple-700 hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar<\/button><\/div><div class="flex flex-col gap-2">' + rows + '<\/div><\/div>';
}

// aiActionsHTML renders the action editor of an "Ações da IA" block. Inputs
// use data-field paths (actions.N.field), so the inspector's generic
// bindings save them; bindAIActions wires the add/remove buttons.
function aiActionsHTML(d) {
	d.actions = Array.isArray(d.actions) ? d.actions : [];
	const smallInput = (value, path, placeholder, extra) => '<input data-field="' + path + '" value="' + escapeAttr(value || '') + '" placeholder="' + escapeAttr(placeholder) + '" ' + (extra || '') + ' class="min-w-0 w-full rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-purple-400">';
	const removeButton = (attr, value, label) => '<button type="button" ' + attr + '="' + value + '" class="grid h-7 w-7 shrink-0 place-items-center rounded-lg text-red-500 hover:bg-red-50" aria-label="' + label + '"><i class="fas fa-times"><\/i><\/button>';
	const cards = d.actions.map((action, i) => {
		const p = 'actions.' + i + '.';
		let body = field('Tipo de ação', inspectorSelect(p + 'type', AI_ACTION_TYPES, action.type, 'Selecione'));
		body += field('Nome', textInput(action.name, p + 'name'));
		body += field('Quando usar', textArea(action.description, p + 'description', 3), 'Explique para a IA em que situação esta ação deve ser executada.');
		switch (action.type) {
		case 'transfer': {
			const department = action.assignType !== 'agent';
			const options = department ? state.departments : state.agents;
			body += field('Transferir para', inspectorSelect(p + 'assignType', [{ value: 'department', label: 'Setor' }, { value: 'agent', label: 'Agente' }], department ? 'department' : 'agent', 'Selecione'));
			body += field(department ? 'Setor' : 'Agente', inspectorSelect(p + 'assignId', [{ value: '', label: 'Selecione' }].concat(options.map(option => ({ value: String(option.id), label: option.name }))), action.assignId || '', 'Selecione'));
			body += field('Mensagem automática (opcional)', textArea(action.message, p + 'message', 2), 'Enviada depois da resposta da IA, antes da transferência. Aceita variáveis do fluxo. A IA também deixa um resumo no histórico do atendimento.');
			break;
		}
		case 'close':
			body += field('Mensagem automática (opcional)', textArea(action.message, p + 'message', 2), 'Enviada depois da despedida da IA, antes de encerrar o atendimento.');
			break;
		case 'pause':
			body += field('Pausar por (minutos)', '<input type="number" min="0" max="43200" data-field="' + p + 'pauseMinutes" value="' + Number(action.pauseMinutes || 0) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', '0 mantém a IA pausada até um atendente transferir, aceitar ou encerrar a conversa. Até 43200 (30 dias); depois disso a IA volta a responder. Durante a pausa, nenhum fluxo é iniciado nessa conversa.');
			body += field('Mensagem automática (opcional)', textArea(action.message, p + 'message', 2), 'Enviada depois da resposta da IA, quando a pausa começa. A IA registra o motivo no histórico.');
			break;
		case 'summary':
			body += '<p class="rounded-lg border border-violet-100 bg-white p-2.5 text-[11px] leading-relaxed text-gray-600"><i class="fas fa-note-sticky mr-1 text-violet-600"><\/i> A IA escreve um resumo da conversa e o publica como <strong>nota interna<\/strong> no chat. Só a equipe vê; o cliente não recebe nada.<\/p>';
			break;
		case 'tag':
			body += field('Etiqueta', textInput(action.tag, p + 'tag'));
			break;
		case 'contactField':
			body += field('Campo do cliente', inspectorSelect(p + 'field', [{ value: 'name', label: 'Nome' }, { value: 'email', label: 'Email' }, { value: 'custom', label: 'Campo personalizado' }], action.field || 'email', 'Selecione'));
			if (action.field === 'custom') body += field('Chave do campo', textInput(action.fieldKey, p + 'fieldKey'), 'Começa com letra; use letras, números e _. Ex.: cpf, empresa.');
			break;
		case 'http': {
			action.headers = Array.isArray(action.headers) ? action.headers : [];
			action.parameters = Array.isArray(action.parameters) ? action.parameters : [];
			body += field('Método', inspectorSelect(p + 'method', ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'].map(method => ({ value: method, label: method })), action.method || 'POST', 'Selecione'));
			body += field('URL', textInput(action.url, p + 'url'), 'Use ' + VAR_OPEN + 'parametro' + VAR_CLOSE + ' para pôr um parâmetro na URL; os demais vão no corpo JSON (ou na query, em GET e DELETE). Somente destinos públicos.');
			body += aiActionListHTML('Parâmetros que a IA preenche', 'data-ai-param-add="' + i + '"', action.parameters.map((parameter, j) =>
				'<div class="rounded-lg border border-stone-200 bg-white p-2"><div class="flex items-center gap-2">' +
					smallInput(parameter.name, p + 'parameters.' + j + '.name', 'nome') +
					'<label class="flex shrink-0 items-center gap-1 text-[11px] text-gray-600"><input type="checkbox" data-field="' + p + 'parameters.' + j + '.required" ' + (parameter.required ? 'checked' : '') + '> Obrigatório<\/label>' +
					removeButton('data-ai-param-remove', i + ':' + j, 'Remover parâmetro') +
				'<\/div><div class="mt-2">' + smallInput(parameter.description, p + 'parameters.' + j + '.description', 'O que a IA deve informar') + '<\/div><\/div>').join(''));
			body += aiActionListHTML('Cabeçalhos', 'data-ai-header-add="' + i + '"', action.headers.map((header, j) =>
				'<div class="flex items-center gap-2">' + smallInput(header.key, p + 'headers.' + j + '.key', 'Header') + smallInput(header.value, p + 'headers.' + j + '.value', 'Valor', 'autocomplete="off"') +
				removeButton('data-ai-header-remove', i + ':' + j, 'Remover cabeçalho') + '<\/div>').join(''));
			body += field('Timeout (ms)', numberInput(action.timeout, p + 'timeout'), 'Entre 100 e 60000. A resposta da API é repassada à IA para ela continuar a conversa.');
			break;
		}
		}
		return '<div class="rounded-xl border border-stone-200 bg-stone-50 p-3"><div class="mb-2 flex items-center justify-between gap-2"><span class="text-xs font-bold text-gray-700"><i class="fas fa-bolt mr-1 text-violet-600"><\/i>Ação ' + (i + 1) + '<\/span><button type="button" data-ai-action-remove="' + i + '" class="text-xs font-medium text-red-600 hover:underline">Remover<\/button><\/div><div class="flex flex-col gap-3">' + body + '<\/div><\/div>';
	});
	return '<div class="flex flex-col gap-3">' + (cards.join('') || '<p class="text-xs text-gray-500">Nenhuma ação cadastrada.<\/p>') +
		'<button type="button" data-ai-action-add class="rounded-lg border border-dashed border-violet-300 px-3 py-2 text-sm font-semibold text-violet-700 hover:bg-violet-50"><i class="fas fa-plus mr-1"><\/i>Adicionar ação<\/button><\/div>';
}

function bindAIActions(node, box) {
	const actions = node.data.actions;
	const rerender = () => { renderCanvas(); renderInspector(); };
	const pair = value => String(value).split(':').map(Number);
	box.querySelectorAll('[data-ai-action-add]').forEach(button => button.onclick = () => { actions.push(defaultAIAction('transfer')); rerender(); });
	box.querySelectorAll('[data-ai-action-remove]').forEach(button => button.onclick = () => { actions.splice(Number(button.dataset.aiActionRemove), 1); rerender(); });
	box.querySelectorAll('[data-ai-param-add]').forEach(button => button.onclick = () => { actions[Number(button.dataset.aiParamAdd)].parameters.push({ name: '', description: '', required: false }); rerender(); });
	box.querySelectorAll('[data-ai-param-remove]').forEach(button => button.onclick = () => { const [i, j] = pair(button.dataset.aiParamRemove); actions[i].parameters.splice(j, 1); rerender(); });
	box.querySelectorAll('[data-ai-header-add]').forEach(button => button.onclick = () => { actions[Number(button.dataset.aiHeaderAdd)].headers.push({ key: '', value: '' }); rerender(); });
	box.querySelectorAll('[data-ai-header-remove]').forEach(button => button.onclick = () => { const [i, j] = pair(button.dataset.aiHeaderRemove); actions[i].headers.splice(j, 1); rerender(); });
}

function setPath(obj, path, val) {
  const parts = path.split('.');
  let cur = obj;
  for (let i = 0; i < parts.length - 1; i++) {
    cur[parts[i]] = cur[parts[i]] || {};
    cur = cur[parts[i]];
  }
  if (val === undefined) delete cur[parts[parts.length - 1]];
  else cur[parts[parts.length - 1]] = val;
}

// delegate node delete clicks (rendered inside dynamically built cards)
document.addEventListener('click', (e) => {
  const delBtn = e.target.closest('[data-del-node]');
  if (delBtn) { e.stopPropagation(); deleteNode(delBtn.dataset.delNode); }
});

// ---------------------------------------------------------------------
// Utils
// ---------------------------------------------------------------------
function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
function escapeAttr(s) { return escapeHtml(s); }

function resetTemplateForm(template) {
	document.getElementById('template-id').value = template?.id || '';
	document.getElementById('template-revision').value = template?.revision || '';
	document.getElementById('template-name').value = template?.name || '';
	document.getElementById('template-content').value = template?.content || '';
}

function insertFormattedSelection(input, token) {
	const start = input.selectionStart;
	const end = input.selectionEnd;
	const selected = input.value.slice(start, end) || 'texto';
	input.setRangeText(token + selected + token, start, end, 'end');
	input.dispatchEvent(new Event('input', { bubbles: true }));
	input.focus();
}

function renderTemplateVariables() {
	const menu = document.getElementById('template-variables');
	const variables = availableFlowVariables();
	const render = variable => '<button type="button" data-template-variable="' + escapeAttr(variable.name) + '" class="w-full px-3 py-2 text-left hover:bg-purple-50"><span class="block text-xs font-medium text-gray-700">' + escapeHtml(variable.label) + '<\/span><code class="text-[10px] text-purple-600">{' + '{' + escapeHtml(variable.name) + '}' + '}<\/code><\/button>';
	menu.innerHTML = variableAccordions(variables, render);
	menu.querySelectorAll('[data-template-variable]').forEach(button => button.onclick = () => {
	  const input = document.getElementById('template-content');
	  input.setRangeText('{' + '{' + button.dataset.templateVariable + '}' + '}', input.selectionStart, input.selectionEnd, 'end');
	  menu.classList.add('hidden');
	  input.focus();
	});
}

function renderTemplatesList() {
	const list = document.getElementById('templates-list');
	list.innerHTML = state.templates.length ? state.templates.map(template =>
	  '<div class="rounded-xl border border-stone-200 p-3"><div class="flex items-start justify-between gap-2"><button type="button" data-edit-template="' + template.id + '" class="text-left min-w-0 flex-1"><strong class="text-sm text-gray-800">' + escapeHtml(template.name) + '<\/strong><p class="mt-1 text-xs text-gray-500 line-clamp-2">' + escapeHtml(template.content) + '<\/p><\/button><button type="button" data-delete-template="' + template.id + '" class="p-1 text-red-500 hover:text-red-700"><i class="fas fa-trash"><\/i><\/button><\/div><\/div>'
	).join('') : '<p class="text-sm text-gray-400 text-center py-10">Nenhum modelo cadastrado.<\/p>';
	list.querySelectorAll('[data-edit-template]').forEach(button => button.onclick = () => resetTemplateForm(state.templates.find(template => template.id === Number(button.dataset.editTemplate))));
	list.querySelectorAll('[data-delete-template]').forEach(button => button.onclick = async () => {
	  if (!confirm('Excluir este modelo? Fluxos já iniciados manterão o snapshot atual.')) return;
	  try {
		await api('DELETE', '/flows/api/templates/' + button.dataset.deleteTemplate);
		state.templates = await api('GET', '/flows/api/templates');
		resetTemplateForm();
		renderTemplatesList();
	  } catch (error) { alert('Não foi possível excluir o modelo: ' + error.message); }
	});
}

function openTemplatesModal() {
	const modal = document.getElementById('templates-modal');
	modal.classList.remove('hidden');
	modal.classList.add('flex');
	resetTemplateForm();
	renderTemplateVariables();
	renderTemplatesList();
}

function closeTemplatesModal() {
	const modal = document.getElementById('templates-modal');
	modal.classList.add('hidden');
	modal.classList.remove('flex');
}

// ---------------------------------------------------------------------
// Boot
// ---------------------------------------------------------------------
// ---------------------------------------------------------------------
// JSON import/export
// ---------------------------------------------------------------------
// The file is self-describing: alongside the graph it carries the names of
// the company records the blocks point to, so another company can rebind
// them, and the uploaded media, which live in per-company storage.
const FLOW_FILE_FORMAT = 'sophus.flow';
const FLOW_FILE_VERSION = 1;
const MAX_FLOW_FILE_BYTES = 150 * 1024 * 1024;
const MEDIA_NODE_TYPES = ['sendImage', 'sendVideo', 'sendAudio', 'sendFile'];
const SENSITIVE_HEADER = new RegExp('authorization|token|api[-_ ]?key|secret|password|senha|cookie|credential', 'i');
let pendingFlowExport = null;

function cloneJSON(value) { return JSON.parse(JSON.stringify(value)); }
function sameName(a, b) { return String(a || '').trim().toLowerCase() === String(b || '').trim().toLowerCase(); }
function nodeLabel(node) { return (NODE_TYPES[node.type] && NODE_TYPES[node.type].label) || node.type; }

function flowReferenceCatalog(flow, flowData) {
	const refs = { flows: {}, templates: {}, aiAgents: {}, aiCredentials: {}, agents: {}, departments: {}, connection: null };
	const remember = (bucket, list, id) => {
		const item = list.find(entry => entry.id === Number(id));
		if (item) refs[bucket][item.id] = item.provider ? { name: item.name, provider: item.provider } : { name: item.name };
	};
	(flowData.nodes || []).forEach(node => {
		const d = node.data || {};
		if (node.type === 'subflow') remember('flows', state.flows, d.flowId);
		if (node.type === 'sendTemplate') remember('templates', state.templates, d.templateId);
		if (d.aiAgentId) remember('aiAgents', state.aiAgents, d.aiAgentId);
		if (d.credentialId) remember('aiCredentials', state.aiCredentials, d.credentialId);
		if (node.type === 'assign') remember(d.assignType === 'department' ? 'departments' : 'agents', d.assignType === 'department' ? state.departments : state.agents, d.assignId);
		if (node.type === 'smartAssign' && d.departmentId) remember('departments', state.departments, d.departmentId);
		if (node.type === 'aiTools') (d.actions || []).forEach(action => {
			if (action.type === 'transfer') remember(action.assignType === 'agent' ? 'agents' : 'departments', action.assignType === 'agent' ? state.agents : state.departments, action.assignId);
		});
	});
	const noResponse = flowData.settings && flowData.settings.noResponse;
	if (noResponse && noResponse.targetId) remember(noResponse.targetType === 'department' ? 'departments' : 'agents', noResponse.targetType === 'department' ? state.departments : state.agents, noResponse.targetId);
	const connection = state.connections.find(entry => entry.id === Number(flow.connectionId));
	if (connection) refs.connection = { id: connection.id, name: connection.name };
	return refs;
}

// Secrets live in callback tokens and HTTP headers; they leave the company
// only when the administrator explicitly opts in.
function flowSecrets(flowData) {
	const found = [];
	(flowData.nodes || []).forEach(node => {
		const d = node.data || {};
		if (node.type === 'callback' && d.token) found.push(nodeLabel(node) + ': token Bearer');
		if (node.type === 'aiTools') (d.actions || []).forEach(action => (action.headers || []).forEach(header => {
			if (header.value && SENSITIVE_HEADER.test(header.key || '')) found.push(nodeLabel(node) + ' "' + (action.name || 'ação') + '": header ' + header.key);
		}));
		if (node.type !== 'httpRequest') return;
		(d.headerFields || []).forEach(header => { if (header.value && SENSITIVE_HEADER.test(header.key || '')) found.push(nodeLabel(node) + ': header ' + header.key); });
		let raw = d.headers && typeof d.headers === 'object' ? d.headers : null;
		if (d.headersRaw) { try { raw = JSON.parse(d.headersRaw); } catch (_) { found.push(nodeLabel(node) + ': headers JSON'); raw = null; } }
		if (raw) Object.keys(raw).forEach(key => { if (raw[key] && SENSITIVE_HEADER.test(key)) found.push(nodeLabel(node) + ': header ' + key); });
	});
	return found;
}

function removeFlowSecrets(flowData) {
	(flowData.nodes || []).forEach(node => {
		const d = node.data || {};
		if (node.type === 'callback') delete d.token;
		if (node.type === 'aiTools') (d.actions || []).forEach(action => (action.headers || []).forEach(header => { if (SENSITIVE_HEADER.test(header.key || '')) header.value = ''; }));
		if (node.type !== 'httpRequest') return;
		(d.headerFields || []).forEach(header => { if (SENSITIVE_HEADER.test(header.key || '')) header.value = ''; });
		const clean = headers => { Object.keys(headers).forEach(key => { if (SENSITIVE_HEADER.test(key)) headers[key] = ''; }); return headers; };
		if (d.headers && typeof d.headers === 'object') clean(d.headers);
		if (d.headersRaw) { try { d.headersRaw = JSON.stringify(clean(JSON.parse(d.headersRaw)), null, 2); } catch (_) { d.headersRaw = ''; } }
	});
}

function blobToDataURL(blob) {
	return new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = () => reject(reader.error); reader.readAsDataURL(blob); });
}

function dataURLToBlob(dataURL) {
	const comma = dataURL.indexOf(',');
	const header = dataURL.slice(5, comma);
	if (comma < 0 || !header.endsWith(';base64')) throw new Error('conteúdo inválido');
	const binary = atob(dataURL.slice(comma + 1));
	const bytes = new Uint8Array(binary.length);
	for (let index = 0; index < binary.length; index++) bytes[index] = binary.charCodeAt(index);
	return new Blob([bytes], { type: header.slice(0, -7) });
}

async function embedFlowMedia(flowData) {
	const media = [], warnings = [];
	for (const node of flowData.nodes || []) {
		if (!MEDIA_NODE_TYPES.includes(node.type)) continue;
		const config = mediaNodeConfig(node.type), d = node.data || {};
		if (!d[config.pathField]) continue;
		try {
			if (!d.mediaPreviewUrl) throw new Error('sem endereço de download');
			const response = await fetch(d.mediaPreviewUrl, { credentials: 'same-origin' });
			if (!response.ok) throw new Error('HTTP ' + response.status);
			const blob = await response.blob();
			media.push({ nodeId: node.id, kind: config.kind, name: d.mediaName || d[config.pathField], mimeType: d[config.mimeField] || blob.type, data: await blobToDataURL(blob) });
			delete d[config.pathField]; delete d.mediaPreviewUrl;
		} catch (error) {
			warnings.push('A mídia do bloco "' + nodeLabel(node) + '" não foi incluída (' + error.message + ').');
		}
	}
	return { media, warnings };
}

function flowFileName(name) {
	const slug = String(name || 'fluxo').normalize('NFD').replace(new RegExp('[\\u0300-\\u036f]', 'g'), '').toLowerCase().replace(new RegExp('[^a-z0-9]+', 'g'), '-').replace(new RegExp('^-+|-+$', 'g'), '');
	return (slug || 'fluxo') + '.sophus-flow.json';
}

function openFlowExport(flow, flowData) {
	pendingFlowExport = { flow: cloneJSON(flow), flowData: cloneJSON(flowData) };
	const secrets = flowSecrets(pendingFlowExport.flowData);
	const mediaCount = (pendingFlowExport.flowData.nodes || []).filter(node => MEDIA_NODE_TYPES.includes(node.type) && node.data && node.data[mediaNodeConfig(node.type).pathField]).length;
	document.getElementById('flow-export-title').textContent = flow.name || 'Fluxo sem nome';
	document.getElementById('flow-export-summary').textContent = (pendingFlowExport.flowData.nodes || []).length + ' blocos, ' + (pendingFlowExport.flowData.edges || []).length + ' conexões' + (mediaCount ? ' e ' + mediaCount + (mediaCount === 1 ? ' mídia enviada' : ' mídias enviadas') : '') + '.';
	document.getElementById('flow-export-secrets-field').classList.toggle('hidden', secrets.length === 0);
	document.getElementById('flow-export-secrets').checked = false;
	document.getElementById('flow-export-secrets-list').textContent = 'Encontrados: ' + secrets.join(', ') + '. Sem esta opção eles ficam vazios no arquivo.';
	const status = document.getElementById('flow-export-status'); status.classList.add('hidden'); status.textContent = '';
	document.getElementById('flow-export-submit').disabled = false;
	document.getElementById('flow-export-modal').showModal();
}

async function exportSavedFlow(id) {
	try {
		const flow = await api('GET', '/flows/api/' + id);
		openFlowExport(flow, flow.flowData && flow.flowData.nodes ? flow.flowData : blankFlowData());
	} catch (error) { alert('Não foi possível carregar o fluxo: ' + error.message); }
}

async function downloadFlowExport() {
	if (!pendingFlowExport) return;
	const submit = document.getElementById('flow-export-submit'), status = document.getElementById('flow-export-status');
	submit.disabled = true; status.className = 'rounded-xl bg-stone-50 p-3 text-xs text-gray-600'; status.textContent = 'Preparando arquivo...';
	try {
		const flow = pendingFlowExport.flow, flowData = cloneJSON(pendingFlowExport.flowData);
		const includeSecrets = document.getElementById('flow-export-secrets').checked;
		if (!includeSecrets) removeFlowSecrets(flowData);
		const references = flowReferenceCatalog(flow, flowData);
		const embedded = await embedFlowMedia(flowData);
		const file = {
			format: FLOW_FILE_FORMAT, version: FLOW_FILE_VERSION, exportedAt: new Date().toISOString(),
			flow: { name: flow.name || '', description: flow.description || '', triggerType: flow.triggerType || 'keyword', triggerValue: flow.triggerValue || '', priority: Number(flow.priority || 0), flowData },
			references, media: embedded.media, secretsIncluded: includeSecrets,
		};
		const link = document.createElement('a');
		link.href = URL.createObjectURL(new Blob([JSON.stringify(file, null, 2)], { type: 'application/json' }));
		link.download = flowFileName(flow.name);
		document.body.appendChild(link); link.click(); link.remove();
		setTimeout(() => URL.revokeObjectURL(link.href), 1000);
		if (embedded.warnings.length) { status.className = 'rounded-xl bg-amber-50 p-3 text-xs text-amber-800'; status.textContent = 'Arquivo baixado com avisos: ' + embedded.warnings.join(' '); submit.disabled = false; return; }
		document.getElementById('flow-export-modal').close();
	} catch (error) {
		status.className = 'rounded-xl bg-red-50 p-3 text-xs text-red-700'; status.textContent = 'Não foi possível exportar: ' + error.message; submit.disabled = false;
	}
}

// parseFlowFile accepts the export format and, for convenience, a bare
// flowData object ({nodes, edges}). The server validates again on save.
function parseFlowFile(text) {
	let parsed;
	try { parsed = JSON.parse(text); } catch (_) { throw new Error('o arquivo não é um JSON válido.'); }
	if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('o arquivo não contém um fluxo.');
	let flow, references = {}, media = [];
	if (parsed.format === FLOW_FILE_FORMAT) {
		if (Number(parsed.version) > FLOW_FILE_VERSION) throw new Error('o arquivo foi gerado por uma versão mais nova do DoveChat (versão ' + parsed.version + ').');
		flow = parsed.flow || {}; references = parsed.references || {}; media = Array.isArray(parsed.media) ? parsed.media : [];
	} else if (Array.isArray(parsed.nodes)) {
		flow = { flowData: parsed };
	} else if (parsed.flowData && Array.isArray(parsed.flowData.nodes)) {
		flow = parsed;
	} else {
		throw new Error('formato não reconhecido; use um arquivo exportado pelo DoveChat.');
	}
	const flowData = flow.flowData;
	if (!flowData || !Array.isArray(flowData.nodes) || (flowData.edges !== undefined && !Array.isArray(flowData.edges))) throw new Error('o fluxo não possui blocos.');
	flowData.edges = flowData.edges || [];
	flowData.settings = flowData.settings && typeof flowData.settings === 'object' ? flowData.settings : {};
	const ids = new Set();
	for (const node of flowData.nodes) {
		if (!node || typeof node.id !== 'string' || !node.id || ids.has(node.id)) throw new Error('há blocos sem identificador ou com identificador repetido.');
		if (!NODE_TYPES[node.type]) throw new Error('tipo de bloco desconhecido: ' + node.type + '.');
		ids.add(node.id);
		node.data = node.data && typeof node.data === 'object' ? node.data : {};
		node.position = { x: Number(node.position && node.position.x) || 0, y: Number(node.position && node.position.y) || 0 };
	}
	if (flowData.nodes.filter(node => node.type === 'start').length !== 1) throw new Error('o fluxo precisa ter exatamente um bloco de Início.');
	for (const edge of flowData.edges) {
		if (!edge || !ids.has(edge.source) || !ids.has(edge.target)) throw new Error('há conexões apontando para blocos inexistentes.');
	}
	const triggerType = ['keyword', 'exact', 'always'].includes(flow.triggerType) ? flow.triggerType : 'keyword';
	return {
		flow: { name: String(flow.name || 'Fluxo importado').slice(0, 200), description: String(flow.description || ''), triggerType, triggerValue: String(flow.triggerValue || ''), priority: Math.max(-1000, Math.min(1000, Number(flow.priority) || 0)) },
		flowData, references, media,
	};
}

// Rebinds ids to this company: kept when the record exists here, matched by
// name otherwise, cleared with a warning when nothing matches.
function rebindFlowReferences(flowData, references) {
	const warnings = [];
	const resolve = (list, bucket, id) => {
		if (id === undefined || id === null || id === '') return { id: undefined, missing: false };
		if (list.some(item => item.id === Number(id))) return { id: Number(id), missing: false };
		const ref = references[bucket] && references[bucket][id];
		const match = ref && list.find(item => sameName(item.name, ref.name) && (!ref.provider || !item.provider || item.provider === ref.provider));
		return match ? { id: match.id, missing: false } : { id: undefined, missing: true, name: ref ? ref.name : '#' + id };
	};
	const bind = (node, field, list, bucket, what) => {
		const result = resolve(list, bucket, node.data[field]);
		if (result.id === undefined) delete node.data[field]; else node.data[field] = result.id;
		if (result.missing) warnings.push('Bloco "' + nodeLabel(node) + '": ' + what + ' "' + result.name + '" não existe nesta empresa; selecione outro.');
	};
	flowData.nodes.forEach(node => {
		if (node.type === 'subflow') bind(node, 'flowId', state.flows, 'flows', 'subfluxo');
		if (node.type === 'sendTemplate') bind(node, 'templateId', state.templates, 'templates', 'modelo de mensagem');
		if (node.data.aiAgentId !== undefined) bind(node, 'aiAgentId', state.aiAgents, 'aiAgents', 'agente de IA');
		if (node.data.credentialId !== undefined && node.data.credentialId !== '') bind(node, 'credentialId', state.aiCredentials, 'aiCredentials', 'credencial de IA');
		if (node.type === 'assign') {
			const department = node.data.assignType === 'department';
			bind(node, 'assignId', department ? state.departments : state.agents, department ? 'departments' : 'agents', department ? 'setor' : 'agente');
		}
		if (node.type === 'smartAssign') bind(node, 'departmentId', state.departments, 'departments', 'setor');
		if (node.type === 'aiTools' && Array.isArray(node.data.actions)) node.data.actions.forEach(action => {
			if (!action || action.type !== 'transfer') return;
			const agent = action.assignType === 'agent';
			const result = resolve(agent ? state.agents : state.departments, agent ? 'agents' : 'departments', action.assignId);
			if (result.id === undefined) delete action.assignId; else action.assignId = result.id;
			if (result.missing) warnings.push('Ação "' + (action.name || 'Transferir') + '": ' + (agent ? 'agente' : 'setor') + ' "' + result.name + '" não existe nesta empresa; selecione outro.');
		});
	});
	const noResponse = flowData.settings.noResponse;
	if (noResponse && noResponse.targetId) {
		const department = noResponse.targetType === 'department';
		const result = resolve(department ? state.departments : state.agents, department ? 'departments' : 'agents', noResponse.targetId);
		noResponse.targetId = result.id || 0;
		if (result.missing && noResponse.enabled) {
			noResponse.enabled = false;
			warnings.push('Tratamento sem resposta desativado: ' + (department ? 'setor' : 'agente') + ' "' + result.name + '" não existe nesta empresa.');
		}
	}
	return warnings;
}

async function uploadImportedMedia(flowData, media) {
	const warnings = [];
	for (const item of media) {
		const node = flowData.nodes.find(candidate => candidate.id === (item && item.nodeId));
		if (!node || !MEDIA_NODE_TYPES.includes(node.type)) continue;
		const config = mediaNodeConfig(node.type);
		try {
			if (typeof item.data !== 'string' || !item.data.startsWith('data:')) throw new Error('conteúdo inválido');
			const blob = dataURLToBlob(item.data);
			const form = new FormData();
			form.append('kind', config.kind);
			form.append('file', new File([blob], item.name || 'midia', { type: item.mimeType || blob.type }));
			const response = await fetch('/flows/api/media', { method: 'POST', body: form });
			const payload = await response.json().catch(() => ({}));
			if (!response.ok) throw new Error(payload.error || ('Erro ' + response.status));
			const stored = payload.data;
			delete node.data[config.urlField];
			node.data[config.pathField] = stored.path; node.data[config.mimeField] = stored.mimeType;
			node.data.mediaPreviewUrl = stored.url; node.data.mediaName = stored.name;
		} catch (error) {
			delete node.data[config.pathField]; delete node.data.mediaPreviewUrl;
			warnings.push('Mídia do bloco "' + nodeLabel(node) + '" não foi enviada (' + error.message + '); envie-a novamente.');
		}
	}
	// A path without embedded media points to the exporting company's storage.
	flowData.nodes.forEach(node => {
		if (!MEDIA_NODE_TYPES.includes(node.type) || media.some(item => item && item.nodeId === node.id)) return;
		const config = mediaNodeConfig(node.type);
		if (node.data[config.pathField]) warnings.push('Bloco "' + nodeLabel(node) + '": confira a mídia, ela não veio no arquivo.');
	});
	return warnings;
}

async function importFlowFile(file) {
	if (!file) return;
	if (flowIsDirty() && !confirm('Existem alterações não salvas. Deseja descartá-las e importar o arquivo?')) return;
	try {
		if (file.size > MAX_FLOW_FILE_BYTES) throw new Error('o arquivo excede 150 MB.');
		const imported = parseFlowFile(await file.text());
		const warnings = rebindFlowReferences(imported.flowData, imported.references);
		warnings.push(...await uploadImportedMedia(imported.flowData, imported.media));
		let name = imported.flow.name;
		if (state.flows.some(flow => sameName(flow.name, name))) name += ' (importado)';
		const exportedConnection = imported.references.connection;
		const connection = exportedConnection && (state.connections.find(entry => entry.id === Number(exportedConnection.id)) || state.connections.find(entry => sameName(entry.name, exportedConnection.name)));
		if (exportedConnection && !connection) warnings.push('Conexão "' + exportedConnection.name + '" não existe nesta empresa; o fluxo vale para todas as conexões até você escolher uma.');
		document.querySelectorAll('[data-dd-name]').forEach(hideFlowDropdown);
		state.currentFlow = { id: null, name, description: imported.flow.description, connectionId: connection ? connection.id : null, triggerType: imported.flow.triggerType,
			triggerValue: imported.flow.triggerValue, isActive: false, priority: imported.flow.priority, revision: 0 };
		state.flowData = migrateLegacyAICredentialSelections(imported.flowData);
		state.selectedNodeId = null; state.armedHandle = null; state.connectionDrag = null;
		showView('editor'); renderTopbarExtra(); renderPalette(); renderCanvas(); renderInspector();
		requestAnimationFrame(fitView);
		const guide = document.getElementById('flow-starter-guide');
		guide.textContent = 'Importado de "' + file.name + '" como rascunho inativo. ' + (warnings.length ? 'Revise antes de salvar: ' + warnings.join(' ') : 'Revise, salve e ative quando estiver pronto.');
		guide.classList.remove('hidden');
		state.savedFingerprint = '';
	} catch (error) {
		alert('Não foi possível importar o fluxo: ' + error.message);
	}
}

async function boot() {
	initCanvasNavigation();
	initMobileFlowLayout();
	document.getElementById('btn-new-flow').onclick = openNewFlowModal;
	const newFlowModal=document.getElementById('new-flow-modal');
	document.getElementById('new-flow-close').onclick=()=>newFlowModal.close();
	document.getElementById('new-flow-blank').onclick=()=>{newFlowModal.close();openEditor(null);};
	document.getElementById('new-flow-from-model').onclick=()=>showNewFlowModels(true);
	document.getElementById('new-flow-back').onclick=()=>{showNewFlowModels(false);document.getElementById('new-flow-from-model').focus();};
	document.querySelectorAll('[name="flow-starter-choice"]').forEach(radio=>radio.addEventListener('change',()=>{selectedStarterId=radio.value;document.getElementById('new-flow-use-model').disabled=false;}));
	document.getElementById('new-flow-use-model').onclick=()=>{if(!selectedStarterId)return;newFlowModal.close();openEditor(null,selectedStarterId);};
	newFlowModal.addEventListener('click',event=>{if(event.target!==newFlowModal)return;const bounds=newFlowModal.getBoundingClientRect();if(event.clientX<bounds.left||event.clientX>bounds.right||event.clientY<bounds.top||event.clientY>bounds.bottom)newFlowModal.close();});
	document.getElementById('btn-templates').onclick = openTemplatesModal;
	const importInput = document.getElementById('flow-import-file');
	document.getElementById('btn-import-flow').onclick = () => importInput.click();
	document.getElementById('new-flow-import').onclick = () => { newFlowModal.close(); importInput.click(); };
	importInput.onchange = () => { const file = importInput.files[0]; importInput.value = ''; importFlowFile(file); };
	const exportModal = document.getElementById('flow-export-modal');
	document.getElementById('flow-export-form').onsubmit = event => { event.preventDefault(); downloadFlowExport(); };
	document.getElementById('flow-export-close').onclick = () => exportModal.close();
	document.getElementById('flow-export-cancel').onclick = () => exportModal.close();
	exportModal.addEventListener('close', () => { pendingFlowExport = null; });
	document.getElementById('btn-close-no-response').onclick = closeNoResponseSettings;
	document.getElementById('btn-cancel-no-response').onclick = closeNoResponseSettings;
	document.getElementById('no-response-enabled').onchange = event => {
	  noResponseDraft.enabled = event.target.checked;
	  setNoResponseFieldsEnabled(noResponseDraft.enabled);
	};
	document.getElementById('no-response-form').onsubmit = event => {
	  event.preventDefault();
	  noResponseDraft.reminderMinutes = Number(document.getElementById('no-response-minutes').value || 0);
	  noResponseDraft.reminderMessage = document.getElementById('no-response-message').value.trim();
	  if (noResponseDraft.enabled && (noResponseDraft.reminderMinutes < 1 || noResponseDraft.reminderMinutes > 43200)) {
		alert('Informe um prazo entre 1 minuto e 30 dias.');
		return;
	  }
	  if (noResponseDraft.enabled && !noResponseDraft.reminderMessage) {
		alert('Informe a mensagem de lembrete.');
		return;
	  }
	  if (noResponseDraft.enabled && !noResponseDraft.targetId) {
		alert('Selecione o setor ou agente que receberá a conversa.');
		return;
	  }
	  if (!state.flowData.settings) state.flowData.settings = {};
	  state.flowData.settings.noResponse = { ...noResponseDraft };
	  closeNoResponseSettings();
	};
	document.getElementById('no-response-modal').addEventListener('click', event => {
	  if (event.target.id === 'no-response-modal') closeNoResponseSettings();
	});
	document.getElementById('btn-close-templates').onclick = closeTemplatesModal;
	document.getElementById('btn-new-template').onclick = () => resetTemplateForm();
	document.querySelectorAll('[data-template-format]').forEach(button => button.onclick = () => insertFormattedSelection(document.getElementById('template-content'), button.dataset.templateFormat));
	document.getElementById('btn-template-variables').onclick = () => document.getElementById('template-variables').classList.toggle('hidden');
	document.getElementById('template-form').onsubmit = async event => {
	  event.preventDefault();
	  const id = document.getElementById('template-id').value;
	  const body = { name: document.getElementById('template-name').value, content: document.getElementById('template-content').value };
	  if (id) body.revision = Number(document.getElementById('template-revision').value);
	  try {
		await api(id ? 'PUT' : 'POST', id ? '/flows/api/templates/' + id : '/flows/api/templates', body);
		state.templates = await api('GET', '/flows/api/templates');
		resetTemplateForm();
		renderTemplatesList();
	  } catch (error) { alert('Não foi possível salvar o modelo: ' + error.message); }
	};
  try {
    state.connections = await api('GET', '/flows/api/connections');
  } catch (e) { console.error(e); state.connections = []; }
  try {
    const options = await api('GET', '/flows/api/assignment-options');
    state.agents = options.agents || [];
    state.departments = options.departments || [];
  } catch (e) { console.error(e); state.agents = []; state.departments = []; }
	try { state.templates = await api('GET', '/flows/api/templates'); }
	catch (e) { console.error(e); state.templates = []; }
	try { state.aiAgents = await api('GET', '/flows/api/ai-agents'); }
	catch (e) { console.error(e); state.aiAgents = []; }
	try { state.aiCredentials = await api('GET', '/flows/api/ai-credentials'); }
	catch (e) { console.error(e); state.aiCredentials = []; }
  try {
    await loadFlowsList();
  } catch (e) {
    document.getElementById('flows-grid').innerHTML = '<p class="text-red-500 text-sm">Erro ao carregar automações: ' + escapeHtml(e.message) + '<\/p>';
  }
	if(state.currentFlow){renderTopbarExtra();renderInspector();}
}
boot();
window.addEventListener('beforeunload', event => {
	if (!flowIsDirty()) return;
	event.preventDefault();
	event.returnValue = '';
});
</script>
	</main>
	}
}

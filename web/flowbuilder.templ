package web

templ FlowBuilder() {
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Automações - Sophus</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
  html, body { height: 100%; margin: 0; background: #f5f5f4; }
  #canvas-wrap { background-image: radial-gradient(#e7e5e4 1.5px, transparent 1.5px); background-size: 22px 22px; }
  .node-card { position: absolute; width: 220px; cursor: grab; user-select: none; }
  .node-card.dragging { cursor: grabbing; z-index: 30; }
  .node-card.selected { box-shadow: 0 0 0 2px #6123cc, 0 8px 20px rgba(0,0,0,.12); }
  .node-card.connection-target { box-shadow: 0 0 0 3px #22c55e, 0 8px 20px rgba(34,197,94,.2); }
  .handle { width: 14px; height: 14px; border-radius: 9999px; border: 2px solid white; box-shadow: 0 0 0 1px #a8a29e; cursor: crosshair; position: absolute; background: #78716c; touch-action: none; }
  .handle:hover { background: #6123cc; box-shadow: 0 0 0 1px #6123cc; }
  .handle.armed { background: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.4); animation: pulse 1s infinite; }
  .handle-label { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); white-space: nowrap; pointer-events: none; font-size: 10px; line-height: 1; color: #78716c; }
	input[type="checkbox"]:not(.hidden) { appearance: none; -webkit-appearance: none; width: 1.1rem; height: 1.1rem; flex: 0 0 auto; display: inline-grid; place-content: center; border: 1.5px solid #c4b5fd; border-radius: .32rem; background: #fff; cursor: pointer; transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease; }
	input[type="checkbox"]:not(.hidden)::before { content: ''; width: .58rem; height: .32rem; border-left: 2px solid white; border-bottom: 2px solid white; transform: rotate(-45deg) scale(0); transform-origin: center; transition: transform .12s ease; margin-top: -.08rem; }
	input[type="checkbox"]:not(.hidden):checked { border-color: #7c3aed; background: linear-gradient(135deg, #7c3aed, #4f46e5); box-shadow: 0 0 0 2px rgba(124,58,237,.12); }
	input[type="checkbox"]:not(.hidden):checked::before { transform: rotate(-45deg) scale(1); }
	input[type="checkbox"]:not(.hidden):focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(124,58,237,.22); }
	input[type="checkbox"]:not(.hidden):disabled { cursor: not-allowed; opacity: .5; }
  @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.25); } }
  .palette-item { cursor: grab; }
  .palette-item:active { cursor: grabbing; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 8px; }
</style>
</head>
<body class="h-screen overflow-hidden flex flex-col">

  <!-- Top bar -->
  <div class="flex items-center justify-between px-5 py-3 shadow-sm z-40" style="background: linear-gradient(to right, #3b82f6, #6123cc);">
    <div class="flex items-center gap-3 text-white">
      <a href="/messages" class="p-2 hover:bg-white hover:bg-opacity-20 rounded-lg transition-colors">
        <i class="fas fa-arrow-left"></i>
      </a>
      <i class="fas fa-diagram-project text-lg"></i>
      <span class="font-bold text-lg">Automações</span>
    </div>
    <div id="editor-topbar-extra" class="flex items-center gap-2"></div>
  </div>

  <!-- LIST VIEW -->
  <div id="view-list" class="flex-1 overflow-y-auto p-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Seus fluxos</h1>
          <p class="text-sm text-gray-500 mt-1">Robôs de atendimento automático para o WhatsApp</p>
        </div>
		<div class="flex items-center gap-2">
		  <button id="btn-templates" class="px-4 py-2.5 rounded-xl font-medium text-purple-700 bg-purple-50 hover:bg-purple-100 transition-all flex items-center gap-2"><i class="fas fa-layer-group"></i> Modelos</button>
		  <button id="btn-new-flow" class="px-5 py-2.5 rounded-xl font-medium text-white shadow-sm hover:shadow-md transition-all flex items-center gap-2" style="background: linear-gradient(to right, #3b82f6, #6123cc);">
			<i class="fas fa-plus"></i> Nova automação
		  </button>
		</div>
      </div>
      <div id="flows-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>
      <div id="flows-empty" class="hidden text-center py-24 text-gray-400">
        <i class="fas fa-diagram-project text-5xl mb-4"></i>
        <p class="text-sm">Nenhum fluxo criado ainda.</p>
      </div>
    </div>
  </div>

  <!-- EDITOR VIEW -->
  <div id="view-editor" class="hidden flex-1 flex overflow-hidden">
    <!-- Palette -->
    <div class="w-60 bg-white border-r border-stone-200 overflow-y-auto p-3 flex flex-col gap-4">
      <div id="palette"></div>
    </div>

    <!-- Canvas -->
    <div id="canvas-wrap" class="flex-1 relative overflow-auto">
      <div id="canvas" style="width:3000px;height:2200px;position:relative;">
        <svg id="edges-svg" width="3000" height="2200" style="position:absolute;top:0;left:0;pointer-events:none;">
          <defs>
            <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="#a8a29e"></path>
            </marker>
          </defs>
        </svg>
        <div id="nodes-layer"></div>
      </div>
    </div>

    <!-- Inspector -->
    <div id="inspector" class="w-80 bg-white border-l border-stone-200 overflow-y-auto p-4 hidden"></div>
  </div>

  <div id="templates-modal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-40 p-4 items-center justify-center">
	<div class="w-full max-w-3xl max-h-[88vh] overflow-hidden rounded-2xl bg-white shadow-2xl flex flex-col">
	  <div class="p-5 border-b border-stone-200 flex items-center justify-between"><div><h2 class="text-lg font-bold text-gray-900">Modelos de mensagem</h2><p class="text-xs text-gray-500 mt-1">Conteúdo reutilizável capturado no snapshot de cada execução.</p></div><button id="btn-close-templates" class="p-2 rounded-lg hover:bg-stone-100"><i class="fas fa-times"></i></button></div>
	  <div class="grid md:grid-cols-2 min-h-0 flex-1">
		<div id="templates-list" class="p-4 border-r border-stone-200 overflow-y-auto space-y-2"></div>
		<form id="template-form" class="p-4 flex flex-col gap-3 overflow-y-auto">
		  <input type="hidden" id="template-id"><input type="hidden" id="template-revision">
		  <div><label class="block text-xs font-medium text-gray-600 mb-1">Nome</label><input id="template-name" maxlength="100" required class="w-full px-3 py-2 rounded-lg border border-stone-200"></div>
		  <div><label class="block text-xs font-medium text-gray-600 mb-1">Mensagem</label><div class="rounded-lg border border-stone-200 bg-stone-50"><div class="flex items-center gap-1 px-2 py-1.5 border-b border-stone-200 bg-white"><button type="button" data-template-format="*" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-bold"></i></button><button type="button" data-template-format="_" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-italic"></i></button><button type="button" data-template-format="~" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-strikethrough"></i></button><button type="button" data-template-format="```" class="w-8 h-8 rounded-md hover:bg-purple-50"><i class="fas fa-code"></i></button><span class="h-5 w-px bg-stone-200 mx-1"></span><button type="button" id="btn-template-variables" class="h-8 px-2.5 rounded-md text-xs font-medium text-purple-700 hover:bg-purple-50"><i class="fas fa-at mr-1"></i>Variáveis</button></div><div id="template-variables" class="hidden border-b border-stone-200 bg-white max-h-48 overflow-y-auto"></div><textarea id="template-content" maxlength="10000" rows="10" required class="w-full px-3 py-2 bg-stone-50 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-purple-400"></textarea></div><p class="text-[11px] text-gray-400 mt-1">Aceita variáveis do contexto do fluxo.</p></div>
		  <div class="flex gap-2"><button type="submit" class="flex-1 px-4 py-2 rounded-lg bg-purple-700 text-white font-medium">Salvar modelo</button><button type="button" id="btn-new-template" class="px-4 py-2 rounded-lg bg-stone-100 text-gray-700">Limpar</button></div>
		</form>
	  </div>
	</div>
  </div>

<script>
// ---------------------------------------------------------------------
// Node type metadata - field names/behavior mirror internal/flowengine
// exactly (types.go / engine.go).
// ---------------------------------------------------------------------
const NODE_TYPES = {
  start:           { label: 'Início',              icon: 'fa-play',            color: '#22c55e', category: 'Fluxo',     singleton: true, noInput: true },
  sendText:        { label: 'Enviar Texto',         icon: 'fa-comment',         color: '#3b82f6', category: 'Mensagens' },
  sendImage:       { label: 'Enviar Imagem',        icon: 'fa-image',           color: '#3b82f6', category: 'Mensagens' },
  sendVideo:       { label: 'Enviar Vídeo',          icon: 'fa-video',           color: '#3b82f6', category: 'Mensagens' },
  sendAudio:       { label: 'Enviar Áudio',         icon: 'fa-microphone',      color: '#3b82f6', category: 'Mensagens' },
  sendFile:        { label: 'Enviar Arquivo',       icon: 'fa-paperclip',       color: '#3b82f6', category: 'Mensagens' },
  sendMenu:        { label: 'Enviar Menu',          icon: 'fa-list-ul',         color: '#3b82f6', category: 'Mensagens' },
  sendTemplate:    { label: 'Enviar Modelo',        icon: 'fa-layer-group',     color: '#3b82f6', category: 'Mensagens' },
  condition:       { label: 'Condição',             icon: 'fa-code-branch',     color: '#f59e0b', category: 'Lógica' },
  switch:          { label: 'Múltipla Escolha',     icon: 'fa-list',            color: '#f59e0b', category: 'Lógica' },
  delay:           { label: 'Aguardar',             icon: 'fa-clock',           color: '#f59e0b', category: 'Lógica' },
  changeStatus:    { label: 'Mudar Status',         icon: 'fa-tag',             color: '#8b5cf6', category: 'Sistema' },
  assign:          { label: 'Transferir conversa',  icon: 'fa-user-check',      color: '#8b5cf6', category: 'Sistema' },
  httpRequest:     { label: 'HTTP Request',         icon: 'fa-globe',           color: '#8b5cf6', category: 'Sistema' },
  waitForResponse: { label: 'Esperar Resposta',     icon: 'fa-hourglass-half',  color: '#ec4899', category: 'Interação' },
  input:           { label: 'Capturar Resposta',    icon: 'fa-keyboard',        color: '#ec4899', category: 'Interação' },
  checkResponse:   { label: 'Verificar Resposta',   icon: 'fa-check-double',    color: '#ec4899', category: 'Interação' },
  setVariable:     { label: 'Definir Variável',      icon: 'fa-code',            color: '#8b5cf6', category: 'Sistema' },
  tag:             { label: 'Gerenciar Tag',         icon: 'fa-tags',            color: '#8b5cf6', category: 'Sistema' },
  updateContact:   { label: 'Atualizar Contato',     icon: 'fa-address-card',    color: '#8b5cf6', category: 'Sistema' },
  businessHours:   { label: 'Horário Comercial',    icon: 'fa-calendar-check',  color: '#f59e0b', category: 'Lógica' },
  randomSplit:     { label: 'Divisão Aleatória',     icon: 'fa-shuffle',         color: '#f59e0b', category: 'Lógica' },
  messageType:     { label: 'Tipo de Mensagem',      icon: 'fa-photo-film',      color: '#f59e0b', category: 'Lógica' },
  smartAssign:     { label: 'Distribuição Inteligente', icon: 'fa-users-gear',   color: '#8b5cf6', category: 'Sistema' },
  addNote:         { label: 'Registrar Nota',         icon: 'fa-note-sticky',    color: '#8b5cf6', category: 'Sistema' },
  callback:        { label: 'Callback',               icon: 'fa-satellite-dish', color: '#8b5cf6', category: 'Sistema' },
  subflow:         { label: 'Executar Subfluxo',      icon: 'fa-diagram-project', color: '#8b5cf6', category: 'Sistema' },
  ai:              { label: 'Gerar com IA',          icon: 'fa-wand-magic-sparkles', color: '#8b5cf6', category: 'Sistema' },
  scheduleMessage: { label: 'Agendar Mensagem',      icon: 'fa-calendar-plus',    color: '#8b5cf6', category: 'Sistema' },
  end:             { label: 'Fim',                  icon: 'fa-flag-checkered', color: '#ef4444', category: 'Fluxo' },
};
const CATEGORIES = ['Fluxo', 'Mensagens', 'Lógica', 'Sistema', 'Interação'];
const NODE_W = 220;
const CONDITION_SOURCES = [
  { value: 'contactName', label: 'NOME DO CONTATO' },
  { value: 'contactNumber', label: 'NÚMERO DO CONTATO' },
  { value: 'conversationTag', label: 'TAG DA CONVERSA' },
  { value: 'contactEmail', label: 'EMAIL DO CONTATO' },
  { value: 'contactMessage', label: 'MENSAGEM DO CONTATO' },
  { value: 'department', label: 'DEPARTAMENTO' },
  { value: 'time', label: 'HORÁRIO' },
  { value: 'variable', label: 'VARIÁVEL' },
  { value: 'connectionType', label: 'TIPO DE CONEXÃO' },
];
const CONDITION_OPERATORS = [
  { value: 'equals', label: 'IGUAL A' },
  { value: 'notEquals', label: 'NÃO IGUAL' },
  { value: 'contains', label: 'CONTÉM' },
  { value: 'notContains', label: 'NÃO CONTÉM' },
  { value: 'greaterThan', label: 'MAIOR QUE' },
  { value: 'lessThan', label: 'MENOR QUE' },
  { value: 'true', label: 'VERDADEIRO' },
  { value: 'false', label: 'FALSO' },
];
const CONDITION_OUTPUT_LABELS = {
  equals:      ['Igual a', 'Não igual'],
  notEquals:   ['Não igual', 'Igual a'],
  contains:    ['Contém', 'Não contém'],
  notContains: ['Não contém', 'Contém'],
  greaterThan: ['Maior que', 'Menor ou igual'],
  lessThan:    ['Menor que', 'Maior ou igual'],
  true:        ['Verdadeiro', 'Falso'],
  false:       ['Falso', 'Verdadeiro'],
};

function uid(prefix) { return prefix + '_' + Math.random().toString(36).slice(2, 9); }

// ---------------------------------------------------------------------
// Custom dropdown (same visual/interaction pattern as the "Tipo de
// conexão" selector in instances.templ: hidden radios + a checkbox that
// toggles a floating options panel via CSS peer/:has() - no JS needed for
// open/close, only for wiring the selected value back into state).
// ---------------------------------------------------------------------
let ddCounter = 0;
function customSelectHTML(role, options, selected, placeholder, field) {
  const base = 'dd' + (ddCounter++);
  const wrapperId = base + '_wrap';
  const toggleId = base + '_toggle';
  const selectedOpt = options.find(o => String(o.value) === String(selected));

  const radios = options.map((o, i) =>
    '<input type="radio" name="' + base + '" id="' + base + '_opt' + i + '" value="' + escapeAttr(o.value) +
    '" class="hidden" ' + (String(o.value) === String(selected) ? 'checked' : '') + '>'
  ).join('');

  const panelItems = options.map((o, i) => {
    const radioId = base + '_opt' + i;
    return '<label for="' + radioId + '" class="cursor-pointer w-full px-4 py-2.5 text-left text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors flex items-center gap-2.5 dd-item" data-radio="' + radioId + '">' +
      (o.dot ? '<span class="w-2 h-2 rounded-full flex-shrink-0" style="background:' + o.dot + '"><\/span>' : '') +
      '<span class="truncate">' + escapeHtml(o.label) + '<\/span>' +
      '<i class="fas fa-check ml-auto text-purple-600 opacity-0 dd-check" data-radio="' + radioId + '"><\/i>' +
      '<\/label>';
  }).join('');

  const hasRules = options.map((o, i) =>
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) .dd-placeholder{display:none}' +
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) .dd-selected{display:flex}' +
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) [data-radio="' + base + '_opt' + i + '"].dd-check{opacity:1}' +
    '#' + wrapperId + ':has(#' + base + '_opt' + i + ':checked) [data-radio="' + base + '_opt' + i + '"].dd-item{background:#faf5ff;color:#7e22ce;font-weight:500}'
  ).join('');

  return '' +
    '<div class="relative' + (field ? ' w-full' : '') + '" id="' + wrapperId + '" data-dd-name="' + base + '" data-dd-role="' + role + '"' + (field ? ' data-dd-field="' + escapeAttr(field) + '"' : '') + '>' +
      radios +
      '<input type="checkbox" id="' + toggleId + '" class="hidden peer">' +
      '<label for="' + toggleId + '" class="cursor-pointer' + (field ? ' w-full' : '') + ' min-w-[170px] px-3 py-2 bg-white border border-stone-200 rounded-xl text-sm transition-all flex items-center justify-between gap-2 hover:border-purple-300 peer-checked:ring-2 peer-checked:ring-purple-400 peer-checked:rounded-b-none shadow-sm">' +
        '<span class="dd-placeholder text-gray-400 truncate">' + escapeHtml(placeholder) + '<\/span>' +
        '<span class="dd-selected hidden text-gray-900 items-center gap-2 truncate">' +
          (selectedOpt && selectedOpt.dot ? '<span class="w-2 h-2 rounded-full flex-shrink-0" style="background:' + selectedOpt.dot + '"><\/span>' : '') +
          '<span class="truncate">' + escapeHtml(selectedOpt ? selectedOpt.label : '') + '<\/span>' +
        '<\/span>' +
        '<i class="fas fa-chevron-down text-gray-400 text-xs transition-transform peer-checked:rotate-180 flex-shrink-0"><\/i>' +
      '<\/label>' +
      '<div class="hidden peer-checked:flex absolute left-0 right-0 top-full flex-col bg-white rounded-b-xl shadow-lg border border-t-0 border-stone-200 overflow-hidden z-50 py-1.5 max-h-64 overflow-y-auto">' +
        panelItems +
      '<\/div>' +
      '<style>' + hasRules + '<\/style>' +
    '<\/div>';
}

function inspectorSelect(fieldName, options, selected, placeholder) {
  return customSelectHTML('inspector-' + fieldName, options, selected, placeholder || 'Selecione', fieldName);
}

// close any open custom dropdown when clicking outside it
document.addEventListener('click', (e) => {
  document.querySelectorAll('[data-dd-name]').forEach(w => {
    if (!w.contains(e.target)) {
      const t = w.querySelector('input[type=checkbox]');
      if (t) t.checked = false;
    }
  });
});

// ---------------------------------------------------------------------
// State
// ---------------------------------------------------------------------
const state = {
  flows: [],
  connections: [],
  agents: [],
  departments: [],
	templates: [],
  currentFlow: null,      // {id, name, description, connectionId, triggerType, triggerValue, isActive}
  flowData: { nodes: [], edges: [] },
  selectedNodeId: null,
  armedHandle: null,      // {nodeId, handle} - connection source selected by click or drag
	connectionDrag: null,   // {pointerId, startClientX, startClientY, x, y, moved}
	savedFingerprint: '',
	saving: false,
};

function flowFingerprint() {
	if (!state.currentFlow) return '';
	const flow = state.currentFlow;
	return JSON.stringify({ name: flow.name, description: flow.description, connectionId: flow.connectionId,
		triggerType: flow.triggerType, triggerValue: flow.triggerValue, isActive: flow.isActive,
		priority: flow.priority || 0, flowData: state.flowData });
}

function flowIsDirty() { return !!state.currentFlow && state.savedFingerprint !== flowFingerprint(); }

// ---------------------------------------------------------------------
// API helpers
// ---------------------------------------------------------------------
async function api(method, url, body) {
  const res = await fetch(url, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: body !== undefined ? JSON.stringify(body) : undefined,
  });
  if (res.status === 204) return null;
  const json = await res.json().catch(() => ({}));
  if (!res.ok) {
    console.error('API error', method, url, res.status, json);
    throw new Error(json.error || ('Erro ' + res.status));
  }
  return json.data;
}

// ---------------------------------------------------------------------
// List view
// ---------------------------------------------------------------------
async function loadFlowsList() {
  state.flows = await api('GET', '/flows/api/');
  renderFlowsList();
}

function triggerBadge(flow) {
  if (flow.triggerType === 'always') return '<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 text-xs font-medium">Sempre responde<\/span>';
  if (flow.triggerType === 'exact') return `<span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-medium">Mensagem exata: "${escapeHtml(flow.triggerValue||'')}"<\/span>`;
  return `<span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 text-xs font-medium">Palavra-chave: "${escapeHtml(flow.triggerValue||'')}"<\/span>`;
}

function renderFlowsList() {
  const grid = document.getElementById('flows-grid');
  const empty = document.getElementById('flows-empty');
  grid.innerHTML = '';
  empty.classList.toggle('hidden', state.flows.length > 0);
  for (const flow of state.flows) {
    const conn = state.connections.find(c => c.id === flow.connectionId);
    const card = document.createElement('div');
    card.className = 'bg-white rounded-2xl p-5 shadow-sm border-t-4 hover:shadow-lg transition-all flex flex-col';
    card.style.borderTopColor = flow.isActive ? '#22c55e' : '#d6d3d1';
    card.innerHTML = `
      <div class="flex items-start justify-between mb-2">
        <h3 class="text-base font-bold text-gray-900">${escapeHtml(flow.name)}<\/h3>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full ${flow.isActive ? 'bg-green-100 text-green-700' : 'bg-stone-100 text-gray-500'}">
          ${flow.isActive ? 'Ativo' : 'Inativo'}
        <\/span>
      <\/div>
      <p class="text-xs text-gray-500 mb-3 flex-1">${escapeHtml(flow.description || 'Sem descrição')}<\/p>
      <div class="flex items-center gap-2 flex-wrap mb-3">${triggerBadge(flow)}<\/div>
      <div class="text-xs text-gray-500 mb-4 flex items-center gap-1.5">
        <i class="fab fa-whatsapp ${conn ? 'text-green-600' : 'text-gray-300'}"><\/i>
		${conn ? escapeHtml(conn.name) : 'Todas as conexões'}
      <\/div>
      <div class="flex gap-2">
        <button data-edit="${flow.id}" class="flex-1 p-2 bg-stone-100 hover:bg-stone-200 rounded-lg transition-colors text-xs font-medium text-gray-700">
          <i class="fas fa-edit mr-1"><\/i>Editar
        <\/button>
        <button data-del="${flow.id}" class="p-2 bg-red-50 hover:bg-red-100 text-red-500 rounded-lg transition-colors">
          <i class="fas fa-trash text-xs"><\/i>
        <\/button>
      <\/div>`;
    grid.appendChild(card);
  }
  grid.querySelectorAll('[data-edit]').forEach(btn => btn.onclick = () => openEditor(Number(btn.dataset.edit)));
  grid.querySelectorAll('[data-del]').forEach(btn => btn.onclick = () => deleteFlow(Number(btn.dataset.del)));
}

async function deleteFlow(id) {
  if (!confirm('Apagar esta automação? Essa ação não pode ser desfeita.')) return;
  await api('DELETE', '/flows/api/' + id);
  await loadFlowsList();
}

// ---------------------------------------------------------------------
// Editor view - open/new/save
// ---------------------------------------------------------------------
function blankFlowData() {
  return { nodes: [{ id: uid('n'), type: 'start', position: { x: 80, y: 160 }, data: {} }], edges: [] };
}

async function openEditor(id) {
  if (id) {
    const flow = await api('GET', '/flows/api/' + id);
    state.currentFlow = flow;
    state.flowData = flow.flowData && flow.flowData.nodes ? flow.flowData : blankFlowData();
  } else {
	state.currentFlow = { id: null, name: 'Nova automação', description: '', connectionId: null, triggerType: 'keyword', triggerValue: '', isActive: false, priority: 0, revision: 0 };
    state.flowData = blankFlowData();
  }
  state.selectedNodeId = null;
  state.armedHandle = null;
  state.connectionDrag = null;
  showView('editor');
  renderTopbarExtra();
  renderPalette();
  renderCanvas();
	renderInspector();
	state.savedFingerprint = flowFingerprint();
}

function closeEditor() {
	if (flowIsDirty() && !confirm('Existem alterações não salvas. Deseja sair mesmo assim?')) return;
  state.currentFlow = null;
  showView('list');
  renderTopbarExtra();
  loadFlowsList().catch(e => console.error('erro ao recarregar lista de fluxos', e));
}

function showView(name) {
  document.getElementById('view-list').classList.toggle('hidden', name !== 'list');
  document.getElementById('view-editor').classList.toggle('hidden', name !== 'editor');
}

async function saveFlow() {
	if (state.saving) return;
  const f = state.currentFlow;
  if (!f.name || !f.name.trim()) { alert('Dá um nome pra essa automação antes de salvar.'); return; }
  const startNodes = state.flowData.nodes.filter(n => n.type === 'start');
  if (startNodes.length !== 1) { alert('O fluxo precisa ter exatamente um node de Início.'); return; }
  const requiredMediaFields = {
    sendImage: { url: 'imageUrl', path: 'imagePath' },
    sendVideo: { url: 'videoUrl', path: 'videoPath' },
    sendAudio: { url: 'audioUrl', path: 'audioPath' },
    sendFile: { url: 'fileUrl', path: 'filePath' },
  };
  const missingMedia = state.flowData.nodes.find(node => {
    const fields = requiredMediaFields[node.type];
    return fields && !String(node.data[fields.url] || '').trim() && (!fields.path || !String(node.data[fields.path] || '').trim());
  });
  if (missingMedia) { alert('Configure a mídia do bloco "' + NODE_TYPES[missingMedia.type].label + '" antes de salvar.'); return; }

  const payload = {
    name: f.name,
    description: f.description || '',
    connectionId: f.connectionId || null,
    triggerType: f.triggerType || 'keyword',
    triggerValue: f.triggerValue || '',
	  flowData: state.flowData,
	  isActive: !!f.isActive,
	  priority: Number(f.priority || 0),
	  revision: Number(f.revision || 0),
  };
	const submittedFingerprint = flowFingerprint();
	try {
		state.saving = true;
		const saveButton = document.getElementById('btn-save');
		if (saveButton) saveButton.disabled = true;
    let savedFlow;
    if (f.id) {
      savedFlow = await api('PUT', '/flows/api/' + f.id, payload);
    } else {
      savedFlow = await api('POST', '/flows/api/', payload);
    }
		if (flowFingerprint() === submittedFingerprint) {
		  Object.assign(f, savedFlow);
		  state.savedFingerprint = flowFingerprint();
		} else {
		  f.id = savedFlow.id;
		  f.revision = savedFlow.revision;
		  f.createdAt = savedFlow.createdAt;
		  f.updatedAt = savedFlow.updatedAt;
		  state.savedFingerprint = submittedFingerprint;
		}
    flashSaved();
    loadFlowsList().catch(e => console.error('erro ao atualizar lista após salvar', e));
	} catch (e) {
    console.error('erro ao salvar fluxo', e);
    alert('Não deu pra salvar: ' + e.message);
	} finally {
		state.saving = false;
		const saveButton = document.getElementById('btn-save');
		if (saveButton) saveButton.disabled = false;
	}
}

function flashSaved() {
  const btn = document.getElementById('btn-save');
  if (!btn) return;
  const original = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-check"><\/i> Salvo';
  setTimeout(() => { btn.innerHTML = original; }, 1200);
}

async function testFlow() {
  const f = state.currentFlow;
  if (!f.id) { alert('Salve o fluxo antes de testar.'); return; }
  const conversationId = prompt('ID da conversa (numérico) pra rodar esse fluxo de teste:');
  if (!conversationId) return;
  try {
    await api('POST', '/flows/api/' + f.id + '/execute', { conversationId: Number(conversationId), context: {} });
    alert('Fluxo enfileirado para execução nessa conversa.');
  } catch (e) {
    alert('Erro ao testar: ' + e.message);
  }
}

// ---------------------------------------------------------------------
// Top bar (editor mode)
// ---------------------------------------------------------------------
function renderTopbarExtra() {
  const el = document.getElementById('editor-topbar-extra');
  if (!state.currentFlow) { el.innerHTML = ''; return; }
  const f = state.currentFlow;

	const connOptions = [{ value: '', label: 'Todas as conexões' }]
    .concat(state.connections.map(c => ({ value: String(c.id), label: c.name, dot: c.status === 'connected' ? '#22c55e' : '#a8a29e' })));
  const triggerOptions = [
    { value: 'keyword', label: 'Palavra-chave' },
    { value: 'exact', label: 'Mensagem exata' },
    { value: 'always', label: 'Sempre responde' },
  ];

  el.innerHTML = `
    <input id="inp-name" value="${escapeAttr(f.name)}" placeholder="Nome da automação"
      class="px-3 py-2 rounded-xl text-sm bg-white bg-opacity-90 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-white w-48 shadow-sm">
    ${customSelectHTML('connection', connOptions, f.connectionId || '', 'Selecione a conexão')}
    ${customSelectHTML('trigger-type', triggerOptions, f.triggerType || 'keyword', 'Tipo de gatilho')}
	<input id="inp-trigger-value" value="${escapeAttr(f.triggerValue||'')}" placeholder="ex: orçamento"
      class="px-3 py-2 rounded-xl text-sm bg-white bg-opacity-90 text-gray-900 placeholder-gray-400 focus:outline-none w-32 shadow-sm ${f.triggerType==='always'?'hidden':''}">
	<input id="inp-priority" type="number" min="-1000" max="1000" value="${Number(f.priority || 0)}" title="Prioridade do gatilho" class="w-20 px-3 py-2 rounded-xl text-sm bg-white bg-opacity-90 text-gray-900 focus:outline-none shadow-sm">
    <label class="flex items-center gap-1.5 text-white text-sm px-2">
      <input id="chk-active" type="checkbox" ${f.isActive?'checked':''}> Ativo
    <\/label>
    <button id="btn-test" class="px-3 py-1.5 rounded-lg text-sm font-medium text-white bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors">
      <i class="fas fa-vial mr-1"><\/i>Testar
    <\/button>
    <button id="btn-save" class="px-4 py-1.5 rounded-lg text-sm font-bold text-purple-700 bg-white hover:bg-purple-50 transition-colors shadow-sm">
      <i class="fas fa-save mr-1"><\/i>Salvar
    <\/button>
    <button id="btn-close-editor" class="p-2 hover:bg-white hover:bg-opacity-20 rounded-lg text-white transition-colors">
      <i class="fas fa-times"><\/i>
    <\/button>
  `;
  document.getElementById('inp-name').oninput = e => { f.name = e.target.value; };

  el.querySelector('[data-dd-role="connection"]').querySelectorAll('input[type=radio]').forEach(r => {
    r.addEventListener('change', () => {
      f.connectionId = r.value ? Number(r.value) : null;
      closeDropdown(r);
    });
  });
  el.querySelector('[data-dd-role="trigger-type"]').querySelectorAll('input[type=radio]').forEach(r => {
    r.addEventListener('change', () => {
      f.triggerType = r.value;
      document.getElementById('inp-trigger-value').classList.toggle('hidden', f.triggerType === 'always');
      closeDropdown(r);
    });
  });

	document.getElementById('inp-trigger-value').oninput = e => { f.triggerValue = e.target.value; };
	document.getElementById('inp-priority').oninput = e => { f.priority = Number(e.target.value || 0); };
  document.getElementById('chk-active').onchange = e => { f.isActive = e.target.checked; };
  document.getElementById('btn-test').onclick = testFlow;
  document.getElementById('btn-save').onclick = saveFlow;
  document.getElementById('btn-close-editor').onclick = closeEditor;
}

function closeDropdown(radio) {
  const wrapper = radio.closest('[data-dd-name]');
  const toggle = wrapper && wrapper.querySelector('input[type=checkbox]');
  if (toggle) toggle.checked = false;
}

// ---------------------------------------------------------------------
// Palette
// ---------------------------------------------------------------------
function renderPalette() {
  const el = document.getElementById('palette');
  el.innerHTML = CATEGORIES.map(cat => {
    const items = Object.entries(NODE_TYPES).filter(([,m]) => m.category === cat);
    return `
      <div class="mb-4">
        <div class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-2 px-1">${cat}<\/div>
        <div class="flex flex-col gap-1.5">
          ${items.map(([type, meta]) => `
            <button data-add="${type}" class="palette-item flex items-center gap-2 px-3 py-2 rounded-xl text-sm text-left hover:shadow-md transition-all border border-stone-100"
              style="background: color-mix(in srgb, ${meta.color} 8%, white);">
              <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0" style="background:${meta.color}22;">
                <i class="fas ${meta.icon}" style="color:${meta.color};"><\/i>
              <\/span>
              <span class="font-medium text-gray-700">${meta.label}<\/span>
            <\/button>`).join('')}
        <\/div>
      <\/div>`;
  }).join('');
  el.querySelectorAll('[data-add]').forEach(btn => btn.onclick = () => addNode(btn.dataset.add));
}

function addNode(type) {
  const meta = NODE_TYPES[type];
  if (meta.singleton && state.flowData.nodes.some(n => n.type === type)) {
    alert('Só pode existir um node de ' + meta.label + ' no fluxo.');
    return;
  }
  const wrap = document.getElementById('canvas-wrap');
  const node = {
    id: uid('n'),
    type,
    position: { x: wrap.scrollLeft + 260, y: wrap.scrollTop + 120 + state.flowData.nodes.length * 12 },
    data: defaultDataFor(type),
  };
  state.flowData.nodes.push(node);
  state.selectedNodeId = node.id;
  renderCanvas();
  renderInspector();
}

function defaultDataFor(type) {
  switch (type) {
    case 'sendMenu': return {
      title: 'Menu', description: '', buttonText: 'Ver Menu', footerText: 'Sophus', useFallback: false,
	  allowBackPrevious: false, allowBackMain: false,
      sections: [{ title: 'Opções', rows: [{ title: 'Opção 1', description: '', rowId: 'opcao_1', _handleId: uid('mh') }] }],
    };
	case 'switch': return { message: '', cases: [{ label: 'Opção 1', condition: '' }] };
    case 'condition': return { conditionSource: 'contactMessage', conditionOperator: 'equals', conditionValue: '' };
    case 'delay': return { delayType: 'fixed', seconds: 2 };
    case 'sendImage': return { imageUrl: '', imagePath: '', imageMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'sendVideo': return { videoUrl: '', videoPath: '', videoMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'sendAudio': return { audioUrl: '', audioPath: '', audioMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'sendFile': return { fileUrl: '', filePath: '', fileMimeType: '', mediaPreviewUrl: '', mediaName: '' };
    case 'assign': return { assignType: 'agent' };
    case 'setVariable': return { variableName: '', value: '' };
    case 'tag': return { operation: 'add', tag: '' };
    case 'updateContact': return { field: 'name', value: '' };
    case 'businessHours': return { timezone: 'America/Sao_Paulo', days: [1,2,3,4,5], startTime: '08:00', endTime: '18:00', lunchEnabled: false, lunchStart: '12:00', lunchEnd: '13:00' };
    case 'randomSplit': return { percentage: 50 };
	case 'input': return { variableName: 'userInput', validationType: 'any' };
	case 'smartAssign': return { strategy: 'leastLoaded' };
	case 'addNote': return { eventType: 'note', content: '' };
	case 'callback': return { eventName: 'flow.event', url: '', timeout: 10000, followRedirects: false };
	case 'subflow': return {};
	case 'sendTemplate': return {};
	case 'ai': return { systemPrompt: '', prompt: '', saveResponseTo: 'aiResponse' };
	case 'scheduleMessage': return { message: '', delayMinutes: 60 };
    case 'httpRequest': return {
      method: 'POST', headerMode: 'none', headerFields: [],
      bodyMode: 'none', bodyFields: [],
    };
    default: return {};
  }
}

// ---------------------------------------------------------------------
// Canvas / nodes / edges rendering
// ---------------------------------------------------------------------
function nodeHeight(node) {
  if (node.type === 'sendMenu') {
    return 103 + outputsFor(node).length * 28;
  }
	const outputCount = outputsFor(node).length;
	let baseHeight = 90;
	if (node.type === 'switch') baseHeight = 56 + outputCount * 26;
	if (node.type === 'condition') baseHeight = 130;
	if (node.type === 'messageType') baseHeight = 212;
	if (node.type === 'smartAssign') baseHeight = 112;
	if (outputCount > 1) baseHeight = Math.max(baseHeight, 70 + (outputCount - 1) * 32);
	return baseHeight;
}

// Returns [{handle, label}] for a node's outgoing connection points.
function outputsFor(node) {
	if (node.type === 'condition' || node.type === 'checkResponse') {
		if (node.type === 'checkResponse') return [{ handle: 'true', label: 'Respondeu' }, { handle: 'false', label: 'Não respondeu' }];
    const labels = CONDITION_OUTPUT_LABELS[(node.data || {}).conditionOperator] || ['Verdadeiro', 'Falso'];
    return [{ handle: 'true', label: labels[0] }, { handle: 'false', label: labels[1] }];
  }
	if (node.type === 'businessHours') return [{ handle: 'true', label: 'Dentro do horário' }, { handle: 'false', label: 'Fora do horário' }];
	if (node.type === 'randomSplit') return [{ handle: 'a', label: 'Grupo A' }, { handle: 'b', label: 'Grupo B' }];
	if (node.type === 'waitForResponse') {
		return [{ handle: 'replied', label: 'Respondeu' }, { handle: 'timeout', label: 'Timeout' }];
	}
	if (node.type === 'input') return [{ handle: 'valid', label: 'Válida' }, { handle: 'invalid', label: 'Inválida' }, { handle: 'timeout', label: 'Timeout' }];
	if (node.type === 'messageType') return [
	  { handle: 'text', label: 'Texto' }, { handle: 'image', label: 'Imagem' }, { handle: 'video', label: 'Vídeo' },
	  { handle: 'audio', label: 'Áudio' }, { handle: 'document', label: 'Documento' }, { handle: 'other', label: 'Outro' },
	];
	if (node.type === 'smartAssign') return [{ handle: 'assigned', label: 'Atribuído' }, { handle: 'unavailable', label: 'Indisponível' }];
	if (node.type === 'callback') return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'subflow') return [{ handle: 'success', label: 'Concluído' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'ai') return [{ handle: 'success', label: 'Sucesso' }, { handle: 'failure', label: 'Falha' }];
	if (node.type === 'scheduleMessage') return [{ handle: 'scheduled', label: 'Agendada' }, { handle: 'failure', label: 'Falha' }];
  if (node.type === 'sendMenu') {
    const out = [];
    const fallbackEdges = state.flowData.edges.filter(edge => edge.source === node.id && (edge.sourceHandle === 'fallback' || !edge.sourceHandle));
    if (node.data.useFallback === undefined) node.data.useFallback = fallbackEdges.length > 0;
    if (node.data.useFallback) fallbackEdges.forEach(edge => { edge.sourceHandle = 'fallback'; });
    else if (fallbackEdges.length) state.flowData.edges = state.flowData.edges.filter(edge => !fallbackEdges.includes(edge));
    (node.data.sections || []).forEach(section => (section.rows || []).forEach(row => {
      if (!row._handleId) {
        const legacyHandle = 'menu-' + row.rowId;
        row._handleId = state.flowData.edges.some(edge => edge.source === node.id && edge.sourceHandle === legacyHandle) ? row.rowId : uid('mh');
      }
      out.push({ handle: 'menu-' + row._handleId, label: row.title || row.rowId || 'Opção' });
    }));
    if (node.data.useFallback) out.push({ handle: 'fallback', label: 'Caminho padrão' });
    return out;
  }
  if (node.type === 'switch') {
    const cases = (node.data.cases || []);
    const out = cases.map((c, i) => ({ handle: 'case-' + i, label: c.label || ('Opção ' + (i + 1)) }));
    out.push({ handle: 'fallback', label: 'Nenhuma opção' });
    return out;
  }
  if (node.type === 'end') return [];
  return [{ handle: '', label: '' }];
}

function nodeSummary(node) {
  const d = node.data || {};
  switch (node.type) {
    case 'sendText': return d.message ? truncate(d.message, 60) : 'Sem mensagem configurada';
    case 'sendImage': return d.mediaName || (d.imageUrl ? truncate(d.imageUrl, 40) : 'Sem imagem configurada');
    case 'sendVideo': return d.mediaName || (d.videoUrl ? truncate(d.videoUrl, 40) : 'Sem vídeo configurado');
    case 'sendAudio': return d.mediaName || (d.audioUrl ? truncate(d.audioUrl, 40) : 'Sem áudio configurado');
    case 'sendFile': return d.mediaName || (d.fileUrl ? truncate(d.fileUrl, 40) : 'Sem arquivo configurado');
    case 'sendMenu': return [d.title, d.description].filter(Boolean).join(' — ') || 'Sem mensagem configurada';
	case 'sendTemplate': {
	  const selected = state.templates.find(template => template.id === Number(d.templateId));
	  return selected ? selected.name : 'Sem modelo selecionado';
	}
    case 'condition': {
      if (!d.conditionSource || d.conditionSource === 'legacy') return d.condition ? truncate(d.condition, 60) : 'Sem condição configurada';
      const source = CONDITION_SOURCES.find(option => option.value === d.conditionSource)?.label || d.conditionSource;
      const operator = CONDITION_OPERATORS.find(option => option.value === d.conditionOperator)?.label || d.conditionOperator || '';
      const value = d.conditionSource === 'variable' ? (d.conditionVariable || 'variável') : d.conditionValue;
      return truncate([source, operator, value].filter(Boolean).join(' · '), 60);
    }
    case 'switch': return (d.cases || []).length + ' opção(ões)';
    case 'delay': return d.delayType === 'range' ? (d.minSeconds||0) + 's - ' + (d.maxSeconds||0) + 's' : (d.seconds||0) + 's';
    case 'changeStatus': return d.status ? ('→ ' + d.status) : 'Sem status definido';
    case 'assign': {
      const options = d.assignType === 'department' ? state.departments : state.agents;
      const selected = options.find(option => option.id === Number(d.assignId));
      return selected ? ((d.assignType === 'department' ? 'Setor: ' : 'Agente: ') + selected.name) : 'Sem destino definido';
    }
    case 'httpRequest': return d.url ? truncate((d.method||'POST') + ' ' + d.url, 50) : 'Sem URL configurada';
    case 'input': return d.variableName ? ('Salva em: ' + d.variableName) : 'Captura resposta livre';
    case 'waitForResponse': return d.timeout ? ('Timeout: ' + d.timeout + 's') : 'Sem timeout';
    case 'checkResponse': return d.saveResponseTo ? ('Salva em: ' + d.saveResponseTo) : '';
	case 'setVariable': return d.variableName ? (d.variableName + ' = ' + truncate(d.value || '', 35)) : 'Sem variável definida';
	case 'tag': return (d.operation === 'remove' ? 'Remover: ' : 'Adicionar: ') + (d.tag || 'sem tag');
	case 'updateContact': return (d.field === 'email' ? 'Email: ' : 'Nome: ') + (d.value || 'sem valor');
	case 'businessHours': return (d.startTime || '08:00') + ' - ' + (d.endTime || '18:00');
	case 'randomSplit': return (d.percentage || 50) + '% no grupo A';
	case 'messageType': return 'Roteia conforme a mídia recebida';
	case 'smartAssign': return d.strategy === 'random' ? 'Agente aleatório' : 'Agente com menor carga';
	case 'addNote': return d.content ? truncate(d.content, 55) : 'Sem conteúdo';
	case 'callback': return d.url ? truncate((d.eventName || 'evento') + ' → ' + d.url, 55) : 'Sem URL configurada';
	case 'subflow': {
	  const selected = state.flows.find(flow => flow.id === Number(d.flowId));
	  return selected ? selected.name : 'Sem subfluxo selecionado';
	}
	case 'ai': return d.saveResponseTo ? ('Resposta em: ' + d.saveResponseTo) : 'Sem variável definida';
	case 'scheduleMessage': return d.delayMinutes ? ('Enviar em ' + d.delayMinutes + ' min') : 'Sem prazo definido';
    case 'start': return d.businessHours && d.businessHours.enabled ? 'Horário de atendimento ativo' : 'Início do fluxo';
    default: return '';
  }
}

function truncate(s, n) { s = String(s); return s.length > n ? s.slice(0, n) + '…' : s; }

function nodeBodyHTML(node, outs) {
  if (node.type === 'sendMenu') {
    const title = node.data.title || 'Sem título';
    const message = node.data.description || 'Sem mensagem configurada';
    return '<div class="px-3 py-2 text-xs leading-snug overflow-hidden" style="height:52px">' +
      '<div class="font-semibold text-gray-700 truncate">' + escapeHtml(title) + '<\/div>' +
      '<div class="text-gray-500 mt-0.5 line-clamp-2">' + escapeHtml(message) + '<\/div>' +
    '<\/div>' +
    '<div class="px-3 pb-2 text-[10px] text-gray-400 flex flex-col">' +
      outs.map(o => '<div class="truncate flex items-center" style="height:28px">↳ ' + escapeHtml(o.label) + '<\/div>').join('') +
    '<\/div>';
  }
  if (node.type === 'condition') {
    return '<div class="px-3 py-2 text-xs text-gray-500 leading-snug line-clamp-3" style="height:89px;padding-right:108px">' + escapeHtml(nodeSummary(node)) + '<\/div>';
  }
  return '<div class="px-3 py-2 text-xs text-gray-500 leading-snug">' + escapeHtml(nodeSummary(node)) + '<\/div>' +
	    ((node.type === 'switch' || node.type === 'messageType') ? '<div class="px-3 text-[10px] text-gray-400 flex flex-col gap-0.5">' + outs.map(o=>'<div class="truncate">↳ ' + escapeHtml(o.label) + '<\/div>').join('') + '<\/div>' : '');
}

function outputY(node, index, count) {
  if (node.type === 'sendMenu') return 108 + index * 28;
  const h = nodeHeight(node);
	if (count === 1) return h / 2;
	const topPadding = 48;
	const bottomPadding = 24;
	const spacing = Math.min(32, (h - topPadding - bottomPadding) / Math.max(1, count - 1));
	const groupHeight = spacing * (count - 1);
	const center = (topPadding + h - bottomPadding) / 2;
	return center - groupHeight / 2 + index * spacing;
}

function renderCanvas() {
  const layer = document.getElementById('nodes-layer');
  layer.innerHTML = '';
  for (const node of state.flowData.nodes) {
    const meta = NODE_TYPES[node.type] || { label: node.type, icon: 'fa-question', color: '#78716c' };
    const h = nodeHeight(node);
    const outs = outputsFor(node);
    const card = document.createElement('div');
    card.className = 'node-card bg-white rounded-xl shadow-sm border border-stone-200' + (state.selectedNodeId === node.id ? ' selected' : '');
    card.style.left = node.position.x + 'px';
    card.style.top = node.position.y + 'px';
    card.style.height = h + 'px';
    card.dataset.nodeId = node.id;

    card.innerHTML = `
      <div class="flex items-center gap-2 px-3 py-2 border-b border-stone-100 rounded-t-xl" style="background:${meta.color}14;">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:${meta.color}22;">
          <i class="fas ${meta.icon} text-xs" style="color:${meta.color};"><\/i>
        <\/span>
        <span class="text-xs font-bold text-gray-700 flex-1 truncate">${meta.label}<\/span>
        ${node.type !== 'start' ? '<button data-del-node="' + node.id + '" class="text-gray-300 hover:text-red-500 transition-colors"><i class="fas fa-times text-xs"><\/i><\/button>' : ''}
      <\/div>
      ${nodeBodyHTML(node, outs)}
    `;

    if (!meta.noInput) {
      const inHandle = document.createElement('div');
      inHandle.className = 'handle';
      inHandle.style.left = '-7px';
      inHandle.style.top = (h / 2 - 7) + 'px';
      inHandle.onclick = (e) => { e.stopPropagation(); completeConnection(node.id); };
      card.appendChild(inHandle);
    }

    outs.forEach((o, i) => {
      const y = outputY(node, i, outs.length);
      const out = document.createElement('div');
      out.className = 'handle' + (state.armedHandle && state.armedHandle.nodeId === node.id && state.armedHandle.handle === o.handle ? ' armed' : '');
      out.style.right = '-7px';
      out.style.top = (y - (node.type === 'sendMenu' ? 8 : 7)) + 'px';
      out.title = o.label;
	  if (node.type === 'condition' || node.type === 'checkResponse' || node.type === 'waitForResponse' || node.type === 'input' || node.type === 'businessHours' || node.type === 'randomSplit' || node.type === 'messageType' || node.type === 'smartAssign' || node.type === 'callback' || node.type === 'subflow' || node.type === 'ai' || node.type === 'scheduleMessage') out.innerHTML = '<span class="handle-label">' + escapeHtml(o.label) + '<\/span>';
      out.onpointerdown = (e) => startConnectionDrag(e, node.id, o.handle);
      card.appendChild(out);
    });

    card.onmousedown = (e) => startDrag(e, node);
    card.onclick = (e) => {
      if (state.armedHandle) return;
      selectNode(node.id);
    };
    layer.appendChild(card);
  }
  renderEdges();
}

function selectNode(id) {
  state.selectedNodeId = id;
  renderCanvas();
  renderInspector();
}

function startDrag(e, node) {
  if (e.target.classList.contains('handle')) return;
  const wrap = document.getElementById('canvas-wrap');
  const startX = e.clientX + wrap.scrollLeft;
  const startY = e.clientY + wrap.scrollTop;
  const origX = node.position.x, origY = node.position.y;
  const card = e.currentTarget;
  card.classList.add('dragging');

  function onMove(ev) {
    const dx = (ev.clientX + wrap.scrollLeft) - startX;
    const dy = (ev.clientY + wrap.scrollTop) - startY;
    node.position.x = Math.max(0, origX + dx);
    node.position.y = Math.max(0, origY + dy);
    card.style.left = node.position.x + 'px';
    card.style.top = node.position.y + 'px';
    renderEdges();
  }
  function onUp() {
    card.classList.remove('dragging');
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mouseup', onUp);
  }
  document.addEventListener('mousemove', onMove);
  document.addEventListener('mouseup', onUp);
}

function startConnectionDrag(e, nodeId, handle) {
  if (e.button !== undefined && e.button !== 0) return;
  e.preventDefault();
  e.stopPropagation();

  const point = canvasPoint(e.clientX, e.clientY);
  state.armedHandle = { nodeId, handle };
  state.connectionDrag = {
    pointerId: e.pointerId,
    startClientX: e.clientX,
    startClientY: e.clientY,
    x: point.x,
    y: point.y,
    moved: false,
  };
  e.currentTarget.classList.add('armed');

  function onMove(ev) {
    if (!state.connectionDrag || ev.pointerId !== state.connectionDrag.pointerId) return;
    ev.preventDefault();
    const drag = state.connectionDrag;
    const current = canvasPoint(ev.clientX, ev.clientY);
    drag.x = current.x;
    drag.y = current.y;
    drag.moved = drag.moved || Math.hypot(ev.clientX - drag.startClientX, ev.clientY - drag.startClientY) > 4;
    highlightConnectionTarget(ev.clientX, ev.clientY, nodeId);
    renderEdges();
  }

  function finish(ev, cancelled) {
    if (!state.connectionDrag || ev.pointerId !== state.connectionDrag.pointerId) return;
    const drag = state.connectionDrag;
    const targetCard = !cancelled && document.elementFromPoint(ev.clientX, ev.clientY)?.closest('.node-card');
    const targetId = targetCard && targetCard.dataset.nodeId;
    const targetNode = state.flowData.nodes.find(n => n.id === targetId);
    const canConnect = targetNode && targetId !== nodeId && !(NODE_TYPES[targetNode.type] || {}).noInput;

    document.removeEventListener('pointermove', onMove);
    document.removeEventListener('pointerup', onUp);
    document.removeEventListener('pointercancel', onCancel);
    clearConnectionTarget();
    state.connectionDrag = null;

    if (canConnect) {
      completeConnection(targetId);
    } else if (drag.moved || cancelled) {
      state.armedHandle = null;
      renderCanvas();
    } else {
      renderCanvas();
    }
  }

  function onUp(ev) { finish(ev, false); }
  function onCancel(ev) { finish(ev, true); }

  document.addEventListener('pointermove', onMove, { passive: false });
  document.addEventListener('pointerup', onUp);
  document.addEventListener('pointercancel', onCancel);
  renderEdges();
}

function canvasPoint(clientX, clientY) {
  const rect = document.getElementById('canvas').getBoundingClientRect();
  return { x: clientX - rect.left, y: clientY - rect.top };
}

function highlightConnectionTarget(clientX, clientY, sourceNodeId) {
  clearConnectionTarget();
  const card = document.elementFromPoint(clientX, clientY)?.closest('.node-card');
  if (!card || card.dataset.nodeId === sourceNodeId) return;
  const node = state.flowData.nodes.find(n => n.id === card.dataset.nodeId);
  if (node && !(NODE_TYPES[node.type] || {}).noInput) card.classList.add('connection-target');
}

function clearConnectionTarget() {
  document.querySelectorAll('.node-card.connection-target').forEach(card => card.classList.remove('connection-target'));
}

function completeConnection(targetNodeId) {
  if (!state.armedHandle) return;
  if (state.armedHandle.nodeId === targetNodeId) { state.armedHandle = null; renderCanvas(); return; }
  state.flowData.edges = state.flowData.edges.filter(e => !(e.source === state.armedHandle.nodeId && (e.sourceHandle || '') === (state.armedHandle.handle || '')));
  state.flowData.edges.push({
    id: uid('e'),
    source: state.armedHandle.nodeId,
    target: targetNodeId,
    sourceHandle: state.armedHandle.handle,
  });
  state.armedHandle = null;
  renderCanvas();
}

document.addEventListener('click', (e) => {
  if (e.target.id === 'canvas' || e.target.id === 'nodes-layer' || e.target.id === 'canvas-wrap') {
    state.armedHandle = null;
    state.selectedNodeId = null;
    renderCanvas();
    renderInspector();
  }
});

function deleteNode(id) {
  if (!confirm('Remover esse node?')) return;
  state.flowData.nodes = state.flowData.nodes.filter(n => n.id !== id);
  state.flowData.edges = state.flowData.edges.filter(e => e.source !== id && e.target !== id);
  if (state.selectedNodeId === id) state.selectedNodeId = null;
  renderCanvas();
  renderInspector();
}

function handlePos(node, handle, isOutput) {
  const h = nodeHeight(node);
  if (!isOutput) return { x: node.position.x, y: node.position.y + h / 2 };
  const outs = outputsFor(node);
  const idx = Math.max(0, outs.findIndex(o => o.handle === handle));
  const y = outputY(node, idx, outs.length);
  return { x: node.position.x + NODE_W, y: node.position.y + y };
}

function renderEdges() {
  const svg = document.getElementById('edges-svg');
  svg.querySelectorAll('path.edge').forEach(p => p.remove());
  const byId = Object.fromEntries(state.flowData.nodes.map(n => [n.id, n]));
  for (const edge of state.flowData.edges) {
    const s = byId[edge.source], t = byId[edge.target];
    if (!s || !t) continue;
    const p1 = handlePos(s, edge.sourceHandle, true);
    const p2 = handlePos(t, edge.targetHandle, false);
    const dx = Math.max(60, Math.abs(p2.x - p1.x) / 2);
    const d = 'M ' + p1.x + ' ' + p1.y + ' C ' + (p1.x + dx) + ' ' + p1.y + ', ' + (p2.x - dx) + ' ' + p2.y + ', ' + p2.x + ' ' + p2.y;
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    path.setAttribute('class', 'edge');
    path.setAttribute('stroke', '#a8a29e');
    path.setAttribute('stroke-width', '2');
    path.setAttribute('fill', 'none');
    path.setAttribute('marker-end', 'url(#arrow)');
    path.style.pointerEvents = 'stroke';
    path.style.cursor = 'pointer';
    path.setAttribute('title', edge.sourceHandle || '');
    path.onclick = (e) => { e.stopPropagation(); if (confirm('Remover essa conexão?')) { state.flowData.edges = state.flowData.edges.filter(x => x.id !== edge.id); renderEdges(); } };
    svg.appendChild(path);
  }

  if (state.connectionDrag && state.armedHandle) {
    const source = byId[state.armedHandle.nodeId];
    if (!source) return;
    const p1 = handlePos(source, state.armedHandle.handle, true);
    const p2 = state.connectionDrag;
    const dx = Math.max(60, Math.abs(p2.x - p1.x) / 2);
    const preview = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    preview.setAttribute('d', 'M ' + p1.x + ' ' + p1.y + ' C ' + (p1.x + dx) + ' ' + p1.y + ', ' + (p2.x - dx) + ' ' + p2.y + ', ' + p2.x + ' ' + p2.y);
    preview.setAttribute('class', 'edge');
    preview.setAttribute('stroke', '#6123cc');
    preview.setAttribute('stroke-width', '2.5');
    preview.setAttribute('stroke-dasharray', '7 5');
    preview.setAttribute('fill', 'none');
    preview.setAttribute('marker-end', 'url(#arrow)');
    svg.appendChild(preview);
  }
}

// ---------------------------------------------------------------------
// Inspector (right panel) - field editors per node type
// ---------------------------------------------------------------------
function renderInspector() {
  const el = document.getElementById('inspector');
  const node = state.flowData.nodes.find(n => n.id === state.selectedNodeId);
  if (!node) { el.classList.add('hidden'); return; }
  el.classList.remove('hidden');
  const meta = NODE_TYPES[node.type];
  el.innerHTML = `
    <div class="flex items-center gap-2 mb-4">
      <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:${meta.color}22;">
        <i class="fas ${meta.icon}" style="color:${meta.color};"><\/i>
      <\/span>
      <h3 class="font-bold text-gray-800">${meta.label}<\/h3>
    <\/div>
    <div id="inspector-fields" class="flex flex-col gap-3"><\/div>
  `;
  renderFieldsFor(node);
}

function field(label, inputHtml, hint) {
  return '<div><label class="block text-xs font-medium text-gray-600 mb-1">' + label + '<\/label>' + inputHtml + (hint ? '<p class="text-[11px] text-gray-400 mt-1">' + hint + '<\/p>' : '') + '<\/div>';
}
function textInput(val, name) {
  return '<input data-field="' + name + '" value="' + escapeAttr(val||'') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">';
}
function textArea(val, name, rows) {
  return '<textarea data-field="' + name + '" rows="' + (rows||3) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">' + escapeHtml(val||'') + '<\/textarea>';
}

function availableFlowVariables() {
	const standard = [
	  { name: 'conversationId', label: 'ID do atendimento' },
	  { name: 'executionId', label: 'ID da execução' },
	  { name: 'flowId', label: 'ID do fluxo' },
	  { name: 'contactName', label: 'Nome do cliente' },
	  { name: 'contactNumber', label: 'Número do cliente' },
	  { name: 'contactEmail', label: 'Email do cliente' },
	  { name: 'conversationTags', label: 'Tags do atendimento' },
	  { name: 'department', label: 'Setor atual' },
	  { name: 'connectionType', label: 'Tipo de conexão' },
	  { name: 'message', label: 'Mensagem recebida' },
	  { name: 'response', label: 'Última resposta' },
	  { name: 'senderName', label: 'Nome informado pelo WhatsApp' },
	  { name: 'messageType', label: 'Tipo da mensagem recebida' },
	];
	const discovered = new Map();
	(state.flowData?.nodes || []).forEach(node => {
	  const data = node.data || {};
	  let name = '';
	  let source = '';
	  if (node.type === 'setVariable') { name = data.variableName; source = 'Definir Variável'; }
	  if (node.type === 'input') { name = data.variableName || 'userInput'; source = 'Capturar Resposta'; }
	  if (node.type === 'httpRequest') { name = data.saveResponseTo; source = 'HTTP Request'; }
	  if (node.type === 'checkResponse') { name = data.saveResponseTo; source = 'Verificar Resposta'; }
	  if (node.type === 'ai') { name = data.saveResponseTo; source = 'Gerar com IA'; }
	  name = String(name || '').trim();
	  if (name && !standard.some(variable => variable.name === name)) discovered.set(name, { name, label: source });
	});
	[
	  { name: 'assignedAgentId', label: 'ID do agente distribuído' },
	  { name: 'assignedAgentName', label: 'Nome do agente distribuído' },
	  { name: 'callbackResponse', label: 'Resposta do callback' },
	  { name: 'scheduledMessageAt', label: 'Data do agendamento' },
	].forEach(variable => discovered.set(variable.name, variable));
	return { standard, custom: Array.from(discovered.values()) };
}

function formattedTextArea(val, name, rows) {
  const formats = [
    { token: '*', icon: 'fa-bold', title: 'Negrito' },
    { token: '_', icon: 'fa-italic', title: 'Itálico' },
    { token: '~', icon: 'fa-strikethrough', title: 'Tachado' },
    { token: '```', icon: 'fa-code', title: 'Monoespaçado' },
  ];
	const variables = availableFlowVariables();
	const variableButton = variable => '<button type="button" data-variable-name="' + escapeAttr(variable.name) + '" class="w-full px-3 py-2 text-left hover:bg-purple-50 flex items-center justify-between gap-2"><span><span class="block text-xs font-medium text-gray-700">' + escapeHtml(variable.label) + '<\/span><code class="text-[10px] text-purple-600">{' + '{' + escapeHtml(variable.name) + '}' + '}<\/code><\/span><i class="fas fa-plus text-[10px] text-purple-500"><\/i><\/button>';
	return '<div data-formatted-editor class="rounded-lg border border-stone-200 bg-stone-50">' +
    '<div class="flex items-center gap-1 px-2 py-1.5 border-b border-stone-200 bg-white">' +
      formats.map(format => '<button type="button" data-format-token="' + format.token + '" title="' + format.title + '" class="w-8 h-8 rounded-md text-gray-600 hover:bg-purple-50 hover:text-purple-700"><i class="fas ' + format.icon + '"><\/i><\/button>').join('') +
	  '<span class="h-5 w-px bg-stone-200 mx-1"><\/span>' +
	  '<button type="button" data-variable-toggle title="Inserir variável" class="h-8 px-2.5 rounded-md text-xs font-medium text-purple-700 hover:bg-purple-50 flex items-center gap-1.5"><i class="fas fa-at"><\/i>Variáveis<\/button>' +
    '<\/div>' +
	'<div data-variable-menu class="hidden border-b border-stone-200 bg-white max-h-56 overflow-y-auto">' +
	  '<p class="px-3 pt-2 pb-1 text-[10px] font-bold uppercase tracking-wide text-gray-400">Dados do atendimento<\/p>' + standardVariableList(variables.standard, variableButton) +
	  (variables.custom.length ? '<p class="px-3 pt-3 pb-1 text-[10px] font-bold uppercase tracking-wide text-gray-400">Variáveis do fluxo<\/p>' + standardVariableList(variables.custom, variableButton) : '') +
	'<\/div>' +
    '<textarea data-field="' + name + '" data-formatted-text rows="' + (rows||4) + '" class="w-full px-3 py-2 bg-stone-50 text-sm focus:outline-none focus:ring-2 focus:ring-inset focus:ring-purple-400">' + escapeHtml(val||'') + '<\/textarea>' +
  '<\/div>';
}

function standardVariableList(variables, renderer) {
	return variables.map(renderer).join('');
}
function numberInput(val, name) {
  return '<input type="number" data-field="' + name + '" value="' + (val ?? '') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">';
}

function businessHoursFields(bh, prefix, includeOutsideAction) {
  if (!bh.startTime) bh.startTime = '08:00';
  if (!bh.endTime) bh.endTime = '18:00';
  if (!bh.timezone) bh.timezone = 'America/Sao_Paulo';
  if (!Array.isArray(bh.days)) bh.days = [1,2,3,4,5];
  const timeInput = (value, path) => '<input type="time" data-field="' + path + '" value="' + escapeAttr(value) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">';
  const dayLabels = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  let html = field('Dias de atendimento', '<div class="grid grid-cols-4 gap-1.5">' + dayLabels.map((label, day) =>
    '<label class="flex items-center gap-1 text-xs text-gray-600"><input type="checkbox" data-business-days-path="' + prefix + 'days" value="' + day + '" ' + (bh.days.includes(day)?'checked':'') + '> ' + label + '<\/label>'
  ).join('') + '<\/div>');
  html += field('Início', timeInput(bh.startTime, prefix + 'startTime'));
  html += field('Fim', timeInput(bh.endTime, prefix + 'endTime'));
  html += field('Fuso horário', textInput(bh.timezone, prefix + 'timezone'));
  html += field('Intervalo', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="' + prefix + 'lunchEnabled" ' + (bh.lunchEnabled?'checked':'') + '> Considerar intervalo de almoço<\/label>');
  if (bh.lunchEnabled) {
    if (!bh.lunchStart) bh.lunchStart = '12:00';
    if (!bh.lunchEnd) bh.lunchEnd = '13:00';
    html += field('Início do intervalo', timeInput(bh.lunchStart, prefix + 'lunchStart'));
    html += field('Fim do intervalo', timeInput(bh.lunchEnd, prefix + 'lunchEnd'));
  }
  if (includeOutsideAction) {
    if (!bh.outsideAction) bh.outsideAction = 'block';
    html += field('Fora do horário', inspectorSelect(prefix + 'outsideAction', [
      { value: 'block', label: 'Ignorar mensagem' }, { value: 'message', label: 'Enviar aviso automático' },
    ], bh.outsideAction, 'Selecione uma ação'));
	if (bh.outsideAction === 'message') html += field('Mensagem de aviso', formattedTextArea(bh.outsideMessage, prefix + 'outsideMessage', 4));
  }
  return html;
}

function mediaNodeConfig(type) {
  if (type === 'sendImage') return { kind: 'image', urlField: 'imageUrl', pathField: 'imagePath', mimeField: 'imageMimeType', accept: 'image/jpeg,image/png,image/gif,image/webp', label: 'uma imagem', hint: 'JPG, PNG, GIF ou WEBP · até 10 MB' };
  if (type === 'sendVideo') return { kind: 'video', urlField: 'videoUrl', pathField: 'videoPath', mimeField: 'videoMimeType', accept: 'video/mp4,video/webm,video/quicktime', label: 'um vídeo', hint: 'MP4, WEBM ou MOV · até 50 MB' };
  if (type === 'sendAudio') return { kind: 'audio', urlField: 'audioUrl', pathField: 'audioPath', mimeField: 'audioMimeType', accept: 'audio/webm,audio/ogg,audio/mpeg,audio/mp4,audio/wav', label: 'um áudio', hint: 'WEBM, OGG, MP3, M4A ou WAV · até 20 MB' };
  if (type === 'sendFile') return { kind: 'document', urlField: 'fileUrl', pathField: 'filePath', mimeField: 'fileMimeType', accept: '.pdf,.txt,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip', label: 'um documento', hint: 'PDF, Office, TXT, CSV ou ZIP · até 50 MB' };
  return null;
}

function mediaUploadHTML(kind, data, options) {
  const url = data[options.urlField] || '';
  const uploaded = !!data[options.pathField];
  const previewUrl = data.mediaPreviewUrl || url;
  let preview = '';
  if (uploaded && previewUrl) {
    if (kind === 'image') preview = '<img src="' + escapeAttr(previewUrl) + '" class="w-full h-28 object-cover rounded-lg border border-stone-200">';
    if (kind === 'video') preview = '<video src="' + escapeAttr(previewUrl) + '" controls class="w-full max-h-36 rounded-lg border border-stone-200"><\/video>';
    if (kind === 'audio') preview = '<audio src="' + escapeAttr(previewUrl) + '" controls class="w-full"><\/audio>';
    if (kind === 'document') preview = '<a href="' + escapeAttr(previewUrl) + '" target="_blank" class="flex items-center gap-2 p-3 rounded-lg border border-stone-200 bg-stone-50 text-sm text-purple-700"><i class="fas fa-file-lines text-xl"><\/i><span class="truncate">' + escapeHtml(data.mediaName || 'Documento') + '<\/span><\/a>';
    preview += '<div class="flex items-center justify-between gap-2 mt-2"><span class="text-[11px] text-gray-500 truncate">' + escapeHtml(data.mediaName || options.label) + '<\/span>' +
      '<button type="button" data-media-remove class="text-xs text-red-600 hover:underline">Remover<\/button><\/div>';
  }
  return '<div data-media-upload>' +
    '<label class="block border-2 border-dashed border-stone-300 hover:border-purple-400 rounded-xl p-4 text-center cursor-pointer transition-colors" data-media-dropzone>' +
      '<input type="file" accept="' + options.accept + '" class="hidden" data-media-file>' +
      '<i class="fas fa-cloud-arrow-up text-2xl text-purple-500 mb-2"><\/i>' +
      '<div class="text-sm font-medium text-gray-700">Arraste ou selecione ' + options.label + '<\/div>' +
      '<div class="text-[11px] text-gray-400 mt-1">' + options.hint + '<\/div>' +
    '<\/label>' +
    (kind === 'audio' ? '<button type="button" data-record-audio class="mt-2 w-full px-3 py-2 rounded-lg bg-purple-100 text-purple-700 hover:bg-purple-200 text-sm font-medium"><i class="fas fa-microphone mr-1"><\/i>Gravar agora<\/button>' : '') +
    '<div data-media-status class="text-xs text-gray-500 mt-2"><\/div>' +
    (preview ? '<div class="mt-3">' + preview + '<\/div>' : '') +
  '<\/div>';
}

function renderFieldsFor(node) {
  const box = document.getElementById('inspector-fields');
  const d = node.data;
  let html = '';

  switch (node.type) {
    case 'start': {
      d.businessHours = d.businessHours || {};
      const bh = d.businessHours;
      html += field('Horário de atendimento', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="businessHours.enabled" ' + (bh.enabled?'checked':'') + '> Restringir a um horário<\/label>');
	  if (bh.enabled) {
		html += businessHoursFields(bh, 'businessHours.', true);
      }
      break;
    }
    case 'sendText':
      html += field('Mensagem', formattedTextArea(d.message, 'message', 5), 'Selecione um trecho e use a barra de formatação. Variáveis continuam disponíveis com {' + '{variavel}' + '}.');
      break;
	case 'sendTemplate':
	  html += field('Modelo', inspectorSelect('templateId', [{ value: '', label: 'Selecione' }].concat(state.templates.map(template => ({ value: String(template.id), label: template.name }))), d.templateId || '', 'Selecione'));
	  const selectedTemplate = state.templates.find(template => template.id === Number(d.templateId));
	  if (selectedTemplate) html += '<div class="rounded-lg bg-stone-50 border border-stone-200 p-3 text-xs text-gray-600 whitespace-pre-wrap">' + escapeHtml(selectedTemplate.content) + '<\/div>';
	  break;
    case 'sendImage':
      html += mediaUploadHTML('image', d, mediaNodeConfig(node.type));
      if (!d.imagePath) html += field('Ou use uma URL externa', textInput(d.imageUrl, 'imageUrl'));
	  html += field('Legenda (opcional)', formattedTextArea(d.caption, 'caption', 3));
      break;
    case 'sendVideo':
      html += mediaUploadHTML('video', d, mediaNodeConfig(node.type));
      if (!d.videoPath) html += field('Ou use uma URL externa', textInput(d.videoUrl, 'videoUrl'));
	  html += field('Legenda (opcional)', formattedTextArea(d.caption, 'caption', 3));
      break;
    case 'sendAudio':
      html += mediaUploadHTML('audio', d, mediaNodeConfig(node.type));
      if (!d.audioPath) html += field('Ou use uma URL externa', textInput(d.audioUrl, 'audioUrl'));
      break;
    case 'sendFile':
      html += mediaUploadHTML('document', d, mediaNodeConfig(node.type));
      if (!d.filePath) html += field('Ou use uma URL externa', textInput(d.fileUrl, 'fileUrl'));
	  html += field('Legenda (opcional)', formattedTextArea(d.caption, 'caption', 3));
      break;
    case 'sendMenu':
      d.sections = d.sections || [];
      html += field('Título', textInput(d.title || 'Menu', 'title'));
	  html += field('Mensagem', formattedTextArea(d.description, 'description', 4));
      html += field('Texto do botão', textInput(d.buttonText || 'Ver Menu', 'buttonText'));
      html += field('Rodapé', textInput(d.footerText || 'Sophus', 'footerText'));
      html += field('Caminho padrão', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="useFallback" ' + (d.useFallback?'checked':'') + '> Adicionar saída para respostas inválidas<\/label>');
	  html += field('Navegação entre menus', '<div class="space-y-2 rounded-xl border border-stone-200 bg-stone-50 p-3">' +
		'<label class="flex items-start gap-2 text-sm text-gray-700"><input type="checkbox" data-field="allowBackPrevious" ' + (d.allowBackPrevious?'checked':'') + '><span><span class="block font-medium">Voltar ao menu anterior<\/span><span class="block text-[11px] text-gray-400">Retoma o menu visitado imediatamente antes deste.<\/span><\/span><\/label>' +
		'<label class="flex items-start gap-2 text-sm text-gray-700"><input type="checkbox" data-field="allowBackMain" ' + (d.allowBackMain?'checked':'') + '><span><span class="block font-medium">Voltar ao menu principal<\/span><span class="block text-[11px] text-gray-400">Retoma o primeiro menu visitado na execução.<\/span><\/span><\/label>' +
	  '<\/div>', 'As opções aparecem para o cliente somente quando já existe um menu anterior no histórico.');
      html += '<div class="text-xs font-medium text-gray-600 mt-1">Seções e opções<\/div>';
      html += '<div id="menu-sections" class="flex flex-col gap-3"><\/div>';
      html += '<button id="btn-add-menu-section" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar seção<\/button>';
      break;
    case 'condition': {
      if (!d.conditionSource) d.conditionSource = d.condition ? 'legacy' : 'contactMessage';
      if (!d.conditionOperator) d.conditionOperator = 'equals';
      const sourceOptions = d.conditionSource === 'legacy'
        ? [{ value: 'legacy', label: 'EXPRESSÃO ANTIGA' }].concat(CONDITION_SOURCES)
        : CONDITION_SOURCES;
      html += field('Avaliar', inspectorSelect('conditionSource', sourceOptions, d.conditionSource, 'Escolha o dado'));
      if (d.conditionSource === 'legacy') {
        html += field('Expressão antiga', textArea(d.condition, 'condition', 3), 'Selecione uma origem acima para migrar esta condição para o formato visual.');
        break;
      }
      if (d.conditionSource === 'variable') {
        html += field('Nome da variável', textInput(d.conditionVariable, 'conditionVariable'), 'Use o nome salvo por Capturar Resposta ou HTTP Request. Caminhos como apiResult.data.status são aceitos.');
      }
      html += field('Operador', inspectorSelect('conditionOperator', CONDITION_OPERATORS, d.conditionOperator, 'Escolha o operador'));
      if (d.conditionOperator !== 'true' && d.conditionOperator !== 'false') {
        if (d.conditionSource === 'department') {
          const departments = [{ value: '', label: 'Selecione o departamento' }].concat(state.departments.map(department => ({ value: department.name, label: department.name })));
          html += field('Valor', inspectorSelect('conditionValue', departments, d.conditionValue || '', 'Selecione o departamento'));
        } else if (d.conditionSource === 'connectionType') {
          html += field('Valor', inspectorSelect('conditionValue', [
            { value: 'whatsapp_qrcode', label: 'WhatsApp por QR Code' },
            { value: 'api_oficial', label: 'WhatsApp API Oficial' },
          ], d.conditionValue || '', 'Selecione o tipo'));
        } else if (d.conditionSource === 'time') {
          html += field('Horário', '<input type="time" data-field="conditionValue" value="' + escapeAttr(d.conditionValue || '') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', 'Usa o fuso horário configurado no bloco Início; o padrão é America/Sao_Paulo.');
        } else {
          html += field('Valor', textInput(d.conditionValue, 'conditionValue'), 'A comparação ignora diferenças entre maiúsculas e minúsculas.');
        }
      } else {
        html += '<p class="text-[11px] text-gray-400">Este operador avalia o valor diretamente e não precisa de comparação.<\/p>';
      }
      break;
    }
    case 'switch':
      d.cases = d.cases || [];
	  html += field('Mensagem (opcional)', formattedTextArea(d.message, 'message', 4), 'Enviada antes de aguardar a resposta.');
      html += '<div class="text-xs font-medium text-gray-600 mb-1">Opções (avaliadas na ordem)<\/div>';
      html += '<div id="switch-cases" class="flex flex-col gap-2"><\/div>';
      html += '<button id="btn-add-case" class="mt-1 text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar opção<\/button>';
      html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'), 'Se o contato não responder nesse tempo, segue pelo "Nenhuma opção".');
      break;
    case 'delay':
      html += field('Tipo', inspectorSelect('delayType', [
        { value: 'fixed', label: 'Tempo fixo' },
        { value: 'range', label: 'Intervalo aleatório' },
      ], d.delayType || 'fixed', 'Selecione o tipo'));
      if (d.delayType === 'range') {
        html += field('Mínimo (s)', numberInput(d.minSeconds, 'minSeconds'));
        html += field('Máximo (s)', numberInput(d.maxSeconds, 'maxSeconds'));
      } else {
        html += field('Segundos', numberInput(d.seconds, 'seconds'));
      }
      html += '<p class="text-[11px] text-gray-400">Limitado a 60s no máximo.<\/p>';
      break;
    case 'changeStatus':
      html += field('Novo status', inspectorSelect('status', [
        { value: '', label: 'Selecione' },
        { value: 'open', label: 'Aberta', dot: '#22c55e' },
        { value: 'pending', label: 'Pendente', dot: '#f59e0b' },
        { value: 'closed', label: 'Fechada', dot: '#ef4444' },
      ], d.status || '', 'Selecione o status'));
      break;
    case 'assign':
      html += field('Transferir para', inspectorSelect('assignType', [
        { value: 'agent', label: 'Agente' },
        { value: 'department', label: 'Setor' },
      ], d.assignType || 'agent', 'Selecione o destino'));
      const assignmentOptions = d.assignType === 'department' ? state.departments : state.agents;
      html += field(d.assignType === 'department' ? 'Setor' : 'Agente',
          inspectorSelect('assignId', [{ value: '', label: 'Selecione' }].concat(assignmentOptions.map(option => ({ value: String(option.id), label: option.name }))), d.assignId || '', 'Selecione'));
	  html += field('Mensagem após transferir (opcional)', formattedTextArea(d.message, 'message', 4), 'Enviada ao cliente depois que a transferência for concluída.');
      break;
    case 'httpRequest':
      html += '<div class="rounded-xl border border-purple-200 bg-purple-50 p-3 flex flex-col gap-2">' +
        '<div><p class="text-xs font-semibold text-purple-900"><i class="fas fa-terminal mr-1"><\/i>Importar de cURL<\/p><p class="mt-1 text-[11px] leading-relaxed text-purple-700">Cole um comando cURL para preencher URL, método, headers e corpo.<\/p><\/div>' +
        '<textarea id="http-curl-command" rows="5" spellcheck="false" placeholder="curl https://api.exemplo.com ..." class="w-full resize-y rounded-lg border border-purple-200 bg-white px-3 py-2 font-mono text-xs text-gray-800 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><\/textarea>' +
        '<button type="button" id="btn-import-http-curl" class="w-full rounded-lg bg-purple-700 px-3 py-2 text-xs font-semibold text-white transition hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-file-import mr-1"><\/i>Importar configurações<\/button>' +
        '<p id="http-curl-feedback" class="hidden text-[11px] leading-relaxed"><\/p><\/div>';
      html += field('Método', inspectorSelect('method', ['GET','POST','PUT','PATCH','DELETE'].map(method => ({ value: method, label: method })), d.method || 'POST', 'Método HTTP'));
      html += field('URL', textInput(d.url, 'url'));
      if (!d.headerMode) {
        d.headerMode = d.headers && typeof d.headers === 'object' && !Array.isArray(d.headers) ? 'rawJSON' : 'none';
        if (d.headerMode === 'rawJSON' && !d.headersRaw) d.headersRaw = JSON.stringify(d.headers, null, 2);
      }
      d.headerFields = d.headerFields || [];
      html += field('Formato dos headers', inspectorSelect('headerMode', [
        { value: 'fields', label: 'Chave/valor' },
        { value: 'rawJSON', label: 'JSON livre' },
        { value: 'none', label: 'Sem headers' },
      ], d.headerMode, 'Formato dos headers'));
      if (d.headerMode === 'fields') {
        html += '<div class="flex items-center justify-between"><span class="text-xs font-medium text-gray-600">Headers</span>' +
          '<button type="button" id="btn-add-http-header" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar header<\/button><\/div>' +
          '<div id="http-header-fields" class="flex flex-col gap-2"><\/div>' +
          '<p class="text-[11px] text-gray-400">Valores aceitam {' + '{variavel}' + '}. Headers de proxy e roteamento são bloqueados.<\/p>';
      } else if (d.headerMode === 'rawJSON') {
        html += field('Headers JSON', textArea(d.headersRaw, 'headersRaw', 5), 'Objeto JSON com valores de texto. Ex: {"Authorization":"Bearer token"}.');
      }
      if ((d.method||'POST') !== 'GET') {
        if (!d.bodyMode) d.bodyMode = d.body ? 'rawJSON' : 'none';
        d.bodyFields = d.bodyFields || [];
        html += field('Formato do corpo', inspectorSelect('bodyMode', [
          { value: 'json', label: 'JSON por campos' },
          { value: 'rawJSON', label: 'JSON livre' },
          { value: 'raw', label: 'Texto livre' },
          { value: 'form', label: 'Formulário (x-www-form-urlencoded)' },
		  { value: 'multipart', label: 'Form-data (multipart)' },
          { value: 'none', label: 'Sem corpo' },
        ], d.bodyMode, 'Formato do corpo'));
		if (d.bodyMode === 'json' || d.bodyMode === 'form' || d.bodyMode === 'multipart') {
          html += '<div class="flex items-center justify-between"><span class="text-xs font-medium text-gray-600">Campos do corpo<\/span>' +
            '<button type="button" id="btn-add-http-field" class="text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar campo<\/button><\/div>' +
            '<div id="http-body-fields" class="flex flex-col gap-2"><\/div>' +
			'<p class="text-[11px] text-gray-400">' + (d.bodyMode === 'multipart' ? 'Cada campo será enviado como uma parte do form-data. O Content-Type da parte é opcional.' : 'Valores aceitam {' + '{variavel}' + '}. No modo JSON, números, booleanos, objetos e arrays válidos são tipados automaticamente.') + '<\/p>';
        } else if (d.bodyMode === 'rawJSON' || d.bodyMode === 'raw') {
          html += field(d.bodyMode === 'rawJSON' ? 'Corpo JSON' : 'Corpo da requisição', textArea(d.body, 'body', 6), 'Use {' + '{variavel}' + '} para inserir dados capturados no fluxo.');
        }
      }
      html += field('Salvar resposta em', textInput(d.saveResponseTo, 'saveResponseTo'), 'Nome da variável, ex: apiResult');
      html += field('Timeout (ms)', numberInput(d.timeout, 'timeout'));
	  html += field('Timeout de conexão (ms)', numberInput(d.connectTimeout, 'connectTimeout'));
	  html += field('Redirecionamentos', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="followRedirects" ' + (d.followRedirects?'checked':'') + '> Seguir respostas 3xx<\/label>', 'Ative para reproduzir cURL com --location. Cada destino continua sujeito à proteção contra endereços privados.');
      break;
    case 'waitForResponse':
      html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'));
      break;
    case 'input':
	  html += field('Mensagem (opcional)', formattedTextArea(d.message, 'message', 4), 'Enviada antes de aguardar a resposta.');
      html += field('Salvar resposta em', textInput(d.variableName, 'variableName'), 'Nome da variável, ex: nomeCliente');
	  html += field('Validação', inspectorSelect('validationType', [
		{ value: 'any', label: 'Qualquer mensagem (texto ou mídia)' }, { value: 'text', label: 'Texto não vazio' }, { value: 'email', label: 'Email' },
		{ value: 'number', label: 'Número' }, { value: 'regex', label: 'Expressão regular' },
	  ], d.validationType || 'any', 'Selecione'));
	  if (d.validationType === 'regex') html += field('Expressão regular', textInput(d.validationPattern, 'validationPattern'), 'Formato RE2 do Go, por exemplo: ^[0-9]{11}$');
      html += field('Timeout (segundos, opcional)', numberInput(d.timeout, 'timeout'));
      break;
    case 'checkResponse':
      html += field('Salvar resultado em (opcional)', textInput(d.saveResponseTo, 'saveResponseTo'));
      break;
	case 'setVariable':
	  html += field('Nome da variável', textInput(d.variableName, 'variableName'), 'Use letras, números e sublinhado; comece por uma letra.');
	  html += field('Valor', textArea(d.value, 'value', 3), 'Aceita variáveis como {' + '{contactName}' + '}.');
	  break;
	case 'tag':
	  html += field('Ação', inspectorSelect('operation', [{ value: 'add', label: 'Adicionar tag' }, { value: 'remove', label: 'Remover tag' }], d.operation || 'add', 'Selecione'));
	  html += field('Tag', textInput(d.tag, 'tag'), 'Aceita variáveis e ignora diferenças entre maiúsculas e minúsculas ao evitar duplicatas.');
	  break;
	case 'updateContact':
	  html += field('Campo', inspectorSelect('field', [{ value: 'name', label: 'Nome' }, { value: 'email', label: 'Email' }], d.field || 'name', 'Selecione'));
	  html += field('Novo valor', textInput(d.value, 'value'), 'Aceita variáveis do contexto do fluxo.');
	  break;
	case 'businessHours':
	  html += businessHoursFields(d, '', false);
	  break;
	case 'randomSplit':
	  html += field('Percentual no grupo A', '<input type="number" min="1" max="99" data-field="percentage" value="' + Number(d.percentage || 50) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', 'O restante segue pelo grupo B. Cada passagem faz um novo sorteio.');
	  break;
	case 'messageType':
	  html += '<p class="text-sm text-gray-500">Encaminha o fluxo conforme o tipo da última mensagem recebida pelo contato.<\/p>';
	  break;
	case 'smartAssign':
	  html += field('Estratégia', inspectorSelect('strategy', [
		{ value: 'leastLoaded', label: 'Menor quantidade de conversas' }, { value: 'random', label: 'Aleatória' },
	  ], d.strategy || 'leastLoaded', 'Selecione'));
	  html += field('Restringir ao setor (opcional)', inspectorSelect('departmentId', [{ value: '', label: 'Todos os agentes' }].concat(state.departments.map(department => ({ value: String(department.id), label: department.name }))), d.departmentId || '', 'Todos os agentes'));
	  break;
	case 'addNote':
	  html += field('Tipo', inspectorSelect('eventType', [{ value: 'note', label: 'Nota interna' }, { value: 'history', label: 'Evento de histórico' }], d.eventType || 'note', 'Selecione'));
	  html += field('Conteúdo', textArea(d.content, 'content', 4), 'Registro interno: não será enviado ao contato. Aceita variáveis.');
	  break;
	case 'callback':
	  html += field('Nome do evento', textInput(d.eventName, 'eventName'));
	  html += field('URL', textInput(d.url, 'url'), 'Somente destinos públicos são permitidos.');
	  html += field('Token Bearer (opcional)', '<input type="password" data-field="token" value="' + escapeAttr(d.token || '') + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">');
	  html += field('Timeout (ms)', numberInput(d.timeout, 'timeout'));
	  html += field('Redirecionamentos', '<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" data-field="followRedirects" ' + (d.followRedirects?'checked':'') + '> Seguir respostas 3xx<\/label>');
	  break;
	case 'subflow': {
	  const availableFlows = state.flows.filter(flow => flow.id !== state.currentFlow.id);
	  html += field('Fluxo reutilizável', inspectorSelect('flowId', [{ value: '', label: 'Selecione' }].concat(availableFlows.map(flow => ({ value: String(flow.id), label: flow.name }))), d.flowId || '', 'Selecione'));
	  html += '<p class="text-[11px] text-gray-400">Subfluxos são capturados no início da execução e não podem conter blocos que aguardam resposta.<\/p>';
	  break;
	}
	case 'ai':
	  html += field('Instrução do sistema (opcional)', textArea(d.systemPrompt, 'systemPrompt', 4));
	  html += field('Prompt', textArea(d.prompt, 'prompt', 6), 'Aceita variáveis. Credenciais e modelo são configurados no servidor.');
	  html += field('Salvar resposta em', textInput(d.saveResponseTo, 'saveResponseTo'));
	  break;
	case 'scheduleMessage':
	  html += field('Mensagem', formattedTextArea(d.message, 'message', 5), 'As variáveis são resolvidas no momento do agendamento.');
	  html += field('Enviar após (minutos)', '<input type="number" min="1" max="43200" data-field="delayMinutes" value="' + Number(d.delayMinutes || 60) + '" class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">', 'Entre 1 minuto e 30 dias. O envio sobrevive a reinícios do servidor.');
	  break;
    case 'end':
      html += '<p class="text-sm text-gray-500">Fim do fluxo. Nenhuma configuração necessária.<\/p>';
      break;
  }

  box.innerHTML = html;

  box.querySelectorAll('[data-field]').forEach(input => {
    const path = input.dataset.field;
    const handler = () => {
      const val = input.type === 'checkbox' ? input.checked
        : input.type === 'number' ? (input.value === '' ? undefined : Number(input.value))
        : path === 'assignId' ? (input.value === '' ? undefined : Number(input.value))
        : input.value;
      setPath(d, path, val);
      if (node.type === 'httpRequest' && path === 'bodyMode') {
		if ((val === 'json' || val === 'form' || val === 'multipart') && !d.bodyFields.length) d.bodyFields.push({ key: '', value: '', contentType: '' });
      }
      if (node.type === 'httpRequest' && path === 'headerMode') {
        d.headerFields = d.headerFields || [];
        if (val === 'fields' && !d.headerFields.length) d.headerFields.push({ key: '', value: '' });
      }
      const mediaConfig = mediaNodeConfig(node.type);
      if (mediaConfig && path === mediaConfig.urlField) {
        delete d[mediaConfig.pathField];
        delete d[mediaConfig.mimeField];
        delete d.mediaPreviewUrl;
        delete d.mediaName;
      }
      if (node.type === 'assign' && path === 'assignType') delete d.assignId;
      if (node.type === 'condition' && path === 'conditionSource') d.conditionValue = '';
      if (node.type === 'sendMenu' && path === 'useFallback' && !val) {
        state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || (edge.sourceHandle !== 'fallback' && !!edge.sourceHandle));
        if (state.armedHandle?.nodeId === node.id && state.armedHandle.handle === 'fallback') state.armedHandle = null;
      }
      renderCanvas();
      if (node.type !== 'sendMenu' && (input.tagName === 'SELECT' || input.type === 'checkbox')) renderInspector();
    };
    input.addEventListener((input.tagName === 'SELECT' || input.type === 'checkbox') ? 'change' : 'input', handler);
  });

  box.querySelectorAll('[data-dd-field]').forEach(wrapper => {
    const path = wrapper.dataset.ddField;
    wrapper.querySelectorAll('input[type=radio]').forEach(radio => radio.addEventListener('change', () => {
	  const numericSelect = path === 'assignId' || path === 'departmentId' || path === 'flowId' || path === 'templateId';
      const val = numericSelect ? (radio.value === '' ? undefined : Number(radio.value)) : radio.value;
      setPath(d, path, val);
      if (node.type === 'httpRequest' && path === 'bodyMode') {
        d.bodyFields = d.bodyFields || [];
		if ((val === 'json' || val === 'form' || val === 'multipart') && !d.bodyFields.length) d.bodyFields.push({ key: '', value: '', contentType: '' });
      }
      if (node.type === 'httpRequest' && path === 'headerMode') {
        d.headerFields = d.headerFields || [];
        if (val === 'fields' && !d.headerFields.length) d.headerFields.push({ key: '', value: '' });
      }
      if (node.type === 'assign' && path === 'assignType') delete d.assignId;
      if (node.type === 'condition' && path === 'conditionSource') d.conditionValue = '';
      closeDropdown(radio);
      renderCanvas();
      renderInspector();
    }));
  });

  box.querySelectorAll('[data-business-days-path]').forEach(input => input.addEventListener('change', () => {
	const path = input.dataset.businessDaysPath;
	const days = Array.from(box.querySelectorAll('[data-business-days-path="' + path + '"]:checked')).map(day => Number(day.value));
	setPath(d, path, days);
	renderCanvas();
  }));

  box.querySelectorAll('[data-format-token]').forEach(button => button.onclick = () => {
	const editor = button.closest('[data-formatted-editor]');
	const input = editor?.querySelector('[data-formatted-text]');
	if (!input) return;
    const token = button.dataset.formatToken;
    const start = input.selectionStart;
    const end = input.selectionEnd;
    const selected = input.value.slice(start, end) || 'texto';
	const replacement = token + selected + token;
	input.setRangeText(replacement, start, end, 'end');
	input.dispatchEvent(new Event('input', { bubbles: true }));
	input.focus();
  });

  box.querySelectorAll('[data-variable-toggle]').forEach(button => button.onclick = () => {
	const editor = button.closest('[data-formatted-editor]');
	const menu = editor?.querySelector('[data-variable-menu]');
	if (menu) menu.classList.toggle('hidden');
  });

  box.querySelectorAll('[data-variable-name]').forEach(button => button.onclick = () => {
	const editor = button.closest('[data-formatted-editor]');
	const input = editor?.querySelector('[data-formatted-text]');
	if (!input) return;
	const variable = '{' + '{' + button.dataset.variableName + '}' + '}';
	input.setRangeText(variable, input.selectionStart, input.selectionEnd, 'end');
	input.dispatchEvent(new Event('input', { bubbles: true }));
	editor.querySelector('[data-variable-menu]')?.classList.add('hidden');
	input.focus();
  });

  if (node.type === 'switch') renderSwitchCases(node);
  if (node.type === 'sendMenu') renderMenuSections(node);
  if (node.type === 'httpRequest') {
	bindHTTPCURLImport(node, box);
    renderHTTPHeaderFields(node);
    renderHTTPBodyFields(node);
  }
  bindMediaUploads(node, box);
}

function bindHTTPCURLImport(node, box) {
  const button = box.querySelector('#btn-import-http-curl');
  const input = box.querySelector('#http-curl-command');
  const feedback = box.querySelector('#http-curl-feedback');
  if (!button || !input || !feedback) return;
  button.onclick = async () => {
    const command = input.value.trim();
    if (!command) {
      feedback.textContent = 'Cole um comando cURL antes de importar.';
      feedback.className = 'text-[11px] leading-relaxed text-red-600';
      input.focus();
      return;
    }
    button.disabled = true;
    feedback.textContent = 'Lendo configurações...';
    feedback.className = 'text-[11px] leading-relaxed text-purple-700';
    try {
      const imported = await api('POST', '/flows/api/parse-curl', { command });
	  if (state.selectedNodeId !== node.id || !state.flowData.nodes.includes(node)) return;
	  ['method', 'url', 'headerMode', 'headerFields', 'headersRaw', 'headers', 'bodyMode', 'bodyFields', 'body', 'timeout', 'connectTimeout', 'followRedirects'].forEach(field => delete node.data[field]);
      Object.assign(node.data, imported);
      renderCanvas();
      renderInspector();
      const success = document.getElementById('http-curl-feedback');
      if (success) {
        success.textContent = 'Configurações importadas. Revise os dados antes de salvar.';
        success.className = 'text-[11px] leading-relaxed text-emerald-700';
      }
    } catch (error) {
      feedback.textContent = error.message;
      feedback.className = 'text-[11px] leading-relaxed text-red-600';
      button.disabled = false;
    }
  };
}

function renderHTTPHeaderFields(node) {
  const wrap = document.getElementById('http-header-fields');
  if (!wrap) return;
  node.data.headerFields = node.data.headerFields || [];
  wrap.innerHTML = node.data.headerFields.map((header, index) =>
    '<div class="grid grid-cols-[1fr_1fr_auto] gap-2 items-center">' +
      '<input data-http-header-key="' + index + '" value="' + escapeAttr(header.key||'') + '" placeholder="Header" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
      '<input data-http-header-value="' + index + '" value="' + escapeAttr(header.value||'') + '" placeholder="Valor" autocomplete="off" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
      '<button type="button" data-http-header-remove="' + index + '" class="w-8 h-8 text-red-500 hover:bg-red-50 rounded-lg"><i class="fas fa-times"><\/i><\/button>' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-http-header-key]').forEach(input => input.oninput = () => {
    node.data.headerFields[Number(input.dataset.httpHeaderKey)].key = input.value;
  });
  wrap.querySelectorAll('[data-http-header-value]').forEach(input => input.oninput = () => {
    node.data.headerFields[Number(input.dataset.httpHeaderValue)].value = input.value;
  });
  wrap.querySelectorAll('[data-http-header-remove]').forEach(button => button.onclick = () => {
    node.data.headerFields.splice(Number(button.dataset.httpHeaderRemove), 1);
    renderHTTPHeaderFields(node);
  });
  const add = document.getElementById('btn-add-http-header');
  if (add) add.onclick = () => {
    node.data.headerFields.push({ key: '', value: '' });
    renderHTTPHeaderFields(node);
    wrap.querySelector('[data-http-header-key="' + (node.data.headerFields.length - 1) + '"]').focus();
  };
}

function renderHTTPBodyFields(node) {
  const wrap = document.getElementById('http-body-fields');
  if (!wrap) return;
  node.data.bodyFields = node.data.bodyFields || [];
	const multipart = node.data.bodyMode === 'multipart';
  wrap.innerHTML = node.data.bodyFields.map((field, index) =>
	'<div class="grid ' + (multipart ? 'grid-cols-[1fr_1fr_1fr_auto]' : 'grid-cols-[1fr_1fr_auto]') + ' gap-2 items-center">' +
      '<input data-http-key="' + index + '" value="' + escapeAttr(field.key||'') + '" placeholder="Chave" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
      '<input data-http-value="' + index + '" value="' + escapeAttr(field.value||'') + '" placeholder="Valor" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' +
	  (multipart ? '<input data-http-content-type="' + index + '" value="' + escapeAttr(field.contentType||'') + '" placeholder="Content-Type opcional" class="min-w-0 px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs">' : '') +
      '<button type="button" data-http-remove="' + index + '" class="w-8 h-8 text-red-500 hover:bg-red-50 rounded-lg"><i class="fas fa-times"><\/i><\/button>' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-http-key]').forEach(input => input.oninput = () => {
    node.data.bodyFields[Number(input.dataset.httpKey)].key = input.value;
  });
  wrap.querySelectorAll('[data-http-value]').forEach(input => input.oninput = () => {
    node.data.bodyFields[Number(input.dataset.httpValue)].value = input.value;
  });
	wrap.querySelectorAll('[data-http-content-type]').forEach(input => input.oninput = () => {
		node.data.bodyFields[Number(input.dataset.httpContentType)].contentType = input.value;
	});
  wrap.querySelectorAll('[data-http-remove]').forEach(button => button.onclick = () => {
    node.data.bodyFields.splice(Number(button.dataset.httpRemove), 1);
    renderHTTPBodyFields(node);
  });
  const add = document.getElementById('btn-add-http-field');
  if (add) add.onclick = () => {
	node.data.bodyFields.push({ key: '', value: '', contentType: '' });
    renderHTTPBodyFields(node);
    wrap.querySelector('[data-http-key="' + (node.data.bodyFields.length - 1) + '"]').focus();
  };
}

function bindMediaUploads(node, box) {
  const wrapper = box.querySelector('[data-media-upload]');
  if (!wrapper) return;
  const config = mediaNodeConfig(node.type);
  const input = wrapper.querySelector('[data-media-file]');
  const dropzone = wrapper.querySelector('[data-media-dropzone]');
  const status = wrapper.querySelector('[data-media-status]');

  async function uploadMedia(file) {
    if (!file) return;
    status.textContent = 'Enviando mídia...';
    status.className = 'text-xs text-gray-500 mt-2';
    const form = new FormData();
    form.append('kind', config.kind);
    form.append('file', file, file.name || ('gravacao.' + (file.type.includes('ogg') ? 'ogg' : 'webm')));
    try {
      const response = await fetch('/flows/api/media', { method: 'POST', body: form });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || ('Erro ' + response.status));
      const stored = payload.data;
      delete node.data[config.urlField];
      node.data[config.pathField] = stored.path;
      node.data[config.mimeField] = stored.mimeType;
      node.data.mediaPreviewUrl = stored.url;
      node.data.mediaName = stored.name;
      renderCanvas();
      renderInspector();
    } catch (error) {
      status.textContent = error.message;
      status.className = 'text-xs text-red-600 mt-2';
    }
  }

  input.addEventListener('change', () => uploadMedia(input.files[0]));
  dropzone.addEventListener('dragover', event => {
    event.preventDefault();
    dropzone.classList.add('border-purple-500', 'bg-purple-50');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-purple-500', 'bg-purple-50'));
  dropzone.addEventListener('drop', event => {
    event.preventDefault();
    dropzone.classList.remove('border-purple-500', 'bg-purple-50');
    uploadMedia(event.dataTransfer.files[0]);
  });

  const remove = wrapper.querySelector('[data-media-remove]');
  if (remove) remove.onclick = () => {
    delete node.data[config.urlField];
    delete node.data[config.pathField];
    delete node.data[config.mimeField];
    delete node.data.mediaPreviewUrl;
    delete node.data.mediaName;
    renderCanvas();
    renderInspector();
  };

  const record = wrapper.querySelector('[data-record-audio]');
  if (record) record.onclick = async () => {
    if (record._recorder && record._recorder.state === 'recording') {
      record._recorder.stop();
      return;
    }
    if (!navigator.mediaDevices || !window.MediaRecorder) {
      status.textContent = 'Gravação de áudio não suportada neste navegador.';
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const candidates = ['audio/webm;codecs=opus', 'audio/ogg;codecs=opus', 'audio/webm'];
      const mimeType = candidates.find(type => MediaRecorder.isTypeSupported(type)) || '';
      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
      const chunks = [];
      record._recorder = recorder;
      recorder.ondataavailable = event => { if (event.data.size) chunks.push(event.data); };
      recorder.onstop = () => {
        stream.getTracks().forEach(track => track.stop());
        record.innerHTML = '<i class="fas fa-microphone mr-1"><\/i>Gravar agora';
        record.className = 'mt-2 w-full px-3 py-2 rounded-lg bg-purple-100 text-purple-700 hover:bg-purple-200 text-sm font-medium';
        const type = recorder.mimeType || 'audio/webm';
        const extension = type.includes('ogg') ? 'ogg' : 'webm';
        uploadMedia(new File(chunks, 'gravacao-' + Date.now() + '.' + extension, { type }));
      };
      recorder.start();
      record.innerHTML = '<i class="fas fa-stop mr-1"><\/i>Parar gravação';
      record.className = 'mt-2 w-full px-3 py-2 rounded-lg bg-red-100 text-red-700 hover:bg-red-200 text-sm font-medium';
      status.textContent = 'Gravando...';
    } catch (error) {
      status.textContent = 'Não foi possível acessar o microfone: ' + error.message;
      status.className = 'text-xs text-red-600 mt-2';
    }
  };
}

function renderMenuSections(node) {
  const wrap = document.getElementById('menu-sections');
  if (!wrap) return;
  wrap.innerHTML = node.data.sections.map((section, sectionIndex) =>
    '<div class="p-2.5 bg-stone-50 rounded-xl border border-stone-200 flex flex-col gap-2">' +
      '<div class="flex items-center gap-1.5">' +
        '<input data-menu-section-title="' + sectionIndex + '" value="' + escapeAttr(section.title||'') + '" placeholder="Nome da seção" class="flex-1 px-2 py-1.5 bg-white border border-stone-200 rounded text-xs font-medium">' +
        '<button data-menu-section-del="' + sectionIndex + '" class="text-gray-300 hover:text-red-500"><i class="fas fa-trash text-xs"><\/i><\/button>' +
      '<\/div>' +
      '<div class="flex flex-col gap-2">' + (section.rows || []).map((row, rowIndex) =>
        '<div class="p-2 bg-white rounded-lg border border-stone-100 flex flex-col gap-1.5">' +
          '<div class="flex items-center gap-1.5">' +
            '<input data-menu-row-title="' + sectionIndex + ':' + rowIndex + '" value="' + escapeAttr(row.title||'') + '" placeholder="Texto da opção" class="flex-1 px-2 py-1.5 bg-stone-50 border border-stone-200 rounded text-xs">' +
            '<button data-menu-row-del="' + sectionIndex + ':' + rowIndex + '" class="text-gray-300 hover:text-red-500"><i class="fas fa-times text-xs"><\/i><\/button>' +
          '<\/div>' +
          '<input data-menu-row-description="' + sectionIndex + ':' + rowIndex + '" value="' + escapeAttr(row.description||'') + '" placeholder="Descrição (opcional)" class="px-2 py-1.5 bg-stone-50 border border-stone-200 rounded text-xs">' +
          '<input data-menu-row-id="' + sectionIndex + ':' + rowIndex + '" value="' + escapeAttr(row.rowId||'') + '" placeholder="ID da resposta, ex: vendas" class="px-2 py-1.5 bg-stone-50 border border-stone-200 rounded text-xs font-mono">' +
        '<\/div>'
      ).join('') + '<\/div>' +
      '<button data-menu-row-add="' + sectionIndex + '" class="text-left text-xs text-purple-600 font-medium hover:underline"><i class="fas fa-plus mr-1"><\/i>Adicionar opção<\/button>' +
    '<\/div>'
  ).join('');

  wrap.querySelectorAll('[data-menu-section-title]').forEach(input => input.oninput = () => {
    node.data.sections[Number(input.dataset.menuSectionTitle)].title = input.value;
  });
  wrap.querySelectorAll('[data-menu-section-del]').forEach(button => button.onclick = () => {
    const sectionIndex = Number(button.dataset.menuSectionDel);
    const handles = new Set((node.data.sections[sectionIndex].rows || []).map(row => 'menu-' + row._handleId));
    state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || !handles.has(edge.sourceHandle));
    node.data.sections.splice(sectionIndex, 1);
    renderCanvas();
    renderInspector();
  });
  wrap.querySelectorAll('[data-menu-row-add]').forEach(button => button.onclick = () => {
    const sectionIndex = Number(button.dataset.menuRowAdd);
    const section = node.data.sections[sectionIndex];
    const number = section.rows.length + 1;
    section.rows.push({ title: 'Opção ' + number, description: '', rowId: 'secao_' + (sectionIndex + 1) + '_opcao_' + number, _handleId: uid('mh') });
    renderCanvas();
    renderInspector();
  });
  wrap.querySelectorAll('[data-menu-row-del]').forEach(button => button.onclick = () => {
    const [sectionIndex, rowIndex] = button.dataset.menuRowDel.split(':').map(Number);
    const handle = 'menu-' + node.data.sections[sectionIndex].rows[rowIndex]._handleId;
    state.flowData.edges = state.flowData.edges.filter(edge => edge.source !== node.id || edge.sourceHandle !== handle);
    node.data.sections[sectionIndex].rows.splice(rowIndex, 1);
    renderCanvas();
    renderInspector();
  });
  wrap.querySelectorAll('[data-menu-row-title], [data-menu-row-description], [data-menu-row-id]').forEach(input => input.oninput = () => {
    const key = input.hasAttribute('data-menu-row-title') ? 'title' : input.hasAttribute('data-menu-row-description') ? 'description' : 'rowId';
    const indexes = input.dataset.menuRowTitle || input.dataset.menuRowDescription || input.dataset.menuRowId;
    const [sectionIndex, rowIndex] = indexes.split(':').map(Number);
    node.data.sections[sectionIndex].rows[rowIndex][key] = input.value;
    if (key === 'title') renderCanvas();
  });

  const addSection = document.getElementById('btn-add-menu-section');
  if (addSection) addSection.onclick = () => {
    const number = node.data.sections.length + 1;
    node.data.sections.push({ title: 'Seção ' + number, rows: [{ title: 'Opção 1', description: '', rowId: 'secao_' + number + '_opcao_1', _handleId: uid('mh') }] });
    renderCanvas();
    renderInspector();
  };
}

function renderSwitchCases(node) {
  const wrap = document.getElementById('switch-cases');
  if (!wrap) return;
  wrap.innerHTML = node.data.cases.map((c, i) =>
    '<div class="flex flex-col gap-1 p-2 bg-stone-50 rounded-lg border border-stone-100">' +
      '<div class="flex items-center gap-1.5">' +
        '<input data-case-label="' + i + '" value="' + escapeAttr(c.label||'') + '" placeholder="Nome da opção" class="flex-1 px-2 py-1.5 bg-white border border-stone-200 rounded text-xs">' +
        '<button data-case-del="' + i + '" class="text-gray-300 hover:text-red-500"><i class="fas fa-times text-xs"><\/i><\/button>' +
      '<\/div>' +
      '<input data-case-cond="' + i + '" value="' + escapeAttr(c.condition||'') + '" placeholder=\'condição, ex: response == "1"\' class="px-2 py-1.5 bg-white border border-stone-200 rounded text-xs">' +
    '<\/div>'
  ).join('');
  wrap.querySelectorAll('[data-case-label]').forEach(inp => inp.oninput = () => { node.data.cases[Number(inp.dataset.caseLabel)].label = inp.value; renderCanvas(); });
  wrap.querySelectorAll('[data-case-cond]').forEach(inp => inp.oninput = () => { node.data.cases[Number(inp.dataset.caseCond)].condition = inp.value; });
  wrap.querySelectorAll('[data-case-del]').forEach(btn => btn.onclick = () => {
    const i = Number(btn.dataset.caseDel);
    const removedHandle = 'case-' + i;
    node.data.cases.splice(i, 1);
    state.flowData.edges = state.flowData.edges.filter(e => !(e.source === node.id && e.sourceHandle === removedHandle));
    state.flowData.edges.forEach(e => {
      if (e.source === node.id && e.sourceHandle && e.sourceHandle.startsWith('case-')) {
        const idx = Number(e.sourceHandle.split('-')[1]);
        if (idx > i) e.sourceHandle = 'case-' + (idx - 1);
      }
    });
    renderCanvas();
    renderInspector();
  });
  const addBtn = document.getElementById('btn-add-case');
  if (addBtn) addBtn.onclick = () => {
    node.data.cases.push({ label: 'Opção ' + (node.data.cases.length + 1), condition: '' });
    renderCanvas();
    renderInspector();
  };
}

function setPath(obj, path, val) {
  const parts = path.split('.');
  let cur = obj;
  for (let i = 0; i < parts.length - 1; i++) {
    cur[parts[i]] = cur[parts[i]] || {};
    cur = cur[parts[i]];
  }
  if (val === undefined) delete cur[parts[parts.length - 1]];
  else cur[parts[parts.length - 1]] = val;
}

// delegate node delete clicks (rendered inside dynamically built cards)
document.addEventListener('click', (e) => {
  const delBtn = e.target.closest('[data-del-node]');
  if (delBtn) { e.stopPropagation(); deleteNode(delBtn.dataset.delNode); }
});

// ---------------------------------------------------------------------
// Utils
// ---------------------------------------------------------------------
function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
function escapeAttr(s) { return escapeHtml(s); }

function resetTemplateForm(template) {
	document.getElementById('template-id').value = template?.id || '';
	document.getElementById('template-revision').value = template?.revision || '';
	document.getElementById('template-name').value = template?.name || '';
	document.getElementById('template-content').value = template?.content || '';
}

function insertFormattedSelection(input, token) {
	const start = input.selectionStart;
	const end = input.selectionEnd;
	const selected = input.value.slice(start, end) || 'texto';
	input.setRangeText(token + selected + token, start, end, 'end');
	input.dispatchEvent(new Event('input', { bubbles: true }));
	input.focus();
}

function renderTemplateVariables() {
	const menu = document.getElementById('template-variables');
	const variables = availableFlowVariables();
	const render = variable => '<button type="button" data-template-variable="' + escapeAttr(variable.name) + '" class="w-full px-3 py-2 text-left hover:bg-purple-50"><span class="block text-xs font-medium text-gray-700">' + escapeHtml(variable.label) + '<\/span><code class="text-[10px] text-purple-600">{' + '{' + escapeHtml(variable.name) + '}' + '}<\/code><\/button>';
	menu.innerHTML = variables.standard.map(render).join('') + variables.custom.map(render).join('');
	menu.querySelectorAll('[data-template-variable]').forEach(button => button.onclick = () => {
	  const input = document.getElementById('template-content');
	  input.setRangeText('{' + '{' + button.dataset.templateVariable + '}' + '}', input.selectionStart, input.selectionEnd, 'end');
	  menu.classList.add('hidden');
	  input.focus();
	});
}

function renderTemplatesList() {
	const list = document.getElementById('templates-list');
	list.innerHTML = state.templates.length ? state.templates.map(template =>
	  '<div class="rounded-xl border border-stone-200 p-3"><div class="flex items-start justify-between gap-2"><button type="button" data-edit-template="' + template.id + '" class="text-left min-w-0 flex-1"><strong class="text-sm text-gray-800">' + escapeHtml(template.name) + '<\/strong><p class="mt-1 text-xs text-gray-500 line-clamp-2">' + escapeHtml(template.content) + '<\/p><\/button><button type="button" data-delete-template="' + template.id + '" class="p-1 text-red-500 hover:text-red-700"><i class="fas fa-trash"><\/i><\/button><\/div><\/div>'
	).join('') : '<p class="text-sm text-gray-400 text-center py-10">Nenhum modelo cadastrado.<\/p>';
	list.querySelectorAll('[data-edit-template]').forEach(button => button.onclick = () => resetTemplateForm(state.templates.find(template => template.id === Number(button.dataset.editTemplate))));
	list.querySelectorAll('[data-delete-template]').forEach(button => button.onclick = async () => {
	  if (!confirm('Excluir este modelo? Fluxos já iniciados manterão o snapshot atual.')) return;
	  try {
		await api('DELETE', '/flows/api/templates/' + button.dataset.deleteTemplate);
		state.templates = await api('GET', '/flows/api/templates');
		resetTemplateForm();
		renderTemplatesList();
	  } catch (error) { alert('Não foi possível excluir o modelo: ' + error.message); }
	});
}

function openTemplatesModal() {
	const modal = document.getElementById('templates-modal');
	modal.classList.remove('hidden');
	modal.classList.add('flex');
	resetTemplateForm();
	renderTemplateVariables();
	renderTemplatesList();
}

function closeTemplatesModal() {
	const modal = document.getElementById('templates-modal');
	modal.classList.add('hidden');
	modal.classList.remove('flex');
}

// ---------------------------------------------------------------------
// Boot
// ---------------------------------------------------------------------
async function boot() {
  document.getElementById('btn-new-flow').onclick = () => openEditor(null);
	document.getElementById('btn-templates').onclick = openTemplatesModal;
	document.getElementById('btn-close-templates').onclick = closeTemplatesModal;
	document.getElementById('btn-new-template').onclick = () => resetTemplateForm();
	document.querySelectorAll('[data-template-format]').forEach(button => button.onclick = () => insertFormattedSelection(document.getElementById('template-content'), button.dataset.templateFormat));
	document.getElementById('btn-template-variables').onclick = () => document.getElementById('template-variables').classList.toggle('hidden');
	document.getElementById('template-form').onsubmit = async event => {
	  event.preventDefault();
	  const id = document.getElementById('template-id').value;
	  const body = { name: document.getElementById('template-name').value, content: document.getElementById('template-content').value };
	  if (id) body.revision = Number(document.getElementById('template-revision').value);
	  try {
		await api(id ? 'PUT' : 'POST', id ? '/flows/api/templates/' + id : '/flows/api/templates', body);
		state.templates = await api('GET', '/flows/api/templates');
		resetTemplateForm();
		renderTemplatesList();
	  } catch (error) { alert('Não foi possível salvar o modelo: ' + error.message); }
	};
  try {
    state.connections = await api('GET', '/flows/api/connections');
  } catch (e) { console.error(e); state.connections = []; }
  try {
    const options = await api('GET', '/flows/api/assignment-options');
    state.agents = options.agents || [];
    state.departments = options.departments || [];
  } catch (e) { console.error(e); state.agents = []; state.departments = []; }
	try { state.templates = await api('GET', '/flows/api/templates'); }
	catch (e) { console.error(e); state.templates = []; }
  try {
    await loadFlowsList();
  } catch (e) {
    document.getElementById('flows-grid').innerHTML = '<p class="text-red-500 text-sm">Erro ao carregar automações: ' + escapeHtml(e.message) + '<\/p>';
  }
}
boot();
window.addEventListener('beforeunload', event => {
	if (!flowIsDirty()) return;
	event.preventDefault();
	event.returnValue = '';
});
</script>
</body>
</html>
}

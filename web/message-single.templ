package web

import "sophus/internal/repo"
import "sophus/web/components"
import "fmt"
import "time"
import "sort"

func messageStartsNewDay(messages []repo.MessageData, index int) bool {
    return index == 0 || components.MessageDateKey(messages[index-1]) != components.MessageDateKey(messages[index])
}

type conversationMessageItem struct {
	Messages []repo.MessageData
	Note *repo.ConversationEvent
	StartsNewDay bool
	StartsConversation bool
}

func conversationTimeline(messages []repo.MessageData, events []repo.ConversationEvent) []conversationMessageItem {
	items := conversationMessageItems(messages)
	for _, event := range events {
		if event.EventType == "note" { note := event; items = append(items, conversationMessageItem{Note: &note}) }
	}
	sort.SliceStable(items, func(i, j int) bool { return conversationItemTime(items[i]).Before(conversationItemTime(items[j])) })
	lastDate := ""
	lastConversation := -1
	for index := range items {
		origin:=timelineConversationID(items[index]);items[index].StartsConversation=origin!=lastConversation;lastConversation=origin
		if items[index].Note != nil { continue }
		date := components.MessageDateKey(items[index].Messages[0])
		items[index].StartsNewDay = date != lastDate
		lastDate = components.MessageDateKey(items[index].Messages[len(items[index].Messages)-1])
	}
	return items
}

func conversationItemTime(item conversationMessageItem) time.Time {
	if item.Note != nil { return item.Note.CreatedAt }
	return item.Messages[0].CreatedAt
}

func messagesTimezone(messages []repo.MessageData) string {
	if len(messages) > 0 { return messages[0].Timezone }
	return "America/Sao_Paulo"
}

func isReceivedGalleryMedia(message repo.MessageData) bool {
	return !message.IsFromMe && message.MediaPath != "" && (message.MediaType == "image" || message.MediaType == "video")
}

func receivedGalleryMatches(previous, current repo.MessageData) bool {
	if previous.ConversationId != current.ConversationId || !isReceivedGalleryMedia(previous) || !isReceivedGalleryMedia(current) || previous.IsGroup != current.IsGroup {
		return false
	}
	if previous.IsGroup && previous.Sender != current.Sender {
		return false
	}
	difference := current.CreatedAt.Sub(previous.CreatedAt)
	return difference >= 0 && difference <= 10*time.Second
}

func conversationMessageItems(messages []repo.MessageData) []conversationMessageItem {
	items := make([]conversationMessageItem, 0, len(messages))
	for _, message := range messages {
		if len(items) > 0 {
			last := &items[len(items)-1]
			previous := last.Messages[len(last.Messages)-1]
			if receivedGalleryMatches(previous, message) {
				last.Messages = append(last.Messages, message)
				continue
			}
		}
		items = append(items, conversationMessageItem{Messages: []repo.MessageData{message}})
	}
	return items
}

func messageItemStartsNewDay(items []conversationMessageItem, index int) bool {
	for previous := index-1; previous >= 0; previous-- {
		if items[previous].Note == nil { return components.MessageDateKey(items[previous].Messages[len(items[previous].Messages)-1]) != components.MessageDateKey(items[index].Messages[0]) }
	}
	return true
}

func messageConversationTab(conversation repo.Conversation) string {
    if conversation.Status == repo.ConversationStatusClosed {
        return "closed"
    }
    if conversation.Status == repo.ConversationStatusRunning {
        return "pending"
    }
    if conversation.AgentID == nil {
        return "pending"
    }
    return "active"
}

func canReplyToConversation(conversation repo.Conversation, agent repo.Agent) bool {
	return agent.IsAdmin() || (conversation.AgentID != nil && *conversation.AgentID == agent.Id)
}

func messageConversationScope(conversation repo.Conversation) string {
    if conversation.Contact.IsGroup {
        return "group"
    }
    return "individual"
}

templ MessageSingle(activeConversation repo.Conversation, agent repo.Agent, conversations []repo.Conversation, messages []repo.MessageData, events []repo.ConversationEvent, counts repo.ConversationScopeCounts, page ...repo.ConversationMessagePage) {
	@messagesDefault(conversations, messageConversationTab(activeConversation), messageConversationScope(activeConversation), counts, activeConversation.URL.String()) {
		@ConversationPanel(activeConversation, agent, messages, events, page...)
	}
}

templ ConversationPanel(activeConversation repo.Conversation, agent repo.Agent, messages []repo.MessageData, events []repo.ConversationEvent, page ...repo.ConversationMessagePage) {
	<div id="conversation-panel" hx-history="false" data-conversation-url={ activeConversation.URL.String() } data-conversation-id={fmt.Sprint(activeConversation.Id)} data-can-edit-messages={fmt.Sprint(activeConversation.CanEditMessages)} data-conversation-tab={ messageConversationTab(activeConversation) } data-conversation-scope={ messageConversationScope(activeConversation) } class="contents">
		@ConversationScope()
		<style>
			.audio-volume-control { appearance: none; -webkit-appearance: none; height: 1.25rem; background: transparent; --audio-progress: 100%; }
			.audio-volume-control::-webkit-slider-runnable-track { height: .35rem; border-radius: 9999px; background: linear-gradient(to right, var(--audio-fill) 0 var(--audio-progress), var(--audio-track) var(--audio-progress) 100%); }
			.audio-volume-control::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: .9rem; height: .9rem; margin-top: -.275rem; border: 2px solid var(--audio-thumb-border); border-radius: 9999px; background: var(--audio-thumb); box-shadow: 0 2px 5px rgba(0,0,0,.25); transition: transform .15s ease; }
			.audio-volume-control:hover::-webkit-slider-thumb { transform: scale(1.12); }
			.audio-volume-control::-moz-range-track { height: .35rem; border-radius: 9999px; background: var(--audio-track); }
			.audio-volume-control::-moz-range-progress { height: .35rem; border-radius: 9999px; background: var(--audio-fill); }
			.audio-volume-control::-moz-range-thumb { width: .8rem; height: .8rem; border: 2px solid var(--audio-thumb-border); border-radius: 9999px; background: var(--audio-thumb); box-shadow: 0 1px 3px rgba(0,0,0,.2); }
			.audio-volume-control:focus-visible { outline: 2px solid #a78bfa; outline-offset: 3px; border-radius: 9999px; }
			.audio-volume-control-light { --audio-track: #ddd6fe; --audio-fill: #7c3aed; --audio-thumb: #7c3aed; --audio-thumb-border: #ffffff; }
			.audio-volume-control-dark { --audio-track: rgba(255,255,255,.28); --audio-fill: #ffffff; --audio-thumb: #ffffff; --audio-thumb-border: rgba(255,255,255,.45); }
			.message-recording-dot { animation: message-recording-pulse 1s infinite; }
			@keyframes message-recording-pulse { 50% { opacity: .25; } }
		</style>
    <div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-2xl bg-stone-50 shadow-sm">
       <!-- Chat Header -->
        <header id="conversation-chat-header" class="relative z-40 flex shrink-0 items-center justify-between gap-2 border-b border-stone-200 bg-white p-3 lg:p-4">
          <div class="flex min-w-0 flex-1 items-center gap-2 sm:gap-3">
			<a href="/messages" hx-get="/messages" hx-target="#conversation-panel" hx-swap="outerHTML" hx-push-url="true" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-purple-700 hover:bg-purple-50 lg:hidden" aria-label="Voltar para conversas"><i class="fas fa-arrow-left"></i></a>
              <img src={ fmt.Sprintf("/management/api/contacts/%d/avatar", activeConversation.Contact.Id) } alt="Foto do contato" class="h-10 w-10 shrink-0 rounded-full object-cover ring-1 ring-stone-200">
              <div class="min-w-0 flex-1">
                 <div class="flex min-w-0 items-baseline gap-1.5"><span class="min-w-0 truncate text-sm font-bold text-gray-900" title={ activeConversation.Contact.Name }>{ activeConversation.Contact.Name }</span>
					if activeConversation.Protocol > 0 {
						<span class="shrink-0 text-[11px] font-normal tabular-nums text-gray-400" title={ fmt.Sprintf("Protocolo desta empresa: #%d", activeConversation.Protocol) } aria-label={ fmt.Sprintf("Protocolo %d", activeConversation.Protocol) }>#{ fmt.Sprint(activeConversation.Protocol) }</span>
					}
				 </div>
                 <div class="mt-0.5 flex min-w-0 items-center gap-1.5"><span class="truncate text-[11px] text-gray-500">{ activeConversation.Contact.Number }</span><span class="shrink-0 text-[10px] font-semibold text-purple-600 lg:hidden">· { historyStatusLabel(activeConversation.Status) }</span></div>
                 if activeConversation.DepartmentName != "" || activeConversation.AgentName != "" {
                    <div class="mt-0.5 truncate text-[10px] text-gray-400 lg:hidden">
                        { activeConversation.DepartmentName }
                        if activeConversation.DepartmentName != "" && activeConversation.AgentName != "" {
                            <span> · </span>
                        }
                        { activeConversation.AgentName }
                    </div>
                 }
              </div>
            </div>
              <button id="conversation-actions-toggle" type="button" aria-label="Abrir ações da conversa" aria-controls="conversation-header-actions" aria-expanded="false" class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-purple-100 bg-purple-50 text-purple-700 transition hover:bg-purple-100 focus:outline-none focus:ring-2 focus:ring-purple-300 lg:hidden"><i class="fas fa-bars" aria-hidden="true"></i></button>
              <div id="conversation-header-actions" role="group" aria-label="Ações da conversa" class="absolute left-3 right-3 top-[calc(100%+0.5rem)] hidden max-h-[60dvh] flex-col items-stretch gap-2 overflow-y-auto rounded-2xl border border-stone-200 bg-white p-3 shadow-2xl lg:static lg:flex lg:max-h-none lg:flex-row lg:flex-wrap lg:items-center lg:justify-end lg:gap-2 lg:overflow-visible lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none">
			  <p class="px-1 pb-1 text-[10px] font-black uppercase tracking-[.15em] text-gray-400 lg:hidden">Ações da conversa</p>
			  if activeConversation.ConnectionID == 0 {
			  <span class="hidden rounded-xl bg-amber-50 px-3 py-2 text-xs font-bold text-amber-700 sm:inline-flex sm:items-center sm:gap-2"><i class="fas fa-box-archive"></i> Histórico sem conexão</span>
			  }
               if activeConversation.AgentID == nil && activeConversation.Status != repo.ConversationStatusRunning {
               <button type="button" hx-post={ fmt.Sprintf("/messages/%s/accept", activeConversation.URL.String()) } hx-swap="none" class="px-2 py-2 bg-green-600 text-white hover:bg-green-700 rounded-xl text-xs font-semibold sm:px-4 sm:text-sm">
                 <i class="fas fa-check mr-1"></i>Aceitar
              </button>
                <button type="button" hx-post={ fmt.Sprintf("/messages/%s/ignore", activeConversation.URL.String()) } hx-swap="none" hx-confirm="Recusar e fechar esta conversa?" class="px-2 py-2 bg-stone-100 text-gray-700 hover:bg-red-50 hover:text-red-700 rounded-xl text-xs font-semibold sm:px-4 sm:text-sm">
                  Recusar
               </button>
				if agent.IsAdmin() {
				<button type="button" onclick="window.openTransferConversationModal()" class="flex items-center gap-2 rounded-xl bg-purple-700 px-2 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-purple-800 sm:px-4 sm:text-sm" title="Transferir conversa"><i class="fas fa-arrow-right-arrow-left"></i><span>Transferir</span></button>
				}
                } else if activeConversation.Status != repo.ConversationStatusClosed && canReplyToConversation(activeConversation, agent) {
				<button type="button" onclick="window.openTransferConversationModal()" class="flex items-center gap-2 rounded-xl bg-purple-700 px-2 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-purple-800 sm:px-4 sm:text-sm" title="Transferir conversa"><i class="fas fa-arrow-right-arrow-left"></i><span>Transferir</span></button>
                <button
                  type="button"
                  onclick="window.openCloseConversationModal()"
                  class="flex items-center gap-2 rounded-xl bg-red-600 px-2 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-red-700 sm:px-4 sm:text-sm"
                  title="Fechar conversa">
                 <i class="fas fa-check-circle"></i>
                  <span>Fechar conversa</span>
              </button>
              } else if activeConversation.Status == repo.ConversationStatusClosed {
                <span class="hidden items-center gap-2 rounded-xl bg-stone-100 px-2 py-2 text-xs font-medium text-gray-500 lg:flex lg:px-3 lg:text-sm">
                 <i class="fas fa-lock"></i>
                 <span>Conversa fechada</span>
              </span>
              }
			  if agent.IsAdmin() {
				@ConversationExportControls(activeConversation.URL.String(), activeConversation.Contact.Id)
			  }
			  <button id="conversation-message-search-button" type="button" class="p-2 hover:bg-stone-200 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-purple-300" title="Buscar mensagens nesta conversa" aria-label="Buscar mensagens nesta conversa" aria-expanded="false" aria-controls="conversation-message-search">
              <i class="fas fa-search text-gray-600"></i>
              <span class="text-sm font-semibold text-gray-700 lg:hidden">Buscar mensagens</span>
              </button>
			  <button type="button" class="p-2 hover:bg-stone-200 rounded-xl transition-colors" aria-label="Detalhes do contato" onclick="document.getElementById('contactPanel').classList.toggle('hidden')">
              <i class="fas fa-ellipsis-v text-gray-600"></i>
			  <span class="text-sm font-semibold text-gray-700 lg:hidden">Detalhes do contato</span>
			  </button>
            </div>
		</header>
		@ConversationHeaderMenuRuntime()
		@ConversationHistorySwitch(activeConversation)
		<div id="conversation-message-search" data-search-url={ fmt.Sprintf("/messages/%s/search", activeConversation.URL.String()) } data-context-url={ fmt.Sprintf("/messages/%s/search-context", activeConversation.URL.String()) } class="hidden border-b border-stone-200 bg-white px-4 py-3" role="search">
			<div class="mx-auto flex max-w-3xl items-center gap-2">
				<label class="relative min-w-0 flex-1"><span class="sr-only">Buscar no histórico desta conversa</span><i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-gray-400"></i><input id="conversation-message-search-input" type="search" autocomplete="off" placeholder="Buscar no histórico desta conversa" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-2.5 pl-9 pr-3 text-sm outline-none transition focus:border-purple-400 focus:bg-white focus:ring-2 focus:ring-purple-100"/></label>
				<button id="conversation-message-search-count" type="button" disabled class="min-w-14 rounded-lg px-2 py-1 text-center text-xs font-semibold text-gray-500 hover:bg-purple-50 disabled:cursor-default" aria-live="polite" aria-label="Visualizar resultado da busca" title="Visualizar resultado">0 de 0</button>
				<button id="conversation-message-search-previous" type="button" disabled class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-gray-500 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-30" aria-label="Resultado anterior"><i class="fas fa-chevron-up text-xs"></i></button>
				<button id="conversation-message-search-next" type="button" disabled class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-gray-500 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-30" aria-label="Próximo resultado"><i class="fas fa-chevron-down text-xs"></i></button>
				<button id="conversation-message-search-close" type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-gray-500 hover:bg-stone-100" aria-label="Fechar busca"><i class="fas fa-xmark"></i></button>
			</div>
		</div>
        <div id="close-conversation-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-950/55 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="close-conversation-title" aria-describedby="close-conversation-description">
            <div class="max-h-[calc(100dvh-2rem)] w-full max-w-md overflow-y-auto rounded-3xl bg-white shadow-2xl ring-1 ring-black/5">
                <div class="flex items-start gap-4 border-b border-stone-100 px-6 py-5">
                    <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-red-50 text-red-600"><i class="fas fa-check-circle text-xl"></i></div>
                    <div class="min-w-0 flex-1">
                        <h2 id="close-conversation-title" class="text-lg font-black text-stone-950">Finalizar conversa?</h2>
                        <p id="close-conversation-description" class="mt-1 text-sm leading-relaxed text-stone-500">A conversa com <strong class="font-bold text-stone-700">{ activeConversation.Contact.Name }</strong> será encerrada.</p>
                    </div>
                    <button id="close-conversation-modal-button" type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-stone-400 hover:bg-stone-100 hover:text-stone-700" aria-label="Fechar confirmação"><i class="fas fa-xmark"></i></button>
                </div>
                <div class="px-6 py-5">
                    <div class="flex gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900"><i class="fas fa-circle-info mt-0.5 text-amber-600"></i><span>O fluxo em andamento será cancelado e novas mensagens poderão abrir uma nova conversa.</span></div>
                    <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                        <button id="cancel-close-conversation" type="button" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-bold text-stone-700 hover:bg-stone-50">Continuar conversa</button>
                        <button id="confirm-close-conversation" type="button" hx-post={ fmt.Sprintf("/messages/%s/close", activeConversation.URL.String()) } hx-swap="none" class="rounded-xl bg-red-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-red-700 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-check mr-2"></i>Finalizar conversa</button>
                    </div>
                </div>
            </div>
        </div>
		<div id="transfer-conversation-modal" data-options-url={ fmt.Sprintf("/messages/%s/transfer/options", activeConversation.URL.String()) } data-transfer-url={ fmt.Sprintf("/messages/%s/transfer", activeConversation.URL.String()) } class="fixed inset-0 z-[60] hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="transfer-conversation-title">
			<div class="w-full max-w-md rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl"><header class="flex items-start gap-4 border-b border-stone-100 px-5 py-4 sm:px-6"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-purple-100 text-purple-700"><i class="fas fa-arrow-right-arrow-left"></i></span><div class="min-w-0 flex-1"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Encaminhamento</p><h2 id="transfer-conversation-title" class="mt-1 text-lg font-black text-gray-950">Transferir conversa</h2><p class="mt-1 text-xs leading-relaxed text-gray-500">Escolha um departamento ou um operador e o departamento em que ele atende.</p></div><button id="transfer-conversation-close" type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-gray-400 hover:bg-stone-100" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header><div class="space-y-4 p-5 sm:p-6"><div id="transfer-conversation-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></div><label class="block text-sm font-bold text-gray-700">Operador <span class="font-normal text-gray-400">opcional</span><select id="transfer-conversation-agent" class="mt-2 w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="">Somente departamento</option></select></label><label class="block text-sm font-bold text-gray-700">Departamento<select id="transfer-conversation-department" class="mt-2 w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="">Selecione o departamento</option></select></label></div><footer class="flex flex-col-reverse gap-3 border-t border-stone-100 bg-stone-50 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><button id="transfer-conversation-cancel" type="button" class="rounded-xl border border-stone-200 px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-white">Cancelar</button><button id="transfer-conversation-submit" type="button" class="rounded-xl bg-purple-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-arrow-right-arrow-left mr-2"></i>Transferir</button></footer></div>
		</div>
        if agent.IsAdmin() && !activeConversation.Contact.IsGroup {
        <div id="conversation-contact-edit-modal" class="fixed inset-0 z-[60] hidden items-end justify-center bg-stone-950/65 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="conversation-contact-edit-title">
            <div class="max-h-[100dvh] w-full max-w-xl overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:max-h-[calc(100dvh-2.5rem)] sm:rounded-3xl">
                <header class="flex items-center justify-between border-b border-stone-200 px-5 py-4 sm:px-6"><div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Cadastro do contato</p><h2 id="conversation-contact-edit-title" class="mt-1 text-xl font-black text-gray-950">Editar contato</h2></div><button id="conversation-contact-edit-close" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header>
				<form id="conversation-contact-edit-form" class="p-5 sm:p-6"><input id="conversation-contact-edit-id" type="hidden" value={ fmt.Sprintf("%d", activeConversation.Contact.Id) }/><div id="conversation-contact-edit-error" class="mb-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold text-gray-700">Nome<input id="conversation-contact-edit-name" required maxlength="160" value={ activeConversation.Contact.Name } class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></label><label class="text-sm font-semibold text-gray-700">Empresa<input id="conversation-contact-edit-company" maxlength="160" value={ activeConversation.Contact.Company } class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100" placeholder="Empresa do contato"/></label><label class="text-sm font-semibold text-gray-700">Email<input id="conversation-contact-edit-email" type="email" maxlength="320" value={ activeConversation.Contact.Email } class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></label><label class="text-sm font-semibold text-gray-700">Telefone<input id="conversation-contact-edit-number" type="tel" required maxlength="24" value={ activeConversation.Contact.Number } class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><span class="mt-1 block text-xs font-normal text-gray-400">Use DDI e DDD.</span></label></div><div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><button id="conversation-contact-edit-cancel" type="button" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-bold text-gray-700 hover:bg-stone-50">Cancelar</button><button id="conversation-contact-edit-save" type="submit" class="rounded-xl bg-purple-700 px-5 py-3 text-sm font-bold text-white hover:bg-purple-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-floppy-disk mr-2"></i>Salvar</button></div></form>
            </div>
        </div>
        }
        <script>
            (function () {
                const document = window.conversationDocument;
                const modal = document.getElementById('close-conversation-modal');
                const trigger = document.querySelector('[onclick="window.openCloseConversationModal()"]');
                const closeButton = document.getElementById('close-conversation-modal-button');
                const cancelButton = document.getElementById('cancel-close-conversation');
                const confirmButton = document.getElementById('confirm-close-conversation');
                if (!modal || !confirmButton) return;
                let previousFocus;
                function close() {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                    if (previousFocus) previousFocus.focus();
                }
                window.openCloseConversationModal = function () {
                    previousFocus = document.activeElement;
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    document.body.classList.add('overflow-hidden');
                    confirmButton.focus();
                };
                closeButton.addEventListener('click', close);
                cancelButton.addEventListener('click', close);
                modal.addEventListener('click', event => { if (event.target === modal) close(); });
                document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('flex')) close(); });
                document.body.addEventListener('htmx:beforeRequest', event => {
                    if (event.detail.elt === confirmButton) confirmButton.disabled = true;
                });
                document.body.addEventListener('htmx:afterRequest', event => {
                    if (event.detail.elt === confirmButton && event.detail.successful) close();
                    if (event.detail.elt === confirmButton && !event.detail.successful) confirmButton.disabled = false;
                });
            })();
        </script>
		<script>
			(function () {
				const document = window.conversationDocument;
				const modal = document.getElementById('transfer-conversation-modal');
				const agentSelect = document.getElementById('transfer-conversation-agent');
				const departmentSelect = document.getElementById('transfer-conversation-department');
				const errorBox = document.getElementById('transfer-conversation-error');
				const submit = document.getElementById('transfer-conversation-submit');
				for (const select of [agentSelect, departmentSelect]) select.closest('label').setAttribute('for', select.id);
				let options = { agents: [], departments: [] }; let previousFocus;
				function close() { modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); if (previousFocus && previousFocus.isConnected) previousFocus.focus(); }
				function renderDepartments() { const selectedAgent = options.agents.find(item => String(item.id) === agentSelect.value); const allowed = selectedAgent ? new Set(selectedAgent.departmentIds || []) : null; const previous = departmentSelect.value; departmentSelect.replaceChildren(new Option('Selecione o departamento', '')); options.departments.filter(item => !allowed || allowed.has(item.id)).forEach(item => departmentSelect.add(new Option(item.name, item.id))); if (Array.from(departmentSelect.options).some(item => item.value === previous)) departmentSelect.value = previous; if (departmentSelect._refreshAdminSelect) departmentSelect._refreshAdminSelect(); }
				window.openTransferConversationModal = async function () { previousFocus = document.activeElement; errorBox.classList.add('hidden'); submit.disabled = true; modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); try { const response = await fetch(modal.dataset.optionsUrl, { credentials: 'same-origin', headers: { Accept: 'application/json' } }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Não foi possível carregar os destinos.'); options = payload.data || options; agentSelect.replaceChildren(new Option('Somente departamento', '')); (options.agents || []).forEach(item => agentSelect.add(new Option(item.name, item.id))); agentSelect.value = ''; renderDepartments(); if (window.refreshAdminSelects) window.refreshAdminSelects(modal); submit.disabled = false; (agentSelect._adminTrigger || agentSelect).focus(); } catch (error) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); } };
			agentSelect.addEventListener('change', renderDepartments);
			document.getElementById('transfer-conversation-close').addEventListener('click', close); document.getElementById('transfer-conversation-cancel').addEventListener('click', close); modal.addEventListener('click', event => { if (event.target === modal) close(); }); document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('flex')) close(); });
			submit.addEventListener('click', async function () { const departmentID = Number(departmentSelect.value); if (!departmentID) { errorBox.textContent = 'Selecione o departamento de destino.'; errorBox.classList.remove('hidden'); return; } const agentID = agentSelect.value ? Number(agentSelect.value) : null; submit.disabled = true; errorBox.classList.add('hidden'); try { const response = await fetch(modal.dataset.transferUrl, { method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify({ agentId: agentID, departmentId: departmentID }) }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Não foi possível transferir a conversa.'); window.location.assign('/messages?tab=pending'); } catch (error) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); submit.disabled = false; } });
			})();
		</script>
		@ConversationSearchDialog()
		<script>
			(function () {
				const document = window.conversationDocument;
				const trigger = document.getElementById('conversation-message-search-button');
				const panel = document.getElementById('conversation-message-search');
				const input = document.getElementById('conversation-message-search-input');
				const count = document.getElementById('conversation-message-search-count');
				const previous = document.getElementById('conversation-message-search-previous');
				const next = document.getElementById('conversation-message-search-next');
				const closeButton = document.getElementById('conversation-message-search-close');
				const modal = document.getElementById('conversation-search-preview');
				const content = document.getElementById('conversation-search-preview-content');
				const status = document.getElementById('conversation-search-preview-status');
				const loadButton = document.getElementById('conversation-search-preview-load');
				const modalPrevious = document.getElementById('conversation-search-preview-previous');
				const modalNext = document.getElementById('conversation-search-preview-next');
				const modalCount = document.getElementById('conversation-search-preview-count');
				document.body.appendChild(modal);
				let results = [];
				let current = -1;
				let total = 0, timer = null, generation = 0, request = null;
				let previewRequest = null, previewVersion = 0, loadingHistory = false;
				function pausePreview() { content.querySelectorAll('audio, video').forEach(media => media.pause()); }
				function closePreview() {
					++previewVersion; if (previewRequest) previewRequest.abort(); pausePreview(); loadingHistory = false;
					if (modal.open) modal.close(); document.body.classList.remove('overflow-hidden');
					updateNavigation();
				}
				window.conversationAbort.signal.addEventListener('abort', () => { clearTimeout(timer); if (request) request.abort(); closePreview(); modal.remove(); }, { once: true });
				function updateNavigation() {
					count.textContent = results.length ? (current + 1) + ' de ' + total : '0 de 0'; count.disabled = !results.length;
					modalCount.textContent = count.textContent;
					previous.disabled = modalPrevious.disabled = loadingHistory || current <= 0;
					next.disabled = modalNext.disabled = loadingHistory || current < 0 || current + 1 >= total;
				}
				async function openPreview(match, expected) {
					if (previewRequest) previewRequest.abort(); previewRequest = new AbortController();
					const version = ++previewVersion;
					pausePreview(); content.textContent = 'Carregando contexto da mensagem…'; status.textContent = ''; loadButton.disabled = true;
					if (!modal.open) modal.showModal(); document.body.classList.add('overflow-hidden');
					try {
						const params = new URLSearchParams({ id: String(match.id), history: panel.dataset.historyScope || 'current' });
						const response = await fetch(panel.dataset.contextUrl + '?' + params, { credentials: 'same-origin', headers: { Accept: 'application/json' }, signal: previewRequest.signal });
						const payload = await response.json(); if (!response.ok) throw new Error(payload.error || 'Não foi possível carregar o contexto.');
						if (generation !== expected || previewVersion !== version || !modal.open) return;
						content.innerHTML = payload.html;
						const selected = content.querySelector('[data-search-context-selected]');
						if (!selected) throw new Error('A mensagem encontrada não está mais disponível.');
						status.textContent = 'Prévia do histórico. Carregue a conversa até este ponto para continuar lendo.'; loadButton.disabled = false;
						requestAnimationFrame(() => { if (version === previewVersion && modal.open) selected.scrollIntoView({ block: 'center' }); });
					} catch (error) {
						if (error.name === 'AbortError' || version !== previewVersion || generation !== expected) return;
						content.textContent = 'Não foi possível exibir esta mensagem.'; status.textContent = error.message;
						const retry = document.createElement('button'); retry.type = 'button'; retry.className = 'mt-3 block rounded-lg bg-white px-3 py-2 text-xs font-bold text-purple-700'; retry.textContent = 'Tentar novamente'; retry.addEventListener('click', () => showCurrent(true)); content.appendChild(retry);
					}
				}
				function clearHighlights() {
					document.querySelectorAll('#chatMessages [data-message-id]').forEach(message => message.classList.remove('rounded-2xl', 'ring-2', 'ring-amber-400', 'ring-offset-2'));
				}
				async function showCurrent(scroll) {
					clearHighlights();
					if (!results.length) { current = -1; updateNavigation(); closePreview(); return; }
					if (current < 0 || current >= results.length) current = 0;
					updateNavigation();
					const message = document.querySelector('#chatMessages [data-message-id="' + CSS.escape(results[current].messageId) + '"]');
					if (message) message.classList.add('rounded-2xl', 'ring-2', 'ring-amber-400', 'ring-offset-2');
					if (scroll) await openPreview(results[current], generation);
				}
				async function fetchMatches(offset, expected) {
					if (request) request.abort(); request = new AbortController();
					const params = new URLSearchParams({ q: input.value.trim(), offset: String(offset), history: panel.dataset.historyScope || 'current' });
					const response = await fetch(panel.dataset.searchUrl + '?' + params, { credentials: 'same-origin', headers: { Accept: 'application/json' }, signal: request.signal });
					const payload = await response.json(); if (!response.ok) throw new Error(payload.error || 'Não foi possível pesquisar.');
					if (generation !== expected) return false;
					total = Number(payload.total || 0); results = offset ? results.concat(payload.matches || []) : (payload.matches || []);
					return true;
				}
				function search(scroll) {
					clearTimeout(timer); const expected = ++generation; if (request) request.abort();
					if (!input.value.trim()) { results = []; total = 0; current = -1; showCurrent(false); return; }
					count.textContent = 'Buscando...'; count.disabled = true; previous.disabled = true; next.disabled = true;
					timer = setTimeout(async () => { try { if (await fetchMatches(0, expected)) { current = results.length ? 0 : -1; await showCurrent(scroll); } } catch (error) { if (error.name !== 'AbortError' && generation === expected) count.textContent = 'Falha na busca'; } }, 250);
				}
				function open() { panel.classList.remove('hidden'); trigger.setAttribute('aria-expanded', 'true'); setTimeout(() => input.focus(), 30); if (input.value) search(false); }
				function close() { ++generation; clearTimeout(timer); if (request) request.abort(); closePreview(); panel.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); input.value = ''; results = []; total = 0; current = -1; clearHighlights(); updateNavigation(); trigger.focus(); }
				async function move(step) { if (!results.length || loadingHistory) return; const target = current + step; if (target < 0 || target >= total) return; const expected = generation; try { if (target >= results.length && !await fetchMatches(results.length, expected)) return; if (generation !== expected) return; current = target; await showCurrent(true); } catch (error) { if (error.name !== 'AbortError' && generation === expected) { if (modal.open) status.textContent = 'Não foi possível carregar o resultado. Tente novamente.'; else count.textContent = 'Falha na busca'; } } }
				trigger.addEventListener('click', () => panel.classList.contains('hidden') ? open() : close());
				closeButton.addEventListener('click', close);
				input.addEventListener('input', () => search(true));
				input.addEventListener('keydown', event => { if (event.key === 'Enter') { event.preventDefault(); move(event.shiftKey ? -1 : 1); } else if (event.key === 'Escape') { event.preventDefault(); close(); } });
				previous.addEventListener('click', () => move(-1)); next.addEventListener('click', () => move(1));
				count.addEventListener('click', () => showCurrent(true)); modalPrevious.addEventListener('click', () => move(-1)); modalNext.addEventListener('click', () => move(1));
				document.getElementById('conversation-search-preview-close').addEventListener('click', closePreview);
				modal.addEventListener('cancel', event => { event.preventDefault(); closePreview(); });
				modal.addEventListener('click', event => { if (event.target === modal) { const bounds = modal.getBoundingClientRect(); if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) closePreview(); } });
				loadButton.addEventListener('click', async () => {
					if (loadingHistory || !results[current]) return;
					const match = results[current], expected = generation, version = previewVersion;
					const valid = () => modal.open && expected === generation && version === previewVersion && !window.conversationAbort.signal.aborted;
					loadingHistory = true; loadButton.disabled = true; updateNavigation(); status.textContent = 'Carregando conversa até a mensagem… Feche a prévia para interromper.';
					try {
						let message = document.querySelector('#chatMessages [data-message-id="' + CSS.escape(match.messageId) + '"]');
						if (!message && window.ensureConversationMessage) message = await window.ensureConversationMessage(match.messageId, valid, pages => { if (valid()) status.textContent = 'Carregando conversa… ' + pages + ' bloco(s) carregado(s). Feche a prévia para interromper.'; });
						if (!valid()) return;
						if (!message || !message.isConnected) throw new Error('Não foi possível localizar a mensagem no histórico. Tente novamente.');
						closePreview(); clearHighlights(); message.classList.add('rounded-2xl', 'ring-2', 'ring-amber-400', 'ring-offset-2'); message.scrollIntoView({ behavior: 'smooth', block: 'center' }); updateNavigation();
					} catch (error) { if (valid() && error.name !== 'AbortError') status.textContent = error.message; }
					finally { if (version === previewVersion) { loadingHistory = false; loadButton.disabled = false; updateNavigation(); } }
				});
				document.body.addEventListener('htmx:sseMessage', () => { if (!modal.open && !panel.classList.contains('hidden') && input.value) setTimeout(() => search(false), 0); });
				document.addEventListener('conversation:history-scope', () => { ++generation; clearTimeout(timer); if(request)request.abort(); closePreview(); clearHighlights(); results=[];total=0;current=-1;updateNavigation(); if(input.value.trim())search(false); });
				document.body.addEventListener('htmx:responseError', event => { if(event.detail.target?.id==='chatMessages')document.getElementById('conversation-history-scope-error')?.classList.remove('hidden'); });
			})();
		</script>
        <!-- Messages Area -->
        <div hx-ext="sse" sse-connect={ fmt.Sprintf("/sse?conversation=%s", activeConversation.URL.String()) } sse-swap="message,internal-note,message-status,message-update" hx-swap="beforeend" hx-target="#chatMessages" data-read-url={ fmt.Sprintf("/messages/%s/read", activeConversation.URL.String()) } class="min-h-0 flex-1 space-y-6 overflow-y-auto p-3 sm:p-6" style="background: linear-gradient(to bottom, #f5f5f4, #e7e5e4);" id="chatMessages">
			@ConversationTimelineContent(activeConversation, agent, messages, events, historyPageOrDefault(page))
       </div>
		@ConversationNoteComposer(activeConversation.URL.String())
		<script>
			(function(){
				const chat=document.getElementById('chatMessages'),signal=window.conversationAbort.signal;
				chat.addEventListener('click',async event=>{
					const button=event.target.closest('[data-media-retry]');if(!button||button.disabled)return;
					const message=button.closest('[data-message-id]'),error=button.parentElement.querySelector('[data-media-retry-error]');button.disabled=true;button.textContent='Carregando…';error.classList.add('hidden');
					try{
						const response=await fetch(button.dataset.retryUrl,{method:'POST',credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({id:button.dataset.messageDbId}),signal});
						const payload=await response.json();if(!response.ok)throw new Error(payload.error||'Não foi possível recuperar esta mídia.');if(signal.aborted)return;
						const template=document.createElement('template');template.innerHTML=payload.html;const replacement=template.content.firstElementChild;
						if(!replacement)throw new Error('Não foi possível exibir o arquivo.');if(message.isConnected){message.replaceWith(replacement);if(window.htmx)htmx.process(replacement);if(window.initAudioPlayer)replacement.querySelectorAll('[data-audio-player]').forEach(window.initAudioPlayer);}
					}catch(failure){if(failure.name!=='AbortError'){error.textContent=failure.message;error.classList.remove('hidden');}}
					finally{button.disabled=false;button.textContent='Tentar carregar';}
				},{signal});
			})();
		</script>
       <!-- Input Area -->
       if canReplyToConversation(activeConversation, agent) && activeConversation.AgentID != nil && activeConversation.Status != repo.ConversationStatusClosed && activeConversation.Status != repo.ConversationStatusRunning {
        <div id="message-composer-area" data-composer-layout="desktop" class="relative z-30 shrink-0 border-t border-stone-200 bg-stone-50 p-2 sm:p-4">
			 <div id="message-reply-preview" class="mb-3 hidden items-center gap-3 rounded-2xl border border-purple-200 bg-white px-4 py-3 shadow-sm">
				<div class="w-1 self-stretch rounded-full bg-purple-500"></div>
				<div class="min-w-0 flex-1"><div class="text-xs font-bold text-purple-700">Respondendo</div><div id="message-reply-text" class="truncate text-sm text-gray-500"></div></div>
				<button id="message-reply-cancel" type="button" class="grid h-8 w-8 place-items-center rounded-full text-gray-400 hover:bg-stone-100" aria-label="Cancelar resposta"><i class="fas fa-xmark"></i></button>
			 </div>
			 <div id="message-media-error" class="mb-3 hidden flex-wrap items-center gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"><span id="message-media-error-text" class="flex-1"></span><button id="message-microphone-retry" type="button" class="hidden shrink-0 rounded-lg border border-red-300 px-3 py-1.5 text-xs font-bold hover:bg-red-100">Tentar microfone novamente</button></div>
			 <div id="message-recording" class="mb-3 hidden items-center gap-3 rounded-2xl border border-red-200 bg-white p-3 shadow-sm" aria-live="polite">
				 <span class="message-recording-dot h-2.5 w-2.5 shrink-0 rounded-full bg-red-600"></span>
				 <span class="min-w-0 flex-1 text-sm font-semibold text-gray-700">Gravando áudio <span id="message-recording-time">00:00</span></span>
				 <button id="message-recording-cancel" type="button" class="rounded-lg px-3 py-2 text-xs font-bold text-gray-600 hover:bg-stone-100">Cancelar</button>
				 <button id="message-recording-stop" type="button" class="rounded-lg bg-red-600 px-3 py-2 text-xs font-bold text-white hover:bg-red-700">Parar</button>
			 </div>
			 <div id="message-recording-preview" class="mb-3 hidden flex-wrap items-center gap-3 rounded-2xl border border-purple-200 bg-white p-3 shadow-sm">
				 <audio id="message-recording-audio" controls class="min-w-0 flex-1"></audio>
				 <button id="message-recording-discard" type="button" class="rounded-lg px-3 py-2 text-xs font-bold text-gray-600 hover:bg-stone-100">Descartar</button>
				 <button id="message-recording-send" type="button" class="rounded-lg bg-purple-600 px-3 py-2 text-xs font-bold text-white hover:bg-purple-700 disabled:opacity-50">Enviar áudio</button>
			 </div>
               <div id="message-composer-layout" class="flex w-full min-w-0 items-center gap-1 sm:gap-3">
               <details id="message-attachment-details" class="group/attachment relative">
                   <summary id="message-attachment-button" class="list-none cursor-pointer rounded-xl p-2 transition-colors hover:bg-stone-200" aria-label="Anexar mídia" aria-controls="message-attachment-menu" aria-expanded="false"><i class="fas fa-paperclip text-gray-400 text-xl"></i></summary>
                   <div id="message-attachment-menu" class="absolute bottom-full left-0 z-50 mb-3 max-h-[min(60dvh,24rem)] w-[min(22rem,calc(100vw-2.5rem))] overflow-y-auto rounded-2xl border border-stone-200 bg-white p-3 shadow-2xl">
					   <header class="mb-3 flex items-center justify-between gap-2"><span class="text-sm font-bold text-gray-800">Adicionar à mensagem</span><button id="message-actions-close" type="button" aria-label="Fechar ações da mensagem" class="grid h-9 w-9 place-items-center rounded-lg text-gray-400 hover:bg-stone-100"><i class="fas fa-xmark"></i></button></header>
					   <div id="message-actions-grid" class="grid grid-cols-2 gap-2">
                        <button id="message-upload-option" type="button" aria-label="Enviar do dispositivo" class="flex w-full items-center gap-3 rounded-xl p-3 text-left hover:bg-stone-50"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-purple-100 text-purple-700"><i class="fas fa-arrow-up-from-bracket"></i></span><span><span class="block text-sm font-bold text-gray-800">Arquivo</span><span class="mt-0.5 block text-[11px] text-gray-500">Do dispositivo</span></span></button>
                        <button id="message-gallery-option" type="button" aria-label="Escolher da galeria" class="flex w-full items-center gap-3 rounded-xl bg-purple-50 p-3 text-left hover:bg-purple-100"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-purple-200 text-purple-700"><i class="fas fa-photo-film"></i></span><span><span class="block text-sm font-bold text-purple-900">Galeria</span><span class="mt-0.5 block text-[11px] text-purple-700">Mídias da empresa</span></span></button>
						<div id="message-mobile-actions" class="contents"></div>
					   </div>
                   </div>
                   <input id="message-media-file" type="file" class="hidden" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,audio/webm,audio/ogg,audio/mpeg,audio/mp4,audio/wav,.pdf,.txt,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip"/>
                </details>
			 <form id="message-composer" class="flex min-w-0 flex-1 items-center gap-1 sm:gap-3" hx-post="/api/message/send" hx-trigger="submit" hx-swap="beforeend" hx-target="#chatMessages" hx-on::before-request="this.dataset.sentWithQuote = String(Boolean(this.querySelector('[name=quotedId]').value)); this.reset(); window.clearMessageReply(); this.querySelector('[name=message]').focus();" hx-on::after-request="if (event.detail.successful) window.refreshConversationSidebar && window.refreshConversationSidebar();">
				 <input type="hidden" name="conversation" value={ activeConversation.URL.String() }/>
				 <input type="hidden" name="quotedId" value=""/>
                 <textarea rows="1" required placeholder="Mensagem ou / para atalhos" aria-label="Mensagem" name="message" class="min-w-0 flex-1 max-h-36 resize-none px-3 py-3 bg-white border border-stone-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-400 transition-all sm:px-4"></textarea>
				 <div id="message-composer-shortcuts" class="flex shrink-0 items-center gap-1 sm:gap-3">
                  <button id="conversation-note-button" type="button" title="Nota interna" aria-label="Adicionar nota interna" aria-expanded="false" aria-controls="conversation-note-form" class="shrink-0 rounded-xl p-2 text-amber-600 transition-colors hover:bg-amber-100"><i class="fas fa-note-sticky text-xl"></i><span class="message-action-label">Nota interna</span></button>
                 <button id="message-emoji-button" type="button" class="shrink-0 rounded-xl p-2 transition-colors hover:bg-stone-200" aria-label="Escolher emoji" aria-expanded="false" aria-controls="message-emoji-tray">
                     <i class="far fa-smile text-gray-400 text-xl"></i>
                     <span class="message-action-label">Emojis</span>
               </button>
                 <button id="message-record-button" type="button" class="shrink-0 rounded-xl p-2 transition-colors hover:bg-stone-200" aria-label="Gravar áudio">
                     <i class="fas fa-microphone text-gray-400 text-xl"></i>
                     <span class="message-action-label">Áudio</span>
                </button>
				 </div>
                <button id="message-send-button" type="submit" aria-label="Enviar mensagem" class="shrink-0 p-3 rounded-full hover:shadow-md shadow-sm transition-all" style="background: linear-gradient(to right, #3b82f6, #9333ea);">
                   <i class="fas fa-paper-plane text-white"></i>
               </button>
              </form>
			 </div>
				 <div id="message-emoji-tray" class="absolute bottom-full right-2 z-50 mb-2 hidden w-[min(22rem,calc(100vw-1rem))] rounded-2xl border border-stone-200 bg-white p-3 shadow-xl sm:right-4" aria-label="Emojis">
				 <div class="mb-2 flex items-center justify-between"><span class="text-xs font-bold text-gray-700">Escolha um emoji</span><button id="message-emoji-close" type="button" class="rounded-lg p-1 text-gray-500 hover:bg-stone-100" aria-label="Fechar emojis"><i class="fas fa-xmark"></i></button></div>
				 <div id="message-emoji-list" class="grid max-h-48 grid-cols-8 gap-1 overflow-y-auto"></div>
				 </div>
				 @QuickReplyTray()
		 </div>
		 @MessageComposerLayoutRuntime()
		<div id="message-upload-modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-stone-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="message-upload-title">
			<div class="max-h-[calc(100dvh-2rem)] w-full max-w-lg overflow-y-auto rounded-3xl bg-white shadow-2xl">
				<header class="flex items-start gap-4 border-b border-stone-100 px-6 py-5"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-purple-100 text-purple-700"><i class="fas fa-paperclip text-lg"></i></span><div class="min-w-0 flex-1"><h2 id="message-upload-title" class="text-lg font-black text-gray-950">Enviar arquivo</h2><p id="message-upload-meta" class="mt-1 truncate text-xs text-gray-500"></p></div><button id="message-upload-close" type="button" class="grid h-9 w-9 place-items-center rounded-xl text-gray-400 hover:bg-stone-100" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header>
				<div class="p-6"><div id="message-upload-preview" class="flex min-h-48 items-center justify-center overflow-hidden rounded-2xl bg-stone-100"></div><label class="mt-5 block text-sm font-bold text-gray-700">Legenda opcional<textarea id="message-upload-caption" maxlength="1000" rows="3" placeholder="Adicione uma legenda" class="mt-2 w-full resize-none rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm font-normal outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></textarea></label><div id="message-upload-error" class="mt-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div></div>
				<footer class="flex justify-end gap-3 border-t border-stone-100 bg-stone-50 px-6 py-4"><button id="message-upload-cancel" type="button" class="rounded-xl px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-stone-200">Cancelar</button><button id="message-upload-send" type="button" class="rounded-xl bg-gradient-to-r from-blue-500 to-purple-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:shadow-md disabled:cursor-wait disabled:opacity-60"><i class="fas fa-paper-plane mr-2"></i>Enviar mídia</button></footer>
			</div>
		</div>
		<div id="message-gallery-modal" data-list-url={ fmt.Sprintf("/messages/%s/media", activeConversation.URL.String()) } data-send-url={ fmt.Sprintf("/messages/%s/media/send", activeConversation.URL.String()) } data-upload-url={ fmt.Sprintf("/messages/%s/media/upload", activeConversation.URL.String()) } class="fixed inset-0 z-[70] hidden items-center justify-center bg-stone-950/65 p-3 backdrop-blur-sm sm:p-5" role="dialog" aria-modal="true" aria-labelledby="message-gallery-title">
			<div class="flex max-h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl">
				<header class="flex items-start gap-4 border-b border-stone-100 px-5 py-4 sm:px-6 sm:py-5"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-purple-100 text-purple-700"><i class="fas fa-photo-film text-lg"></i></span><div class="min-w-0 flex-1"><h2 id="message-gallery-title" class="text-lg font-black text-gray-950">Galeria de mídias</h2><p class="mt-1 text-xs text-gray-500">Selecione um arquivo já armazenado pela empresa.</p></div><button id="message-gallery-close" type="button" class="grid h-9 w-9 place-items-center rounded-xl text-gray-400 hover:bg-stone-100" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header>
				<div class="border-b border-stone-100 px-5 py-4 sm:px-6"><div class="flex flex-col gap-3 sm:flex-row"><label class="relative min-w-0 flex-1"><i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-gray-400"></i><input id="message-gallery-search" type="search" placeholder="Buscar na galeria" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-2.5 pl-9 pr-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></label><div id="message-gallery-filters" class="flex gap-2 overflow-x-auto"><button type="button" data-gallery-kind="all" class="rounded-xl bg-purple-600 px-3 py-2 text-xs font-bold text-white">Todos</button><button type="button" data-gallery-kind="image" class="rounded-xl bg-stone-100 px-3 py-2 text-xs font-bold text-gray-600">Imagens</button><button type="button" data-gallery-kind="video" class="rounded-xl bg-stone-100 px-3 py-2 text-xs font-bold text-gray-600">Vídeos</button><button type="button" data-gallery-kind="audio" class="rounded-xl bg-stone-100 px-3 py-2 text-xs font-bold text-gray-600">Áudios</button><button type="button" data-gallery-kind="document" class="rounded-xl bg-stone-100 px-3 py-2 text-xs font-bold text-gray-600">Documentos</button></div></div></div>
				<div class="min-h-0 flex-1 overflow-y-auto p-5 sm:p-6"><div id="message-gallery-loading" class="py-16 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i>Carregando galeria...</div><div id="message-gallery-grid" class="hidden grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"></div><div id="message-gallery-empty" class="hidden py-16 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-stone-100 text-gray-400"><i class="fas fa-photo-film"></i></span><p class="mt-4 text-sm font-bold text-gray-700">Nenhuma mídia encontrada</p></div><div id="message-gallery-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div></div>
				<footer class="border-t border-stone-100 bg-stone-50 px-5 py-4 sm:px-6"><div class="flex flex-col gap-3 sm:flex-row sm:items-end"><div class="min-w-0 flex-1"><p id="message-gallery-selection" class="mb-2 truncate text-xs font-bold text-gray-600">Nenhuma mídia selecionada</p><input id="message-gallery-caption" maxlength="1000" placeholder="Legenda opcional" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div><div class="flex justify-end gap-2"><button id="message-gallery-cancel" type="button" class="rounded-xl px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-stone-200">Cancelar</button><button id="message-gallery-send" type="button" disabled class="rounded-xl bg-gradient-to-r from-blue-500 to-purple-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm disabled:cursor-not-allowed disabled:opacity-40"><i class="fas fa-paper-plane mr-2"></i>Enviar</button></div></div></footer>
			</div>
		</div>
		<div id="conversation-media-preview" class="fixed inset-0 z-[80] hidden items-center justify-center bg-stone-950/90 p-3 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Visualização da mídia"><div class="flex h-full max-h-[920px] w-full max-w-6xl flex-col overflow-hidden rounded-2xl border border-white/10 bg-stone-950 text-white shadow-2xl"><header class="flex items-center gap-3 border-b border-white/10 px-4 py-3"><div class="min-w-0 flex-1"><p id="conversation-media-preview-name" class="truncate text-sm font-bold"></p><p id="conversation-media-preview-meta" class="mt-0.5 text-xs text-stone-400"></p></div><a id="conversation-media-preview-download" class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 hover:bg-white/20" aria-label="Baixar mídia"><i class="fas fa-download"></i></a><button id="conversation-media-preview-close" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 hover:bg-white/20" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header><div id="conversation-media-preview-stage" class="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-black/40 p-3 sm:p-8"><button id="conversation-media-preview-previous" type="button" class="absolute left-3 z-10 grid h-11 w-11 place-items-center rounded-full bg-black/50 hover:bg-black/70" aria-label="Mídia anterior"><i class="fas fa-chevron-left"></i></button><div id="conversation-media-preview-content" class="flex h-full w-full items-center justify-center"></div><button id="conversation-media-preview-next" type="button" class="absolute right-3 z-10 grid h-11 w-11 place-items-center rounded-full bg-black/50 hover:bg-black/70" aria-label="Próxima mídia"><i class="fas fa-chevron-right"></i></button></div><footer class="flex items-center justify-between border-t border-white/10 px-4 py-3 text-xs text-stone-400"><span>Mídia da conversa</span><span id="conversation-media-preview-counter"></span></footer></div></div>
		<script>
			(function () {
				const document = window.conversationDocument;
				const composer = document.getElementById('message-composer');
				const preview = document.getElementById('message-reply-preview');
				const previewText = document.getElementById('message-reply-text');
				if (!composer || !preview || !previewText) return;
				const quotedInput = composer.querySelector('[name=quotedId]');
				window.clearMessageReply = function () { quotedInput.value = ''; previewText.textContent = ''; preview.classList.add('hidden'); preview.classList.remove('flex'); window.syncMessageComposerLayout?.(); };
				document.getElementById('message-reply-cancel').addEventListener('click', window.clearMessageReply);
				document.getElementById('chatMessages').addEventListener('click', async function (event) {
					const quotedMessage = event.target.closest('[data-quoted-message-id]');
					if (quotedMessage) { const id = quotedMessage.dataset.quotedMessageId; let target = document.querySelector('#chatMessages [data-message-id="' + CSS.escape(id) + '"]'); if (!target && window.ensureConversationMessage) target = await window.ensureConversationMessage(id); if (target && target.isConnected) { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); target.classList.add('rounded-2xl', 'ring-2', 'ring-purple-400', 'ring-offset-2'); setTimeout(() => target.classList.remove('rounded-2xl', 'ring-2', 'ring-purple-400', 'ring-offset-2'), 1800); } return; }
					const button = event.target.closest('[data-reply-message-id]');
					if (!button) return;
					quotedInput.value = button.dataset.replyMessageId;
					previewText.textContent = button.dataset.replyText || 'Mensagem';
					preview.classList.remove('hidden'); preview.classList.add('flex');
					window.syncMessageComposerLayout?.();
					composer.querySelector('[name=message]').focus();
				});
			})();
		</script>
		<script>
			(function () {
				const document = window.conversationDocument;
				const button = document.getElementById('message-emoji-button');
				if (!button) return;
				const tray = document.getElementById('message-emoji-tray');
				const input = document.querySelector('#message-composer [name=message]');
				const list = document.getElementById('message-emoji-list');
				const emojis = '😀 😃 😄 😁 😆 😅 😂 🙂 🙃 😉 😊 😍 🥰 😘 😎 🤔 😢 😭 😡 👍 👎 👏 🙌 👋 🤝 🙏 💪 ❤️ 💜 💙 💚 💛 🧡 🔥 ✨ 🎉 🎂 🎁 ✅ ❌ 👀 💬 📞 🌹'.split(' ');
				function close() { tray.classList.add('hidden'); button.setAttribute('aria-expanded', 'false'); }
				emojis.forEach(emoji => { const option = document.createElement('button'); option.type = 'button'; option.className = 'rounded-lg p-1 text-2xl hover:bg-purple-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-purple-500'; option.textContent = emoji; option.setAttribute('aria-label', 'Inserir ' + emoji); option.addEventListener('click', () => { const start = input.selectionStart ?? input.value.length; const end = input.selectionEnd ?? start; input.setRangeText(emoji, start, end, 'end'); input.dispatchEvent(new Event('input', { bubbles: true })); close(); input.focus(); }); list.appendChild(option); });
				button.addEventListener('click', () => { const open = tray.classList.toggle('hidden') === false; button.setAttribute('aria-expanded', String(open)); if (open) list.querySelector('button').focus(); });
				document.getElementById('message-emoji-close').addEventListener('click', () => { close(); button.focus(); });
				document.addEventListener('click', event => { if (!tray.contains(event.target) && !button.contains(event.target)) close(); });
				document.addEventListener('keydown', event => { if (event.key === 'Escape' && !tray.classList.contains('hidden')) { close(); button.focus(); } });
			})();
		</script>
		<script>
			(function () {
				const document = window.conversationDocument;
				const modal = document.getElementById('conversation-media-preview');
				const content = document.getElementById('conversation-media-preview-content');
				// The conversation layout clips overflowing content; keep the viewer above it.
				document.body.appendChild(modal);
				let current = 0, documentURL = '', previewToken = 0;
				function items() { return Array.from(document.querySelectorAll('[data-conversation-media-preview]')); }
				function clearDocumentURL() { if (documentURL) { URL.revokeObjectURL(documentURL); documentURL = ''; } }
				function close() { previewToken++; modal.classList.add('hidden'); modal.classList.remove('flex'); content.querySelectorAll('video').forEach(video => video.pause()); clearDocumentURL(); document.body.classList.remove('overflow-hidden'); }
				function canReadDocument(item) { const mime = String(item.dataset.mediaMime || '').toLowerCase(); const name = String(item.dataset.mediaName || '').toLowerCase(); return mime === 'application/pdf' || mime === 'text/plain' || mime === 'text/csv' || /\.(pdf|txt|csv)$/.test(name); }
				function showDocumentLoadError() { const error = document.createElement('div'); error.className = 'text-center'; error.innerHTML = '<span class="mx-auto grid h-24 w-24 place-items-center rounded-3xl bg-red-500/15 text-4xl text-red-300"><i class="fas fa-file-circle-exclamation"><\/i><\/span><p class="mt-5 text-sm text-stone-300">Não foi possível carregar o documento para leitura. Use o botão de download para abri-lo.<\/p>'; content.replaceChildren(error); }
				async function loadReadableDocument(item, token) { try { const response = await fetch(item.dataset.mediaContent, { credentials: 'same-origin' }); if (!response.ok) throw new Error('HTTP ' + response.status); const blob = await response.blob(); if (token !== previewToken || !modal.classList.contains('flex')) return; clearDocumentURL(); documentURL = URL.createObjectURL(blob); const frame = document.createElement('iframe'); frame.src = documentURL; frame.title = 'Leitura de ' + (item.dataset.mediaName || 'documento'); frame.className = 'h-full w-full rounded-lg border-0 bg-white'; content.replaceChildren(frame); } catch (_) { if (token === previewToken && modal.classList.contains('flex')) showDocumentLoadError(); } }
				function open(index) { const media = items(); if (!media.length) return; current = (index + media.length) % media.length; const item = media[current]; const kind = item.dataset.mediaKind; const token = ++previewToken; clearDocumentURL(); content.replaceChildren(); let element; if (kind === 'image') { element = document.createElement('img'); element.src = item.dataset.mediaContent; element.alt = item.dataset.mediaName || 'Imagem'; element.className = 'max-h-full max-w-full object-contain'; } else if (kind === 'video') { element = document.createElement('video'); element.src = item.dataset.mediaContent; element.controls = true; element.autoplay = false; element.className = 'max-h-full max-w-full'; } else if (kind === 'document' && canReadDocument(item)) { element = document.createElement('div'); element.className = 'text-sm text-stone-300'; element.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-2 text-purple-300"><\/i>Carregando documento...'; } else { element = document.createElement('div'); element.className = 'text-center'; element.innerHTML = '<span class="mx-auto grid h-24 w-24 place-items-center rounded-3xl bg-white/10 text-4xl"><i class="fas fa-file-lines"><\/i><\/span><p class="mt-5 text-sm text-stone-300">Este formato não pode ser lido no navegador. Use o botão de download para abrir o documento.<\/p>'; } content.appendChild(element); document.getElementById('conversation-media-preview-name').textContent = item.dataset.mediaName || 'Mídia'; document.getElementById('conversation-media-preview-meta').textContent = kind === 'image' ? 'Imagem' : kind === 'video' ? 'Vídeo' : canReadDocument(item) ? 'Documento para leitura' : 'Documento'; document.getElementById('conversation-media-preview-download').href = item.dataset.mediaDownload; document.getElementById('conversation-media-preview-counter').textContent = (current + 1) + ' de ' + media.length; modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); if (kind === 'document' && canReadDocument(item)) loadReadableDocument(item, token); }
				document.getElementById('chatMessages').addEventListener('click', event => { const item = event.target.closest('[data-conversation-media-preview]'); if (!item) return; event.preventDefault(); open(items().indexOf(item)); }, true);
				document.getElementById('conversation-media-preview-close').onclick = close; document.getElementById('conversation-media-preview-previous').onclick = () => open(current - 1); document.getElementById('conversation-media-preview-next').onclick = () => open(current + 1); modal.onclick = event => { if (event.target === modal) close(); };
				document.addEventListener('keydown', event => { if (!modal.classList.contains('flex')) return; if (event.key === 'Escape') close(); if (event.key === 'ArrowLeft') open(current - 1); if (event.key === 'ArrowRight') open(current + 1); });
			})();
		</script>
		<script>
			(function () {
				const document = window.conversationDocument;
				const attachmentButton = document.getElementById('message-attachment-button');
				const attachmentDetails = document.getElementById('message-attachment-details');
				const attachmentMenu = document.getElementById('message-attachment-menu');
				const fileInput = document.getElementById('message-media-file');
				const uploadModal = document.getElementById('message-upload-modal');
				const galleryModal = document.getElementById('message-gallery-modal');
				const pageError = document.getElementById('message-media-error');
				const microphoneRetry = document.getElementById('message-microphone-retry');
				let uploadFile = null;
				let uploadObjectURL = '';
				let galleryItems = [];
				let galleryKind = 'all';
				let selectedGalleryItem = null;

				function setVisible(modal, visible) { modal.classList.toggle('hidden', !visible); modal.classList.toggle('flex', visible); document.body.classList.toggle('overflow-hidden', visible); }
				function showError(element, message) { (element === pageError ? document.getElementById('message-media-error-text') : element).textContent = message; element.classList.remove('hidden'); }
				function clearError(element) { (element === pageError ? document.getElementById('message-media-error-text') : element).textContent = ''; element.classList.add('hidden'); if (element === pageError) microphoneRetry.classList.add('hidden'); }
				function mediaKind(file) { const type = String(file.type || '').toLowerCase(); if (type.startsWith('image/')) return 'image'; if (type.startsWith('video/')) return 'video'; if (type.startsWith('audio/')) return 'audio'; return 'document'; }
				function mediaBytes(value) { const bytes = Number(value || 0); if (bytes < 1024 * 1024) return Math.max(1, Math.round(bytes / 1024)) + ' KB'; return (bytes / 1024 / 1024).toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + ' MB'; }
				async function responseText(response) { const text = await response.text(); if (response.ok) return text; let message = ''; try { const payload = JSON.parse(text); message = typeof payload.error === 'string' ? payload.error : ''; } catch (_) {} if (!message) message = response.status >= 500 ? 'O serviço de envio não respondeu (HTTP ' + response.status + '). Confira se a mensagem apareceu na conversa antes de tentar novamente.' : 'Não foi possível enviar a mídia (HTTP ' + response.status + ').'; throw new Error(message); }
				function appendMessage(html) { const template = document.createElement('template'); template.innerHTML = html.trim(); const message = template.content.firstElementChild; if (!message) return; const id = message.dataset.messageId; if (id && document.querySelector('#chatMessages [data-message-id="' + CSS.escape(id) + '"]')) return; document.getElementById('chatMessages').appendChild(message); if (window.htmx) htmx.process(message); message.querySelectorAll('[data-audio-player]').forEach(player => initAudioPlayer(player)); if (!window.shouldAutoScrollAfterSend || window.shouldAutoScrollAfterSend(Boolean(message.dataset.messageQuotedId))) message.scrollIntoView({ behavior: 'smooth', block: 'end' }); }
				function toggleMenu(show) { attachmentDetails.open = show; attachmentButton.setAttribute('aria-expanded', show ? 'true' : 'false'); }
				function closeUpload() { setVisible(uploadModal, false); uploadFile = null; fileInput.value = ''; document.getElementById('message-upload-caption').value = ''; document.getElementById('message-upload-preview').replaceChildren(); clearError(document.getElementById('message-upload-error')); if (uploadObjectURL) URL.revokeObjectURL(uploadObjectURL); uploadObjectURL = ''; }
				function openUpload(file) { uploadFile = file; uploadObjectURL = URL.createObjectURL(file); const preview = document.getElementById('message-upload-preview'); preview.replaceChildren(); const kind = mediaKind(file); let element; if (kind === 'image') { element = document.createElement('img'); element.src = uploadObjectURL; element.className = 'max-h-80 w-full object-contain'; } else if (kind === 'video') { element = document.createElement('video'); element.src = uploadObjectURL; element.controls = true; element.className = 'max-h-80 w-full'; } else if (kind === 'audio') { element = document.createElement('audio'); element.src = uploadObjectURL; element.controls = true; element.className = 'w-full px-5'; } else { element = document.createElement('div'); element.className = 'py-10 text-center text-gray-500'; element.innerHTML = '<span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-purple-100 text-2xl text-purple-700"><i class="fas fa-file-lines"><\/i><\/span><p class="mt-3 text-sm font-bold"><\/p>'; element.querySelector('p').textContent = file.name; } preview.appendChild(element); document.getElementById('message-upload-meta').textContent = file.name + ' · ' + mediaBytes(file.size); setVisible(uploadModal, true); }

				const recordButton = document.getElementById('message-record-button');
				const recordingPanel = document.getElementById('message-recording');
				const recordingPreview = document.getElementById('message-recording-preview');
				const recordingAudio = document.getElementById('message-recording-audio');
				const recordingSend = document.getElementById('message-recording-send');
				const recordingDiscard = document.getElementById('message-recording-discard');
				let recorder = null, recordingStream = null, recordingFile = null, recordingURL = '', recordingTimer = null, recordingStarted = 0, recordingRequest = 0;
				function releaseMicrophone() { if (recordingStream) recordingStream.getTracks().forEach(track => track.stop()); recordingStream = null; }
				function discardRecording() {
					recordingRequest++;
					if (recorder && recorder.state !== 'inactive') { recorder.onstop = null; recorder.stop(); }
					recorder = null; releaseMicrophone(); clearInterval(recordingTimer); recordingTimer = null;
					recordingAudio.pause(); recordingAudio.removeAttribute('src'); recordingAudio.load();
					if (recordingURL) URL.revokeObjectURL(recordingURL);
					recordingURL = ''; recordingFile = null;
					recordingPanel.classList.add('hidden'); recordingPanel.classList.remove('flex');
					recordingPreview.classList.add('hidden'); recordingPreview.classList.remove('flex');
					recordButton.disabled = false;
				}
				async function startRecording() {
					if (recorder || recordingFile || recordButton.disabled) return;
					clearError(pageError);
					if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { showError(pageError, 'O microfone requer uma conexão segura (HTTPS ou localhost) e um navegador compatível.'); return; }
					recordButton.disabled = true;
					const request = ++recordingRequest;
					let stream;
					try {
						stream = await navigator.mediaDevices.getUserMedia({ audio: true });
					} catch (error) {
						discardRecording();
						if (error.name === 'NotAllowedError' || error.name === 'PermissionDeniedError' || error.name === 'SecurityError') {
							let blocked = false;
							try { blocked = (await navigator.permissions.query({ name: 'microphone' })).state === 'denied'; } catch (_) { /* Nem todos os navegadores implementam a consulta de permissão. */ }
							showError(pageError, blocked ? 'O navegador bloqueou o microfone para este site e não mostrará outro pedido. Clique no ícone à esquerda do endereço, mude Microfone para Permitir e clique em Tentar microfone novamente.' : 'Permissão de microfone recusada. Clique em Tentar microfone novamente para solicitar acesso; se o navegador não perguntar, permita o microfone nas configurações deste site (ícone à esquerda do endereço).');
						} else {
							showError(pageError, error.name === 'NotFoundError' ? 'Nenhum microfone foi encontrado. Conecte um microfone e tente novamente.' : 'Não foi possível acessar o microfone. Verifique se ele está conectado e tente novamente.');
						}
						microphoneRetry.classList.remove('hidden');
						return;
					}
					try {
						if (request !== recordingRequest) { stream.getTracks().forEach(track => track.stop()); return; }
						recordingStream = stream;
						if (!window.MediaRecorder) throw new Error('MediaRecorder indisponível');
						const mime = ['audio/webm;codecs=opus', 'audio/ogg;codecs=opus', 'audio/mp4', 'audio/webm', 'audio/ogg'].find(type => MediaRecorder.isTypeSupported(type));
						if (!mime) throw new Error('Formato de áudio incompatível');
						const chunks = [];
						const current = new MediaRecorder(stream, { mimeType: mime });
						recorder = current;
						stream.getAudioTracks().forEach(track => track.addEventListener('ended', () => { if (recorder === current && current.state === 'recording') current.stop(); }));
						current.ondataavailable = event => { if (event.data.size) chunks.push(event.data); };
						current.onerror = () => { discardRecording(); showError(pageError, 'A gravação foi interrompida. Tente novamente.'); };
						current.onstop = () => {
							if (recorder !== current) return;
							recorder = null; releaseMicrophone(); clearInterval(recordingTimer); recordingTimer = null;
							recordingPanel.classList.add('hidden'); recordingPanel.classList.remove('flex');
							const type = mime.split(';')[0];
							const blob = new Blob(chunks, { type });
							if (!blob.size || blob.size > 20 * 1024 * 1024) { discardRecording(); showError(pageError, blob.size ? 'O áudio excede o limite de 20 MB.' : 'Não foi possível capturar o áudio.'); return; }
							recordingFile = new File([blob], 'gravacao.' + (type === 'audio/mp4' ? 'm4a' : type === 'audio/ogg' ? 'ogg' : 'webm'), { type });
							recordingURL = URL.createObjectURL(blob); recordingAudio.src = recordingURL;
							recordingPreview.classList.remove('hidden'); recordingPreview.classList.add('flex'); recordingSend.focus();
						};
						current.start(1000);
						recordingStarted = Date.now();
						document.getElementById('message-recording-time').textContent = '00:00';
						recordingTimer = setInterval(() => { const seconds = Math.floor((Date.now() - recordingStarted) / 1000); document.getElementById('message-recording-time').textContent = String(Math.floor(seconds / 60)).padStart(2, '0') + ':' + String(seconds % 60).padStart(2, '0'); }, 1000);
						recordingPanel.classList.remove('hidden'); recordingPanel.classList.add('flex');
					} catch (error) {
						discardRecording();
						showError(pageError, 'O microfone foi permitido, mas este navegador não conseguiu iniciar a gravação de áudio.');
						microphoneRetry.classList.remove('hidden');
					}
				}
				recordButton.addEventListener('click', startRecording);
				microphoneRetry.addEventListener('click', startRecording);
				document.getElementById('message-recording-stop').addEventListener('click', () => { if (recorder && recorder.state === 'recording') recorder.stop(); });
				document.getElementById('message-recording-cancel').addEventListener('click', discardRecording);
				recordingDiscard.addEventListener('click', discardRecording);
				recordingSend.addEventListener('click', async () => {
					if (!recordingFile || recordingSend.disabled) return;
					clearError(pageError); recordingSend.disabled = true; recordingDiscard.disabled = true;
					const data = new FormData(); data.append('file', recordingFile); data.append('kind', 'audio'); data.append('caption', '');
					try { const response = await fetch(galleryModal.dataset.uploadUrl, { method: 'POST', credentials: 'same-origin', body: data }); appendMessage(await responseText(response)); discardRecording(); if (window.refreshConversationSidebar) window.refreshConversationSidebar(); }
					catch (error) { showError(pageError, error.message); }
					finally { recordingSend.disabled = false; recordingDiscard.disabled = false; }
				});
				window.addEventListener('pagehide', discardRecording, { signal: window.conversationAbort.signal });
				window.conversationAbort.signal.addEventListener('abort', discardRecording, { once: true });

				attachmentDetails.addEventListener('toggle', () => attachmentButton.setAttribute('aria-expanded', attachmentDetails.open ? 'true' : 'false'));
				document.addEventListener('click', event => { if (!attachmentDetails.contains(event.target)) toggleMenu(false); });
				document.getElementById('message-upload-option').addEventListener('click', () => { toggleMenu(false); fileInput.click(); });
				fileInput.addEventListener('change', () => { if (fileInput.files && fileInput.files[0]) openUpload(fileInput.files[0]); });
				document.addEventListener('paste', event => { const item = Array.from((event.clipboardData && event.clipboardData.items) || []).find(value => value.kind === 'file'); if (!item || !uploadModal.classList.contains('hidden') || !galleryModal.classList.contains('hidden')) return; const file = item.getAsFile(); if (!file) return; event.preventDefault(); toggleMenu(false); openUpload(file); });
				document.getElementById('message-upload-close').addEventListener('click', closeUpload); document.getElementById('message-upload-cancel').addEventListener('click', closeUpload);
				uploadModal.addEventListener('click', event => { if (event.target === uploadModal) closeUpload(); });
				document.getElementById('message-upload-send').addEventListener('click', async function () { if (!uploadFile) return; const button = this; clearError(document.getElementById('message-upload-error')); button.disabled = true; const data = new FormData(); data.append('file', uploadFile); data.append('kind', mediaKind(uploadFile)); data.append('caption', document.getElementById('message-upload-caption').value.trim()); try { const response = await fetch(galleryModal.dataset.uploadUrl, { method: 'POST', credentials: 'same-origin', body: data }); appendMessage(await responseText(response)); closeUpload(); } catch (error) { showError(document.getElementById('message-upload-error'), error.message); } finally { button.disabled = false; } });

				function galleryCard(item) { const card = document.createElement('button'); card.type = 'button'; card.className = 'group overflow-hidden rounded-2xl border bg-white text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ' + (selectedGalleryItem === item ? 'border-purple-500 ring-2 ring-purple-200' : 'border-stone-200'); const preview = document.createElement('div'); preview.className = 'relative flex aspect-square items-center justify-center overflow-hidden bg-stone-100'; if (item.kind === 'image') { const image = document.createElement('img'); image.src = item.previewURL; image.alt = ''; image.loading = 'lazy'; image.className = 'h-full w-full object-cover transition group-hover:scale-105'; preview.appendChild(image); } else { const icon = document.createElement('span'); icon.className = 'grid h-14 w-14 place-items-center rounded-2xl text-xl ' + (item.kind === 'video' ? 'bg-blue-100 text-blue-700' : item.kind === 'audio' ? 'bg-purple-100 text-purple-700' : 'bg-stone-200 text-gray-600'); icon.innerHTML = '<i class="fas ' + (item.kind === 'video' ? 'fa-play' : item.kind === 'audio' ? 'fa-waveform-lines' : 'fa-file-lines') + '"><\/i>'; preview.appendChild(icon); } if (selectedGalleryItem === item) { const mark = document.createElement('span'); mark.className = 'absolute right-2 top-2 grid h-7 w-7 place-items-center rounded-full bg-purple-600 text-xs text-white shadow'; mark.innerHTML = '<i class="fas fa-check"><\/i>'; preview.appendChild(mark); } const info = document.createElement('div'); info.className = 'p-3'; const name = document.createElement('p'); name.className = 'truncate text-xs font-bold text-gray-800'; name.textContent = item.name; const meta = document.createElement('p'); meta.className = 'mt-1 text-[10px] text-gray-500'; meta.textContent = mediaBytes(item.sizeBytes) + ' · ' + (item.scope === 'flows' ? 'Automação' : 'Conversa'); info.append(name, meta); card.append(preview, info); card.addEventListener('click', () => { selectedGalleryItem = item; document.getElementById('message-gallery-selection').textContent = item.name + ' · ' + mediaBytes(item.sizeBytes); document.getElementById('message-gallery-send').disabled = false; renderGallery(); }); return card; }
				function renderGallery() { const query = document.getElementById('message-gallery-search').value.trim().toLowerCase(); const visible = galleryItems.filter(item => (galleryKind === 'all' || item.kind === galleryKind) && (!query || item.name.toLowerCase().includes(query))); const grid = document.getElementById('message-gallery-grid'); grid.replaceChildren(); visible.forEach(item => grid.appendChild(galleryCard(item))); grid.classList.toggle('hidden', visible.length === 0); grid.classList.toggle('grid', visible.length > 0); document.getElementById('message-gallery-empty').classList.toggle('hidden', visible.length > 0); }
				async function openGallery() { toggleMenu(false); clearError(document.getElementById('message-gallery-error')); setVisible(galleryModal, true); document.getElementById('message-gallery-loading').classList.remove('hidden'); document.getElementById('message-gallery-grid').classList.add('hidden'); document.getElementById('message-gallery-empty').classList.add('hidden'); try { const response = await fetch(galleryModal.dataset.listUrl, { credentials: 'same-origin', headers: { Accept: 'application/json' } }); const text = await response.text(); const payload = text ? JSON.parse(text) : {}; if (!response.ok) throw new Error(payload.error || 'Não foi possível carregar a galeria.'); galleryItems = (payload.data && payload.data.items) || []; renderGallery(); } catch (error) { showError(document.getElementById('message-gallery-error'), error.message); } finally { document.getElementById('message-gallery-loading').classList.add('hidden'); } }
				function closeGallery() { setVisible(galleryModal, false); selectedGalleryItem = null; document.getElementById('message-gallery-selection').textContent = 'Nenhuma mídia selecionada'; document.getElementById('message-gallery-caption').value = ''; document.getElementById('message-gallery-send').disabled = true; }
				document.getElementById('message-gallery-option').addEventListener('click', openGallery); document.getElementById('message-gallery-close').addEventListener('click', closeGallery); document.getElementById('message-gallery-cancel').addEventListener('click', closeGallery); galleryModal.addEventListener('click', event => { if (event.target === galleryModal) closeGallery(); });
				document.getElementById('message-gallery-search').addEventListener('input', renderGallery); document.querySelectorAll('[data-gallery-kind]').forEach(button => button.addEventListener('click', () => { galleryKind = button.dataset.galleryKind; document.querySelectorAll('[data-gallery-kind]').forEach(item => item.className = 'rounded-xl px-3 py-2 text-xs font-bold ' + (item === button ? 'bg-purple-600 text-white' : 'bg-stone-100 text-gray-600')); renderGallery(); }));
				document.getElementById('message-gallery-send').addEventListener('click', async function () { if (!selectedGalleryItem) return; const button = this; clearError(document.getElementById('message-gallery-error')); button.disabled = true; try { const response = await fetch(galleryModal.dataset.sendUrl, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'text/html' }, body: JSON.stringify({ scope: selectedGalleryItem.scope, file: selectedGalleryItem.name, caption: document.getElementById('message-gallery-caption').value.trim() }) }); appendMessage(await responseText(response)); closeGallery(); } catch (error) { showError(document.getElementById('message-gallery-error'), error.message); button.disabled = false; } });
				document.addEventListener('keydown', event => { if (event.key !== 'Escape') return; if (uploadModal.classList.contains('flex')) closeUpload(); else if (galleryModal.classList.contains('flex')) closeGallery(); else toggleMenu(false); });
			})();
		</script>
       } else {
       <div class="p-4 border-t border-stone-200 bg-stone-50 text-center text-sm text-gray-500">
           if activeConversation.Status == repo.ConversationStatusClosed {
              Conversa fechada.
           } else if activeConversation.AgentID == nil && activeConversation.Status != repo.ConversationStatusRunning {
              Aceite a conversa para responder.
           } else if activeConversation.Status == repo.ConversationStatusRunning {
              Atendimento automático em andamento.
           } else {
              Conversa atribuída a outro agente.
           }
       </div>
       }
		<script>
           (function () {
			 const document = window.conversationDocument;
			 let readInFlight = false;
			 const shouldAutoScrollAfterSend = quoted => !window.shouldAutoScrollAfterSend || window.shouldAutoScrollAfterSend(quoted);
			 const keepsQuotePosition = () => window.getAutoScrollAfterSendMode?.() === 'except_quotes' && window.isReplyingToMessage?.();
              function scrollChatToBottom(force) {
                requestAnimationFrame(function () {
                   var chat = document.getElementById('chatMessages');
                   if (chat && (force || !keepsQuotePosition())) chat.scrollTop = chat.scrollHeight;
                });
             }
			 async function markVisibleMessagesRead() {
				const chat = document.getElementById('chatMessages');
				if (!chat || readInFlight || document.visibilityState !== 'visible') return;
				readInFlight = true;
				try { await fetch(chat.dataset.readUrl, { method: 'POST', credentials: 'same-origin' }); } finally { readInFlight = false; }
			 }
             scrollChatToBottom(true);
			 markVisibleMessagesRead();
			 document.body.addEventListener('htmx:sseMessage', function (event) {
				if (event.detail.type === 'message-status' || event.detail.type === 'message-update') return;
				const template=document.createElement('template');template.innerHTML=event.detail.data||'';const message=template.content.querySelector('[data-message-id]');
				if(message?.dataset.fromMe!=='true'||shouldAutoScrollAfterSend(Boolean(message.dataset.messageQuotedId)))scrollChatToBottom();markVisibleMessagesRead();
			 });
			 document.body.addEventListener('htmx:oobBeforeSwap', function (event) {
				const current = event.detail.target;
				if (!current || !current.hasAttribute('data-delivery-status')) return;
				const incoming = event.detail.fragment.querySelector('[data-delivery-status]');
				if (incoming && Number(incoming.dataset.deliveryStatus) < Number(current.dataset.deliveryStatus)) event.detail.shouldSwap = false;
			 });
			 document.addEventListener('visibilitychange', markVisibleMessagesRead);
              document.body.addEventListener('htmx:afterSwap', function (e) {
                 if (e.detail.target && e.detail.target.id === 'chatMessages') {
					if(!e.detail.requestConfig)return; // SSE scroll decisions use the message's own quote metadata.
                    const sentByComposer = e.detail.requestConfig && e.detail.requestConfig.elt && e.detail.requestConfig.elt.id === 'message-composer';
					const source=e.detail.requestConfig?.elt;const quoted=Boolean(e.detail.requestConfig?.parameters?.quotedId)||source?.dataset.sentWithQuote==='true';
                    if (!sentByComposer || shouldAutoScrollAfterSend(quoted)) scrollChatToBottom();
                 }
              });
          })();
       </script>
        <script>
           (function () {
           const document = window.conversationDocument;
           window._audioCurrentlyPlaying = null;

           function initAudioPlayer(player) {
               if (player.dataset.audioInitialized === 'true') return;
               const audio = player.querySelector('audio');
               const playBtn = player.querySelector('[data-play-btn]');
               const playIcon = playBtn && playBtn.querySelector('i');
                const progressBar = player.querySelector('[data-progress-bar]');
                const progressTrack = player.querySelector('[data-progress-track]');
                const timeDisplay = player.querySelector('[data-time-display]');
                 const volumeControl = player.querySelector('[data-volume-control]');
				 const volumeIcon = player.querySelector('[data-volume-icon]');
                const speedControl = player.querySelector('[data-speed-control]');
                if (!audio || !playBtn || !playIcon || !progressBar || !progressTrack || !timeDisplay || !volumeControl || !speedControl) return;
               player.dataset.audioInitialized = 'true';

               function formatTime(secs) {
                   if (isNaN(secs) || secs === Infinity) return '0:00';
                   const m = Math.floor(secs / 60);
                   const s = Math.floor(secs % 60).toString().padStart(2, '0');
                   return `${m}:${s}`;
               }

               function setPlaying(playing) {
                   playIcon.classList.toggle('fa-play', !playing);
                   playIcon.classList.toggle('fa-pause', playing);
               }

               audio.addEventListener('loadedmetadata', () => {
                   timeDisplay.textContent = formatTime(audio.duration);
               });
                if (audio.readyState >= 1) timeDisplay.textContent = formatTime(audio.duration);

                const playbackRates = [1, 1.5, 2];
                function updateSpeedControl() {
                    speedControl.textContent = audio.playbackRate + 'x';
                }
				 function updateVolumeControl() { const value = Number(volumeControl.value); audio.volume = value; volumeControl.style.setProperty('--audio-progress', Math.round(value * 100) + '%'); if (volumeIcon) volumeIcon.className = 'fas ' + (value === 0 ? 'fa-volume-xmark' : value < 0.5 ? 'fa-volume-low' : 'fa-volume-high') + ' w-3 text-center text-[11px] ' + (volumeIcon.classList.contains('text-white') ? 'text-white' : 'text-purple-700'); }
				 updateVolumeControl();
                 updateSpeedControl();

                 volumeControl.addEventListener('input', () => {
					updateVolumeControl();
                 });

                speedControl.addEventListener('click', () => {
                    const current = playbackRates.indexOf(audio.playbackRate);
                    audio.playbackRate = playbackRates[(current + 1) % playbackRates.length];
                    updateSpeedControl();
                });

               playBtn.addEventListener('click', () => {
                   if (audio.paused) {
                       audio.play().catch(err => {
                           setPlaying(false);
                           if (window._audioCurrentlyPlaying === audio) window._audioCurrentlyPlaying = null;
                           if (err.name !== 'AbortError') console.warn('Audio play error:', err);
                       });
                   } else {
                       audio.pause();
                   }
               });

               audio.addEventListener('play', () => {
                   const previous = window._audioCurrentlyPlaying;
                   if (previous && previous !== audio) previous.pause();
                   window._audioCurrentlyPlaying = audio;
                   setPlaying(true);
               });

               audio.addEventListener('pause', () => {
                   setPlaying(false);
                   if (window._audioCurrentlyPlaying === audio) window._audioCurrentlyPlaying = null;
               });

               audio.addEventListener('timeupdate', () => {
                   if (!audio.duration) return;
                   progressBar.style.width = (audio.currentTime / audio.duration * 100) + '%';
                   timeDisplay.textContent = formatTime(audio.currentTime);
               });

               audio.addEventListener('ended', () => {
                   setPlaying(false);
                   progressBar.style.width = '0%';
                   timeDisplay.textContent = formatTime(audio.duration);
                   if (window._audioCurrentlyPlaying === audio) window._audioCurrentlyPlaying = null;
               });

               progressTrack.addEventListener('click', (e) => {
                   if (!audio.duration) return;
                   const rect = progressTrack.getBoundingClientRect();
                   audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
               });
           }

           function initAudioPlayers(root) {
               if (root.matches && root.matches('[data-audio-player]')) initAudioPlayer(root);
               if (root.querySelectorAll) root.querySelectorAll('[data-audio-player]').forEach(initAudioPlayer);
           }

           function createMessageDateDivider(key, label) {
               const divider = document.createElement('div');
               divider.dataset.messageDateDivider = key;
               divider.className = 'flex items-center gap-3 py-2';
               divider.setAttribute('role', 'separator');
               divider.setAttribute('aria-label', label);
               const left = document.createElement('span');
               left.className = 'h-px flex-1 bg-stone-300/80';
               const text = document.createElement('span');
               text.className = 'rounded-full border border-stone-200 bg-white/90 px-3 py-1 text-[10px] font-bold uppercase tracking-[.12em] text-gray-500 shadow-sm';
               text.textContent = label;
               const right = left.cloneNode();
               divider.append(left, text, right);
               return divider;
           }

           function initMessageDateDividers(root) {
               const messages = [];
               if (root.matches && root.matches('[data-message-date]')) messages.push(root);
               if (root.querySelectorAll) messages.push(...root.querySelectorAll('[data-message-date]'));
               messages.forEach(message => {
                   const previous = message.previousElementSibling;
                   if (previous && (previous.dataset.messageDate === message.dataset.messageDate || previous.dataset.messageDateDivider === message.dataset.messageDate)) return;
                   message.before(createMessageDateDivider(message.dataset.messageDate, message.dataset.messageDateLabel));
               });
           }

           initAudioPlayers(document);
		   initMessageDateDividers(document);
           window.initAudioPlayer = initAudioPlayer;
           const chatMessages = document.getElementById('chatMessages');
           const messageObserver = new MutationObserver(records => records.forEach(record => record.addedNodes.forEach(node => {
			   if (node.nodeType !== Node.ELEMENT_NODE) return;
			   initAudioPlayers(node);
			   initMessageDateDividers(node);
           })));
           if (chatMessages) messageObserver.observe(chatMessages, { childList: true, subtree: true });
           window.conversationAbort.signal.addEventListener('abort', () => messageObserver.disconnect(), { once: true });
           })();
       </script>
    </div>
    <!-- Contact Details Sidebar -->
     <div id="contactPanel" class="fixed inset-x-2 bottom-2 top-16 z-40 hidden flex flex-col overflow-hidden rounded-2xl bg-stone-50 shadow-2xl lg:static lg:w-80 lg:shrink-0 lg:shadow-sm">
       <!-- Header -->
       <div class="p-4 border-b border-stone-200 flex items-center justify-between">
          <h2 class="text-lg font-medium text-gray-800">Detalhes do Contato</h2>
          <button class="p-2 hover:bg-stone-200 rounded-xl transition-colors" onclick="document.getElementById('contactPanel').classList.toggle('hidden')">
          <i class="fas fa-times text-gray-600"></i>
          </button>
       </div>
       <!-- Content -->
       <div class="flex-1 overflow-y-auto p-6 space-y-6">
          <!-- Profile Section -->
          <div class="flex flex-col items-center text-center">
              <img src={ fmt.Sprintf("/management/api/contacts/%d/avatar", activeConversation.Contact.Id) } alt="Foto do contato" class="w-20 h-20 rounded-full mb-4 shadow-sm">
			  <h3 class="text-lg font-medium text-gray-900">{ activeConversation.Contact.Name }</h3>
			  <p class="text-sm text-gray-500">{ activeConversation.Contact.Number }</p>
			  <span class="mt-2 inline-block px-3 py-1 bg-purple-100 text-purple-700 text-xs rounded-full">{ activeConversation.Status }</span>
          </div>
          <!-- Divider -->
          <div class="h-px bg-stone-200"></div>
          <!-- Contact Info -->
          <div class="space-y-4">
             <div>
                <p class="text-xs font-medium text-gray-500 uppercase mb-2">Telefone</p>
                <div class="flex items-center gap-3 p-3 bg-white rounded-xl hover:bg-stone-100 transition-colors cursor-pointer">
                   <i class="fas fa-phone text-purple-600"></i>
					<span class="text-sm text-gray-800">{ activeConversation.Contact.Number }</span>
                </div>
             </div>
             <div>
                <p class="text-xs font-medium text-gray-500 uppercase mb-2">Email</p>
                <div class="flex items-center gap-3 p-3 bg-white rounded-xl hover:bg-stone-100 transition-colors cursor-pointer">
                   <i class="fas fa-envelope text-purple-600"></i>
					<span class="text-sm text-gray-800">{ activeConversation.Contact.Email }</span>
                </div>
             </div>
          </div>
          <!-- Divider -->
          <div class="h-px bg-stone-200"></div>
          <!-- Additional Info -->
          <div class="space-y-3">
             <div class="flex items-center justify-between p-3 bg-white rounded-xl">
                <div class="flex items-center gap-3">
                   <i class="fas fa-calendar text-purple-600 w-5"></i>
                   <div>
					   <p class="text-xs text-gray-500">Atendimento</p>
					   <p class="text-sm font-medium text-gray-900">{ activeConversation.Status }</p>
                   </div>
                </div>
             </div>
             <div class="flex items-center justify-between p-3 bg-white rounded-xl">
                <div class="flex items-center gap-3">
                   <i class="fas fa-messages text-purple-600 w-5"></i>
                   <div>
                      <p class="text-xs text-gray-500">Mensagens</p>
					   <p class="text-sm font-medium text-gray-900">{ fmt.Sprintf("%d", len(messages)) }</p>
                   </div>
                </div>
             </div>
          </div>
          <!-- Divider -->
           <div class="h-px bg-stone-200"></div>
		   <div>
			  <p class="text-xs font-medium text-gray-500 uppercase mb-3">Histórico interno</p>
			  <div class="space-y-2">
				 if len(events) == 0 {
				 <p class="text-xs text-gray-400">Nenhum registro interno.</p>
				 }
				 for _, event := range events {
				 <div class="rounded-xl border border-stone-200 bg-white p-3">
					<div class="flex items-center justify-between gap-2">
					   <span class="text-[10px] font-semibold uppercase text-purple-600">{ event.EventType }</span>
					   <time class="text-[10px] text-gray-400">{ event.CreatedAt.Format("02/01/2006 15:04") }</time>
					</div>
					<p class="mt-1 text-xs leading-relaxed text-gray-700 whitespace-pre-wrap">{ event.Content }</p>
				 </div>
				 }
			  </div>
		   </div>
		   <div class="h-px bg-stone-200"></div>
		   <!-- Action Buttons -->
           <div class="space-y-2">
			  if agent.IsAdmin() && !activeConversation.Contact.IsGroup {
			  <button id="conversation-contact-edit-button" type="button" class="w-full px-4 py-3 bg-purple-100 text-purple-700 rounded-xl font-medium hover:bg-purple-200 transition-colors flex items-center justify-center gap-2"><i class="fas fa-pen"></i>Editar contato</button>
			  }
              <button class="w-full px-4 py-3 bg-purple-100 text-purple-700 rounded-xl font-medium hover:bg-purple-200 transition-colors flex items-center justify-center gap-2">
             <i class="fas fa-video"></i>
             Chamada de Vídeo
             </button>
             <button class="w-full px-4 py-3 bg-purple-100 text-purple-700 rounded-xl font-medium hover:bg-purple-200 transition-colors flex items-center justify-center gap-2">
             <i class="fas fa-phone"></i>
             Chamada de Áudio
             </button>
             <button class="w-full px-4 py-3 bg-red-100 text-red-700 rounded-xl font-medium hover:bg-red-200 transition-colors flex items-center justify-center gap-2">
             <i class="fas fa-trash"></i>
             Bloquear Contato
             </button>
           </div>
        </div>
    </div>
	if agent.IsAdmin() && !activeConversation.Contact.IsGroup {
	@ContactAPIRuntime()
	<script>
		(function () {
			const document = window.conversationDocument;
			const modal = document.getElementById('conversation-contact-edit-modal');
			const openButton = document.getElementById('conversation-contact-edit-button');
			const closeButton = document.getElementById('conversation-contact-edit-close');
			const cancelButton = document.getElementById('conversation-contact-edit-cancel');
			const form = document.getElementById('conversation-contact-edit-form');
			const errorBox = document.getElementById('conversation-contact-edit-error');
			if (!modal || !openButton || !form) return;
			function close() { modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); }
			function contactFields() { return { name: document.getElementById('conversation-contact-edit-name').value, company: document.getElementById('conversation-contact-edit-company').value, email: document.getElementById('conversation-contact-edit-email').value, number: document.getElementById('conversation-contact-edit-number').value }; }
			openButton.onclick = () => { form.dataset.initial = JSON.stringify(contactFields()); errorBox.classList.add('hidden'); modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); document.getElementById('conversation-contact-edit-name').focus(); };
			closeButton.onclick = close; cancelButton.onclick = close;
			modal.onclick = event => { if (event.target === modal) close(); };
			form.onsubmit = async event => { event.preventDefault(); const contact = contactFields(); if (form.dataset.initial === JSON.stringify(contact)) { close(); return; } const saveButton = document.getElementById('conversation-contact-edit-save'); saveButton.disabled = true; errorBox.classList.add('hidden'); try { await window.contactRequest('PUT', '/management/api/contacts/' + document.getElementById('conversation-contact-edit-id').value, contact, 'Não foi possível atualizar o contato.'); window.location.reload(); } catch (error) { window.showContactRequestError(errorBox, error); } finally { saveButton.disabled = false; } };
		})();
	</script>
	}
	@ConversationMessageEditor(activeConversation)
	</div>
}

templ Messages(conversations []repo.Conversation, tab, scope string, counts repo.ConversationScopeCounts) {
@messagesDefault(conversations, tab, scope, counts) {
	@EmptyConversationPanel()
    }
}

templ EmptyConversationPanel() {
	<div id="conversation-panel" hx-history="false" class="contents">
    <!-- Main Chat Area - Empty State -->
                <div class="hidden min-w-0 flex-1 flex-col items-center justify-center overflow-hidden rounded-2xl bg-stone-50 shadow-sm lg:flex">
                    <!-- Empty State Content -->
                    <div class="text-center space-y-6">
                        <!-- Icon -->
                        <div class="inline-block p-6 rounded-3xl" style="background: rgba(97, 35, 204, 0.1);">
                            <i class="fas fa-inbox text-6xl" style="color: #6123cc;"></i>
                        </div>

                        <!-- Text -->
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900 mb-2">Nenhuma conversa selecionada</h2>
                            <p class="text-gray-500 max-w-md">
                                Selecione uma conversa na lista ao lado para começar a visualizar mensagens e responder aos seus contatos.
                            </p>
                        </div>

                        <!-- Quick Actions -->
                        <div class="flex items-center gap-3 justify-center">
							<button type="button" onclick="window.openConversationPicker && window.openConversationPicker({})" class="px-6 py-3 rounded-xl font-medium text-white shadow-sm hover:shadow-md transition-all flex items-center gap-2" style="background: linear-gradient(to right, #3b82f6, #6123cc);">
                                <i class="fas fa-pen-square"></i>
                                Nova Conversa
                            </button>
							<button type="button" onclick="window.openConversationPicker && window.openConversationPicker({ query: document.getElementById('contact-global-search').value.trim() })" class="px-6 py-3 rounded-xl font-medium border-2 border-stone-200 text-gray-700 hover:bg-stone-100 transition-colors flex items-center gap-2">
                                <i class="fas fa-search"></i>
                                Buscar
                            </button>
                        </div>

                        <!-- Tips -->
                        <div class="mt-8 bg-white rounded-2xl p-6 max-w-md text-left border border-stone-200">
                            <h3 class="font-medium text-gray-900 mb-3 flex items-center gap-2">
                                <i class="fas fa-lightbulb text-amber-500"></i>
                                Dica
                            </h3>
                            <p class="text-sm text-gray-600">
                                Você pode usar os filtros de departamento e status para encontrar conversas específicas com mais rapidez.
                            </p>
                        </div>
                    </div>
                </div>
	</div>
}

package web

templ Billing() {
	@base("billing") {
		<main class="min-w-0 flex-1 overflow-y-auto rounded-2xl bg-stone-50 shadow-sm">
			<div class="mx-auto max-w-6xl p-4 sm:p-6 lg:p-8">
				<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-purple-600">Assinatura e pagamentos</p>
						<h1 class="mt-2 text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Faturamento</h1>
						<p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-500">Acompanhe o plano da empresa, o próximo vencimento e o histórico financeiro.</p>
					</div>
					<button id="billing-refresh" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-stone-100"><i class="fas fa-rotate"></i> Atualizar</button>
				</header>
				<div id="payment-return-banner" role="status" class="mt-6 hidden items-start justify-between gap-4 rounded-2xl border p-4 text-sm">
					<div class="flex gap-3"><i id="payment-return-icon" class="fas mt-0.5"></i><div><p id="payment-return-title" class="font-bold"></p><p id="payment-return-message" class="mt-1"></p></div></div>
					<button id="close-payment-banner" type="button" aria-label="Fechar aviso"><i class="fas fa-xmark"></i></button>
				</div>
				<div id="billing-error" role="alert" class="mt-6 hidden items-start justify-between gap-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
					<div class="flex gap-3"><i class="fas fa-circle-exclamation mt-0.5"></i><span id="billing-error-text"></span></div>
					<button id="close-billing-error" type="button" aria-label="Fechar aviso"><i class="fas fa-xmark"></i></button>
				</div>
				<div id="billing-loading" class="mt-6 rounded-3xl border border-stone-200 bg-white p-16 text-center text-sm text-gray-500 shadow-sm"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Consultando assinatura...</div>
				<div id="billing-content" class="mt-6 hidden space-y-6">
					<section class="relative overflow-hidden rounded-3xl bg-stone-950 p-6 text-white shadow-xl sm:p-8" style="background: radial-gradient(circle at 85% 20%, rgba(59,130,246,.5), transparent 28%), radial-gradient(circle at 10% 100%, rgba(97,35,204,.55), transparent 35%), #17141f;">
						<div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px); background-size: 38px 38px;"></div>
						<div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
							<div>
								<div class="flex flex-wrap items-center gap-3"><span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-semibold text-stone-200"><i class="fas fa-layer-group mr-1.5"></i> Plano atual</span><span id="billing-status-badge" class="rounded-full px-3 py-1 text-xs font-bold"></span></div>
								<h2 id="billing-plan-name" class="mt-5 text-3xl font-black tracking-tight sm:text-4xl">-</h2>
								<p id="billing-plan-description" class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-300">-</p>
								<div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-stone-300">
									<span><i class="fas fa-headset mr-2 text-purple-300"></i><strong id="billing-agent-limit" class="text-white">-</strong> agentes</span>
									<span><i class="fas fa-link mr-2 text-blue-300"></i><strong id="billing-connection-limit" class="text-white">-</strong> conexões</span>
									<span><i class="fas fa-calendar-days mr-2 text-emerald-300"></i><strong id="billing-duration" class="text-white">-</strong> dias por ciclo</span>
								</div>
							</div>
							<div class="lg:text-right">
								<p class="text-xs font-semibold uppercase tracking-[0.18em] text-stone-400">Valor do ciclo</p>
								<p id="billing-amount" class="mt-2 text-4xl font-black tracking-tight">-</p>
								<p class="mt-2 text-xs text-stone-400">Processado por <strong id="billing-provider" class="text-stone-200">-</strong></p>
								<button id="billing-checkout" type="button" class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-purple-700 shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl lg:w-auto"><i class="fas fa-credit-card"></i> Ir para pagamento</button>
								<div id="billing-free-state" class="mt-5 hidden rounded-xl border border-emerald-300/20 bg-emerald-400/10 px-4 py-3 text-sm font-semibold text-emerald-200"><i class="fas fa-gift mr-2"></i> Este é um plano gratuito</div>
							</div>
						</div>
					</section>
					<section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
						<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-purple-600">Periodicidade</p><h2 class="mt-2 font-black text-gray-950">Escolha como contratar o plano</h2><p class="mt-1 text-sm text-gray-500">A alteração preserva o vencimento atual e passa a valer para a próxima cobrança.</p></div><button id="billing-save-cycle" type="button" class="rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-gray-800 disabled:cursor-not-allowed disabled:opacity-40">Salvar ciclo</button></div>
						<div class="mt-5 grid gap-3 sm:grid-cols-2">
							<button type="button" data-billing-cycle="monthly" class="billing-cycle-option flex items-center justify-between rounded-2xl border border-stone-200 p-4 text-left transition hover:border-purple-300"><span><span class="block text-xs font-bold uppercase tracking-wider text-purple-600">Mensal</span><strong id="billing-monthly-price" class="mt-1 block text-xl text-gray-950">-</strong><span class="mt-1 block text-xs text-gray-500">30 dias de acesso</span></span><span class="billing-cycle-check grid h-7 w-7 place-items-center rounded-full border border-stone-300 text-transparent"><i class="fas fa-check text-xs"></i></span></button>
							<button type="button" data-billing-cycle="annual" class="billing-cycle-option flex items-center justify-between rounded-2xl border border-stone-200 p-4 text-left transition hover:border-purple-300"><span><span class="block text-xs font-bold uppercase tracking-wider text-blue-600">Anual</span><strong id="billing-annual-price" class="mt-1 block text-xl text-gray-950">-</strong><span class="mt-1 block text-xs text-gray-500">365 dias de acesso</span></span><span class="billing-cycle-check grid h-7 w-7 place-items-center rounded-full border border-stone-300 text-transparent"><i class="fas fa-check text-xs"></i></span></button>
						</div>
					</section>
					<section class="grid gap-4 md:grid-cols-3">
						<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
							<div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Empresa</p><p id="billing-company-name" class="mt-3 font-black text-gray-950">-</p><p id="billing-company-email" class="mt-1 truncate text-xs text-gray-500">-</p></div><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-purple-100 text-purple-700"><i class="fas fa-building"></i></span></div>
						</article>
						<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
							<div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Fim do período atual</p><p id="billing-period-end" class="mt-3 font-black text-gray-950">-</p><p id="billing-period-start" class="mt-1 text-xs text-gray-500">-</p></div><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-blue-100 text-blue-700"><i class="fas fa-calendar-check"></i></span></div>
						</article>
						<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
							<div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Próximo vencimento</p><p id="billing-next-due" class="mt-3 font-black text-gray-950">-</p><p id="billing-next-due-status" class="mt-1 text-xs text-gray-500">-</p></div><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-amber-100 text-amber-700"><i class="fas fa-clock"></i></span></div>
						</article>
					</section>
					<section class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
						<div class="flex items-center justify-between gap-3 border-b border-stone-200 p-5">
							<div><h2 class="font-bold text-gray-950">Histórico de pagamentos</h2><p class="mt-1 text-sm text-gray-500">Cobranças emitidas e confirmações recebidas.</p></div>
							<span id="billing-payment-count" class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-gray-600">0 registros</span>
						</div>
						<div id="billing-payments-table" class="hidden overflow-x-auto">
							<table class="w-full min-w-[800px] text-left text-sm">
								<thead class="bg-stone-50 text-[11px] uppercase tracking-wider text-gray-500"><tr><th class="px-5 py-3 font-semibold">Cobrança</th><th class="px-5 py-3 font-semibold">Valor</th><th class="px-5 py-3 font-semibold">Vencimento</th><th class="px-5 py-3 font-semibold">Pagamento</th><th class="px-5 py-3 font-semibold">Status</th><th class="px-5 py-3 text-right font-semibold">Comprovante</th></tr></thead>
								<tbody id="billing-payments-body" class="divide-y divide-stone-100"></tbody>
							</table>
						</div>
						<div id="billing-payments-mobile" class="divide-y divide-stone-100 lg:hidden"></div>
						<div id="billing-payments-empty" class="hidden p-12 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-stone-100 text-xl text-gray-400"><i class="fas fa-receipt"></i></span><p class="mt-4 font-semibold text-gray-700">Nenhum pagamento registrado</p><p id="billing-empty-message" class="mt-1 text-sm text-gray-500">As próximas cobranças aparecerão aqui.</p></div>
					</section>
				</div>
			</div>
		</main>
		<div id="billing-toast" class="fixed bottom-5 right-5 z-50 hidden max-w-sm items-center gap-3 rounded-2xl bg-gray-950 px-5 py-4 text-sm font-medium text-white shadow-2xl" role="status"><i class="fas fa-check-circle text-emerald-400"></i><span id="billing-toast-text"></span></div>
		<script>
const billingState = { company: null, subscription: null, plan: null, payments: [], paymentProvider: null, selectedCycle: null };

function billingElement(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined && text !== null) node.textContent = String(text);
    return node;
}

function billingErrorMessage(payload, fallback) {
    if (!payload) return fallback;
    const value = payload.error || payload.message;
    if (typeof value === 'string') return value;
    if (value && typeof value.message === 'string') return value.message;
    return fallback;
}

async function billingAPI(method, url, body) {
    const options = { method: method, credentials: 'same-origin', headers: { 'Accept': 'application/json' } };
    if (body !== undefined) {
        options.headers['Content-Type'] = 'application/json';
        options.body = JSON.stringify(body);
    }
    const response = await fetch(url, options);
    const text = await response.text();
    let payload = null;
    if (text) {
        try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; }
    }
    if (!response.ok) throw new Error(billingErrorMessage(payload, 'Erro ' + response.status));
    return payload;
}

function billingMoney(cents) {
    const value = Number(cents);
    return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number.isFinite(value) ? value / 100 : 0);
}

function billingDate(value, includeTime) {
    if (!value) return 'Não informado';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return 'Não informado';
    return new Intl.DateTimeFormat('pt-BR', includeTime ? { dateStyle: 'short', timeStyle: 'short' } : { dateStyle: 'long' }).format(date);
}

const billingStatusLabels = {
    trialing: 'Em avaliação', active: 'Em dia', past_due: 'Em atraso', canceled: 'Cancelada', expired: 'Expirada',
    pending: 'Pendente', processing: 'Processando', paid: 'Pago', failed: 'Falhou', refunded: 'Reembolsado'
};

function billingStatusBadge(status) {
    const key = String(status || 'pending');
    const styles = {
        active: 'bg-emerald-100 text-emerald-700', paid: 'bg-emerald-100 text-emerald-700', trialing: 'bg-blue-100 text-blue-700',
        pending: 'bg-amber-100 text-amber-800', processing: 'bg-blue-100 text-blue-700', past_due: 'bg-amber-100 text-amber-800',
        canceled: 'bg-stone-100 text-stone-600', expired: 'bg-red-100 text-red-700', failed: 'bg-red-100 text-red-700', refunded: 'bg-purple-100 text-purple-700'
    };
    return billingElement('span', 'inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ' + (styles[key] || 'bg-stone-100 text-stone-600'), billingStatusLabels[key] || key);
}

function safeBillingCheckoutURL(value) {
    if (!value) return null;
    try {
        const url = new URL(String(value), window.location.origin);
        return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null;
    } catch (_) { return null; }
}

function showBillingError(error) {
    const box = document.getElementById('billing-error');
    document.getElementById('billing-error-text').textContent = error instanceof Error ? error.message : String(error);
    box.classList.remove('hidden');
    box.classList.add('flex');
}

let billingToastTimer;
function showBillingToast(message) {
    const toast = document.getElementById('billing-toast');
    document.getElementById('billing-toast-text').textContent = message;
    toast.classList.remove('hidden');
    toast.classList.add('flex');
    clearTimeout(billingToastTimer);
    billingToastTimer = setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 3500);
}

function configurePaymentReturnBanner() {
    const result = new URLSearchParams(window.location.search).get('payment');
    const states = {
        success: { classes: 'border-emerald-200 bg-emerald-50 text-emerald-800', icon: 'fa-circle-check text-emerald-600', title: 'Pagamento recebido', message: 'A confirmação foi enviada. O status da assinatura será atualizado após o processamento.' },
        pending: { classes: 'border-amber-200 bg-amber-50 text-amber-900', icon: 'fa-clock text-amber-600', title: 'Pagamento pendente', message: 'A cobrança ainda está sendo processada. Atualize esta página em alguns instantes.' },
        failure: { classes: 'border-red-200 bg-red-50 text-red-800', icon: 'fa-circle-xmark text-red-600', title: 'Pagamento não concluído', message: 'Não foi possível finalizar a cobrança. Você pode tentar novamente pelo botão de pagamento.' }
    };
    const state = states[result];
    if (!state) return;
    const banner = document.getElementById('payment-return-banner');
    banner.className = 'mt-6 flex items-start justify-between gap-4 rounded-2xl border p-4 text-sm ' + state.classes;
    document.getElementById('payment-return-icon').className = 'fas mt-0.5 ' + state.icon;
    document.getElementById('payment-return-title').textContent = state.title;
    document.getElementById('payment-return-message').textContent = state.message;
}

function paymentProvider(provider) {
	return provider === 'mercado_pago' ? 'Mercado Pago' : (provider === 'abacate_pay' ? 'AbacatePay' : (provider || 'Não informado'));
}

function receiptLink(payment) {
	const checkoutURL = safeBillingCheckoutURL(payment.receiptURL || payment.checkoutURL);
    if (!checkoutURL) return billingElement('span', 'text-xs text-gray-400', '-');
    const link = billingElement('a', 'inline-flex items-center gap-1.5 rounded-lg bg-purple-50 px-3 py-2 text-xs font-semibold text-purple-700 hover:bg-purple-100', 'Abrir');
    link.href = checkoutURL;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.appendChild(billingElement('i', 'fas fa-arrow-up-right-from-square'));
    return link;
}

function renderPaymentTable(payments) {
    const body = document.getElementById('billing-payments-body');
    body.replaceChildren();
    payments.forEach(payment => {
        const row = billingElement('tr', 'transition hover:bg-stone-50');
		row.append(
			billingElement('td', 'px-5 py-4 font-semibold text-gray-800', '#' + payment.id),
			billingElement('td', 'px-5 py-4 font-bold text-gray-950', billingMoney(payment.amountCents)),
			billingElement('td', 'px-5 py-4 text-gray-600', billingDate(payment.dueDate))
		);
		const paid = billingElement('td', 'px-5 py-4 text-xs text-gray-500');
		paid.append(billingElement('p', '', payment.paidAt ? billingDate(payment.paidAt, true) : 'Ainda não pago'), billingElement('p', 'mt-1 font-semibold text-gray-400', paymentProvider(payment.provider)));
		row.appendChild(paid);
        const status = billingElement('td', 'px-5 py-4');
        status.appendChild(billingStatusBadge(payment.status));
        const receipt = billingElement('td', 'px-5 py-4 text-right');
        receipt.appendChild(receiptLink(payment));
        row.append(status, receipt);
        body.appendChild(row);
    });
}

function renderPaymentCards(payments) {
    const list = document.getElementById('billing-payments-mobile');
    list.replaceChildren();
    payments.forEach(payment => {
        const card = billingElement('article', 'p-5');
        const top = billingElement('div', 'flex items-start justify-between gap-3');
        const value = billingElement('div');
        value.append(billingElement('p', 'text-xs font-semibold uppercase tracking-wider text-gray-500', 'Cobrança #' + payment.id), billingElement('p', 'mt-1 text-xl font-black text-gray-950', billingMoney(payment.amountCents)));
        top.append(value, billingStatusBadge(payment.status));
        const details = billingElement('div', 'my-4 grid grid-cols-2 gap-3 rounded-xl bg-stone-50 p-3 text-xs');
        const due = billingElement('div');
        due.append(billingElement('p', 'text-gray-500', 'Vencimento'), billingElement('p', 'mt-1 font-semibold text-gray-800', billingDate(payment.dueDate)));
        const provider = billingElement('div');
        provider.append(billingElement('p', 'text-gray-500', 'Provedor'), billingElement('p', 'mt-1 font-semibold text-gray-800', paymentProvider(payment.provider)));
        details.append(due, provider);
        card.append(top, details, receiptLink(payment));
        list.appendChild(card);
    });
}

function renderBilling() {
    const company = billingState.company || {};
    const subscription = billingState.subscription || {};
    const plan = billingState.plan || {};
    const payments = billingState.payments;
	const cycle = subscription.billingCycle || 'monthly';
	const amountCents = subscription.priceCents != null ? Number(subscription.priceCents) : Number(cycle === 'annual' ? plan.annualPriceCents : plan.monthlyPriceCents || 0);
    const status = subscription.status || 'active';

    document.getElementById('billing-plan-name').textContent = plan.name || 'Plano não informado';
    document.getElementById('billing-plan-description').textContent = plan.description || 'Consulte o administrador da plataforma para detalhes deste plano.';
    document.getElementById('billing-agent-limit').textContent = plan.agentLimit == null ? '-' : String(plan.agentLimit);
    document.getElementById('billing-connection-limit').textContent = plan.connectionLimit == null ? '-' : String(plan.connectionLimit);
	document.getElementById('billing-duration').textContent = subscription.durationDays == null ? (cycle === 'annual' ? '365' : '30') : String(subscription.durationDays);
	document.getElementById('billing-amount').textContent = billingMoney(amountCents);
	document.getElementById('billing-provider').textContent = paymentProvider(billingState.paymentProvider);
	document.getElementById('billing-monthly-price').textContent = billingMoney(plan.monthlyPriceCents || 0);
	document.getElementById('billing-annual-price').textContent = billingMoney(plan.annualPriceCents || 0);
	if (!billingState.selectedCycle) billingState.selectedCycle = cycle;
	renderBillingCycleOptions();
    document.getElementById('billing-company-name').textContent = company.name || 'Empresa';
    document.getElementById('billing-company-email').textContent = company.email || 'Email não informado';
    document.getElementById('billing-period-end').textContent = billingDate(subscription.currentPeriodEnd);
    document.getElementById('billing-period-start').textContent = subscription.currentPeriodStart ? 'Início: ' + billingDate(subscription.currentPeriodStart) : 'Início não informado';

    const statusBadge = document.getElementById('billing-status-badge');
    const statusStyles = { active: 'bg-emerald-400/20 text-emerald-200', trialing: 'bg-blue-400/20 text-blue-200', past_due: 'bg-amber-400/20 text-amber-200', canceled: 'bg-stone-400/20 text-stone-200', expired: 'bg-red-400/20 text-red-200' };
    statusBadge.className = 'rounded-full px-3 py-1 text-xs font-bold ' + (statusStyles[status] || statusStyles.canceled);
    statusBadge.textContent = billingStatusLabels[status] || status;

    const unpaid = payments.find(payment => payment.status === 'pending' || payment.status === 'processing');
    document.getElementById('billing-next-due').textContent = amountCents === 0 ? 'Sem cobrança' : billingDate(unpaid ? unpaid.dueDate : subscription.currentPeriodEnd);
    document.getElementById('billing-next-due-status').textContent = amountCents === 0 ? 'Plano gratuito' : (unpaid ? billingStatusLabels[unpaid.status] || unpaid.status : 'Fim do período atual');

    const checkout = document.getElementById('billing-checkout');
    const freeState = document.getElementById('billing-free-state');
    checkout.classList.toggle('hidden', amountCents === 0);
    freeState.classList.toggle('hidden', amountCents !== 0);

    document.getElementById('billing-payment-count').textContent = payments.length + (payments.length === 1 ? ' registro' : ' registros');
    document.getElementById('billing-payments-empty').classList.toggle('hidden', payments.length > 0);
    document.getElementById('billing-payments-table').classList.toggle('lg:block', payments.length > 0);
    document.getElementById('billing-empty-message').textContent = amountCents === 0 ? 'Planos gratuitos não geram cobranças.' : 'As próximas cobranças aparecerão aqui.';
    renderPaymentTable(payments);
    renderPaymentCards(payments);

    document.getElementById('billing-loading').classList.add('hidden');
    document.getElementById('billing-content').classList.remove('hidden');
}

function renderBillingCycleOptions() {
	const current = (billingState.subscription && billingState.subscription.billingCycle) || 'monthly';
	document.querySelectorAll('[data-billing-cycle]').forEach(button => {
		const selected = button.dataset.billingCycle === billingState.selectedCycle;
		button.className = 'billing-cycle-option flex items-center justify-between rounded-2xl border p-4 text-left transition ' + (selected ? 'border-purple-500 bg-purple-50 ring-2 ring-purple-100' : 'border-stone-200 hover:border-purple-300');
		const check = button.querySelector('.billing-cycle-check');
		check.className = 'billing-cycle-check grid h-7 w-7 place-items-center rounded-full border text-xs transition ' + (selected ? 'border-purple-600 bg-purple-600 text-white' : 'border-stone-300 text-transparent');
	});
	const hasOpenPayment = billingState.payments.some(payment => payment.status === 'pending' || payment.status === 'processing');
	document.getElementById('billing-save-cycle').disabled = hasOpenPayment || billingState.selectedCycle === current;
}

async function loadBilling() {
    const response = await billingAPI('GET', '/management/api/billing');
    const data = response && response.data ? response.data : {};
    billingState.company = data.company || null;
    billingState.subscription = data.subscription || null;
	billingState.plan = data.plan || null;
	billingState.payments = Array.isArray(data.payments) ? data.payments : [];
	billingState.paymentProvider = data.paymentProvider || null;
	billingState.selectedCycle = data.subscription && data.subscription.billingCycle ? data.subscription.billingCycle : 'monthly';
    renderBilling();
}

async function saveBillingCycle() {
	const button = document.getElementById('billing-save-cycle');
	button.disabled = true;
	try {
		await billingAPI('PUT', '/management/api/billing/cycle', { billingCycle: billingState.selectedCycle });
		showBillingToast('Ciclo de cobrança atualizado.');
		await loadBilling();
	} catch (error) { showBillingError(error); }
	finally { renderBillingCycleOptions(); }
}

async function startBillingCheckout() {
    const button = document.getElementById('billing-checkout');
    button.disabled = true;
    try {
        const response = await billingAPI('POST', '/management/api/billing/checkout');
        const data = response && response.data;
        const payment = data && (data.payment || data);
        const checkoutURL = payment && safeBillingCheckoutURL(payment.checkoutURL);
        if (checkoutURL) {
            window.open(checkoutURL, '_blank', 'noopener,noreferrer');
            showBillingToast('Checkout aberto em uma nova aba.');
            await loadBilling();
        } else {
            showBillingToast('Seu plano não possui cobrança pendente.');
        }
    } catch (error) { showBillingError(error); }
    finally { button.disabled = false; }
}

document.getElementById('billing-checkout').addEventListener('click', startBillingCheckout);
document.getElementById('billing-save-cycle').addEventListener('click', saveBillingCycle);
document.querySelectorAll('[data-billing-cycle]').forEach(button => button.addEventListener('click', () => { billingState.selectedCycle = button.dataset.billingCycle; renderBillingCycleOptions(); }));
document.getElementById('billing-refresh').addEventListener('click', () => loadBilling().catch(showBillingError));
document.getElementById('close-payment-banner').addEventListener('click', () => document.getElementById('payment-return-banner').classList.add('hidden'));
document.getElementById('close-billing-error').addEventListener('click', () => {
    const box = document.getElementById('billing-error');
    box.classList.add('hidden');
    box.classList.remove('flex');
});

configurePaymentReturnBanner();
loadBilling().catch(error => {
    document.getElementById('billing-loading').classList.add('hidden');
    showBillingError(error);
});
</script>
	}
}

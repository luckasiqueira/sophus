package web

func menuIsActive(activeMenus []string, menu string) bool {
    return len(activeMenus) > 0 && activeMenus[0] == menu
}

templ appSidebar(activeMenus ...string) {
	<nav id="app-navigation" aria-label="Navegação principal" class="relative z-40 flex w-full shrink-0 items-center gap-2 rounded-xl px-2 py-1.5 shadow-sm lg:z-auto lg:w-16 lg:flex-col lg:gap-4 lg:overflow-y-auto lg:rounded-2xl lg:px-0 lg:py-4" style="background: #6123cc;">
		<button id="app-menu-button" type="button" aria-label="Abrir menu" aria-controls="app-menu-links" aria-expanded="false" class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-white/20 bg-white/15 text-white shadow-sm transition hover:bg-white/25 active:scale-95 lg:hidden"><i class="fas fa-bars"></i></button>
		<a href="/messages" aria-label="Sophus, início" class="absolute left-1/2 flex -translate-x-1/2 items-center px-1 lg:hidden"><img src="/logos/Sophus_logo_horizontal_branco.svg" alt="Sophus" width="1120" height="256" class="h-7 w-auto"/></a>
		<div id="app-sidebar-header" class="hidden w-full shrink-0 flex-col items-center gap-2 lg:flex"><a href="/messages" aria-label="Início" class="flex shrink-0 items-center rounded-xl p-2 text-white transition-colors hover:bg-purple-700">@BrandSymbol(true, "app-sidebar-collapsed-only h-8 w-8")<img src="/logos/Sophus_logo_horizontal_branco.svg" alt="Sophus" width="1120" height="256" class="app-sidebar-expanded-only hidden h-7 w-auto"/></a><button id="app-sidebar-toggle" type="button" aria-label="Expandir menu lateral" title="Expandir menu lateral" aria-controls="app-menu-links" aria-expanded="false" class="grid h-9 w-9 shrink-0 place-items-center rounded-xl border border-white/20 bg-white/10 text-white transition hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"><i class="fas fa-angles-right" aria-hidden="true"></i></button></div>
		<div id="app-menu-links" class="absolute left-0 right-0 top-[calc(100%+0.5rem)] hidden max-h-[calc(100dvh-5rem)] flex flex-col gap-1 overflow-y-auto rounded-2xl border border-white/20 bg-[#4c1d95] p-2 shadow-2xl ring-1 ring-black/10 lg:static lg:flex lg:max-h-none lg:w-full lg:gap-3 lg:overflow-visible lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none lg:ring-0">
			<div class="flex items-center justify-between px-3 py-2 text-[10px] font-black uppercase tracking-[.18em] text-white/60 lg:hidden"><span>Navegação</span><i class="fas fa-compass text-white/70"></i></div>
			<a id="app-conversations-link" href="/messages" title="Conversas" class={ "relative flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "messages")) }><i class="fas fa-comment-dots w-5 text-center"></i><span class="lg:hidden">Conversas</span><span id="app-conversations-badge" class="absolute right-2 top-1/2 hidden min-w-5 -translate-y-1/2 rounded-full bg-[#25D366] px-1.5 py-0.5 text-center text-[9px] font-black text-white ring-2 ring-purple-800 lg:-right-1 lg:-top-1 lg:translate-y-0"></span></a>
			<a href="/contacts" title="Contatos" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "contacts")) }><i class="fas fa-address-book w-5 text-center"></i><span class="lg:hidden">Contatos</span></a>
			<a href="/flows/" title="Flows" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "flows")) }><i class="fas fa-diagram-project w-5 text-center"></i><span class="lg:hidden">Flows</span></a>
			<a href="/ai-agents" title="Agentes de IA" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "ai-agents")) }><i class="fas fa-brain w-5 text-center"></i><span class="lg:hidden">Agentes de IA</span></a>
			<a href="/departments" title="Setores" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "departments")) }><i class="fas fa-layer-group w-5 text-center"></i><span class="lg:hidden">Setores</span></a>
			<a href="/agents" title="Agentes" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "agents")) }><i class="fas fa-user w-5 text-center"></i><span class="lg:hidden">Agentes</span></a>
			<a href="/instances/" title="Instâncias" class={ "relative flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "instances")) }><i class="fas fa-circle-notch w-5 text-center"></i><span class="lg:hidden">Instâncias</span><span class="absolute right-2 top-2 h-2 w-2 rounded-full border-2 bg-blue-400 lg:right-2 lg:top-2" style="border-color: #6123cc;"></span></a>
			<a href="/quick-replies" title="Respostas rápidas" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "quick-replies")) }><i class="fas fa-bolt w-5 text-center"></i><span class="lg:hidden">Respostas rápidas</span></a>
			<a href="/media" title="Biblioteca de mídia" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "media")) }><i class="fas fa-photo-film w-5 text-center"></i><span class="lg:hidden">Biblioteca de mídia</span></a>
			<a href="/reports" title="Relatórios" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "reports")) }><i class="fas fa-chart-column w-5 text-center"></i><span class="lg:hidden">Relatórios</span></a>
			<a href="/settings" title="Configurações da empresa" class={ "flex items-center gap-3 rounded-xl p-3 text-white transition-all hover:bg-white/20 lg:justify-center lg:rounded-2xl", templ.KV("bg-white/20 shadow-md", menuIsActive(activeMenus, "settings")) }><i class="fas fa-gear w-5 text-center"></i><span class="lg:hidden">Configurações</span></a>
		</div>
		<div class="hidden flex-1 lg:block"></div>
		<div id="app-sidebar-footer" class="ml-auto flex shrink-0 items-center lg:ml-0 lg:flex-col lg:gap-3"><button id="app-notification-center-button" type="button" title="Central de notificações" aria-label="Abrir central de notificações" aria-expanded="false" class="relative flex items-center gap-3 rounded-xl p-3 transition-colors hover:bg-white hover:bg-opacity-20 lg:rounded-2xl"><i class="fas fa-bell text-white"></i><span class="app-sidebar-expanded-only hidden text-sm text-white">Notificações</span><span id="app-notification-center-badge" class="absolute -right-1 -top-1 hidden min-w-5 rounded-full bg-[#25D366] px-1.5 py-0.5 text-center text-[9px] font-black text-white ring-2 ring-purple-800"></span></button>@AvatarMenu()</div>
	</nav>
}

templ base(activeMenus ...string) {
<!DOCTYPE html>
<html lang="pt-BR">
<head>
	@AgentPreferencesRuntime()
	@MessagePreferences()
	<script>
		try { document.documentElement.dataset.sidebarExpanded = localStorage.getItem('sophus-sidebar-expanded') === 'true' ? 'true' : 'false'; }
		catch (_) { document.documentElement.dataset.sidebarExpanded = 'false'; }
	</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sophus | Workspace de atendimento</title>
	@BrandIcons()
	@MobileActionStyles()
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4" integrity="sha384-A986SAtodyH8eg8x8irJnYUk7i9inVQqYigD6qZ9evobksGNIXfeFvDwLSHcp31N" crossorigin="anonymous"></script>
	<style>
		@media (min-width: 1024px) {
			html { --app-sidebar-width: 4rem; }
			html[data-sidebar-expanded="true"] { --app-sidebar-width: 15rem; }
			#app-navigation { width: var(--app-sidebar-width); transition: width .2s ease; }
			#app-notification-panel, #app-user-menu > div { left: calc(var(--app-sidebar-width) + 2rem); }
			html[data-sidebar-expanded="true"] #app-sidebar-header { flex-direction: row; justify-content: space-between; padding: 0 .75rem; }
			html[data-sidebar-expanded="true"] .app-sidebar-expanded-only { display: inline; }
			html[data-sidebar-expanded="true"] .app-sidebar-collapsed-only { display: none; }
			html[data-sidebar-expanded="true"] #app-menu-links { padding: 0 .5rem; gap: .25rem; }
			html[data-sidebar-expanded="true"] #app-menu-links > a { justify-content: flex-start; border-radius: .75rem; min-height: 2.75rem; }
			html[data-sidebar-expanded="true"] #app-menu-links > a > span.lg\:hidden { display: inline; font-size: .875rem; white-space: nowrap; }
			html[data-sidebar-expanded="true"] #app-menu-links > a > i { flex-shrink: 0; }
			html[data-sidebar-expanded="true"] #app-conversations-badge { position: static; margin-left: auto; transform: none; }
			html[data-sidebar-expanded="true"] #app-sidebar-footer { width: 100%; flex-direction: row; justify-content: space-between; padding: 0 .75rem; }
		}
		@media (prefers-reduced-motion: reduce) { #app-navigation { transition: none; } }
		@media (max-width: 1023px) {
			.app-shell { height: 100dvh; flex-direction: column; padding: max(0.5rem, env(safe-area-inset-top)) 0.5rem max(0.5rem, env(safe-area-inset-bottom)); gap: 0.5rem; }
			.app-shell > :not(nav) { min-width: 0; }
		}
	</style>

</head>
<body class="fixed inset-0 flex flex-col overflow-hidden bg-stone-100">
	@SupportSessionBanner()
    <div class="app-shell flex flex-1 min-h-0 min-w-0 gap-3 p-3">
		@appSidebar(activeMenus...)
        { children... }
    </div>
	<div id="app-notification-stack" class="pointer-events-none fixed bottom-5 right-5 z-[120] flex w-[min(24rem,calc(100vw-2rem))] flex-col gap-3" aria-live="polite"></div>
	<aside id="app-notification-panel" class="fixed left-2 right-2 top-16 z-[125] hidden max-h-[calc(100dvh-5rem)] overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-2xl sm:left-auto sm:right-4 sm:w-[22rem] lg:bottom-4 lg:left-24 lg:right-auto lg:top-auto lg:max-h-[calc(100vh-2rem)]" aria-label="Central de notificações">
		<header class="flex items-center justify-between border-b border-stone-100 bg-stone-50 px-4 py-3"><div><p class="text-[10px] font-black uppercase tracking-[.18em] text-purple-600">Tempo real</p><h2 class="text-sm font-black text-gray-950">Notificações</h2></div><div class="flex items-center gap-1"><a href="/preferences#notifications" class="grid h-8 w-8 place-items-center rounded-lg text-gray-400 hover:bg-stone-200 hover:text-purple-600" aria-label="Configurar notificações"><i class="fas fa-sliders"></i></a><button id="app-notification-panel-close" type="button" class="grid h-8 w-8 place-items-center rounded-lg text-gray-400 hover:bg-stone-200" aria-label="Fechar notificações"><i class="fas fa-xmark"></i></button></div></header>
		<div id="app-notification-panel-empty" class="px-5 py-8 text-center"><span class="mx-auto grid h-11 w-11 place-items-center rounded-2xl bg-purple-50 text-purple-500"><i class="far fa-bell"></i></span><p class="mt-3 text-xs font-bold text-gray-700">Nenhuma notificação recente</p></div>
		<div id="app-notification-panel-list" class="max-h-80 divide-y divide-stone-100 overflow-y-auto"></div>
	</aside>
	@RemovalConfirmation()
	@AppNotice()
	@AppToast()
	<script>
		(function () {
			if (window.appConversationEvents) window.appConversationEvents.close();
			const events = new EventSource('/sse/conversations');
			const badge = document.getElementById('app-conversations-badge');
			const menuButton = document.getElementById('app-menu-button');
			const menu = document.getElementById('app-menu-links');
			const navigation = document.getElementById('app-navigation');
			const sidebarToggle = document.getElementById('app-sidebar-toggle');
			function updateSidebarToggle() {
				const expanded = document.documentElement.dataset.sidebarExpanded === 'true';
				const label = expanded ? 'Retrair menu lateral' : 'Expandir menu lateral';
				sidebarToggle.setAttribute('aria-expanded', String(expanded)); sidebarToggle.setAttribute('aria-label', label); sidebarToggle.title = label;
				sidebarToggle.querySelector('i').className = expanded ? 'fas fa-angles-left' : 'fas fa-angles-right';
			}
			sidebarToggle.addEventListener('click', () => {
				const expanded = document.documentElement.dataset.sidebarExpanded !== 'true';
				document.documentElement.dataset.sidebarExpanded = String(expanded);
				try { localStorage.setItem('sophus-sidebar-expanded', String(expanded)); } catch (_) {}
				updateSidebarToggle();
			});
			updateSidebarToggle();
			const centerButton = document.getElementById('app-notification-center-button');
			const centerBadge = document.getElementById('app-notification-center-badge');
			const panel = document.getElementById('app-notification-panel');
			const panelList = document.getElementById('app-notification-panel-list');
			const panelEmpty = document.getElementById('app-notification-panel-empty');
			const permissionButton = document.getElementById('app-notification-permission');
			const defaultSettings = { toast: true, sound: true, browser: true, preview: true, groups: true };
			let notificationSettings = { ...defaultSettings, ...window.agentPreferences.notifications };
			const baseTitle = document.title;
			let refreshTimer;
			const unseenConversations = new Set();
			const conversationSequences = new Map();
			let notificationSequence = 0;
			let latestToastSequence = 0;
			function refreshSidebar() { clearTimeout(refreshTimer); refreshTimer = setTimeout(function () { const sidebar = document.getElementById('conversation-sidebar'); if (sidebar && window.htmx) htmx.ajax('GET', sidebar.dataset.refreshUrl, { source: sidebar, target: '#conversation-sidebar', swap: 'outerHTML' }); }, 100); }
			window.refreshConversationSidebar = refreshSidebar;
			function notificationColor(data) { return /^#[0-9a-f]{6}$/i.test(data.departmentColor || '') ? data.departmentColor : '#7e22ce'; }
			function updatePermissionButton() { if (!permissionButton) return; const dot = permissionButton.querySelector('[data-permission-dot]'); const label = permissionButton.querySelector('[data-permission-label]'); const supported = 'Notification' in window; const granted = supported && Notification.permission === 'granted'; const denied = supported && Notification.permission === 'denied'; dot.className = 'h-2 w-2 rounded-full ' + (granted && notificationSettings.browser ? 'bg-emerald-500' : denied ? 'bg-red-500' : 'bg-amber-400'); label.textContent = !notificationSettings.browser ? 'Notificações do navegador desativadas' : granted ? 'Notificações do navegador ativadas' : denied ? 'Permissão bloqueada no navegador' : supported ? 'Ativar notificações do navegador' : 'Navegador sem suporte'; permissionButton.disabled = !supported || !notificationSettings.browser || denied; }
			function loadNotificationPreferences() {
				notificationSettings = { ...defaultSettings, ...window.agentPreferences.notifications };
				syncNotificationSettings();
				panelList.querySelectorAll('[data-notification-preview]').forEach(item => { item.textContent = notificationSettings.preview ? item.dataset.messagePreview : 'Nova mensagem'; });
				if (!notificationSettings.groups) { panelList.querySelectorAll('[data-group="true"]').forEach(item => item.remove()); panelEmpty.classList.toggle('hidden', panelList.children.length > 0); clearUnseenConversations(); }
			}
			window.addEventListener('agent-preferences-changed', loadNotificationPreferences);
			window.agentPreferencesReady.then(loadNotificationPreferences);
			function syncNotificationSettings() { document.querySelectorAll('[data-notification-setting]').forEach(input => { input.checked = Boolean(notificationSettings[input.dataset.notificationSetting]); }); updatePermissionButton(); }
			function displayNotificationData(data) { return notificationSettings.preview ? data : { ...data, preview: 'Nova mensagem' }; }
			let audioContext;
			function notificationAudioContext() { if (!audioContext) { const AudioContext = window.AudioContext || window.webkitAudioContext; if (AudioContext) audioContext = new AudioContext(); } return audioContext; }
			function playNotificationSound(force) { if (!force && !notificationSettings.sound) return; const context = notificationAudioContext(); if (!context) return; if (context.state === 'suspended') context.resume().catch(() => {}); const start = context.currentTime; [[880, start], [1174, start + 0.11]].forEach(([frequency, time]) => { const oscillator = context.createOscillator(); const gain = context.createGain(); oscillator.type = 'sine'; oscillator.frequency.setValueAtTime(frequency, time); gain.gain.setValueAtTime(0.0001, time); gain.gain.exponentialRampToValueAtTime(0.12, time + 0.012); gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.1); oscillator.connect(gain).connect(context.destination); oscillator.start(time); oscillator.stop(time + 0.11); }); }
			function markConversationUnseen(conversation) { unseenConversations.add(conversation); const count = unseenConversations.size; const label = count > 99 ? '99+' : String(count); badge.textContent = label; centerBadge.textContent = label; badge.classList.remove('hidden'); centerBadge.classList.remove('hidden'); document.title = '(' + count + ') ' + baseTitle; }
			function clearUnseenConversations() { unseenConversations.clear(); centerBadge.classList.add('hidden'); badge.classList.add('hidden'); document.title = baseTitle; }
			function showToast(data) { const color = notificationColor(data); const link = document.createElement('a'); link.href = '/messages/' + encodeURIComponent(data.conversation); link.className = 'pointer-events-auto flex items-start gap-3 rounded-2xl border border-stone-200 border-l-[6px] bg-white p-4 text-left shadow-2xl transition hover:-translate-y-0.5 hover:shadow-xl'; link.style.borderLeftColor = color; const icon = document.createElement('span'); icon.className = 'grid h-10 w-10 shrink-0 place-items-center rounded-xl'; icon.style.color = color; icon.style.backgroundColor = color + '18'; icon.innerHTML = '<i class="fas fa-comment-dots"><\/i>'; const content = document.createElement('span'); content.className = 'min-w-0 flex-1'; const meta = document.createElement('span'); meta.className = 'mb-0.5 block truncate text-[10px] font-black uppercase tracking-wide'; meta.style.color = color; meta.textContent = data.department || 'Sem setor'; const title = document.createElement('strong'); title.className = 'block truncate text-sm text-gray-950'; title.textContent = data.contact || 'Nova mensagem'; const preview = document.createElement('span'); preview.className = 'mt-1 block truncate text-xs text-gray-500'; preview.textContent = data.preview || 'Nova mensagem'; content.append(meta, title, preview); link.append(icon, content); document.getElementById('app-notification-stack').replaceChildren(link); setTimeout(() => link.remove(), 7000); }
			function addPanelItem(data, sequence) { const color = notificationColor(data); const link = document.createElement('a'); link.href = '/messages/' + encodeURIComponent(data.conversation); link.dataset.conversation = data.conversation; link.dataset.sequence = String(sequence); link.dataset.group = String(Boolean(data.isGroup)); link.className = 'flex items-start gap-3 px-4 py-3 transition hover:bg-stone-50'; const dot = document.createElement('span'); dot.className = 'mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full'; dot.style.backgroundColor = color; const content = document.createElement('span'); content.className = 'min-w-0 flex-1'; const row = document.createElement('span'); row.className = 'flex items-center justify-between gap-2'; const title = document.createElement('strong'); title.className = 'truncate text-xs text-gray-900'; title.textContent = data.contact || 'Nova mensagem'; const department = document.createElement('span'); department.className = 'shrink-0 text-[9px] font-bold'; department.style.color = color; department.textContent = data.department || 'Sem setor'; const preview = document.createElement('span'); preview.className = 'mt-1 block truncate text-[11px] text-gray-500'; preview.dataset.notificationPreview = ''; preview.dataset.messagePreview = data.preview || 'Nova mensagem'; preview.textContent = notificationSettings.preview ? preview.dataset.messagePreview : 'Nova mensagem'; row.append(title, department); content.append(row, preview); link.append(dot, content); const existing = Array.from(panelList.children).find(item => item.dataset.conversation === data.conversation); if (existing) existing.remove(); const nextItem = Array.from(panelList.children).find(item => Number(item.dataset.sequence) < sequence); panelList.insertBefore(link, nextItem || null); panelEmpty.classList.add('hidden'); while (panelList.children.length > 10) panelList.lastElementChild.remove(); }
			function setMenuOpen(open) { menu.classList.toggle('hidden', !open); menuButton.setAttribute('aria-expanded', String(open)); menuButton.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu'); menuButton.querySelector('i').className = open ? 'fas fa-xmark' : 'fas fa-bars'; }
			function setPanelVisible(visible) { panel.classList.toggle('hidden', !visible); centerButton.setAttribute('aria-expanded', visible ? 'true' : 'false'); if (visible) clearUnseenConversations(); }
			events.addEventListener('conversation', refreshSidebar);
			events.addEventListener('incoming-message', async function (event) {
				if (!await window.agentPreferencesReady) return;
				let signal; try { signal = JSON.parse(event.data); } catch (_) { return; }
				const current = location.pathname === '/messages/' + signal.conversation;
				if (current && document.visibilityState === 'visible' && document.hasFocus()) return;
				const dedupeKey = 'sophus-notification-' + signal.messageId;
				const seen = Number(localStorage.getItem(dedupeKey) || 0);
				if (Date.now() - seen < 10000) return;
				localStorage.setItem(dedupeKey, String(Date.now()));
				const sequence = ++notificationSequence; conversationSequences.set(signal.conversation, sequence);
				try {
					const response = await fetch('/messages/' + encodeURIComponent(signal.conversation) + '/notification?message=' + encodeURIComponent(signal.messageId), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
					if (!response.ok) return;
					const payload = await response.json(); const data = payload.data || {};
					if (conversationSequences.get(signal.conversation) !== sequence || (data.isGroup && !notificationSettings.groups)) return;
					const displayData = displayNotificationData(data);
					if (sequence > latestToastSequence) { latestToastSequence = sequence; if (notificationSettings.toast) showToast(displayData); }
					addPanelItem(data, sequence); playNotificationSound();
					if (panel.classList.contains('hidden')) markConversationUnseen(data.conversation);
					if (notificationSettings.browser && 'Notification' in window && Notification.permission === 'granted' && (document.visibilityState !== 'visible' || !document.hasFocus())) {
						const browserNotification = new window.Notification(data.contact || 'Nova mensagem', { body: (data.department ? data.department + ' · ' : '') + (displayData.preview || 'Nova mensagem'), tag: 'conversation-' + data.conversation });
						browserNotification.onclick = function () { window.focus(); location.href = '/messages/' + data.conversation; browserNotification.close(); };
					}
				} catch (_) {}
			});
			if (permissionButton) permissionButton.addEventListener('click', async function () { if ('Notification' in window && Notification.permission === 'default') await Notification.requestPermission(); updatePermissionButton(); });
			const soundTestButton = document.getElementById('app-notification-sound-test');
			if (soundTestButton) soundTestButton.addEventListener('click', function () { playNotificationSound(true); });
			menuButton.addEventListener('click', function () { const open = menu.classList.contains('hidden'); if (open) setPanelVisible(false); setMenuOpen(open); });
			menu.addEventListener('click', function (event) { if (event.target.closest('a')) setMenuOpen(false); });
			centerButton.addEventListener('click', function () { setMenuOpen(false); setPanelVisible(panel.classList.contains('hidden')); });
			document.getElementById('app-notification-panel-close').addEventListener('click', function () { setPanelVisible(false); });
			document.addEventListener('click', function (event) { if (!menu.classList.contains('hidden') && !navigation.contains(event.target)) setMenuOpen(false); if (!panel.classList.contains('hidden') && !panel.contains(event.target) && !centerButton.contains(event.target)) setPanelVisible(false); });
			document.addEventListener('keydown', function (event) { if (event.key === 'Escape') { if (!menu.classList.contains('hidden')) { setMenuOpen(false); menuButton.focus(); } setPanelVisible(false); } });
			window.addEventListener('resize', function () { if (window.innerWidth >= 1024 && !menu.classList.contains('hidden')) setMenuOpen(false); });
			document.getElementById('app-conversations-link').addEventListener('click', clearUnseenConversations);
			document.addEventListener('pointerdown', function () { const context = notificationAudioContext(); if (context && context.state === 'suspended') context.resume().catch(() => {}); }, { once: true });
			syncNotificationSettings();
			window.appConversationEvents = events;
		})();
	</script>
	@ContactAvatarRuntime()
	@AdminControls()
	@ReportCalendars("")
	@GuidedOnboarding()
</body>
</html>
}

package web

templ StressTestPanel() {
	<section id="stress-panel" class="hidden">
		<div class="mb-5"><p class="text-xs font-bold uppercase tracking-widest text-purple-600">Desempenho</p><h2 class="mt-2 text-2xl font-black text-gray-950">Teste de estresse</h2><p class="mt-1 text-sm text-gray-500">Gere volume de dados, simule agentes e instâncias online, acompanhe o consumo de hardware e reverta tudo ao final.</p></div>
		<div class="mb-5 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800"><i class="fas fa-triangle-exclamation mt-0.5"></i><p>Os dados de teste são gravados no banco da empresa escolhida e nada é enviado ao WhatsApp. Agentes e instâncias simulados ficam visíveis para a empresa durante o teste; use “Reverter teste” ao terminar.</p></div>
		<div id="stress-form-error" role="alert" class="mb-5 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
		<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
			<label for="stress-company-filter" class="mb-2 block text-sm font-semibold text-gray-700">Empresa alvo</label>
			<div class="relative grid grid-cols-1 gap-2 md:grid-cols-[minmax(0,320px)_minmax(0,1fr)]">
				<label class="relative block"><i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-400"></i><input id="stress-company-filter" type="search" placeholder="Filtrar por nome, email ou ID" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-3 pl-10 pr-3 text-sm outline-none focus:border-purple-400 focus:bg-white focus:ring-2 focus:ring-purple-100"/></label>
				<select id="stress-company" aria-label="Empresas encontradas" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></select>
			</div>
			<p id="stress-company-count" class="mt-1 text-xs text-gray-500"></p>
		</div>
		<div class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-2">
			<form id="stress-form" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
				<div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-purple-100 text-purple-700"><i class="fas fa-database"></i></span><div><h3 class="font-black text-gray-950">Gerar mensagens</h3><p class="mt-1 text-xs text-gray-500">Cria um contato fictício com uma conversa aberta e o volume de mensagens informado.</p></div></div>
				<div class="mt-5 space-y-4">
					<div class="relative"><label for="stress-agent" class="mb-2 block text-sm font-semibold text-gray-700">Usuário responsável pela conversa</label><select id="stress-agent" disabled class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100 disabled:bg-stone-50 disabled:text-gray-400"><option value="">Selecione uma empresa</option></select></div>
					<div><label for="stress-count" class="mb-2 block text-sm font-semibold text-gray-700">Quantidade de mensagens</label><input id="stress-count" type="number" min="1" max="1000000" step="1" value="1000" class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><div class="mt-2 flex flex-wrap gap-2"><button type="button" data-stress-count="1000" class="rounded-lg border border-stone-200 px-3 py-1.5 text-xs font-semibold text-gray-600 hover:bg-stone-50">1 mil</button><button type="button" data-stress-count="10000" class="rounded-lg border border-stone-200 px-3 py-1.5 text-xs font-semibold text-gray-600 hover:bg-stone-50">10 mil</button><button type="button" data-stress-count="100000" class="rounded-lg border border-stone-200 px-3 py-1.5 text-xs font-semibold text-gray-600 hover:bg-stone-50">100 mil</button><button type="button" data-stress-count="500000" class="rounded-lg border border-stone-200 px-3 py-1.5 text-xs font-semibold text-gray-600 hover:bg-stone-50">500 mil</button><button type="button" data-stress-count="1000000" class="rounded-lg border border-stone-200 px-3 py-1.5 text-xs font-semibold text-gray-600 hover:bg-stone-50">1 milhão</button></div><p class="mt-2 text-xs text-gray-500">Até 1.000.000 por execução, em lotes de 5.000, alternando contato e usuário a cada 30 segundos.</p></div>
				</div>
				<div class="mt-5 flex justify-end"><button id="stress-submit" type="submit" class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-md disabled:cursor-not-allowed disabled:opacity-60" style="background: linear-gradient(to right, #3b82f6, #6123cc);"><i class="fas fa-bolt"></i> Gerar mensagens</button></div>
			</form>
			<form id="stress-sim-form" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
				<div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-blue-100 text-blue-700"><i class="fas fa-users-gear"></i></span><div><h3 class="font-black text-gray-950">Simular agentes e instâncias online</h3><p class="mt-1 text-xs text-gray-500">Agentes virtuais navegam pelo sistema com SSE aberto; instâncias simuladas recebem mensagens pelo webhook, como o Evolution GO faria.</p></div></div>
				<div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div><label for="stress-sim-agents" class="mb-2 block text-sm font-semibold text-gray-700">Agentes online</label><input id="stress-sim-agents" type="number" min="0" max="500" step="1" value="20" class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
					<div><label for="stress-sim-instances" class="mb-2 block text-sm font-semibold text-gray-700">Instâncias online</label><input id="stress-sim-instances" type="number" min="0" max="200" step="1" value="5" class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
					<div><label for="stress-sim-rate" class="mb-2 block text-sm font-semibold text-gray-700">Mensagens por minuto, por instância</label><input id="stress-sim-rate" type="number" min="1" max="600" step="1" value="30" class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
					<div><label for="stress-sim-interval" class="mb-2 block text-sm font-semibold text-gray-700">Ação de cada agente a cada (s)</label><input id="stress-sim-interval" type="number" min="2" max="300" step="1" value="15" class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
					<div><label for="stress-sim-duration" class="mb-2 block text-sm font-semibold text-gray-700">Duração (minutos)</label><input id="stress-sim-duration" type="number" min="1" max="240" step="1" value="10" class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
					<p id="stress-sim-estimate" class="self-end text-xs text-gray-500"></p>
				</div>
				<div class="mt-5 flex flex-wrap justify-end gap-3"><button id="stress-sim-stop" type="button" class="hidden rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-semibold text-red-700 hover:bg-red-100">Parar simulação</button><button id="stress-sim-submit" type="submit" class="inline-flex items-center gap-2 rounded-xl bg-gray-950 px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-gray-800 disabled:cursor-not-allowed disabled:opacity-60"><i class="fas fa-play"></i> Iniciar simulação</button></div>
			</form>
		</div>
		<div class="mt-5 grid grid-cols-1 gap-5 lg:grid-cols-2">
			<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
				<h3 class="font-bold text-gray-950">Execução de dados</h3>
				<p id="stress-job-empty" class="mt-3 text-sm text-gray-500">Nenhuma geração ou remoção desde que o servidor foi iniciado.</p>
				<div id="stress-job" class="mt-4 hidden">
					<div class="flex items-center justify-between gap-3"><p id="stress-job-title" class="text-sm font-semibold text-gray-800"></p><span id="stress-job-status" class="rounded-full px-2.5 py-1 text-[11px] font-bold"></span></div>
					<div class="mt-3 h-2.5 overflow-hidden rounded-full bg-purple-100" role="progressbar" aria-label="Progresso" aria-valuemin="0" aria-valuemax="100"><div id="stress-job-bar" class="h-full rounded-full bg-purple-700 transition-all" style="width:0%"></div></div>
					<p id="stress-job-progress" class="mt-2 text-xs text-gray-500"></p>
					<dl id="stress-job-details" class="mt-4 space-y-2 text-xs"></dl>
					<p id="stress-job-error" class="mt-3 hidden rounded-xl bg-red-50 p-3 text-xs text-red-700"></p>
					<button id="stress-cancel" type="button" class="mt-4 hidden w-full rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100">Interromper</button>
				</div>
			</article>
			<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
				<h3 class="font-bold text-gray-950">Simulação</h3>
				<p id="stress-sim-empty" class="mt-3 text-sm text-gray-500">Nenhuma simulação desde que o servidor foi iniciado.</p>
				<div id="stress-sim" class="mt-4 hidden">
					<div class="flex items-center justify-between gap-3"><p id="stress-sim-title" class="text-sm font-semibold text-gray-800"></p><span id="stress-sim-status" class="rounded-full px-2.5 py-1 text-[11px] font-bold"></span></div>
					<div class="mt-3 h-2.5 overflow-hidden rounded-full bg-blue-100" role="progressbar" aria-label="Tempo decorrido" aria-valuemin="0" aria-valuemax="100"><div id="stress-sim-bar" class="h-full rounded-full bg-blue-700 transition-all" style="width:0%"></div></div>
					<dl id="stress-sim-details" class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-xs"></dl>
					<p id="stress-sim-error" class="mt-3 hidden rounded-xl bg-amber-50 p-3 text-xs text-amber-800"></p>
				</div>
			</article>
		</div>
		<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="stress-traffic-title">
			<div class="flex flex-wrap items-start justify-between gap-3"><div><h3 id="stress-traffic-title" class="font-bold text-gray-950">Tráfego da simulação</h3><p class="mt-1 text-xs text-gray-500">Requisições feitas pelos agentes virtuais e mensagens entregues pelas instâncias simuladas.</p></div><button type="button" data-open-monitor class="rounded-xl border border-stone-200 px-3 py-2 text-xs font-semibold text-gray-600 hover:bg-stone-50"><i class="fas fa-chart-line mr-1"></i> Ver consumo de hardware</button></div>
			<div id="stress-tiles" class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-3"></div>
			<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
				<figure><figcaption class="mb-2 text-xs font-semibold text-gray-600">Requisições simuladas por segundo</figcaption><div class="sophus-chart" data-chart="stress-requests" data-unit=" req/s"></div></figure>
				<figure><figcaption class="mb-2 text-xs font-semibold text-gray-600">Latência p95 das requisições simuladas (ms)</figcaption><div class="sophus-chart" data-chart="stress-latency" data-unit=" ms"></div></figure>
			</div>
			<p class="mt-4 text-xs leading-relaxed text-gray-500">O consumo de CPU, memória e banco durante o teste aparece em Monitoramento. O Evolution GO não é exercitado: instâncias simuladas não abrem sessão no WhatsApp.</p>
		</section>
		<section class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
			<div class="flex flex-wrap items-start justify-between gap-3 border-b border-stone-200 p-5">
				<div><h3 class="font-bold text-gray-950">Dados de teste</h3><p id="stress-contacts-caption" class="mt-1 text-sm text-gray-500">Selecione uma empresa para ver os dados gerados.</p></div>
				<div class="flex flex-wrap items-center gap-3"><label class="flex items-center gap-2 text-xs font-semibold text-gray-600"><input id="stress-revert-all" type="checkbox" class="h-4 w-4 rounded border-stone-300"/> Todas as empresas</label><button id="stress-contacts-refresh" type="button" class="rounded-xl border border-stone-200 px-3 py-2 text-sm text-gray-600 hover:bg-stone-50" aria-label="Atualizar dados de teste"><i class="fas fa-rotate"></i></button><button id="stress-revert" type="button" class="inline-flex items-center gap-2 rounded-xl bg-red-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50"><i class="fas fa-rotate-left"></i> Reverter teste</button></div>
			</div>
			<dl id="stress-summary" class="grid grid-cols-2 gap-px bg-stone-100 sm:grid-cols-3 lg:grid-cols-6"></dl>
			<div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="bg-stone-50 text-xs text-gray-500"><tr><th class="p-3">Contato fictício</th><th class="p-3">Protocolo</th><th class="p-3">Usuário</th><th class="p-3">Mensagens</th><th class="p-3">Criado em</th><th class="p-3 text-right">Ações</th></tr></thead><tbody id="stress-contacts" class="divide-y divide-stone-100"></tbody></table><p id="stress-contacts-empty" class="hidden p-6 text-center text-sm text-gray-500">Nenhum contato de mensagens geradas nesta empresa.</p></div>
		</section>
	</section>
	<script>
	(() => {
		const API = '/management/api/stress-test';
		const stress = { agentsCompany: 0, samples: [], lastSample: 0, timer: null, jobStatus: '', simRunning: false };
		const $ = id => document.getElementById(id);
		const number = (value, digits) => new Intl.NumberFormat('pt-BR', { maximumFractionDigits: digits || 0, minimumFractionDigits: digits || 0 }).format(value || 0);
		async function stressAPI(method, url, body) {
			const options = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } };
			if (body !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); }
			const response = await fetch(url, options);
			let payload = null; try { payload = await response.json(); } catch (_) {}
			if (response.status === 401) { window.location.href = '/login'; throw new Error('Sessão expirada.'); }
			if (!response.ok) throw new Error((payload && payload.error) || 'Erro ' + response.status);
			return payload;
		}
		function companies() { return typeof saasState !== 'undefined' && Array.isArray(saasState.companies) ? saasState.companies : []; }
		function companyName(id) { if (!id) return 'Todas as empresas'; const company = companies().find(c => c.id === id); return company ? company.name : '#' + id; }
		function selectedCompany() { return Number($('stress-company').value) || 0; }
		function showStressError(error) { const box = $('stress-form-error'); box.textContent = error instanceof Error ? error.message : String(error); box.classList.remove('hidden'); }
		function clearStressError() { $('stress-form-error').classList.add('hidden'); }
		function detailRows(target, rows) {
			target.replaceChildren(...rows.map(([term, value]) => { const row = document.createElement('div'); row.className = 'flex justify-between gap-3'; const dt = document.createElement('dt'); dt.className = 'text-gray-500'; dt.textContent = term; const dd = document.createElement('dd'); dd.className = 'text-right font-semibold text-gray-800'; dd.textContent = value; row.append(dt, dd); return row; }));
		}
		function badge(element, status) {
			const labels = { running: ['Em execução', 'bg-blue-100 text-blue-700'], completed: ['Concluído', 'bg-emerald-100 text-emerald-700'], failed: ['Falhou', 'bg-red-100 text-red-700'], canceled: ['Interrompido', 'bg-amber-100 text-amber-700'], finished: ['Encerrada', 'bg-stone-100 text-gray-700'] };
			const [label, style] = labels[status] || [status, 'bg-stone-100 text-gray-700'];
			element.textContent = label; element.className = 'rounded-full px-2.5 py-1 text-[11px] font-bold ' + style;
		}
		function duration(seconds) { seconds = Math.max(0, Math.round(seconds)); return seconds < 60 ? seconds + ' s' : Math.floor(seconds * (1 / 60)) + ' min ' + (seconds % 60) + ' s'; }

		function renderCompanyOptions() {
			const select = $('stress-company'); const current = select.value;
			const term = $('stress-company-filter').value.trim().toLowerCase();
			const list = companies().filter(c => !term || String(c.id) === term || (c.name || '').toLowerCase().includes(term) || (c.email || '').toLowerCase().includes(term));
			select.replaceChildren(new Option(list.length ? 'Selecione a empresa' : 'Nenhuma empresa encontrada', ''), ...list.map(c => new Option(c.name + ' · ' + c.email + ' · #' + c.id, String(c.id))));
			if (list.some(c => String(c.id) === current)) select.value = current;
			else if (list.length === 1) select.value = String(list[0].id);
			$('stress-company-count').textContent = list.length + ' de ' + companies().length + ' empresas';
			companyChanged();
		}
		async function companyChanged() {
			const companyId = selectedCompany();
			if (companyId === stress.agentsCompany) return;
			stress.agentsCompany = companyId;
			const agents = $('stress-agent'); agents.disabled = true;
			agents.replaceChildren(new Option(companyId ? 'Carregando usuários...' : 'Selecione uma empresa', ''));
			loadTestData();
			if (!companyId) return;
			try {
				const payload = await stressAPI('GET', API + '/companies/' + companyId + '/agents');
				if (stress.agentsCompany !== companyId) return;
				const list = (payload.data || []).filter(a => !(a.email || '').endsWith('@stress.invalid'));
				agents.replaceChildren(new Option(list.length ? 'Selecione o usuário' : 'Empresa sem usuários', ''), ...list.map(a => new Option(a.name + ' · ' + a.email + ' · ' + (a.role === 'admin' ? 'Administrador' : 'Agente') + (a.isActive ? '' : ' · inativo'), String(a.id))));
				agents.disabled = list.length === 0;
			} catch (error) { agents.replaceChildren(new Option('Falha ao carregar usuários', '')); showStressError(error); }
		}
		function revertScope() { return $('stress-revert-all').checked ? 0 : selectedCompany(); }
		function hasScope() { return $('stress-revert-all').checked || selectedCompany() > 0; }
		async function loadTestData() {
			const companyId = selectedCompany(); const scope = revertScope();
			const body = $('stress-contacts'); body.replaceChildren(); $('stress-contacts-empty').classList.add('hidden');
			$('stress-contacts-caption').textContent = hasScope() ? 'Escopo: ' + companyName(scope) : 'Selecione uma empresa ou marque “Todas as empresas”.';
			$('stress-revert').disabled = !hasScope() || stress.jobStatus === 'running';
			if (hasScope()) loadSummary(scope); else $('stress-summary').replaceChildren();
			if (!companyId) return;
			try {
				const payload = await stressAPI('GET', API + '/companies/' + companyId + '/contacts');
				if (selectedCompany() !== companyId) return;
				for (const contact of payload.data || []) {
					const row = document.createElement('tr');
					for (const value of [contact.name, contact.protocol ? '#' + contact.protocol : '-', contact.agentName || '-', number(contact.messageCount), new Date(contact.createdAt).toLocaleString('pt-BR')]) { const cell = document.createElement('td'); cell.className = 'p-3 text-gray-700'; cell.textContent = String(value); row.appendChild(cell); }
					const actions = document.createElement('td'); actions.className = 'p-3 text-right';
					const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100'; remove.textContent = 'Remover';
					remove.addEventListener('click', () => removeContact(contact));
					actions.appendChild(remove); row.appendChild(actions); body.appendChild(row);
				}
				$('stress-contacts-empty').classList.toggle('hidden', body.childElementCount > 0);
			} catch (error) { showStressError(error); }
		}
		async function loadSummary(scope) {
			try {
				const payload = await stressAPI('GET', API + '/companies/' + scope + '/summary');
				if (revertScope() !== scope) return;
				const data = payload.data || {};
				const items = [['Contatos de mensagens geradas', data.contacts], ['Clientes simulados', data.simulatedContacts], ['Agentes simulados', data.agents], ['Instâncias simuladas', data.connections], ['Conversas', data.conversations], ['Mensagens', data.messages]];
				$('stress-summary').replaceChildren(...items.map(([label, value]) => { const cell = document.createElement('div'); cell.className = 'bg-white p-4'; const dt = document.createElement('dt'); dt.className = 'text-[11px] font-semibold text-gray-500'; dt.textContent = label; const dd = document.createElement('dd'); dd.className = 'mt-1 text-xl font-black text-gray-950'; dd.textContent = number(value); cell.append(dt, dd); return cell; }));
			} catch (error) { showStressError(error); }
		}
		async function removeContact(contact) {
			if (!confirm('Remover "' + contact.name + '" e suas ' + number(contact.messageCount) + ' mensagens? Esta ação não pode ser desfeita.')) return;
			try { const payload = await stressAPI('DELETE', API + '/companies/' + contact.companyId + '/contacts/' + contact.contactId); renderJob(payload.data); poll(); }
			catch (error) { showStressError(error); }
		}

		function renderJob(job) {
			$('stress-job-empty').classList.toggle('hidden', !!job); $('stress-job').classList.toggle('hidden', !job);
			const running = !!job && job.status === 'running';
			$('stress-submit').disabled = running; $('stress-revert').disabled = running || !hasScope();
			$('stress-cancel').classList.toggle('hidden', !running || job.kind === 'revert');
			if (!job) { stress.jobStatus = ''; return; }
			const percent = job.total ? Math.min(100, Math.round(job.done * 100 * (1 / job.total))) : (running ? 0 : 100);
			$('stress-job-title').textContent = job.kind === 'revert' ? 'Reversão do teste' : job.kind === 'cleanup' ? 'Remoção de contato de teste' : 'Geração de mensagens';
			badge($('stress-job-status'), job.status);
			$('stress-job-bar').style.width = percent + '%'; $('stress-job-bar').parentElement.setAttribute('aria-valuenow', String(percent));
			const seconds = Math.max(1, ((job.finishedAt ? new Date(job.finishedAt) : new Date()) - new Date(job.startedAt)) * 0.001);
			const verb = job.kind === 'generate' ? ' mensagens criadas' : ' mensagens removidas';
			$('stress-job-progress').textContent = number(job.done) + ' de ' + number(job.total) + verb + ' · ' + percent + '% · ' + number(job.done * (1 / seconds)) + ' por segundo';
			const details = [['Empresa', companyName(job.companyId)], [job.kind === 'revert' ? 'Escopo' : 'Contato', job.contactName || '-']];
			if (job.kind === 'generate') details.push(['Usuário', job.agentName || '-'], ['Protocolo', job.protocol ? '#' + job.protocol : '-']);
			details.push(['Duração', duration(seconds)]);
			detailRows($('stress-job-details'), details);
			$('stress-job-error').textContent = job.error || ''; $('stress-job-error').classList.toggle('hidden', !job.error);
			if (stress.jobStatus === 'running' && job.status !== 'running') {
				stress.jobStatus = job.status; stress.agentsCompany = -1; companyChanged();
				if (typeof showToast === 'function') showToast(job.status === 'completed' ? (job.kind === 'revert' ? 'Teste revertido.' : 'Execução concluída.') : 'Execução ' + (job.status === 'failed' ? 'falhou.' : 'interrompida.'), job.status === 'failed');
			}
			stress.jobStatus = job.status;
		}
		function renderSimulation(sim) {
			$('stress-sim-empty').classList.toggle('hidden', !!sim); $('stress-sim').classList.toggle('hidden', !sim);
			const running = !!sim && sim.running;
			$('stress-sim-submit').disabled = running; $('stress-sim-stop').classList.toggle('hidden', !running);
			if (stress.simRunning && !running) loadTestData();
			stress.simRunning = running;
			if (!sim) return;
			const config = sim.config || {};
			$('stress-sim-title').textContent = companyName(config.companyId);
			badge($('stress-sim-status'), running ? 'running' : 'finished');
			const total = Math.max(1, new Date(sim.endsAt) - new Date(sim.startedAt));
			const elapsed = (sim.finishedAt ? new Date(sim.finishedAt) : new Date()) - new Date(sim.startedAt);
			$('stress-sim-bar').style.width = Math.min(100, Math.round(elapsed * 100 * (1 / total))) + '%';
			detailRows($('stress-sim-details'), [
				['Agentes online', number(sim.agentsOnline) + ' de ' + number(config.agents)], ['Instâncias online', number(sim.instancesOnline) + ' de ' + number(config.instances)],
				['Requisições', number(sim.requests)], ['Erros', number(sim.errors)], ['Webhooks enviados', number(sim.webhooks)], ['Webhooks com erro', number(sim.webhookErrors)],
				['Decorrido', duration(elapsed * 0.001)], [running ? 'Restante' : 'Motivo', running ? duration((new Date(sim.endsAt) - new Date()) * 0.001) : (sim.stopReason || '-')]]);
			$('stress-sim-error').textContent = sim.lastError ? 'Último erro: ' + sim.lastError : ''; $('stress-sim-error').classList.toggle('hidden', !sim.lastError);
		}

		const trafficTiles = [
			['Requisições simuladas', s => s.requestsPerSecond, v => number(v, 1) + ' por s'],
			['Latência p95', s => s.p95LatencyMs, v => number(v) + ' ms', s => 'média ' + number(s.avgLatencyMs) + ' ms'],
			['Webhooks recebidos', s => s.webhooksPerSecond, v => number(v, 1) + ' por s'],
			['Erros', s => s.errorsPerSecond, v => number(v, 2) + ' por s'],
			['Conexões SSE da simulação', s => s.simulatorSseOpen, v => number(v)],
			['Agentes simulados online', s => s.simulatedAgentsOnline, v => number(v)],
		];
		const trafficSeries = { 'stress-requests': s => s.requestsPerSecond, 'stress-latency': s => s.p95LatencyMs };
		function renderMetrics() {
			window.SophusCharts.renderTiles($('stress-tiles'), stress.samples, trafficTiles);
			document.querySelectorAll('[data-chart^="stress-"]').forEach(container => window.SophusCharts.render(container, stress.samples, trafficSeries[container.dataset.chart]));
		}
		function panelVisible() { return !$('stress-panel').classList.contains('hidden') && document.visibilityState !== 'hidden'; }
		async function poll() {
			try {
				const payload = await stressAPI('GET', API + '/metrics?since=' + stress.lastSample);
				const data = payload.data || {};
				for (const sample of data.samples || []) { stress.samples.push(sample); stress.lastSample = Math.max(stress.lastSample, new Date(sample.t).getTime()); }
				if (stress.samples.length > 900) stress.samples.splice(0, stress.samples.length - 900);
				renderJob(data.job || null); renderSimulation(data.simulation || null); renderMetrics();
			} catch (error) { showStressError(error); }
		}
		function startPolling() { if (stress.timer) return; poll(); stress.timer = setInterval(() => { if (panelVisible()) poll(); }, 2000); }

		function updateEstimate() {
			const instances = Number($('stress-sim-instances').value) || 0, rate = Number($('stress-sim-rate').value) || 0, minutes = Number($('stress-sim-duration').value) || 0;
			$('stress-sim-estimate').textContent = instances ? '≈ ' + number(instances * rate) + ' mensagens por minuto, ' + number(instances * rate * minutes) + ' no total.' : '';
		}
		$('stress-company-filter').addEventListener('input', renderCompanyOptions);
		$('stress-company').addEventListener('change', companyChanged);
		$('stress-revert-all').addEventListener('change', loadTestData);
		$('stress-contacts-refresh').addEventListener('click', loadTestData);
		for (const id of ['stress-sim-instances', 'stress-sim-rate', 'stress-sim-duration']) $(id).addEventListener('input', updateEstimate);
		document.querySelectorAll('[data-stress-count]').forEach(button => button.addEventListener('click', () => { $('stress-count').value = button.dataset.stressCount; }));
		$('stress-cancel').addEventListener('click', async () => { try { await stressAPI('POST', API + '/job/cancel'); poll(); } catch (error) { showStressError(error); } });
		$('stress-form').addEventListener('submit', async event => {
			event.preventDefault(); clearStressError();
			const companyId = selectedCompany(), agentId = Number($('stress-agent').value), count = Number($('stress-count').value);
			if (!companyId || !agentId) { showStressError('Selecione a empresa e o usuário.'); return; }
			if (!Number.isInteger(count) || count < 1 || count > 1000000) { showStressError('Informe uma quantidade entre 1 e 1.000.000.'); return; }
			if (!confirm('Gerar ' + number(count) + ' mensagens na empresa "' + companyName(companyId) + '"?')) return;
			$('stress-submit').disabled = true;
			try { const payload = await stressAPI('POST', API + '/messages', { companyId, agentId, count }); renderJob(payload.data); loadTestData(); }
			catch (error) { $('stress-submit').disabled = false; showStressError(error); }
		});
		$('stress-sim-form').addEventListener('submit', async event => {
			event.preventDefault(); clearStressError();
			const config = { companyId: selectedCompany(), agents: Number($('stress-sim-agents').value), instances: Number($('stress-sim-instances').value), messagesPerMinute: Number($('stress-sim-rate').value), durationMinutes: Number($('stress-sim-duration').value), agentIntervalSeconds: Number($('stress-sim-interval').value) };
			if (!config.companyId) { showStressError('Selecione a empresa.'); return; }
			if (!confirm('Criar ' + config.agents + ' agentes e ' + config.instances + ' instâncias simulados em "' + companyName(config.companyId) + '" por ' + config.durationMinutes + ' minutos?')) return;
			$('stress-sim-submit').disabled = true;
			try { const payload = await stressAPI('POST', API + '/simulation', config); renderSimulation(payload.data); poll(); loadTestData(); }
			catch (error) { $('stress-sim-submit').disabled = false; showStressError(error); }
		});
		$('stress-sim-stop').addEventListener('click', async () => { try { renderSimulation((await stressAPI('POST', API + '/simulation/stop')).data); } catch (error) { showStressError(error); } });
		$('stress-revert').addEventListener('click', async () => {
			clearStressError(); const scope = revertScope();
			if (!hasScope()) { showStressError('Selecione uma empresa ou marque “Todas as empresas”.'); return; }
			if (!confirm('Reverter o teste em "' + companyName(scope) + '"? Serão apagados contatos fictícios, clientes, agentes e instâncias simulados, com suas conversas e mensagens. A simulação em andamento nesse escopo será parada.')) return;
			try { const payload = await stressAPI('POST', API + '/revert', { companyId: scope }); renderJob(payload.data); poll(); }
			catch (error) { showStressError(error); }
		});
		document.querySelectorAll('[data-open-monitor]').forEach(button => button.addEventListener('click', () => { if (typeof setTab === 'function') setTab('monitor'); }));
		window.addEventListener('resize', () => { if (panelVisible()) renderMetrics(); });
		updateEstimate();
		window.openStressPanel = () => { renderCompanyOptions(); startPolling(); };
	})();
	</script>
}

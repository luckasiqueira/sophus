package web

templ MessagePreferences() {
	<script>
		window.getAutoScrollAfterSendMode = function () { const mode = window.agentPreferences ? window.agentPreferences.scrollAfterSendMode : localStorage.getItem('sophus-scroll-after-send-mode'); return mode === 'except_quotes' ? 'except_quotes' : 'always'; };
		window.setAutoScrollAfterSendMode = function (mode) { const value = mode === 'except_quotes' ? 'except_quotes' : 'always'; if (window.agentPreferences) window.agentPreferences.scrollAfterSendMode = value; else localStorage.setItem('sophus-scroll-after-send-mode', value); };
		window.isReplyingToMessage = function () { return typeof document !== 'undefined' && Boolean(document.querySelector('#message-composer [name="quotedId"]')?.value); };
		window.shouldAutoScrollAfterSend = function (quoted) { const enabled = window.agentPreferences ? window.agentPreferences.scrollAfterSend : localStorage.getItem('sophus-scroll-after-send') !== 'false'; return enabled && !(window.getAutoScrollAfterSendMode() === 'except_quotes' && (Boolean(quoted) || window.isReplyingToMessage())); };
		window.setAutoScrollAfterSend = function (enabled) { if (window.agentPreferences) window.agentPreferences.scrollAfterSend = Boolean(enabled); else localStorage.setItem('sophus-scroll-after-send', String(Boolean(enabled))); };
	</script>
}

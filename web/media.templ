package web

templ MediaLibrary() {
	@base("media") {
		<main class="min-w-0 flex-1 overflow-y-auto rounded-2xl bg-stone-50 shadow-sm">
			<div class="mx-auto max-w-7xl p-4 sm:p-6 lg:p-8">
				<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.2em] text-purple-600">Conteúdo da empresa</p><h1 class="mt-2 text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Biblioteca de mídia</h1><p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-500">Visualize, baixe e remova arquivos recebidos em conversas ou usados nas automações.</p></div><a href="/billing" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-gray-800"><i class="fas fa-arrow-up-right-dots"></i> Ver upgrades</a></header>
				<div id="media-error" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
				<section class="mt-6 overflow-hidden rounded-3xl bg-stone-950 p-6 text-white shadow-xl sm:p-7" style="background: radial-gradient(circle at 90% 10%, rgba(59,130,246,.42), transparent 30%), radial-gradient(circle at 10% 100%, rgba(97,35,204,.5), transparent 36%), #17141f;"><div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"><div><p class="text-xs font-bold uppercase tracking-[.18em] text-stone-400">Armazenamento utilizado</p><p class="mt-3 text-3xl font-black"><span id="media-used">-</span> <span class="text-lg font-medium text-stone-400">de <span id="media-limit">-</span></span></p><p id="media-scan-date" class="mt-2 text-xs text-stone-400"></p></div><div class="w-full md:max-w-md"><div class="h-3 overflow-hidden rounded-full bg-white/10"><div id="media-usage-bar" class="h-full rounded-full bg-gradient-to-r from-blue-400 to-purple-500 transition-all" style="width:0%"></div></div><div class="mt-2 flex justify-between text-xs text-stone-400"><span id="media-percent">0%</span><span id="media-count">0 arquivos</span></div></div></div><div id="media-upgrade-warning" class="mt-5 hidden rounded-xl border border-amber-300/20 bg-amber-300/10 px-4 py-3 text-sm text-amber-100"><i class="fas fa-triangle-exclamation mr-2 text-amber-300"></i><span></span> <a href="/billing" class="ml-1 font-bold underline">Escolher um plano maior</a></div></section>
				<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:p-5"><div class="flex flex-col gap-3 lg:flex-row lg:items-center"><label class="relative flex-1"><i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-gray-400"></i><input id="media-search" type="search" placeholder="Buscar pelo nome do arquivo" class="w-full rounded-xl border border-stone-200 bg-stone-50 py-2.5 pl-10 pr-4 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></label><div id="media-filters" class="flex gap-2 overflow-x-auto pb-1 lg:pb-0"><button data-media-kind="all" class="shrink-0 rounded-xl bg-purple-600 px-4 py-2.5 text-xs font-bold text-white">Todos</button><button data-media-kind="image" class="shrink-0 rounded-xl bg-stone-100 px-4 py-2.5 text-xs font-bold text-gray-600">Imagens</button><button data-media-kind="video" class="shrink-0 rounded-xl bg-stone-100 px-4 py-2.5 text-xs font-bold text-gray-600">Vídeos</button><button data-media-kind="audio" class="shrink-0 rounded-xl bg-stone-100 px-4 py-2.5 text-xs font-bold text-gray-600">Áudios</button><button data-media-kind="document" class="shrink-0 rounded-xl bg-stone-100 px-4 py-2.5 text-xs font-bold text-gray-600">Documentos</button></div></div></section>
				<div id="media-loading" class="mt-6 rounded-2xl border border-stone-200 bg-white p-16 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando mídias...</div>
				<section id="media-grid" class="mt-6 hidden grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"></section>
				<section id="media-empty" class="mt-6 hidden rounded-2xl border border-dashed border-stone-300 bg-white p-14 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-stone-100 text-xl text-gray-400"><i class="fas fa-photo-film"></i></span><p class="mt-4 font-bold text-gray-700">Nenhuma mídia encontrada</p><p class="mt-1 text-sm text-gray-500">Os arquivos da empresa aparecerão aqui.</p></section>
			</div>
		</main>
		<div id="media-preview" class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-950/90 p-3 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Visualização da mídia"><div class="flex h-full max-h-[920px] w-full max-w-6xl flex-col overflow-hidden rounded-2xl border border-white/10 bg-stone-950 text-white shadow-2xl"><header class="flex items-center gap-3 border-b border-white/10 px-4 py-3"><div class="min-w-0 flex-1"><p id="media-preview-name" class="truncate text-sm font-bold"></p><p id="media-preview-meta" class="mt-0.5 text-xs text-stone-400"></p></div><a id="media-preview-download" class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 hover:bg-white/20" aria-label="Baixar mídia"><i class="fas fa-download"></i></a><button id="media-preview-delete" class="grid h-10 w-10 place-items-center rounded-xl bg-red-500/15 text-red-300 hover:bg-red-500/25" aria-label="Excluir mídia"><i class="fas fa-trash"></i></button><button id="media-preview-close" class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 hover:bg-white/20" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header><div id="media-preview-stage" class="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-black/40 p-3 sm:p-8"><button id="media-preview-previous" class="absolute left-3 z-10 grid h-11 w-11 place-items-center rounded-full bg-black/50 hover:bg-black/70" aria-label="Mídia anterior"><i class="fas fa-chevron-left"></i></button><div id="media-preview-content" class="flex h-full w-full items-center justify-center"></div><button id="media-preview-next" class="absolute right-3 z-10 grid h-11 w-11 place-items-center rounded-full bg-black/50 hover:bg-black/70" aria-label="Próxima mídia"><i class="fas fa-chevron-right"></i></button></div><footer class="border-t border-white/10 px-4 py-3 text-center text-xs text-stone-400"><span id="media-preview-counter"></span></footer></div></div>
		<div id="media-toast" class="fixed bottom-5 right-5 z-[60] hidden items-center gap-3 rounded-2xl bg-gray-950 px-5 py-4 text-sm font-medium text-white shadow-2xl"><i class="fas fa-circle-check text-emerald-400"></i><span></span></div>
		<script>
const mediaState = { items: [], visible: [], kind: 'all', query: '', current: -1 };
function mediaBytes(value) { const bytes = Number(value || 0); if (bytes < 1024) return bytes + ' B'; const units = ['KB','MB','GB','TB']; let size = bytes; let unit = -1; do { size /= 1024; unit++; } while (size >= 1024 && unit < units.length - 1); return size.toLocaleString('pt-BR', { maximumFractionDigits: unit > 0 ? 2 : 1 }) + ' ' + units[unit]; }
function mediaDate(value) { const date = new Date(value); return Number.isNaN(date.getTime()) ? '-' : new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(date); }
function mediaAPI(method, url) { return fetch(url, { method, credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(async response => { if (response.status === 204) return null; const text = await response.text(); let payload = {}; if (text) { try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; } } if (!response.ok) throw new Error(payload.error || 'Erro ' + response.status); return payload; }); }
function mediaPath(item, suffix) { return '/management/api/media/' + encodeURIComponent(item.scope) + '/' + encodeURIComponent(item.name) + (suffix || ''); }
function showMediaError(error) { const box = document.getElementById('media-error'); box.textContent = error.message || String(error); box.classList.remove('hidden'); }
function showMediaToast(message) { const toast = document.getElementById('media-toast'); toast.querySelector('span').textContent = message; toast.classList.remove('hidden'); toast.classList.add('flex'); setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 3000); }
function renderMediaUsage(usage) { const percent = Math.min(100, Number(usage.percentUsed || 0)); document.getElementById('media-used').textContent = mediaBytes(usage.usedBytes); document.getElementById('media-limit').textContent = mediaBytes(usage.storageLimitBytes); document.getElementById('media-percent').textContent = percent.toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + '%'; document.getElementById('media-count').textContent = usage.fileCount + (usage.fileCount === 1 ? ' arquivo' : ' arquivos'); document.getElementById('media-scan-date').textContent = usage.scannedAt ? 'Última conferência: ' + mediaDate(usage.scannedAt) : 'A conferência diária ainda não foi executada.'; const bar = document.getElementById('media-usage-bar'); bar.style.width = percent + '%'; bar.className = 'h-full rounded-full transition-all ' + (percent >= 100 ? 'bg-red-500' : percent >= 80 ? 'bg-amber-400' : 'bg-gradient-to-r from-blue-400 to-purple-500'); const warning = document.getElementById('media-upgrade-warning'); warning.classList.toggle('hidden', percent < 80); warning.querySelector('span').textContent = percent >= 100 ? 'O armazenamento está cheio e a operação foi interrompida.' : 'Seu armazenamento está próximo do limite.'; }
function mediaCard(item, index) { const card = document.createElement('article'); card.className = 'group overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md'; const preview = document.createElement('button'); preview.type = 'button'; preview.className = 'relative flex aspect-square w-full items-center justify-center overflow-hidden bg-stone-100'; preview.onclick = () => openMediaPreview(index); if (item.kind === 'image') { const image = document.createElement('img'); image.src = item.previewURL; image.alt = ''; image.loading = 'lazy'; image.className = 'h-full w-full object-cover transition group-hover:scale-105'; preview.appendChild(image); } else { const icon = document.createElement('span'); icon.className = 'grid h-14 w-14 place-items-center rounded-2xl text-xl ' + (item.kind === 'video' ? 'bg-blue-100 text-blue-700' : item.kind === 'audio' ? 'bg-purple-100 text-purple-700' : 'bg-stone-200 text-gray-600'); icon.innerHTML = '<i class="fas ' + (item.kind === 'video' ? 'fa-play' : item.kind === 'audio' ? 'fa-waveform-lines' : 'fa-file-lines') + '"><\/i>'; preview.appendChild(icon); } const info = document.createElement('div'); info.className = 'p-3'; const name = document.createElement('p'); name.className = 'truncate text-xs font-bold text-gray-800'; name.textContent = item.name; const meta = document.createElement('p'); meta.className = 'mt-1 text-[10px] text-gray-500'; meta.textContent = mediaBytes(item.sizeBytes) + ' · ' + (item.scope === 'flows' ? 'Automação' : 'Conversa'); info.append(name, meta); card.append(preview, info); return card; }
function renderMediaGrid() { mediaState.visible = mediaState.items.filter(item => (mediaState.kind === 'all' || item.kind === mediaState.kind) && (!mediaState.query || item.name.toLowerCase().includes(mediaState.query))); const grid = document.getElementById('media-grid'); grid.replaceChildren(); mediaState.visible.forEach((item, index) => grid.appendChild(mediaCard(item, index))); grid.classList.toggle('hidden', mediaState.visible.length === 0); grid.classList.toggle('grid', mediaState.visible.length > 0); document.getElementById('media-empty').classList.toggle('hidden', mediaState.visible.length > 0); }
function previewMediaContent(item) { const content = document.getElementById('media-preview-content'); content.replaceChildren(); let element; if (item.kind === 'image') { element = document.createElement('img'); element.src = item.previewURL; element.alt = item.name; element.className = 'max-h-full max-w-full object-contain'; } else if (item.kind === 'video') { element = document.createElement('video'); element.src = item.previewURL; element.controls = true; element.autoplay = false; element.className = 'max-h-full max-w-full'; } else if (item.kind === 'audio') { element = document.createElement('audio'); element.src = item.previewURL; element.controls = true; element.className = 'w-full max-w-xl'; } else { element = document.createElement('div'); element.className = 'text-center'; element.innerHTML = '<span class="mx-auto grid h-24 w-24 place-items-center rounded-3xl bg-white/10 text-4xl"><i class="fas fa-file-lines"><\/i><\/span><p class="mt-5 text-sm text-stone-300">Use o botão de download para abrir este documento.<\/p>'; } content.appendChild(element); }
function openMediaPreview(index) { if (!mediaState.visible.length) return; mediaState.current = (index + mediaState.visible.length) % mediaState.visible.length; const item = mediaState.visible[mediaState.current]; document.getElementById('media-preview-name').textContent = item.name; document.getElementById('media-preview-meta').textContent = mediaBytes(item.sizeBytes) + ' · ' + mediaDate(item.createdAt); document.getElementById('media-preview-counter').textContent = (mediaState.current + 1) + ' de ' + mediaState.visible.length; document.getElementById('media-preview-download').href = mediaPath(item, '/download'); previewMediaContent(item); const modal = document.getElementById('media-preview'); modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); }
function closeMediaPreview() { const modal = document.getElementById('media-preview'); modal.classList.add('hidden'); modal.classList.remove('flex'); modal.querySelectorAll('video,audio').forEach(media => media.pause()); document.body.classList.remove('overflow-hidden'); }
async function deleteCurrentMedia() { const item = mediaState.visible[mediaState.current]; if (!item || !confirm('Excluir esta mídia permanentemente?')) return; try { await mediaAPI('DELETE', mediaPath(item)); closeMediaPreview(); showMediaToast('Mídia excluída.'); await loadMedia(); } catch (error) { showMediaError(error); } }
async function loadMedia() { const response = await mediaAPI('GET', '/management/api/media'); const data = response.data || {}; mediaState.items = Array.isArray(data.items) ? data.items : []; renderMediaUsage(data.usage || {}); renderMediaGrid(); document.getElementById('media-loading').classList.add('hidden'); }
document.getElementById('media-search').addEventListener('input', event => { mediaState.query = event.target.value.trim().toLowerCase(); renderMediaGrid(); });
document.querySelectorAll('[data-media-kind]').forEach(button => button.addEventListener('click', () => { mediaState.kind = button.dataset.mediaKind; document.querySelectorAll('[data-media-kind]').forEach(item => item.className = 'shrink-0 rounded-xl px-4 py-2.5 text-xs font-bold ' + (item === button ? 'bg-purple-600 text-white' : 'bg-stone-100 text-gray-600')); renderMediaGrid(); }));
document.getElementById('media-preview-close').onclick = closeMediaPreview; document.getElementById('media-preview-previous').onclick = () => openMediaPreview(mediaState.current - 1); document.getElementById('media-preview-next').onclick = () => openMediaPreview(mediaState.current + 1); document.getElementById('media-preview-delete').onclick = deleteCurrentMedia;
document.addEventListener('keydown', event => { if (!document.getElementById('media-preview').classList.contains('flex')) return; if (event.key === 'Escape') closeMediaPreview(); if (event.key === 'ArrowLeft') openMediaPreview(mediaState.current - 1); if (event.key === 'ArrowRight') openMediaPreview(mediaState.current + 1); });
let mediaTouchStart = 0; document.getElementById('media-preview-stage').addEventListener('touchstart', event => { mediaTouchStart = event.changedTouches[0].clientX; }, { passive: true }); document.getElementById('media-preview-stage').addEventListener('touchend', event => { const delta = event.changedTouches[0].clientX - mediaTouchStart; if (Math.abs(delta) > 60) openMediaPreview(mediaState.current + (delta < 0 ? 1 : -1)); }, { passive: true });
loadMedia().catch(error => { document.getElementById('media-loading').classList.add('hidden'); showMediaError(error); });
		</script>
	}
}

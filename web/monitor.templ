package web

// MonitorCharts defines window.DoveChatCharts, the line charts and stat tiles
// shared by the monitoring home and the stress-test panel.
templ MonitorCharts() {
	<style>
		.sophus-chart { position: relative; height: 140px; }
		.sophus-chart svg { display: block; width: 100%; height: 100%; overflow: visible; }
		.sophus-chart-tip { position: absolute; top: 0; pointer-events: none; transform: translateX(-50%); white-space: nowrap; border-radius: .5rem; background: #1c1917; color: #fff; padding: .25rem .5rem; font-size: 11px; font-weight: 600; }
	</style>
	<script>
	window.DoveChatCharts = (() => {
		const ACCENT = '#7e22ce';
		const hover = {};
		const number = (value, digits) => new Intl.NumberFormat('pt-BR', { maximumFractionDigits: digits || 0, minimumFractionDigits: digits || 0 }).format(value || 0);
		const time = value => new Date(value).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
		function niceMax(value) { if (value <= 0) return 1; const power = Math.pow(10, Math.floor(Math.log10(value))); for (const step of [1, 2, 2.5, 5, 10]) if (step * power >= value) return step * power; return 10 * power; }
		// One series per chart, one axis: the caption names the series.
		function render(container, samples, read, options) {
			options = options || {};
			const key = container.dataset.chart || 'chart', unit = container.dataset.unit || '';
			const width = container.clientWidth || 300, height = container.clientHeight || 140;
			const left = 44, right = 8, top = 10, bottom = 22, ns = 'http://www.w3.org/2000/svg';
			const svg = document.createElementNS(ns, 'svg'); svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height); svg.setAttribute('role', 'img');
			const caption = container.closest('figure') && container.closest('figure').querySelector('figcaption');
			svg.setAttribute('aria-label', caption ? caption.textContent : key);
			const el = (tag, attrs, text) => { const node = document.createElementNS(ns, tag); for (const name in attrs) node.setAttribute(name, attrs[name]); if (text !== undefined) node.textContent = text; svg.appendChild(node); return node; };
			const values = samples.map(read);
			const maxValue = Math.max(niceMax(Math.max(...values, 0)), options.minMax || 0);
			const plotW = width - left - right, plotH = height - top - bottom, step = samples.length < 2 ? 0 : plotW * (1 / (samples.length - 1));
			const x = index => left + (samples.length < 2 ? plotW : index * step);
			const y = value => top + plotH - Math.min(1, value * (1 / maxValue)) * plotH;
			for (const fraction of [0, 0.5, 1]) {
				const gy = top + plotH - fraction * plotH;
				el('line', { x1: left, x2: width - right, y1: gy, y2: gy, stroke: '#e7e5e4', 'stroke-width': 1 });
				el('text', { x: left - 6, y: gy + 3, 'text-anchor': 'end', 'font-size': 10, fill: '#78716c' }, number(maxValue * fraction, maxValue < 10 ? 1 : 0));
			}
			if (!samples.length) { el('text', { x: left + plotW * 0.5, y: top + plotH * 0.5, 'text-anchor': 'middle', 'font-size': 11, fill: '#78716c' }, 'Aguardando amostras'); container.replaceChildren(svg); return; }
			el('text', { x: left, y: height - 4, 'font-size': 10, fill: '#78716c' }, time(samples[0].t));
			el('text', { x: width - right, y: height - 4, 'text-anchor': 'end', 'font-size': 10, fill: '#78716c' }, time(samples[samples.length - 1].t));
			const points = values.map((value, index) => x(index).toFixed(1) + ',' + y(value).toFixed(1));
			el('path', { d: 'M' + x(0).toFixed(1) + ',' + (top + plotH) + ' L' + points.join(' L') + ' L' + x(values.length - 1).toFixed(1) + ',' + (top + plotH) + ' Z', fill: ACCENT, 'fill-opacity': 0.08 });
			el('path', { d: 'M' + points.join(' L'), fill: 'none', stroke: ACCENT, 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' });
			const cross = el('line', { y1: top, y2: top + plotH, stroke: '#a8a29e', 'stroke-width': 1, visibility: 'hidden' });
			const dot = el('circle', { r: 4, fill: ACCENT, stroke: '#fff', 'stroke-width': 2, visibility: 'hidden' });
			const tip = document.createElement('div'); tip.className = 'sophus-chart-tip hidden';
			const hit = el('rect', { x: left, y: top, width: plotW, height: plotH, fill: 'transparent' });
			// Charts redraw on every poll; the hovered position is kept so the
			// readout survives a redraw under a stationary pointer.
			const showAt = px => {
				const index = samples.length < 2 ? 0 : Math.max(0, Math.min(samples.length - 1, Math.round((px - left) * (1 / step))));
				for (const [node, attr] of [[cross, 'x1'], [cross, 'x2'], [dot, 'cx']]) node.setAttribute(attr, x(index));
				dot.setAttribute('cy', y(values[index])); cross.setAttribute('visibility', 'visible'); dot.setAttribute('visibility', 'visible');
				tip.textContent = time(samples[index].t) + ' · ' + number(values[index], values[index] < 10 ? 1 : 0) + unit;
				tip.style.left = (x(index) * (container.clientWidth || width) * (1 / width)) + 'px'; tip.classList.remove('hidden');
			};
			hit.addEventListener('pointermove', event => { const box = svg.getBoundingClientRect(), px = (event.clientX - box.left) * width * (1 / box.width); hover[key] = px; showAt(px); });
			hit.addEventListener('pointerleave', () => { delete hover[key]; cross.setAttribute('visibility', 'hidden'); dot.setAttribute('visibility', 'hidden'); tip.classList.add('hidden'); });
			if (hover[key] !== undefined) showAt(hover[key]);
			container.replaceChildren(svg, tip);
		}
		// tiles: [label, read(sample) -> number, format(value, sample) -> text, note(sample) -> text]
		function renderTiles(target, samples, tiles) {
			const latest = samples[samples.length - 1];
			target.replaceChildren(...tiles.map(([label, read, format, note]) => {
				const tile = document.createElement('article'); tile.className = 'rounded-xl border border-stone-200 bg-white p-4';
				const name = document.createElement('p'); name.className = 'text-xs font-semibold text-gray-500'; name.textContent = label;
				const value = document.createElement('p'); value.className = 'mt-2 text-lg font-black text-gray-950'; value.textContent = latest ? format(read(latest), latest) : '—';
				const detail = document.createElement('p'); detail.className = 'mt-1 text-[11px] text-gray-500';
				if (latest) {
					const extra = note ? note(latest) : '';
					const peak = samples.reduce((best, sample) => Math.max(best, read(sample)), 0);
					detail.textContent = [extra, peak > 0 ? 'Pico: ' + format(peak, latest) : ''].filter(Boolean).join(' · ');
				}
				tile.append(name, value, detail); return tile;
			}));
		}
		function csv(samples, filename) {
			if (!samples.length) return;
			const keys = Object.keys(samples[0]);
			const rows = [keys.join(',')].concat(samples.map(sample => keys.map(key => sample[key] ?? '').join(',')));
			const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([rows.join('\n')], { type: 'text/csv' })); link.download = filename; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 1000);
		}
		return { render, renderTiles, csv, number };
	})();
	</script>
}

templ MonitorPanel(stressEnabled bool) {
	<section id="monitor-panel">
		<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
			<div><p class="text-xs font-bold uppercase tracking-widest text-purple-600">Monitoramento</p><h2 class="mt-2 text-2xl font-black text-gray-950">Consumo e atividade da plataforma</h2><p id="monitor-host" class="mt-1 text-sm text-gray-500">Coletando amostras a cada 2 segundos...</p></div>
			<button id="monitor-csv" type="button" class="rounded-xl border border-stone-200 bg-white px-3 py-2 text-xs font-semibold text-gray-600 hover:bg-stone-50"><i class="fas fa-file-csv mr-1"></i> Baixar CSV</button>
		</div>
		<div id="monitor-error" role="alert" class="mb-5 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
		<div id="monitor-simulation" class="mb-5 hidden items-center justify-between gap-3 rounded-2xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800">
			<p><i class="fas fa-gauge-high mr-2"></i>Teste de estresse em andamento: os números abaixo incluem a carga simulada.</p>
			if stressEnabled {
				<button type="button" data-monitor-open-stress class="shrink-0 rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-bold text-white hover:bg-blue-800">Ver teste</button>
			}
		</div>
		<div id="monitor-tiles" class="grid grid-cols-2 gap-3 lg:grid-cols-4"></div>
		<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" aria-label="Histórico recente">
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				<figure><figcaption class="mb-2 text-xs font-semibold text-gray-600">Agentes online (incluindo simulados)</figcaption><div class="sophus-chart" data-chart="monitor-agents" data-unit=" agentes"></div></figure>
				<figure><figcaption class="mb-2 text-xs font-semibold text-gray-600">CPU do processo (% da máquina)</figcaption><div class="sophus-chart" data-chart="monitor-cpu" data-unit="%"></div></figure>
				<figure><figcaption class="mb-2 text-xs font-semibold text-gray-600">Memória do processo (MB)</figcaption><div class="sophus-chart" data-chart="monitor-memory" data-unit=" MB"></div></figure>
				<figure><figcaption class="mb-2 text-xs font-semibold text-gray-600">Conexões do banco em uso</figcaption><div class="sophus-chart" data-chart="monitor-db" data-unit=" conexões"></div></figure>
			</div>
			<p class="mt-4 text-xs leading-relaxed text-gray-500">Agente online é quem está com o sistema aberto (conexão em tempo real ativa) neste servidor. CPU e memória do processo são da aplicação; CPU, memória e carga do servidor vêm do Linux (/proc) e incluem Postgres e Redis quando rodam na mesma máquina. Histórico dos últimos 30 minutos.</p>
		</section>
		<section class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
			<div class="border-b border-stone-200 p-5"><h3 class="font-bold text-gray-950">Atividade por empresa</h3><p class="mt-1 text-sm text-gray-500">Empresas com agentes online ou instâncias conectadas agora.</p></div>
			<div class="overflow-x-auto"><table class="w-full min-w-[560px] text-left text-sm"><thead class="bg-stone-50 text-xs text-gray-500"><tr><th class="p-3">Empresa</th><th class="p-3">Agentes online</th><th class="p-3">Instâncias conectadas</th></tr></thead><tbody id="monitor-companies" class="divide-y divide-stone-100"></tbody></table><p id="monitor-companies-empty" class="hidden p-6 text-center text-sm text-gray-500">Nenhuma empresa com agentes online ou instâncias conectadas.</p></div>
		</section>
	</section>
	<script>
	(() => {
		const charts = window.DoveChatCharts, number = charts.number;
		const monitor = { samples: [], lastSample: 0, timer: null, host: null };
		const $ = id => document.getElementById(id);
		const memory = sample => sample.rssMB || sample.runtimeMB || 0;
		const plus = (value, label) => value ? '+' + number(value) + ' ' + label : '';
		const tiles = [
			['Agentes online', s => s.agentsOnline, v => number(v), s => plus(s.simulatedAgentsOnline, 'simulados')],
			['Instâncias conectadas', s => s.instancesConnected, v => number(v), s => plus(s.simulatedInstancesConnected, 'simuladas')],
			['Conexões em tempo real', s => s.sseConnections, v => number(v)],
			['CPU do processo', s => s.cpu, v => number(v, 1) + '%'],
			['CPU do servidor', s => s.systemCpu, v => monitor.host && monitor.host.procSupported ? number(v, 1) + '%' : '—'],
			['Memória do processo', memory, v => number(v) + ' MB', s => 'Heap ' + number(s.heapMB) + ' MB'],
			['Memória do servidor', s => s.systemMemoryPercent, v => v ? number(v, 1) + '%' : '—', s => s.load1 ? 'Carga ' + number(s.load1, 2) : ''],
			['Goroutines', s => s.goroutines, v => number(v)],
			['Conexões do banco em uso', s => s.dbInUse, v => number(v), s => number(s.dbOpen) + ' abertas'],
			['Conexões no Postgres', s => s.pgConnections, v => number(v)],
			['Tamanho do banco', s => s.databaseMB, v => v >= 1024 ? number(v * (1 / 1024), 1) + ' GB' : number(v) + ' MB'],
			['Pausas do coletor de lixo', s => s.gcPauseMs, v => number(v, 1) + ' ms', () => 'a cada 2 s'],
		];
		const series = { 'monitor-agents': s => s.agentsOnline + s.simulatedAgentsOnline, 'monitor-cpu': s => s.cpu, 'monitor-memory': memory, 'monitor-db': s => s.dbInUse };
		function draw() {
			charts.renderTiles($('monitor-tiles'), monitor.samples, tiles);
			document.querySelectorAll('[data-chart^="monitor-"]').forEach(container => charts.render(container, monitor.samples, series[container.dataset.chart], { minMax: container.dataset.chart === 'monitor-cpu' ? 10 : 0 }));
			const host = monitor.host;
			if (host) $('monitor-host').textContent = 'Servidor: ' + host.cpus + ' CPUs · ' + host.os + (host.systemMemoryMB ? ' · ' + number(host.systemMemoryMB * 0.001, 1) + ' GB de RAM' : '') + ' · aplicação iniciada em ' + new Date(host.startedAt).toLocaleString('pt-BR') + (host.procSupported ? '' : ' · métricas do servidor disponíveis apenas em Linux');
		}
		function renderCompanies(companies) {
			const body = $('monitor-companies');
			body.replaceChildren(...companies.map(company => {
				const row = document.createElement('tr');
				for (const value of [company.name, number(company.agentsOnline) + (company.simulatedAgentsOnline ? ' (+' + number(company.simulatedAgentsOnline) + ' simulados)' : ''), number(company.instancesConnected) + (company.simulatedInstancesConnected ? ' (+' + number(company.simulatedInstancesConnected) + ' simuladas)' : '')]) {
					const cell = document.createElement('td'); cell.className = 'p-3 text-gray-700'; cell.textContent = value; row.appendChild(cell);
				}
				return row;
			}));
			$('monitor-companies-empty').classList.toggle('hidden', companies.length > 0);
		}
		async function poll() {
			try {
				const response = await fetch('/management/api/monitoring?since=' + monitor.lastSample, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
				if (response.status === 401) { window.location.href = '/login'; return; }
				const payload = await response.json();
				if (!response.ok) throw new Error(payload.error || 'Erro ' + response.status);
				const data = payload.data || {};
				monitor.host = data.host || monitor.host;
				for (const sample of data.samples || []) { monitor.samples.push(sample); monitor.lastSample = Math.max(monitor.lastSample, new Date(sample.t).getTime()); }
				if (monitor.samples.length > 900) monitor.samples.splice(0, monitor.samples.length - 900);
				renderCompanies(data.companies || []);
				const simulation = $('monitor-simulation'); simulation.classList.toggle('hidden', !data.simulationRunning); simulation.classList.toggle('flex', !!data.simulationRunning);
				$('monitor-error').classList.add('hidden');
				draw();
			} catch (error) { $('monitor-error').textContent = error.message || String(error); $('monitor-error').classList.remove('hidden'); }
		}
		const visible = () => !$('monitor-panel').classList.contains('hidden') && document.visibilityState !== 'hidden';
		$('monitor-csv').addEventListener('click', () => charts.csv(monitor.samples, 'monitoramento-plataforma.csv'));
		document.querySelectorAll('[data-monitor-open-stress]').forEach(button => button.addEventListener('click', () => { if (typeof setTab === 'function') setTab('stress'); }));
		window.addEventListener('resize', () => { if (visible()) draw(); });
		window.openMonitorPanel = () => { if (!monitor.timer) monitor.timer = setInterval(() => { if (visible()) poll(); }, 2000); poll(); };
		draw();
	})();
	</script>
}

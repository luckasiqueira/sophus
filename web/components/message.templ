package components

import "sophus/internal/repo"
import "fmt"

templ MessageSent(msg repo.MessageData, companyId int) {
    <div class="flex gap-3 justify-end">
        <div class="flex-1 flex flex-col items-end">
            <div class="rounded-2xl rounded-tr-none p-4 max-w-2xl shadow-sm" style="background: linear-gradient(to right, #3b82f6, #9333ea);">
                <div class="text-base font-semibold text-white mb-2">{ msg.Text }</div>
                if msg.MediaType != "text" && msg.MediaType != "" {
                    <div class="flex gap-2 mt-3">
                        if msg.MediaType == "image" {
                            <img src={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) } alt="Image" class="w-200 h-200 rounded-xl object-cover"/>
                        }
                        if msg.MediaType == "video" {
                            <div class="relative bg-black rounded-xl overflow-hidden w-full">
                                <video class="w-64 h-64 object-contain" controls preload="metadata">
                                    <source src={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) } type="video/mp4"/>
                                </video>
                                <a
                                    href={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) }
                                    download
                                    class="absolute top-2 right-2 w-8 h-8 bg-black bg-opacity-50 hover:bg-opacity-75 rounded-lg flex items-center justify-center transition-colors"
                                >
                                    <i class="fas fa-download text-white text-xs"></i>
                                </a>
                            </div>
                        }
                        if msg.MediaType == "audio" {
                            <div class="flex items-center gap-3" data-audio-player onload="initAudioPlayer(this)">
                                <audio src={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) } preload="metadata"></audio>
                                <button data-play-btn class="w-10 h-10 rounded-full bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-play text-white text-sm"></i>
                                </button>
                                <div class="flex-1">
                                    <div class="relative w-40 h-2 bg-white bg-opacity-30 rounded-full cursor-pointer" data-progress-track>
                                        <div class="h-2 bg-white rounded-full transition-all" style="width: 0%" data-progress-bar></div>
                                    </div>
                                    <div class="text-xs text-white text-opacity-80 mt-1" data-time-display>0:00</div>
                                </div>
                                <a
                                    href={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) }
                                    download
                                    class="w-8 h-8 rounded-full bg-white bg-opacity-20 hover:bg-opacity-30 transition-colors flex items-center justify-center flex-shrink-0"
                                >
                                    <i class="fas fa-download text-white text-xs"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="text-xs text-gray-500 mt-1 mr-2">{ msg.UpdatedAt.Format("15:04:05 02-01-2006") }</div>
        </div>
        <img src="https://i.pravatar.cc/40?img=1" alt="Avatar" class="w-8 h-8 rounded-full flex-shrink-0"/>
    </div>
}

templ MessageReceived(msg repo.MessageData, companyId int) {
    <div class="flex gap-3">
        <img src="https://i.pravatar.cc/40?img=1" alt="Avatar" class="w-8 h-8 rounded-full flex-shrink-0"/>
        <div class="flex-1">
            <div class="bg-white rounded-2xl rounded-tl-none p-4 max-w-2xl shadow-sm">
                <div class="text-base font-semibold text-gray-600 mb-2">{ msg.Text }</div>
                if msg.MediaType != "text" && msg.MediaType != "" {
                    <div class="mt-2">
                        if msg.MediaType == "image" {
                            <img src={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) } alt="Image" class="w-200 h-200 rounded-xl object-cover"/>
                        }
                        if msg.MediaType == "video" {
                            <div class="relative bg-black rounded-xl overflow-hidden w-full">
                                <video class="w-full max-h-64 object-contain" controls preload="metadata">
                                    <source src={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) } type="video/mp4"/>
                                </video>
                                <a
                                    href={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) }
                                    download
                                    class="absolute top-2 right-2 w-8 h-8 bg-black bg-opacity-50 hover:bg-opacity-75 rounded-lg flex items-center justify-center transition-colors"
                                >
                                    <i class="fas fa-download text-white text-xs"></i>
                                </a>
                            </div>
                        }
                        if msg.MediaType == "audio" {
                            <div class="flex items-center gap-3" data-audio-player onload="initAudioPlayer(this)">
                                <audio src={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) } preload="metadata"></audio>
                                <button data-play-btn class="w-10 h-10 rounded-full bg-purple-100 hover:bg-purple-200 transition-colors flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-play text-purple-600 text-sm"></i>
                                </button>
                                <div class="flex-1">
                                    <div class="relative w-40 h-2 bg-stone-200 rounded-full cursor-pointer" data-progress-track>
                                        <div class="h-2 bg-purple-600 rounded-full transition-all" style="width: 0%" data-progress-bar></div>
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1" data-time-display>0:00</div>
                                </div>
                                <a
                                    href={ fmt.Sprintf("/medias/%d/%s", companyId, msg.MediaPath) }
                                    download
                                    class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 transition-colors flex items-center justify-center flex-shrink-0"
                                >
                                    <i class="fas fa-download text-gray-500 text-xs"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="text-xs text-gray-500 mt-1 ml-2">{ msg.UpdatedAt.Format("15:04 02/01/2006") }</div>
        </div>
    </div>
}

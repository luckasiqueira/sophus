package web

templ SubscriptionAddonManager() {
	<dialog id="subscription-addons-dialog" aria-labelledby="subscription-addons-title" class="m-auto w-11/12 max-w-2xl max-h-[90dvh] overflow-y-auto rounded-3xl border border-stone-200 bg-white p-0 text-gray-800 shadow-2xl backdrop:bg-stone-950/60 backdrop:backdrop-blur-sm">
		<header class="flex items-center justify-between gap-3 border-b border-stone-100 px-5 py-4"><div><p class="text-[10px] font-bold uppercase tracking-wider text-purple-600">Capacidade da assinatura</p><h2 id="subscription-addons-title" class="mt-1 text-lg font-black">Adicionais</h2><p id="subscription-addons-plan" class="mt-1 text-xs text-gray-500"></p></div><button id="subscription-addons-close" type="button" aria-label="Fechar adicionais" class="grid h-9 w-9 place-items-center rounded-xl hover:bg-stone-100"><i class="fas fa-xmark"></i></button></header>
		<form id="subscription-addons-form" class="p-5"><p id="subscription-addons-loading" class="py-8 text-center text-sm text-gray-500">Carregando contratação…</p><div id="subscription-addons-error" role="alert" class="hidden mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>
			<fieldset id="subscription-addons-fields" disabled class="grid gap-4 sm:grid-cols-2 disabled:opacity-50"><label class="rounded-xl border border-stone-200 p-4"><span class="block text-sm font-bold"><i class="fas fa-plug mr-2 text-purple-600"></i>Conexões extras</span><span id="subscription-addon-connection-price" class="mt-1 block text-xs text-gray-500"></span><input id="subscription-addon-connections" type="number" min="0" max="10000" step="1" required value="0" class="mt-3 w-full rounded-lg border border-stone-200 px-3 py-2"/></label><label class="rounded-xl border border-stone-200 p-4"><span class="block text-sm font-bold"><i class="fas fa-users mr-2 text-purple-600"></i>Usuários extras</span><span id="subscription-addon-agent-price" class="mt-1 block text-xs text-gray-500"></span><input id="subscription-addon-agents" type="number" min="0" max="10000" step="1" required value="0" class="mt-3 w-full rounded-lg border border-stone-200 px-3 py-2"/></label><label class="rounded-xl border border-stone-200 p-4"><span class="block text-sm font-bold"><i class="fas fa-hard-drive mr-2 text-purple-600"></i>Armazenamento extra (GB)</span><span id="subscription-addon-storage-price" class="mt-1 block text-xs text-gray-500"></span><input id="subscription-addon-storage" type="number" min="0" max="100000" step="1" required value="0" class="mt-3 w-full rounded-lg border border-stone-200 px-3 py-2"/></label><label class="flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 p-4"><input id="subscription-addon-transcription" type="checkbox" class="mt-1 accent-purple-600"/><span><span class="block text-sm font-bold"><i class="fas fa-microphone mr-2 text-purple-600"></i>Transcrição de áudio</span><span id="subscription-addon-transcription-price" class="mt-1 block text-xs text-gray-500"></span><span class="mt-2 block text-[11px] text-gray-500">Habilita a ferramenta de transcrição de áudio na assinatura.</span></span></label></fieldset>
			<div class="mt-4 rounded-xl border border-purple-100 bg-purple-50 p-4 text-sm"><p id="subscription-addons-summary" class="font-bold text-purple-800"></p><p id="subscription-addons-charge" class="mt-2 text-xs text-purple-700"></p><p id="subscription-addons-limits" class="mt-2 text-xs text-gray-600"></p></div><p class="mt-3 text-[11px] leading-relaxed text-gray-500">Aumentos são liberados após o pagamento proporcional ao período restante. Reduções valem imediatamente para as próximas cobranças, sem estorno do período atual, e não podem deixar os limites abaixo do uso da empresa. No ciclo anual, os adicionais mensais são multiplicados por 12.</p><div class="mt-5 flex items-center justify-end gap-3"><button id="subscription-addons-submit" type="submit" disabled class="rounded-xl bg-purple-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-purple-800 disabled:opacity-50">Confirmar alteração</button></div>
		</form>
	</dialog>
	<script>
		(function(){
			const dialog=document.getElementById('subscription-addons-dialog'),form=document.getElementById('subscription-addons-form'),fields=document.getElementById('subscription-addons-fields'),submit=document.getElementById('subscription-addons-submit'),error=document.getElementById('subscription-addons-error');
			let state=null,endpoint='',request=null,generation=0,saving=false;
			const money=cents=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(Number(cents||0)/100);
			function quantities(){return {extraConnections:Number(document.getElementById('subscription-addon-connections').value),extraAgents:Number(document.getElementById('subscription-addon-agents').value),extraStorageGB:Number(document.getElementById('subscription-addon-storage').value),audioTranscription:document.getElementById('subscription-addon-transcription').checked};}
			function priceFor(key,quantity){return (state.quantities[key]&&(quantity>0||quantity===true))?state.contractPrices:state.prices;}
			function renderQuote(){if(!state)return;const q=quantities(),factor=state.billingCycle==='annual'?12:1,current=state.quantities;
				const prices={extraConnectionPriceCents:priceFor('extraConnections',q.extraConnections).extraConnectionPriceCents||0,extraAgentPriceCents:priceFor('extraAgents',q.extraAgents).extraAgentPriceCents||0,extraStorageGBPriceCents:priceFor('extraStorageGB',q.extraStorageGB).extraStorageGBPriceCents||0,audioTranscriptionPriceCents:priceFor('audioTranscription',q.audioTranscription).audioTranscriptionPriceCents||0};
				const monthly=q.extraConnections*prices.extraConnectionPriceCents+q.extraAgents*prices.extraAgentPriceCents+q.extraStorageGB*prices.extraStorageGBPriceCents+(q.audioTranscription?prices.audioTranscriptionPriceCents:0),total=state.basePriceCents+monthly*factor;
				document.getElementById('subscription-addon-connection-price').textContent=money(prices.extraConnectionPriceCents)+'/mês por conexão';document.getElementById('subscription-addon-agent-price').textContent=money(prices.extraAgentPriceCents)+'/mês por usuário';document.getElementById('subscription-addon-storage-price').textContent=money(prices.extraStorageGBPriceCents)+'/mês por GB';document.getElementById('subscription-addon-transcription-price').textContent=money(prices.audioTranscriptionPriceCents)+'/mês';
				const fraction=Math.max(0,Math.min(1,(new Date(state.currentPeriodEnd).getTime()-Date.now())/((factor===12?365:30)*86400000))),charge=Math.ceil(Math.max(0,total-state.totalPriceCents)*fraction);
				document.getElementById('subscription-addons-summary').textContent='Adicionais: '+money(monthly)+'/mês · Total da assinatura: '+money(total)+(factor===12?'/ano':'/mês');document.getElementById('subscription-addons-charge').textContent=charge>0?'Cobrança proporcional estimada agora: '+money(charge)+'. O valor final é calculado no servidor.':'Sem cobrança adicional agora. O novo total será usado nas próximas renovações.';
				document.getElementById('subscription-addons-limits').textContent='Limites após aplicação: '+(state.limits.agentLimit-current.extraAgents+q.extraAgents)+' usuários · '+(state.limits.connectionLimit-current.extraConnections+q.extraConnections)+' conexões · '+(state.limits.storageLimitGB-current.extraStorageGB+q.extraStorageGB)+' GB';
				submit.disabled=saving||!state.allowed||!!state.pendingPaymentId||JSON.stringify(q)===JSON.stringify(current);
			}
			function renderState(data){state=data;fields.disabled=!state.allowed||!!state.pendingPaymentId;document.getElementById('subscription-addons-plan').textContent=state.planName+' · '+(state.billingCycle==='annual'?'Anual':'Mensal');const q=state.quantities||{};state.quantities={extraConnections:q.extraConnections||0,extraAgents:q.extraAgents||0,extraStorageGB:q.extraStorageGB||0,audioTranscription:!!q.audioTranscription};document.getElementById('subscription-addon-connections').value=state.quantities.extraConnections;document.getElementById('subscription-addon-agents').value=state.quantities.extraAgents;document.getElementById('subscription-addon-storage').value=state.quantities.extraStorageGB;document.getElementById('subscription-addon-transcription').checked=state.quantities.audioTranscription;renderQuote();if(!state.allowed||state.pendingPaymentId){error.textContent=!state.allowed?'O plano atual não permite adicionais.':'Existe uma cobrança de adicionais pendente. Conclua ou cancele essa cobrança antes de alterar a contratação.';error.classList.remove('hidden');}}
			window.openSubscriptionAddons=async(url,title)=>{endpoint=url;state=null;const expected=++generation;if(request)request.abort();request=new AbortController();error.classList.add('hidden');fields.disabled=true;submit.disabled=true;document.getElementById('subscription-addons-title').textContent=title||'Adicionais da assinatura';document.getElementById('subscription-addons-loading').classList.remove('hidden');if(!dialog.open)dialog.showModal();try{const response=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json'},signal:request.signal});const payload=await response.json();if(!response.ok)throw new Error(payload.error||'Não foi possível carregar os adicionais.');if(expected===generation&&dialog.open)renderState(payload.data);}catch(failure){if(failure.name!=='AbortError'&&expected===generation){error.textContent=failure.message;error.classList.remove('hidden');}}finally{if(expected===generation)document.getElementById('subscription-addons-loading').classList.add('hidden');}};
			function close(){if(saving)return;++generation;if(request)request.abort();dialog.close();}
			document.getElementById('subscription-addons-close').onclick=close;dialog.addEventListener('cancel',event=>{event.preventDefault();close();});fields.addEventListener('input',renderQuote);fields.addEventListener('change',renderQuote);
			form.addEventListener('submit',async event=>{event.preventDefault();if(!state||submit.disabled||saving)return;saving=true;submit.disabled=true;error.classList.add('hidden');const popup=window.open('about:blank','_blank');if(popup)popup.opener=null;
				try{const response=await fetch(endpoint,{method:'PUT',credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify(quantities())});const payload=await response.json();if(!response.ok)throw new Error(payload.error||'Não foi possível alterar os adicionais.');const data=payload.data,payment=data.payment;if(payment.checkoutURL){const target=new URL(payment.checkoutURL,location.origin);if(!['https:','http:'].includes(target.protocol))throw new Error('Link de pagamento inválido.');if(popup)popup.location.replace(target.href);else location.assign(target.href);}else if(popup)popup.close();renderState(data.addons);document.dispatchEvent(new CustomEvent('subscription:addons-changed'));if(payment.status==='paid'){dialog.close();if(window.showAppNotice)window.showAppNotice('Adicionais atualizados','Os novos limites e valores já foram aplicados.');}}
				catch(failure){if(popup)popup.close();error.textContent=failure.message;error.classList.remove('hidden');}finally{saving=false;if(state)renderQuote();}
			});
		})();
	</script>
}

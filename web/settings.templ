package web

templ SaaSSettings() {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Configurações - Sophus</title>
			@BrandIcons()
			@MobileActionStyles()
			<script src="https://cdn.tailwindcss.com"></script>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
		</head>
		<body class="min-h-screen bg-stone-100 text-gray-900">
			<div class="min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
				<aside class="relative overflow-hidden bg-stone-950 px-4 py-4 text-white lg:sticky lg:top-0 lg:flex lg:h-screen lg:flex-col lg:px-5 lg:py-6" style="background: radial-gradient(circle at 15% 5%, rgba(59,130,246,.35), transparent 26%), radial-gradient(circle at 95% 85%, rgba(97,35,204,.45), transparent 32%), #17141f;">
					<div class="flex items-center justify-between lg:block">
						<a href="/" class="flex items-center px-2"><div>@BrandLogo(true, "h-9 w-auto")<p class="mt-2 text-[10px] uppercase tracking-[0.24em] text-stone-400">Administração</p></div></a>
						<form action="/logout" method="post" class="lg:hidden"><button type="submit" class="rounded-xl border border-white/10 px-3 py-2 text-xs text-stone-300"><i class="fas fa-arrow-right-from-bracket mr-1"></i> Sair</button></form>
					</div>
					<nav class="mt-4 flex gap-2 overflow-x-auto lg:mt-10 lg:block lg:space-y-2 lg:overflow-visible" aria-label="Seções do console">
						<a href="/" class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold text-stone-300 transition hover:bg-white/10 hover:text-white"><i class="fas fa-table-columns w-5 text-center"></i> Operação</a>
						<a href="/settings" aria-current="page" class="flex shrink-0 items-center gap-3 rounded-xl bg-white/15 px-4 py-3 text-sm font-semibold text-white shadow-inner ring-1 ring-white/10"><i class="fas fa-sliders w-5 text-center"></i> Configurações</a>
					</nav>
					<div class="mt-auto hidden lg:block"><form action="/logout" method="post"><button type="submit" class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-stone-300 transition hover:bg-white/10 hover:text-white"><i class="fas fa-arrow-right-from-bracket w-5 text-center"></i> Encerrar sessão</button></form></div>
				</aside>
				<main class="min-w-0">
					<header class="border-b border-stone-200 bg-white px-4 py-5 sm:px-6 lg:px-8"><div class="mx-auto max-w-[1280px]"><p class="text-[10px] font-bold uppercase tracking-[0.24em] text-purple-600">Governança da plataforma</p><h1 class="mt-1 text-2xl font-black tracking-tight">Configurações</h1><p class="mt-2 text-sm text-gray-500">Defina o comportamento global de cobrança e mantenha seu acesso administrativo atualizado.</p></div></header>
					<div class="mx-auto max-w-[1280px] space-y-6 p-4 sm:p-6 lg:p-8">
						<div id="saas-settings-error" role="alert" class="hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
						<div id="saas-settings-loading" class="rounded-2xl border border-stone-200 bg-white p-12 text-center text-sm text-gray-500 shadow-sm"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando configurações...</div>
						<div id="saas-settings-content" class="hidden grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
							<form id="platform-settings-form" class="rounded-3xl border border-stone-200 bg-white shadow-sm">
								<div class="border-b border-stone-200 p-6"><div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-purple-100 text-purple-700"><i class="fas fa-credit-card"></i></span><div><h2 class="font-black text-gray-950">Cobrança global</h2><p class="mt-1 text-sm text-gray-500">O provedor padrão vale para todas as empresas sem uma exceção ativa.</p></div></div></div>
								<div class="space-y-5 p-6">
									<div><label for="platform-provider" class="mb-2 block text-sm font-semibold text-gray-700">Forma de pagamento padrão</label><select id="platform-provider" required class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="mercado_pago">PIX/Cartão de crédito</option><option value="abacate_pay">PIX</option><option value="asaas">PIX/Boleto/Cartão de crédito (Asaas)</option></select></div>
									<label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-stone-200 bg-stone-50 p-4"><input id="platform-allow-override" type="checkbox" class="peer sr-only"/><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md border border-stone-300 bg-white text-[10px] text-transparent transition peer-checked:border-purple-600 peer-checked:bg-purple-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-purple-200 peer-focus-visible:ring-offset-2"><i class="fas fa-check"></i></span><span><span class="block text-sm font-bold text-gray-800">Permitir escolha por empresa</span><span class="mt-1 block text-xs leading-relaxed text-gray-500">Administradores das empresas poderão usar um provedor diferente do padrão.</span></span></label>
									<div class="grid gap-5 sm:grid-cols-2">
										<div><label for="platform-timezone" class="mb-2 block text-sm font-semibold text-gray-700">Fuso horário padrão</label><select id="platform-timezone" required class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="America/Sao_Paulo">Brasília (GMT-3)</option><option value="America/Manaus">Manaus (GMT-4)</option><option value="America/Rio_Branco">Rio Branco (GMT-5)</option><option value="America/Noronha">Fernando de Noronha (GMT-2)</option><option value="UTC">UTC</option></select></div>
										<div><label for="platform-grace-days" class="mb-2 block text-sm font-semibold text-gray-700">Dias ativos após vencimento</label><div class="relative"><input id="platform-grace-days" type="number" required min="0" max="90" step="1" class="w-full rounded-xl border border-stone-200 px-4 py-3 pr-14 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-400">dias</span></div><p class="mt-1 text-xs leading-relaxed text-gray-500">Período global em que planos pagos continuam operando após o vencimento, mesmo antes da confirmação do pagamento.</p></div>
									</div>
									<button id="platform-settings-submit" type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gray-950 px-5 py-3 text-sm font-bold text-white shadow-md transition hover:bg-gray-800 disabled:cursor-wait disabled:opacity-60 sm:w-auto"><i class="fas fa-floppy-disk"></i> Salvar cobrança</button>
								</div>
							</form>
							<form id="platform-profile-form" class="rounded-3xl border border-stone-200 bg-white shadow-sm">
								<div class="border-b border-stone-200 p-6"><div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-blue-100 text-blue-700"><i class="fas fa-user-shield"></i></span><div><h2 class="font-black text-gray-950">Seu perfil</h2><p class="mt-1 text-sm text-gray-500">Dados usados no acesso ao console.</p></div></div></div>
								<div class="space-y-5 p-6">
									<div><label for="platform-admin-name" class="mb-2 block text-sm font-semibold text-gray-700">Nome</label><input id="platform-admin-name" required maxlength="80" autocomplete="name" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div>
									<div><label for="platform-admin-email" class="mb-2 block text-sm font-semibold text-gray-700">Email</label><input id="platform-admin-email" type="email" disabled class="w-full cursor-not-allowed rounded-xl border border-stone-200 bg-stone-100 px-4 py-3 text-gray-500"/><p class="mt-2 text-xs text-gray-400">O email do administrador global só pode ser alterado diretamente no banco de dados.</p></div>
									<div class="rounded-xl border border-purple-100 bg-purple-50 p-4"><p class="text-sm font-bold text-purple-900">Verificação em duas etapas ativa</p><p class="mt-1 text-xs leading-relaxed text-purple-700">O login do super admin exige um código TOTP do Google Authenticator após a senha.</p></div>
									<button id="platform-profile-submit" type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-stone-200 bg-stone-50 px-5 py-3 text-sm font-bold text-gray-800 transition hover:bg-stone-100 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-user-check"></i> Atualizar perfil</button>
								</div>
							</form>
						</div>
					</div>
				</main>
			</div>
			<div id="saas-settings-toast" class="fixed bottom-5 right-5 z-50 hidden items-center gap-3 rounded-2xl bg-gray-950 px-5 py-4 text-sm font-medium text-white shadow-2xl" role="status"><i class="fas fa-circle-check text-emerald-400"></i><span id="saas-settings-toast-text"></span></div>
			@AdminControls()
			@ReportCalendars("")
			<script>
const platformSettingsState = { admin: null, settings: null };

async function platformSettingsAPI(method, url, body) {
    const options = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } };
    if (body !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); }
    const response = await fetch(url, options);
    const text = await response.text();
    let payload = null;
    if (text) { try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; } }
    if (response.status === 401) { window.location.href = '/login'; throw new Error('Sessão expirada.'); }
    if (!response.ok) throw new Error((payload && (payload.error || payload.message)) || 'Erro ' + response.status);
    return payload;
}

/*
	<section id="company-panel-ai-credentials" role="tabpanel" aria-labelledby="company-tab-ai-credentials" data-company-settings-panel="ai-credentials" class="mt-4 hidden rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-7">
		<div class="flex flex-col gap-4 border-b border-stone-100 pb-6 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-purple-600">Inteligência artificial</p><h2 class="mt-2 text-xl font-black text-gray-950">Chaves IA</h2><p class="mt-1 max-w-2xl text-sm text-gray-500">Guarde as chaves dos provedores com segurança e escolha-as nos blocos de IA e agentes.</p></div><button id="new-ai-credential" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-gray-800"><i class="fas fa-plus"></i> Nova credencial</button></div>
		<div id="ai-credentials-loading" class="py-12 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando credenciais...</div>
		<div id="ai-credentials-grid" class="mt-6 grid gap-4 lg:grid-cols-2"></div>
		<div id="ai-credentials-empty" class="mt-6 hidden rounded-2xl border border-dashed border-stone-300 bg-stone-50 p-10 text-center"><span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-violet-100 text-xl text-violet-700"><i class="fas fa-key"></i></span><p class="mt-4 font-bold text-gray-700">Nenhuma credencial cadastrada</p><p class="mt-1 text-sm text-gray-500">Crie uma credencial para usar IA nos seus fluxos e agentes.</p></div>
	</section>
	<div id="ai-credential-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="ai-credential-title"><form id="ai-credential-form" class="max-h-[94vh] w-full max-w-xl overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl"><header class="sticky top-0 z-10 flex items-center justify-between border-b border-stone-200 bg-white px-5 py-4 sm:px-7"><div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Acesso ao provedor</p><h2 id="ai-credential-title" class="mt-1 text-xl font-black">Nova credencial IA</h2></div><button id="close-ai-credential" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header><div class="space-y-5 p-5 sm:p-7"><div id="ai-credential-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div><div><label for="ai-credential-name" class="mb-2 block text-sm font-semibold text-gray-700">Nome interno</label><input id="ai-credential-name" required maxlength="100" placeholder="Ex: OpenAI produção" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div><div class="grid gap-5 sm:grid-cols-2"><div><label for="ai-credential-provider" class="mb-2 block text-sm font-semibold text-gray-700">Provedor</label><select id="ai-credential-provider" required class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></select></div><div><label for="ai-credential-model" class="mb-2 block text-sm font-semibold text-gray-700">Modelo</label><select id="ai-credential-model" required class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></select></div></div><div><label for="ai-credential-key" class="mb-2 block text-sm font-semibold text-gray-700">Chave de API</label><input id="ai-credential-key" type="password" autocomplete="new-password" placeholder="Informe a chave do provedor" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><p id="ai-credential-key-help" class="mt-2 text-xs text-gray-500">A chave é criptografada e nunca será exibida novamente.</p></div></div><footer class="flex justify-end gap-3 border-t border-stone-200 bg-stone-50 p-5 sm:px-7"><button id="cancel-ai-credential" type="button" class="rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-bold text-gray-700 hover:bg-stone-100">Cancelar</button><button id="save-ai-credential" type="submit" class="rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-gray-800 disabled:cursor-wait disabled:opacity-60"><i class="fas fa-floppy-disk mr-1"></i> Salvar</button></footer></form></div>
}

templ aiCredentialsRuntime() {
	<script>
const aiCredentialsState = { credentials: [], models: {} };
async function aiCredentialsAPI(method, path, body) { const options = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } }; if (body !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); } const response = await fetch('/management/api/ai-credentials' + path, options); if (response.status === 204) return null; const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Falha na operação.'); return payload.data; }
function aiCredentialEscape(value) { const node = document.createElement('div'); node.textContent = String(value || ''); return node.innerHTML; }
function aiCredentialProviders() { return Array.isArray(aiCredentialsState.models) ? aiCredentialsState.models.map(item => item.provider) : Object.keys(aiCredentialsState.models || {}); }
function aiCredentialModels(provider) { const catalog = aiCredentialsState.models || {}; const values = Array.isArray(catalog) ? catalog.find(item => item.provider === provider)?.models : catalog[provider]; return Array.isArray(values) ? values : []; }
function renderAICredentialModelOptions(selected) { const provider = document.getElementById('ai-credential-provider').value; const models = aiCredentialModels(provider); document.getElementById('ai-credential-model').innerHTML = models.map(model => '<option value="' + aiCredentialEscape(model.id) + '">' + aiCredentialEscape(model.name || model.id) + '<\/option>').join(''); if (models.some(model => model.id === selected)) document.getElementById('ai-credential-model').value = selected; }
function renderAICredentials() { const grid = document.getElementById('ai-credentials-grid'); grid.replaceChildren(); aiCredentialsState.credentials.forEach(credential => { const card = document.createElement('article'); card.className = 'rounded-2xl border border-stone-200 bg-stone-50 p-5'; card.innerHTML = '<div class="flex items-start justify-between gap-3"><div class="min-w-0"><h3 class="truncate font-black text-gray-900">' + aiCredentialEscape(credential.name) + '<\/h3><p class="mt-1 text-xs font-medium text-purple-700">' + aiCredentialEscape(credential.provider) + ' · ' + aiCredentialEscape(credential.model) + '<\/p><p class="mt-3 text-xs text-gray-500"><i class="fas fa-lock mr-1 text-emerald-600"><\/i> Chave ' + (credential.hasApiKey ? 'armazenada com segurança' : 'não configurada') + '<\/p><\/div><i class="fas fa-key text-violet-600"><\/i><\/div><div class="mt-5 flex flex-wrap gap-2"><button type="button" data-ai-test class="rounded-lg bg-violet-100 px-3 py-2 text-xs font-bold text-violet-700 hover:bg-violet-200"><i class="fas fa-plug mr-1"><\/i> Testar<\/button><button type="button" data-ai-edit class="rounded-lg bg-white px-3 py-2 text-xs font-bold text-gray-700 hover:bg-stone-100"><i class="fas fa-pen mr-1"><\/i> Editar<\/button><button type="button" data-ai-delete class="ml-auto rounded-lg bg-red-50 px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-100"><i class="fas fa-trash"><\/i><\/button><\/div>'; card.querySelector('[data-ai-test]').onclick = () => testAICredential(credential); card.querySelector('[data-ai-edit]').onclick = () => openAICredential(credential); card.querySelector('[data-ai-delete]').onclick = () => deleteAICredential(credential); grid.appendChild(card); }); document.getElementById('ai-credentials-loading').classList.add('hidden'); document.getElementById('ai-credentials-empty').classList.toggle('hidden', aiCredentialsState.credentials.length > 0); }
async function loadAICredentials() { const [credentials, models] = await Promise.all([aiCredentialsAPI('GET', ''), aiCredentialsAPI('GET', '/models')]); aiCredentialsState.credentials = credentials || []; aiCredentialsState.models = models || {}; renderAICredentials(); }
function openAICredential(credential) { const form = document.getElementById('ai-credential-form'); form.reset(); form.dataset.id = credential ? credential.id : ''; form.dataset.revision = credential ? credential.revision : ''; const providers = aiCredentialProviders(); document.getElementById('ai-credential-provider').innerHTML = providers.map(provider => '<option value="' + aiCredentialEscape(provider) + '">' + aiCredentialEscape(provider) + '<\/option>').join(''); document.getElementById('ai-credential-name').value = credential ? credential.name : ''; document.getElementById('ai-credential-provider').value = credential ? credential.provider : providers[0]; renderAICredentialModelOptions(credential ? credential.model : ''); document.getElementById('ai-credential-key').value = ''; document.getElementById('ai-credential-key').required = !credential; document.getElementById('ai-credential-key-help').textContent = credential ? 'Deixe em branco para manter a chave atual. A chave salva nunca é exibida.' : 'A chave é criptografada e nunca será exibida novamente.'; document.getElementById('ai-credential-title').textContent = credential ? 'Editar credencial IA' : 'Nova credencial IA'; document.getElementById('ai-credential-error').classList.add('hidden'); const modal = document.getElementById('ai-credential-modal'); modal.classList.remove('hidden'); modal.classList.add('flex'); setTimeout(() => document.getElementById('ai-credential-name').focus(), 50); }
function closeAICredential() { const modal = document.getElementById('ai-credential-modal'); modal.classList.add('hidden'); modal.classList.remove('flex'); }
async function deleteAICredential(credential) { if (!confirm('Excluir a credencial "' + credential.name + '"?')) return; try { await aiCredentialsAPI('DELETE', '/' + credential.id); await loadAICredentials(); } catch (error) { showCompanySettingsError(error); } }
async function testAICredential(credential) { try { const result = await aiCredentialsAPI('POST', '/' + credential.id + '/test'); alert('Conexão validada: ' + (result.message || 'provedor respondeu corretamente.')); } catch (error) { showCompanySettingsError(error); } }
document.getElementById('new-ai-credential').onclick = () => openAICredential(null); document.getElementById('close-ai-credential').onclick = closeAICredential; document.getElementById('cancel-ai-credential').onclick = closeAICredential; document.getElementById('ai-credential-provider').onchange = () => renderAICredentialModelOptions(''); document.getElementById('ai-credential-modal').addEventListener('click', event => { if (event.target.id === 'ai-credential-modal') closeAICredential(); }); document.getElementById('ai-credential-form').onsubmit = async event => { event.preventDefault(); const form = event.currentTarget; const id = form.dataset.id; const submit = document.getElementById('save-ai-credential'); submit.disabled = true; try { await aiCredentialsAPI(id ? 'PUT' : 'POST', id ? '/' + id : '', { name: document.getElementById('ai-credential-name').value.trim(), provider: document.getElementById('ai-credential-provider').value, model: document.getElementById('ai-credential-model').value, apiKey: document.getElementById('ai-credential-key').value, revision: Number(form.dataset.revision || 0) }); closeAICredential(); await loadAICredentials(); } catch (error) { const box = document.getElementById('ai-credential-error'); box.textContent = error.message; box.classList.remove('hidden'); } finally { submit.disabled = false; } };
loadAICredentials().catch(error => { document.getElementById('ai-credentials-loading').classList.add('hidden'); showCompanySettingsError(error); });
	<\/script>
*/

function showPlatformSettingsError(error) {
    const box = document.getElementById('saas-settings-error');
    box.textContent = error instanceof Error ? error.message : String(error);
    box.classList.remove('hidden');
}

let platformSettingsToastTimer;
function showPlatformSettingsToast(message) {
    const toast = document.getElementById('saas-settings-toast');
    document.getElementById('saas-settings-toast-text').textContent = message;
    toast.classList.remove('hidden'); toast.classList.add('flex');
    clearTimeout(platformSettingsToastTimer);
    platformSettingsToastTimer = setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 3200);
}

function renderPlatformSettings() {
    const settings = platformSettingsState.settings || {};
    const admin = platformSettingsState.admin || {};
    document.getElementById('platform-provider').value = settings.paymentProvider || 'mercado_pago';
    document.getElementById('platform-allow-override').checked = Boolean(settings.allowCompanyPaymentOverride);
	setSettingsTimezone(document.getElementById('platform-timezone'), settings.defaultTimezone || 'America/Sao_Paulo');
    document.getElementById('platform-grace-days').value = String(settings.subscriptionGraceDays || 0);
    document.getElementById('platform-admin-name').value = admin.name || '';
    document.getElementById('platform-admin-email').value = admin.email || '';
    document.getElementById('saas-settings-loading').classList.add('hidden');
    document.getElementById('saas-settings-content').classList.remove('hidden');
	if (window.refreshAdminSelects) window.refreshAdminSelects();
}

function setSettingsTimezone(select, value) {
	if (value && !Array.from(select.options).some(option => option.value === value)) {
		const option = document.createElement('option'); option.value = value; option.textContent = value; select.appendChild(option);
	}
	select.value = value;
}

async function loadPlatformSettings() {
    const response = await platformSettingsAPI('GET', '/management/api/settings');
    const data = response && response.data ? response.data : {};
    platformSettingsState.admin = data.admin || null;
    platformSettingsState.settings = data.settings || null;
    renderPlatformSettings();
}

document.getElementById('platform-settings-form').addEventListener('submit', async event => {
    event.preventDefault();
    const button = document.getElementById('platform-settings-submit'); button.disabled = true;
    try {
        const response = await platformSettingsAPI('PUT', '/management/api/settings', {
            paymentProvider: document.getElementById('platform-provider').value,
            allowCompanyPaymentOverride: document.getElementById('platform-allow-override').checked,
            defaultTimezone: document.getElementById('platform-timezone').value,
            subscriptionGraceDays: Number(document.getElementById('platform-grace-days').value)
        });
        platformSettingsState.settings = response.data; renderPlatformSettings(); showPlatformSettingsToast('Configurações de cobrança atualizadas.');
    } catch (error) { showPlatformSettingsError(error); } finally { button.disabled = false; }
});

document.getElementById('platform-profile-form').addEventListener('submit', async event => {
    event.preventDefault();
    const button = document.getElementById('platform-profile-submit'); button.disabled = true;
    try {
        const response = await platformSettingsAPI('PUT', '/management/api/profile', {
            name: document.getElementById('platform-admin-name').value.trim(),
            email: document.getElementById('platform-admin-email').value.trim()
        });
		platformSettingsState.admin = response.data;
		if (response.reauthenticate) { window.location.href = '/login'; return; }
		renderPlatformSettings(); showPlatformSettingsToast('Perfil atualizado.');
    } catch (error) { showPlatformSettingsError(error); } finally { button.disabled = false; }
});

loadPlatformSettings().catch(error => { document.getElementById('saas-settings-loading').classList.add('hidden'); showPlatformSettingsError(error); });
			</script>
		</body>
	</html>
}

templ companySettingToggle(id, title, description string) {
	<label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-stone-200 bg-stone-50 p-4 transition hover:border-purple-200 hover:bg-purple-50/30"><input id={ id } type="checkbox" class="peer sr-only"/><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md border border-stone-300 bg-white text-[10px] text-transparent transition peer-checked:border-purple-600 peer-checked:bg-purple-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-purple-300 peer-focus-visible:ring-offset-2"><i class="fas fa-check"></i></span><span><span class="block text-sm font-bold text-gray-900">{ title }</span><span class="mt-1 block text-xs leading-relaxed text-gray-500">{ description }</span></span></label>
}

templ browserNotificationToggle(setting, icon, title, description string) {
	<label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-stone-200 bg-stone-50 p-4 transition hover:border-purple-200 hover:bg-purple-50/30"><input data-notification-setting={ setting } type="checkbox" class="peer sr-only" checked/><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md border border-stone-300 bg-white text-[10px] text-transparent transition peer-checked:border-purple-600 peer-checked:bg-purple-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-purple-300 peer-focus-visible:ring-offset-2"><i class="fas fa-check"></i></span><span class="flex min-w-0 gap-3"><i class={ "fas mt-0.5 w-4 shrink-0 text-center text-purple-500", icon }></i><span><span class="block text-sm font-bold text-gray-900">{ title }</span><span class="mt-1 block text-xs leading-relaxed text-gray-500">{ description }</span></span></span></label>
}

templ companyAttachmentToggle(value, label string) {
	<label class="cursor-pointer"><input type="checkbox" data-company-attachment={ value } class="peer sr-only"/><span class="block rounded-xl border border-stone-200 bg-white px-3 py-2.5 text-center text-xs font-bold text-gray-600 transition peer-checked:border-purple-500 peer-checked:bg-purple-50 peer-checked:text-purple-700 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-200">{ label }</span></label>
}

templ companyBusinessDay(value, label string) {
	<label class="cursor-pointer"><input type="checkbox" data-company-business-day={ value } class="peer sr-only"/><span class="block rounded-xl border border-stone-200 bg-white px-3 py-2.5 text-center text-xs font-bold text-gray-600 transition peer-checked:border-purple-500 peer-checked:bg-purple-50 peer-checked:text-purple-700 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-200">{ label }</span></label>
}

templ companySettingsPanelHeader(icon, eyebrow, title, description string) {
	<header class="flex items-start gap-4 border-b border-stone-100 px-5 py-5 sm:px-7">
		<span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-purple-100 text-purple-700"><i class={ "fas", icon }></i></span>
		<div><p class="text-[10px] font-bold uppercase tracking-[.18em] text-purple-600">{ eyebrow }</p><h2 class="mt-1 text-lg font-black text-gray-950 sm:text-xl">{ title }</h2><p class="mt-1 max-w-2xl text-sm leading-relaxed text-gray-500">{ description }</p></div>
	</header>
}

templ CompanySettings() {
	@base("settings") {
		<main class="min-w-0 flex-1 overflow-y-auto rounded-2xl bg-stone-50 shadow-sm">
			<div class="mx-auto max-w-[1280px] p-4 sm:p-6 lg:p-8">
				<style>
					.company-settings-tab[aria-selected="true"] { border-color: #c4b5fd; background: #f5f3ff; color: #6d28d9; }
					.company-settings-tab[aria-selected="true"] .company-settings-tab-icon { background: #7c3aed; color: white; }
				</style>
				<header><p class="text-xs font-bold uppercase tracking-[0.2em] text-purple-600">Administração da conta</p><h1 class="mt-2 text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Configurações da empresa</h1><p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-500">Escolha uma área abaixo para ajustar como a empresa, o atendimento e as automações funcionam.</p></header>
				<div id="company-settings-error" role="alert" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
				<div id="company-settings-loading" class="mt-6 rounded-3xl border border-stone-200 bg-white p-16 text-center text-sm text-gray-500 shadow-sm"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando configurações...</div>
				<div id="company-settings-content" class="mt-6 hidden">
					<nav class="overflow-x-auto rounded-2xl border border-stone-200 bg-white p-2 shadow-sm" aria-label="Áreas das configurações">
						<div class="grid min-w-[1170px] grid-cols-9 gap-2" role="tablist" aria-label="Configurações da empresa">
							<button id="company-tab-company" type="button" role="tab" aria-selected="true" aria-controls="company-panel-company" data-company-settings-tab="company" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-building"></i></span> Empresa</button>
							<button id="company-tab-messages" type="button" role="tab" aria-selected="false" aria-controls="company-panel-messages" data-company-settings-tab="messages" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-comments"></i></span> Mensagens</button>
							<button id="company-tab-automation" type="button" role="tab" aria-selected="false" aria-controls="company-panel-automation" data-company-settings-tab="automation" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-wand-magic-sparkles"></i></span> Automação</button>
							<button id="company-tab-hours" type="button" role="tab" aria-selected="false" aria-controls="company-panel-hours" data-company-settings-tab="hours" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-clock"></i></span> Horários</button>
							<button id="company-tab-data" type="button" role="tab" aria-selected="false" aria-controls="company-panel-data" data-company-settings-tab="data" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-photo-film"></i></span> Mídias</button>
							<button id="company-tab-ai-credentials" type="button" role="tab" aria-selected="false" aria-controls="company-panel-ai-credentials" data-company-settings-tab="ai-credentials" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-key"></i></span> Chaves IA</button>
							<button id="company-tab-integrations" type="button" role="tab" aria-selected="false" aria-controls="company-panel-integrations" data-company-settings-tab="integrations" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-puzzle-piece"></i></span> Integrações</button>
							<button id="company-tab-billing" type="button" role="tab" aria-selected="false" aria-controls="company-panel-billing" data-company-settings-tab="billing" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-credit-card"></i></span> Cobrança</button>
							<button id="company-tab-logs" type="button" role="tab" aria-selected="false" aria-controls="company-panel-logs" data-company-settings-tab="logs" class="company-settings-tab flex items-center gap-2 rounded-xl border border-transparent px-3 py-2.5 text-left text-xs font-bold text-gray-600 transition hover:bg-stone-50"><span class="company-settings-tab-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-stone-100 text-gray-500 transition"><i class="fas fa-clock-rotate-left"></i></span> Logs</button>
						</div>
					</nav>
					<form id="company-settings-form" novalidate class="mt-4 overflow-visible rounded-3xl border border-stone-200 bg-white shadow-sm">
						<section id="company-panel-company" role="tabpanel" aria-labelledby="company-tab-company" data-company-settings-panel="company">
							@companySettingsPanelHeader("fa-building", "Dados básicos", "Empresa e cobrança", "Informações que identificam sua conta e definem como novas cobranças serão criadas.")
							<div class="grid gap-6 p-5 sm:p-7 lg:grid-cols-[1.1fr_.9fr]">
								<div class="space-y-5">
									<div><label for="company-settings-name" class="mb-2 block text-sm font-bold text-gray-700">Nome da empresa</label><input id="company-settings-name" required maxlength="160" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><p class="mt-1.5 text-xs text-gray-500">Nome usado para identificar sua empresa dentro da plataforma.</p></div>
									<div><label for="company-settings-email" class="mb-2 block text-sm font-bold text-gray-700">Email financeiro</label><input id="company-settings-email" type="email" required maxlength="180" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><p class="mt-1.5 text-xs text-gray-500">Email vinculado ao cadastro financeiro da empresa.</p></div>
									<div><label for="company-settings-timezone" class="mb-2 block text-sm font-bold text-gray-700">Fuso horário</label><select id="company-settings-timezone" required class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="America/Sao_Paulo">Brasília (GMT-3)</option><option value="America/Manaus">Manaus (GMT-4)</option><option value="America/Rio_Branco">Rio Branco (GMT-5)</option><option value="America/Noronha">Fernando de Noronha (GMT-2)</option><option value="UTC">UTC</option></select><p class="mt-1.5 text-xs text-gray-500">Usado para calcular horários de atendimento e datas da empresa.</p></div>
								</div>
								<aside class="rounded-2xl bg-stone-950 p-5 text-white sm:p-6" style="background: radial-gradient(circle at 90% 10%, rgba(59,130,246,.38), transparent 32%), radial-gradient(circle at 10% 100%, rgba(97,35,204,.45), transparent 38%), #17141f;">
									<p class="text-[10px] font-bold uppercase tracking-[.18em] text-blue-200">Cobrança</p><h3 class="mt-2 text-lg font-black">Forma de pagamento</h3><p class="mt-2 text-sm leading-relaxed text-stone-400">A escolha vale somente para cobranças criadas depois da alteração.</p>
									<div class="mt-5 rounded-2xl border border-white/10 bg-white/5 p-4"><p class="text-[10px] font-bold uppercase tracking-[0.18em] text-stone-400">Provedor atual</p><p id="company-effective-provider" class="mt-2 text-lg font-black">-</p><p id="company-provider-policy" class="mt-1 text-xs text-stone-400"></p></div>
									<div class="mt-5"><label for="company-provider-override" class="mb-2 block text-sm font-semibold text-stone-200">Provedor para novas cobranças</label><select id="company-provider-override" data-admin-theme="dark" class="w-full"><option value="">Usar o padrão da plataforma</option><option value="mercado_pago">PIX/Cartão de crédito</option><option value="abacate_pay">PIX</option><option value="asaas">PIX/Boleto/Cartão de crédito (Asaas)</option></select></div>
									<div class="mt-5 flex gap-3 rounded-2xl border border-amber-300/15 bg-amber-300/10 p-4 text-xs leading-relaxed text-amber-100"><i class="fas fa-clock mt-0.5 text-amber-300"></i><p>Após o vencimento, o plano continua ativo por <strong id="company-grace-days">0 dias</strong>.</p></div>
								</aside>
							</div>
						</section>
						<section id="company-panel-messages" role="tabpanel" aria-labelledby="company-tab-messages" data-company-settings-panel="messages" class="hidden">
							@companySettingsPanelHeader("fa-comments", "Atendimento", "Mensagens e contatos", "Controle quais conversas entram na plataforma e como os atendentes podem responder.")
							<div class="mx-5 mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-purple-100 bg-purple-50 p-4 sm:mx-7"><div><p class="text-sm font-bold text-purple-900">Respostas rápidas</p><p class="mt-1 text-xs text-purple-700">Configure atalhos compartilhados e use / no campo de mensagem.</p></div><a href="/quick-replies" class="rounded-lg bg-white px-4 py-2 text-xs font-bold text-purple-700 shadow-sm hover:bg-purple-100"><i class="fas fa-bolt mr-1"></i>Gerenciar atalhos</a></div>
							<div class="grid gap-4 p-5 sm:p-7 lg:grid-cols-2">
								<div class="space-y-4">
									@companySettingToggle("company-outbound-enabled", "Permitir criação de conversas pelo telefone", "Ao enviar uma mensagem pelo celular ou dispositivo vinculado, permite criar ou reabrir um atendimento na plataforma. Desativada, registra apenas em atendimentos já existentes, sem abrir um novo.")
									@companySettingToggle("company-accept-groups", "Receber mensagens de grupos", "Quando desligado, mensagens de grupos do WhatsApp não são registradas na plataforma.")
									@companySettingToggle("company-platform-contacts-only", "Aceitar apenas contatos já cadastrados", "Ignora mensagens de números que ainda não existem na lista de contatos da plataforma.")
								</div>
								<div class="space-y-4">
									<div><label for="company-message-edit-policy" class="mb-2 block text-sm font-bold text-gray-700">Edição de mensagens</label><select id="company-message-edit-policy" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm"><option value="disabled">Edição desabilitada</option><option value="admins">Somente admins</option><option value="all">Todos podem editar</option></select><p class="mt-2 text-xs leading-relaxed text-gray-500">Permite editar textos enviados nos últimos 15 minutos, respeitando o acesso de cada atendente à conversa. A alteração também é enviada ao WhatsApp.</p></div>
									<a href="/preferences" class="block rounded-2xl border border-purple-100 bg-purple-50 p-4 text-sm font-bold text-purple-700"><i class="fas fa-sliders mr-2"></i>Personalize mensagens e notificações em suas Preferências</a>
								</div>
							</div>
						</section>
						<section id="company-panel-automation" role="tabpanel" aria-labelledby="company-tab-automation" data-company-settings-panel="automation" class="hidden">
							@companySettingsPanelHeader("fa-wand-magic-sparkles", "Operação", "Automação e distribuição", "Defina quando os fluxos são iniciados, quem recebe novas conversas e quando atendimentos parados são encerrados.")
							<div class="grid gap-5 p-5 sm:p-7 lg:grid-cols-2">
								<div class="space-y-4">
									@companySettingToggle("company-flows-all", "Iniciar fluxos com mensagens recebidas", "Permite que mensagens de clientes iniciem os fluxos automáticos configurados para a conexão.")
									@companySettingToggle("company-auto-assign", "Distribuir novas conversas automaticamente", "Entrega novas conversas aos atendentes disponíveis sem precisar de distribuição manual.")
								</div>
								<div class="space-y-5 rounded-2xl border border-stone-200 bg-stone-50 p-5">
									<div><label for="company-auto-assign-strategy" class="mb-2 block text-sm font-bold text-gray-700">Como escolher o atendente</label><select id="company-auto-assign-strategy" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm"><option value="least_loaded">Quem tem menos conversas</option><option value="random">Escolher aleatoriamente</option></select><p class="mt-1.5 text-xs text-gray-500">Aplicado somente quando a distribuição automática está ligada.</p></div>
									<div><label for="company-auto-close" class="mb-2 block text-sm font-bold text-gray-700">Encerrar conversa sem atividade</label><div class="relative"><input id="company-auto-close" type="number" min="0" max="43200" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 pr-20 text-sm"/><span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs text-gray-400">minutos</span></div><p class="mt-1.5 text-xs text-gray-500">Encerra conversas após esse tempo sem mensagens. Use 0 para nunca encerrar automaticamente.</p></div>
								</div>
							</div>
						</section>
						<section id="company-panel-hours" role="tabpanel" aria-labelledby="company-tab-hours" data-company-settings-panel="hours" class="hidden">
							@companySettingsPanelHeader("fa-clock", "Disponibilidade", "Horários e respostas automáticas", "Informe quando sua equipe atende e quais mensagens o cliente recebe no primeiro contato.")
							<div class="grid gap-6 p-5 sm:p-7 lg:grid-cols-2">
								<div class="space-y-5">
									@companySettingToggle("company-hours-enabled", "Usar horário de atendimento", "Fora dos dias e horários escolhidos, a plataforma envia a mensagem de ausência no primeiro contato.")
									<div><p class="mb-2 text-sm font-bold text-gray-700">Dias com atendimento</p><div class="grid grid-cols-4 gap-2 sm:grid-cols-7">@companyBusinessDay("0", "Dom") @companyBusinessDay("1", "Seg") @companyBusinessDay("2", "Ter") @companyBusinessDay("3", "Qua") @companyBusinessDay("4", "Qui") @companyBusinessDay("5", "Sex") @companyBusinessDay("6", "Sáb")</div><p id="company-business-days-error" role="alert" class="mt-2 hidden text-xs font-medium text-red-600">Escolha pelo menos um dia de atendimento.</p></div>
									<div class="grid grid-cols-2 gap-3"><label class="text-sm font-bold text-gray-700">Abre às<input id="company-hours-start" type="time" required class="mt-2 w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm"/></label><label class="text-sm font-bold text-gray-700">Fecha às<input id="company-hours-end" type="time" required class="mt-2 w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm"/></label></div>
									@companySettingToggle("company-lunch-enabled", "Considerar intervalo sem atendimento", "Durante esse período, a empresa será tratada como fora do horário de atendimento.")
									<div class="grid grid-cols-2 gap-3"><label class="text-sm font-bold text-gray-700">Intervalo começa<input id="company-lunch-start" type="time" required class="mt-2 w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm"/></label><label class="text-sm font-bold text-gray-700">Intervalo termina<input id="company-lunch-end" type="time" required class="mt-2 w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm"/></label></div>
								</div>
								<div class="space-y-5">
									<div><label for="company-welcome-message" class="mb-2 block text-sm font-bold text-gray-700">Boas-vindas no primeiro contato</label><textarea id="company-welcome-message" maxlength="1000" rows="5" placeholder="Olá! Recebemos sua mensagem e já vamos atender você." class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></textarea><p class="mt-1.5 text-xs text-gray-500">Enviada automaticamente quando uma nova conversa recebe sua primeira mensagem.</p></div>
									<div><label for="company-outside-message" class="mb-2 block text-sm font-bold text-gray-700">Resposta fora do horário</label><textarea id="company-outside-message" maxlength="1000" rows="5" placeholder="Olá! No momento estamos fora do horário de atendimento." class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"></textarea><p class="mt-1.5 text-xs text-gray-500">Substitui as boas-vindas quando o primeiro contato acontece fora do horário configurado.</p></div>
								</div>
							</div>
						</section>
						<section id="company-panel-data" role="tabpanel" aria-labelledby="company-tab-data" data-company-settings-panel="data" class="hidden">
								@companySettingsPanelHeader("fa-photo-film", "Armazenamento", "Mídias, arquivos e atualização", "Defina limites de anexos, limpeza automática e atualização das listas de conversa.")
							<div class="space-y-6 p-5 sm:p-7">
								<section id="billing-storage-card" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6"><div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[.18em] text-purple-600">Uso de mídias</p><h2 class="mt-2 text-xl font-black text-gray-950"><span id="billing-storage-used">-</span> utilizados</h2><p id="billing-storage-copy" class="mt-1 text-sm text-gray-500"></p></div><a href="/media" class="inline-flex items-center justify-center gap-2 rounded-xl border border-stone-200 px-4 py-2.5 text-sm font-bold text-gray-700 hover:bg-stone-50"><i class="fas fa-photo-film"></i> Gerenciar mídias</a></div><div class="mt-5 h-2.5 overflow-hidden rounded-full bg-stone-100"><div id="billing-storage-bar" class="h-full rounded-full bg-gradient-to-r from-blue-500 to-purple-600" style="width:0%"></div></div><div id="billing-storage-upgrade" class="mt-4 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800"><i class="fas fa-arrow-up-right-dots mr-2"></i>Seu espaço está próximo do limite. Selecione um plano com mais armazenamento na aba Cobrança.</div></section>
								<div class="grid gap-6 lg:grid-cols-2">
								<div class="space-y-5">
									<div><label for="company-media-retention" class="mb-2 block text-sm font-bold text-gray-700">Apagar arquivos antigos</label><select id="company-media-retention" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"><option value="">Nunca apagar automaticamente</option><option value="30">Depois de 30 dias</option><option value="90">Depois de 90 dias</option><option value="120">Depois de 120 dias</option></select><p class="mt-1.5 text-xs leading-relaxed text-gray-500">Apaga fotos, vídeos, áudios e documentos antigos das mensagens. O texto da conversa e arquivos usados em automações são mantidos.</p></div>
									<div><label for="company-conversation-retention" class="mb-2 block text-sm font-bold text-gray-700">Apagar conversas encerradas</label><div class="relative"><input id="company-conversation-retention" type="number" min="0" max="3650" class="w-full rounded-xl border border-stone-200 px-4 py-3 pr-16 text-sm"/><span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs text-gray-400">dias</span></div><p class="mt-1.5 text-xs leading-relaxed text-gray-500">Exclui permanentemente conversas encerradas há mais tempo que o informado. Use 0 para manter todas.</p></div>
								</div>
								<div class="space-y-5">
									<div><label for="company-max-attachment" class="mb-2 block text-sm font-bold text-gray-700">Tamanho máximo por arquivo</label><div class="relative"><input id="company-max-attachment" type="number" min="1" max="50" class="w-full rounded-xl border border-stone-200 px-4 py-3 pr-14 text-sm"/><span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs text-gray-400">MB</span></div><p class="mt-1.5 text-xs text-gray-500">Limite aplicado aos arquivos enviados pela plataforma e pelas automações.</p></div>
									<div><p class="mb-2 text-sm font-bold text-gray-700">Tipos de arquivo permitidos</p><div class="grid grid-cols-2 gap-2 sm:grid-cols-4">@companyAttachmentToggle("image", "Imagens") @companyAttachmentToggle("video", "Vídeos") @companyAttachmentToggle("audio", "Áudios") @companyAttachmentToggle("document", "Documentos")</div><p id="company-attachments-error" role="alert" class="mt-2 hidden text-xs font-medium text-red-600">Escolha pelo menos um tipo de arquivo.</p></div>
									@companySettingToggle("company-notify-new", "Atualizar novas conversas em tempo real", "Mostra novas conversas na lista dos atendentes sem precisar atualizar a página.")
								</div>
								</div>
							</div>
						</section>
						<input id="company-accept-calls" type="checkbox" class="hidden" tabindex="-1" aria-hidden="true"/>
						<input id="company-notify-mentions" type="checkbox" class="hidden" tabindex="-1" aria-hidden="true"/>
						<input id="company-notify-unanswered" type="checkbox" class="hidden" tabindex="-1" aria-hidden="true"/>
						<div class="flex flex-col gap-3 rounded-b-[1.4rem] border-t border-stone-200 bg-stone-50 p-5 sm:flex-row sm:items-center sm:justify-between sm:px-7"><p class="text-xs text-gray-500"><i class="fas fa-circle-info mr-1 text-purple-600"></i> As alterações só entram em vigor depois de salvar.</p><button id="company-settings-submit" type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gray-950 px-5 py-3 text-sm font-bold text-white shadow-md transition hover:bg-gray-800 disabled:cursor-wait disabled:opacity-60 sm:w-auto"><i class="fas fa-floppy-disk"></i> Salvar alterações</button></div>
					</form>
				<section id="company-panel-integrations" role="tabpanel" aria-labelledby="company-tab-integrations" data-company-settings-panel="integrations" class="mt-4 hidden rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-7">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-purple-600">Integrações</p><h2 class="mt-2 text-xl font-black text-gray-950">Botões flutuantes do WhatsApp</h2><p class="mt-1 max-w-2xl text-sm text-gray-500">Crie botões para os sites da empresa e compartilhe seu número de atendimento.</p></div><button id="new-whatsapp-widget" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-gray-800"><i class="fas fa-plus"></i> Novo botão</button></div>
					<div id="whatsapp-widgets-loading" class="py-12 text-center text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin mr-2 text-purple-600"></i> Carregando integrações...</div>
					<div id="whatsapp-widgets-grid" class="mt-6 grid gap-4 lg:grid-cols-2"></div>
					<div id="whatsapp-widgets-empty" class="mt-6 hidden rounded-2xl border border-dashed border-stone-300 bg-stone-50 p-10 text-center"><span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-emerald-100 text-xl text-emerald-700"><i class="fab fa-whatsapp"></i></span><p class="mt-4 font-bold text-gray-700">Nenhum botão criado</p><p class="mt-1 text-sm text-gray-500">Crie o primeiro botão e copie o código para seu site.</p></div>
				</section>
				@aiCredentialsSettings()
				@companyBillingPanel()
				@companyAuditPanel()
				</div>
			</div>
		</main>
		<div id="whatsapp-widget-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-stone-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-5" role="dialog" aria-modal="true" aria-labelledby="whatsapp-widget-title"><div class="max-h-[94vh] w-full max-w-3xl overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:rounded-3xl"><header class="sticky top-0 z-10 flex items-center justify-between border-b border-stone-200 bg-white px-5 py-4 sm:px-7"><div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-purple-600">Integração para sites</p><h2 id="whatsapp-widget-title" class="mt-1 text-xl font-black">Novo botão do WhatsApp</h2></div><button id="close-whatsapp-widget" type="button" class="grid h-10 w-10 place-items-center rounded-xl bg-stone-100 text-gray-500 hover:bg-stone-200" aria-label="Fechar"><i class="fas fa-xmark"></i></button></header><form id="whatsapp-widget-form" class="p-5 sm:p-7"><div id="whatsapp-widget-error" class="mb-5 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div><div class="grid gap-6 lg:grid-cols-[1fr_.85fr]"><div class="space-y-5"><div><label for="whatsapp-widget-name" class="mb-2 block text-sm font-semibold text-gray-700">Nome interno</label><input id="whatsapp-widget-name" required maxlength="80" placeholder="Ex: Site institucional" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div><div><label for="whatsapp-widget-phone" class="mb-2 block text-sm font-semibold text-gray-700">Número do WhatsApp</label><input id="whatsapp-widget-phone" type="tel" required maxlength="24" placeholder="Ex: +55 11 99999-9999" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/><p class="mt-2 text-xs text-gray-500">Informe o DDI e o DDD. Pontuação e espaços serão removidos automaticamente.</p></div><div><label for="whatsapp-widget-cta" class="mb-2 block text-sm font-semibold text-gray-700">Texto de chamada</label><input id="whatsapp-widget-cta" required maxlength="80" value="Fale conosco no WhatsApp" class="w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100"/></div><div><label for="whatsapp-widget-color" class="mb-2 block text-sm font-semibold text-gray-700">Cor do botão</label><div class="flex items-center gap-3 rounded-xl border border-stone-200 p-2"><input id="whatsapp-widget-color" type="color" value="#25D366" class="h-10 w-14 cursor-pointer rounded-lg border-0 p-0"/><code id="whatsapp-widget-color-value" class="text-sm font-bold text-gray-600">#25D366</code></div></div><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-stone-200 bg-stone-50 px-4 py-3"><input id="whatsapp-widget-active" type="checkbox" checked class="peer sr-only"/><span class="grid h-5 w-5 place-items-center rounded-md border border-stone-300 bg-white text-[10px] text-transparent peer-checked:border-purple-600 peer-checked:bg-purple-600 peer-checked:text-white"><i class="fas fa-check"></i></span><span><span class="block text-sm font-semibold text-gray-700">Botão ativo</span><span class="block text-xs text-gray-500">Quando desativado, deixa de aparecer nos sites.</span></span></label></div><aside class="flex min-h-72 flex-col rounded-2xl bg-stone-950 p-5 text-white" style="background: radial-gradient(circle at 85% 15%, rgba(59,130,246,.3), transparent 32%), #17141f;"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-stone-400">Pré-visualização</p><div class="relative mt-4 flex flex-1 items-end justify-end overflow-hidden rounded-xl border border-white/10 bg-white/5 p-4"><span class="absolute left-4 top-4 h-2 w-20 rounded bg-white/10"></span><span class="absolute left-4 top-9 h-2 w-32 rounded bg-white/5"></span><div id="whatsapp-widget-preview" class="flex min-h-14 items-center gap-2.5 rounded-full px-5 text-sm font-bold text-white shadow-xl" style="background:#25D366"><i class="fab fa-whatsapp text-2xl"></i><span>Fale conosco no WhatsApp</span></div></div><p class="mt-4 text-xs leading-relaxed text-stone-400">O botão será fixado no canto inferior direito do site.</p></aside></div><div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><button id="cancel-whatsapp-widget" type="button" class="rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-stone-50">Cancelar</button><button id="save-whatsapp-widget" type="submit" class="rounded-xl bg-gray-950 px-5 py-3 text-sm font-bold text-white hover:bg-gray-800 disabled:opacity-60">Salvar botão</button></div></form></div></div>
		<div id="company-settings-toast" class="fixed bottom-5 right-5 z-50 hidden items-center gap-3 rounded-2xl bg-gray-950 px-5 py-4 text-sm font-medium text-white shadow-2xl" role="status"><i class="fas fa-circle-check text-emerald-400"></i><span>Configurações atualizadas.</span></div>
		@AdminControls()
		@billingRuntime()
		@aiCredentialsRuntime()
		@companyAuditRuntime()
		<script>
let companySettingsState = null;
let whatsAppWidgets = [];

async function companySettingsAPI(method, body) {
    const options = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } };
    if (body !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); }
    const response = await fetch('/management/api/settings', options);
    const text = await response.text();
    let payload = null;
    if (text) { try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; } }
    if (!response.ok) throw new Error((payload && (payload.error || payload.message)) || 'Erro ' + response.status);
    return payload;
}

function companyProviderLabel(provider) { return provider === 'abacate_pay' ? 'PIX' : provider === 'mercado_pago' ? 'PIX/Cartão de crédito' : provider === 'asaas' ? 'PIX/Boleto/Cartão de crédito (Asaas)' : 'Não informado'; }

async function whatsAppWidgetAPI(method, path, body) {
	const options = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } };
	if (body !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); }
	const response = await fetch('/management/api/integrations/whatsapp' + (path || ''), options);
	if (response.status === 204) return null;
	const text = await response.text(); let payload = {};
	if (text) { try { payload = JSON.parse(text); } catch (_) { payload = { error: text }; } }
	if (!response.ok) throw new Error(payload.error || 'Erro ' + response.status);
	return payload;
}

function whatsAppWidgetCard(widget) {
	const card = document.createElement('article'); card.className = 'overflow-hidden rounded-2xl border border-stone-200 bg-stone-50';
	const preview = document.createElement('div'); preview.className = 'flex min-h-32 items-end justify-end p-4';
	const button = document.createElement('span'); button.className = widget.iconOnly ? 'flex h-14 w-14 items-center justify-center rounded-full text-white shadow-lg' : 'flex min-h-12 items-center gap-2 rounded-full px-4 text-xs font-bold text-white shadow-lg'; button.style.background = widget.color; button.innerHTML = '<i class="fab fa-whatsapp text-xl"><\/i>' + (widget.iconOnly ? '' : '<span><\/span>'); if (!widget.iconOnly) button.querySelector('span').textContent = widget.callToAction; preview.appendChild(button);
	const content = document.createElement('div'); content.className = 'border-t border-stone-200 bg-white p-4';
	const heading = document.createElement('div'); heading.className = 'flex items-start justify-between gap-3'; const title = document.createElement('div'); title.className = 'min-w-0'; title.innerHTML = '<h3 class="truncate font-bold text-gray-900"><\/h3><p class="mt-1 text-xs text-gray-500"><\/p>'; title.querySelector('h3').textContent = widget.name; title.querySelector('p').textContent = '+' + widget.phoneNumber; const status = document.createElement('span'); status.className = 'shrink-0 rounded-full px-2.5 py-1 text-[10px] font-bold ' + (widget.isActive ? 'bg-emerald-100 text-emerald-700' : 'bg-stone-100 text-gray-500'); status.textContent = widget.isActive ? 'Ativo' : 'Inativo'; heading.append(title, status);
	const code = document.createElement('textarea'); code.readOnly = true; code.rows = 2; code.value = widget.embedCode; code.className = 'mt-4 w-full resize-none rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 font-mono text-[10px] text-gray-600';
	const actions = document.createElement('div'); actions.className = 'mt-3 flex flex-wrap gap-2';
	const copy = document.createElement('button'); copy.type = 'button'; copy.className = 'rounded-lg bg-purple-50 px-3 py-2 text-xs font-bold text-purple-700 hover:bg-purple-100'; copy.innerHTML = '<i class="fas fa-copy mr-1"><\/i> Copiar código'; copy.onclick = () => copyWhatsAppWidgetCode(code, copy);
	const edit = document.createElement('button'); edit.type = 'button'; edit.className = 'rounded-lg bg-stone-100 px-3 py-2 text-xs font-bold text-gray-700 hover:bg-stone-200'; edit.innerHTML = '<i class="fas fa-pen mr-1"><\/i> Editar'; edit.onclick = () => openWhatsAppWidget(widget);
	const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'ml-auto rounded-lg bg-red-50 px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-100'; remove.innerHTML = '<i class="fas fa-trash"><\/i>'; remove.setAttribute('aria-label', 'Excluir botão'); remove.onclick = () => deleteWhatsAppWidget(widget);
	actions.append(copy, edit, remove); content.append(heading, code, actions); card.append(preview, content); return card;
}

function renderWhatsAppWidgets() {
	const grid = document.getElementById('whatsapp-widgets-grid'); grid.replaceChildren(); whatsAppWidgets.forEach(widget => grid.appendChild(whatsAppWidgetCard(widget)));
	document.getElementById('whatsapp-widgets-loading').classList.add('hidden'); document.getElementById('whatsapp-widgets-empty').classList.toggle('hidden', whatsAppWidgets.length > 0);
}

async function loadWhatsAppWidgets() { const response = await whatsAppWidgetAPI('GET', ''); whatsAppWidgets = Array.isArray(response.data) ? response.data : []; renderWhatsAppWidgets(); }
function ensureWhatsAppWidgetVariantControl() { if (document.getElementById('whatsapp-widget-icon-only')) return; const active = document.getElementById('whatsapp-widget-active').closest('label'); const fieldset = document.createElement('fieldset'); fieldset.className = 'rounded-2xl border border-stone-200 bg-stone-50 p-4'; fieldset.innerHTML = '<legend class="px-1 text-sm font-bold text-gray-800">Versão do botão<\/legend><div class="mt-2 grid gap-2 sm:grid-cols-2"><label class="cursor-pointer rounded-xl border border-purple-200 bg-white p-3"><input type="radio" name="whatsapp-widget-variant" value="long" checked class="sr-only peer"><span class="block text-sm font-bold text-gray-800">Versão longa<\/span><span class="mt-1 block text-xs text-gray-500">Ícone e chamada para ação.<\/span><\/label><label class="cursor-pointer rounded-xl border border-stone-200 bg-white p-3"><input id="whatsapp-widget-icon-only" type="radio" name="whatsapp-widget-variant" value="short" class="sr-only peer"><span class="block text-sm font-bold text-gray-800">Versão curta<\/span><span class="mt-1 block text-xs text-gray-500">Somente o ícone do WhatsApp.<\/span><\/label><\/div><\/fieldset>'; active.insertAdjacentElement('afterend', fieldset); document.querySelectorAll('[name="whatsapp-widget-variant"]').forEach(input => input.addEventListener('change', updateWhatsAppWidgetPreview)); }
function updateWhatsAppWidgetPreview() { const color = document.getElementById('whatsapp-widget-color').value.toUpperCase(); const text = document.getElementById('whatsapp-widget-cta').value.trim() || 'Fale conosco no WhatsApp'; const compact = document.getElementById('whatsapp-widget-icon-only').checked; document.getElementById('whatsapp-widget-color-value').textContent = color; const preview = document.getElementById('whatsapp-widget-preview'); const label = preview.querySelector('span'); preview.style.background = color; preview.style.width = compact ? '56px' : ''; preview.style.height = compact ? '56px' : ''; preview.style.minHeight = compact ? '56px' : ''; preview.style.padding = compact ? '0' : ''; preview.style.justifyContent = compact ? 'center' : ''; preview.style.gap = compact ? '0' : ''; label.textContent = text; label.classList.toggle('hidden', compact); }
function openWhatsAppWidget(widget) { const form = document.getElementById('whatsapp-widget-form'); form.reset(); form.dataset.widgetId = widget ? String(widget.id) : ''; form.dataset.revision = widget ? String(widget.revision) : ''; document.getElementById('whatsapp-widget-title').textContent = widget ? 'Editar botão do WhatsApp' : 'Novo botão do WhatsApp'; document.getElementById('whatsapp-widget-name').value = widget ? widget.name : ''; document.getElementById('whatsapp-widget-phone').value = widget ? '+' + widget.phoneNumber : ''; document.getElementById('whatsapp-widget-cta').value = widget ? widget.callToAction : 'Fale conosco no WhatsApp'; document.getElementById('whatsapp-widget-color').value = widget ? widget.color : '#25D366'; document.getElementById('whatsapp-widget-active').checked = widget ? widget.isActive : true; document.getElementById('whatsapp-widget-icon-only').checked = widget ? !!widget.iconOnly : false; if (!document.getElementById('whatsapp-widget-icon-only').checked) document.querySelector('[name="whatsapp-widget-variant"][value="long"]').checked = true; document.getElementById('whatsapp-widget-error').classList.add('hidden'); updateWhatsAppWidgetPreview(); const modal = document.getElementById('whatsapp-widget-modal'); modal.classList.remove('hidden'); modal.classList.add('flex'); setTimeout(() => document.getElementById('whatsapp-widget-name').focus(), 50); }
function closeWhatsAppWidget() { const modal = document.getElementById('whatsapp-widget-modal'); modal.classList.add('hidden'); modal.classList.remove('flex'); }
async function copyWhatsAppWidgetCode(input, button) { input.select(); try { await navigator.clipboard.writeText(input.value); } catch (_) { document.execCommand('copy'); } const original = button.innerHTML; button.innerHTML = '<i class="fas fa-check mr-1"><\/i> Copiado'; setTimeout(() => button.innerHTML = original, 1800); }
async function deleteWhatsAppWidget(widget) { if (!confirm('Excluir o botão "' + widget.name + '"? Ele deixará de aparecer nos sites.')) return; try { await whatsAppWidgetAPI('DELETE', '/' + widget.id); await loadWhatsAppWidgets(); } catch (error) { showCompanySettingsError(error); } }

function showCompanySettingsError(error) {
    const box = document.getElementById('company-settings-error');
    box.textContent = error instanceof Error ? error.message : String(error);
    box.classList.remove('hidden');
}

const companySettingsTabs = ['company', 'messages', 'automation', 'hours', 'data', 'ai-credentials', 'integrations', 'billing', 'logs'];

function setCompanySettingsTab(tab, updateURL) {
	const selected = companySettingsTabs.includes(tab) ? tab : 'company';
	document.querySelectorAll('[data-company-settings-tab]').forEach(button => {
		const active = button.dataset.companySettingsTab === selected;
		button.setAttribute('aria-selected', String(active));
		button.tabIndex = active ? 0 : -1;
	});
	document.querySelectorAll('[data-company-settings-panel]').forEach(panel => panel.classList.toggle('hidden', panel.dataset.companySettingsPanel !== selected));
	document.getElementById('company-settings-form').classList.toggle('hidden', selected === 'ai-credentials' || selected === 'integrations' || selected === 'billing' || selected === 'logs');
	if (selected === 'logs' && window.loadCompanyAuditLog) window.loadCompanyAuditLog(false);
	if (updateURL) history.replaceState(null, '', window.location.pathname + window.location.search + '#settings-' + selected);
}

document.querySelectorAll('[data-company-settings-tab]').forEach((button, index, buttons) => {
	button.addEventListener('click', () => setCompanySettingsTab(button.dataset.companySettingsTab, true));
	button.addEventListener('keydown', event => {
		if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
		event.preventDefault();
		let next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
		buttons[next].focus();
		setCompanySettingsTab(buttons[next].dataset.companySettingsTab, true);
	});
});

document.querySelectorAll('[data-company-business-day]').forEach(input => input.addEventListener('change', () => document.getElementById('company-business-days-error').classList.add('hidden')));
document.querySelectorAll('[data-company-attachment]').forEach(input => input.addEventListener('change', () => document.getElementById('company-attachments-error').classList.add('hidden')));

function renderCompanySettings() {
    const settings = companySettingsState || {};
	const operations = settings.operations || {};
	document.getElementById('company-message-edit-policy').value = operations.messageEditPolicy || 'disabled';
    document.getElementById('company-settings-name').value = settings.name || '';
    document.getElementById('company-settings-email').value = settings.email || '';
	setCompanySettingsTimezone(settings.timezone || settings.defaultTimezone || 'America/Sao_Paulo');
	document.getElementById('company-provider-override').value = settings.paymentProviderOverride || '';
	document.getElementById('company-media-retention').value = settings.mediaRetentionDays ? String(settings.mediaRetentionDays) : '';
	document.getElementById('company-accept-calls').checked = Boolean(operations.acceptCalls);
	document.getElementById('company-accept-groups').checked = Boolean(operations.acceptGroupMessages);
	document.getElementById('company-flows-all').checked = Boolean(operations.flowsForAllContacts);
	document.getElementById('company-platform-contacts-only').checked = Boolean(operations.platformContactsOnly);
	document.getElementById('company-hours-enabled').checked = Boolean(operations.businessHoursEnabled);
	document.getElementById('company-hours-start').value = operations.businessHoursStart || '08:00'; document.getElementById('company-hours-end').value = operations.businessHoursEnd || '18:00';
	const businessDays = Array.isArray(operations.businessHoursDays) ? operations.businessHoursDays.map(Number) : [1,2,3,4,5]; document.querySelectorAll('[data-company-business-day]').forEach(input => input.checked = businessDays.includes(Number(input.dataset.companyBusinessDay)));
	document.getElementById('company-lunch-enabled').checked = Boolean(operations.businessHoursLunchEnabled); document.getElementById('company-lunch-start').value = operations.businessHoursLunchStart || '12:00'; document.getElementById('company-lunch-end').value = operations.businessHoursLunchEnd || '13:00';
	document.getElementById('company-outside-message').value = operations.outsideHoursMessage || ''; document.getElementById('company-welcome-message').value = operations.welcomeMessage || '';
	document.getElementById('company-auto-assign').checked = Boolean(operations.autoAssignEnabled); document.getElementById('company-auto-assign-strategy').value = operations.autoAssignStrategy || 'least_loaded';
	document.getElementById('company-auto-close').value = Number(operations.autoCloseMinutes || 0); document.getElementById('company-conversation-retention').value = Number(operations.conversationRetentionDays || 0); document.getElementById('company-max-attachment').value = Number(operations.maxAttachmentMB || 50);
	document.getElementById('company-notify-new').checked = Boolean(operations.notifyNewConversation); document.getElementById('company-notify-mentions').checked = Boolean(operations.notifyMentions); document.getElementById('company-notify-unanswered').checked = Boolean(operations.notifyUnanswered); document.getElementById('company-outbound-enabled').checked = Boolean(operations.outboundMessagesEnabled);
	const attachments = Array.isArray(operations.allowedAttachmentTypes) ? operations.allowedAttachmentTypes : []; document.querySelectorAll('[data-company-attachment]').forEach(input => input.checked = attachments.includes(input.dataset.companyAttachment));
    document.getElementById('company-provider-override').disabled = !settings.allowCompanyPaymentOverride;
    document.getElementById('company-effective-provider').textContent = companyProviderLabel(settings.effectivePaymentProvider);
    document.getElementById('company-provider-policy').textContent = settings.allowCompanyPaymentOverride ? 'A plataforma permite uma preferência própria.' : 'Definido pela plataforma; escolha própria desabilitada.';
    document.getElementById('company-grace-days').textContent = Number(settings.subscriptionGraceDays || 0) + (Number(settings.subscriptionGraceDays) === 1 ? ' dia' : ' dias');
    document.getElementById('company-settings-loading').classList.add('hidden');
	const content = document.getElementById('company-settings-content');
	const firstRender = content.classList.contains('hidden');
	content.classList.remove('hidden');
	if (firstRender) setCompanySettingsTab(window.location.hash.replace('#settings-', ''), false);
	if (window.refreshAdminSelects) window.refreshAdminSelects();
}

function setCompanySettingsTimezone(value) {
	const select = document.getElementById('company-settings-timezone');
	if (value && !Array.from(select.options).some(option => option.value === value)) {
		const option = document.createElement('option'); option.value = value; option.textContent = value; select.appendChild(option);
	}
	select.value = value;
}

async function loadCompanySettings() {
    const response = await companySettingsAPI('GET');
    companySettingsState = response.data;
    renderCompanySettings();
}

document.getElementById('company-settings-form').addEventListener('submit', async event => {
    event.preventDefault();
	const businessDays = Array.from(document.querySelectorAll('[data-company-business-day]:checked'));
	if (!businessDays.length) {
		setCompanySettingsTab('hours', true);
		document.getElementById('company-business-days-error').classList.remove('hidden');
		document.querySelector('[data-company-business-day]').focus();
		return;
	}
	const attachmentTypes = Array.from(document.querySelectorAll('[data-company-attachment]:checked'));
	if (!attachmentTypes.length) {
		setCompanySettingsTab('data', true);
		document.getElementById('company-attachments-error').classList.remove('hidden');
		document.querySelector('[data-company-attachment]').focus();
		return;
	}
	const invalid = event.currentTarget.querySelector(':invalid');
	if (invalid) {
		const panel = invalid.closest('[data-company-settings-panel]');
		if (panel) setCompanySettingsTab(panel.dataset.companySettingsPanel, true);
		requestAnimationFrame(() => { invalid.focus(); invalid.reportValidity(); });
		return;
	}
    const button = document.getElementById('company-settings-submit'); button.disabled = true;
    const providerSelect = document.getElementById('company-provider-override');
    try {
        const response = await companySettingsAPI('PUT', {
            name: document.getElementById('company-settings-name').value.trim(),
            email: document.getElementById('company-settings-email').value.trim(),
            timezone: document.getElementById('company-settings-timezone').value,
			paymentProviderOverride: !providerSelect.disabled && providerSelect.value ? providerSelect.value : null,
			mediaRetentionDays: document.getElementById('company-media-retention').value ? Number(document.getElementById('company-media-retention').value) : null
			,operations: {
				...companySettingsState.operations,
				messageEditPolicy: document.getElementById('company-message-edit-policy').value,
				acceptCalls: document.getElementById('company-accept-calls').checked,
				acceptGroupMessages: document.getElementById('company-accept-groups').checked,
				flowsForAllContacts: document.getElementById('company-flows-all').checked,
				platformContactsOnly: document.getElementById('company-platform-contacts-only').checked,
				businessHoursEnabled: document.getElementById('company-hours-enabled').checked,
				businessHoursStart: document.getElementById('company-hours-start').value,
				businessHoursEnd: document.getElementById('company-hours-end').value,
				businessHoursDays: Array.from(document.querySelectorAll('[data-company-business-day]:checked')).map(input => Number(input.dataset.companyBusinessDay)),
				businessHoursLunchEnabled: document.getElementById('company-lunch-enabled').checked,
				businessHoursLunchStart: document.getElementById('company-lunch-start').value,
				businessHoursLunchEnd: document.getElementById('company-lunch-end').value,
				outsideHoursMessage: document.getElementById('company-outside-message').value.trim(),
				welcomeMessage: document.getElementById('company-welcome-message').value.trim(),
				autoAssignEnabled: document.getElementById('company-auto-assign').checked,
				autoAssignStrategy: document.getElementById('company-auto-assign-strategy').value,
				autoCloseMinutes: Number(document.getElementById('company-auto-close').value || 0),
				conversationRetentionDays: Number(document.getElementById('company-conversation-retention').value || 0),
				allowedAttachmentTypes: Array.from(document.querySelectorAll('[data-company-attachment]:checked')).map(input => input.dataset.companyAttachment),
				maxAttachmentMB: Number(document.getElementById('company-max-attachment').value || 50),
				notifyNewConversation: document.getElementById('company-notify-new').checked,
				notifyMentions: document.getElementById('company-notify-mentions').checked,
				notifyUnanswered: document.getElementById('company-notify-unanswered').checked,
				outboundMessagesEnabled: document.getElementById('company-outbound-enabled').checked
			}
        });
        companySettingsState = response.data; renderCompanySettings();
        const toast = document.getElementById('company-settings-toast'); toast.classList.remove('hidden'); toast.classList.add('flex');
        setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 3200);
    } catch (error) { showCompanySettingsError(error); } finally { button.disabled = false; }
});

loadCompanySettings().catch(error => { document.getElementById('company-settings-loading').classList.add('hidden'); showCompanySettingsError(error); });
ensureWhatsAppWidgetVariantControl();
loadWhatsAppWidgets().catch(error => { document.getElementById('whatsapp-widgets-loading').classList.add('hidden'); showCompanySettingsError(error); });
document.getElementById('new-whatsapp-widget').onclick = () => openWhatsAppWidget(null);
document.getElementById('close-whatsapp-widget').onclick = closeWhatsAppWidget; document.getElementById('cancel-whatsapp-widget').onclick = closeWhatsAppWidget;
document.getElementById('whatsapp-widget-modal').addEventListener('click', event => { if (event.target.id === 'whatsapp-widget-modal') closeWhatsAppWidget(); });
document.getElementById('whatsapp-widget-color').addEventListener('input', updateWhatsAppWidgetPreview); document.getElementById('whatsapp-widget-cta').addEventListener('input', updateWhatsAppWidgetPreview);
document.getElementById('whatsapp-widget-form').addEventListener('submit', async event => { event.preventDefault(); const form = event.currentTarget; const submit = document.getElementById('save-whatsapp-widget'); const errorBox = document.getElementById('whatsapp-widget-error'); submit.disabled = true; errorBox.classList.add('hidden'); const payload = { name: document.getElementById('whatsapp-widget-name').value.trim(), phoneNumber: document.getElementById('whatsapp-widget-phone').value.trim(), callToAction: document.getElementById('whatsapp-widget-cta').value.trim(), color: document.getElementById('whatsapp-widget-color').value, iconOnly: document.getElementById('whatsapp-widget-icon-only').checked, isActive: document.getElementById('whatsapp-widget-active').checked, revision: Number(form.dataset.revision || 0) }; try { const id = form.dataset.widgetId; await whatsAppWidgetAPI(id ? 'PUT' : 'POST', id ? '/' + id : '', payload); closeWhatsAppWidget(); await loadWhatsAppWidgets(); } catch (error) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); } finally { submit.disabled = false; } });
	document.addEventListener('keydown', event => { if (event.key === 'Escape' && document.getElementById('whatsapp-widget-modal').classList.contains('flex')) closeWhatsAppWidget(); });
		</script>
	}
}
